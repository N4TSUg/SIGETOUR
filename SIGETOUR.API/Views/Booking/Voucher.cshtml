@model SIGETOUR.API.Core.Entities.Booking
@{
    ViewData["Title"] = "Voucher de Reserva";
    var tour = Model.Items.FirstOrDefault()?.TourPackage;
}

<div class="bg-surface-container py-12 px-4 md:px-8 min-h-screen">
    <div class="max-w-3xl mx-auto bg-surface-container-lowest rounded-xl shadow-md border border-outline-variant p-8 text-center">
        <span class="material-symbols-outlined text-[64px] text-primary mb-4" data-icon="check_circle">check_circle</span>
        <h1 class="font-title-lg text-title-lg text-on-surface font-bold mb-2">¡Reserva Confirmada!</h1>
        <p class="font-body-md text-body-md text-secondary mb-8">Tu solicitud ha sido procesada con éxito. Por favor presenta este código el día de tu viaje.</p>

        <div class="bg-primary/10 border border-primary/20 rounded-lg p-6 mb-8 inline-block mx-auto min-w-[200px]">
            <span class="block font-label-sm text-label-sm uppercase tracking-wider text-primary mb-1">Código de Reserva</span>
            <span class="font-headline-md text-headline-md font-bold text-primary">@Model.ReferenceCode</span>
        </div>

        <div class="text-left bg-surface-container-low p-6 rounded-lg border border-outline-variant grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
                <span class="block font-label-sm text-label-sm text-secondary uppercase">Tour Seleccionado</span>
                <span class="font-title-sm font-bold text-on-surface">@(tour?.Title ?? "N/A")</span>
            </div>
            <div>
                <span class="block font-label-sm text-label-sm text-secondary uppercase">Fecha de Viaje</span>
                <span class="font-title-sm font-bold text-on-surface">@Model.TravelDate.ToString("dd/MM/yyyy")</span>
            </div>
            <div>
                <span class="block font-label-sm text-label-sm text-secondary uppercase">Pasajeros</span>
                <span class="font-title-sm font-bold text-on-surface">@Model.TotalPassengers</span>
            </div>
            <div>
                <span class="block font-label-sm text-label-sm text-secondary uppercase">Punto de Recojo</span>
                <span class="font-title-sm font-bold text-on-surface">@Model.PickupLocation</span>
            </div>
            <div>
                <span class="block font-label-sm text-label-sm text-secondary uppercase">Titular</span>
                <span class="font-title-sm font-bold text-on-surface">@Model.CustomerName</span>
            </div>
            <div>
                <span class="block font-label-sm text-label-sm text-secondary uppercase">Total Pagado / A Pagar</span>
                <span class="font-headline-sm font-bold text-primary">S/ @Model.TotalAmount.ToString("0.00")</span>
            </div>
        </div>

        <div class="mt-8 pt-6 border-t border-outline-variant flex justify-center gap-4">
            <a href="/Tour/Catalog" class="px-6 py-3 border border-outline text-secondary font-label-md rounded-lg hover:bg-surface-container-low transition-all">Volver al Catálogo</a>
            <a href="https://wa.me/51901195392?text=Hola,%20tengo%20la%20reserva%20@Model.ReferenceCode" target="_blank" class="px-6 py-3 bg-primary text-on-primary font-label-md rounded-lg hover:bg-primary-container transition-all flex items-center gap-2">
                <span class="material-symbols-outlined text-sm">chat</span> WhatsApp
            </a>
        </div>
    </div>
</div>
