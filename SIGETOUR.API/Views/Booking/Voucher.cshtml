@model SIGETOUR.API.Core.Entities.Booking
@using System.Text.Json
@{
    ViewData["Title"] = "Voucher Oficial de Reserva – " + Model.ReferenceCode;
    var tour = Model.Items.FirstOrDefault()?.TourPackage;
    var tourPrice = tour?.BasePrice ?? (Model.TotalAmount / Math.Max(1, Model.TotalPassengers));
    
    // Parse extra passengers safely
    var extraPassengers = new List<(string Name, string Dni, string Phone)>();
    if (!string.IsNullOrWhiteSpace(Model.AdditionalPassengersJson) && Model.AdditionalPassengersJson != "[]")
    {
        try
        {
            using var doc = JsonDocument.Parse(Model.AdditionalPassengersJson);
            foreach (var elem in doc.RootElement.EnumerateArray())
            {
                var name = elem.TryGetProperty("Name", out var n) ? n.GetString() ?? "" : "";
                var dni = elem.TryGetProperty("Dni", out var d) ? d.GetString() ?? "" : "";
                var phone = elem.TryGetProperty("Phone", out var p) ? p.GetString() ?? "" : "";
                if (!string.IsNullOrWhiteSpace(name))
                {
                    extraPassengers.Add((name, dni, phone));
                }
            }
        }
        catch { }
    }

    var receipt = ViewBag.Receipt as SIGETOUR.API.Core.Entities.ElectronicReceipt;
    var hasValidReceipt = receipt != null && (receipt.Status == "Accepted" || receipt.Status == "Simulation");
    var hasExternalPdf = !string.IsNullOrWhiteSpace(receipt?.PdfUrl) && receipt.PdfUrl.StartsWith("http");
    var hasXml = !string.IsNullOrWhiteSpace(receipt?.XmlUrl);
}

<style>
  @@page {
    size: A4 portrait;
    margin: 8mm;
  }
  @@media print {
    html, body {
      margin: 0 !important;
      padding: 0 !important;
      background: white !important;
      color: black !important;
      -webkit-print-color-adjust: exact !important;
      print-color-adjust: exact !important;
    }
    body * {
      visibility: hidden;
    }
    #print-voucher-area, #print-voucher-area * {
      visibility: visible;
    }
    #print-voucher-area {
      position: absolute !important;
      left: 0 !important;
      top: 0 !important;
      width: 100% !important;
      max-width: 100% !important;
      margin: 0 !important;
      padding: 16px !important;
      border: 1.5px solid #00685a !important;
      border-radius: 10px !important;
      box-shadow: none !important;
      page-break-inside: avoid !important;
      page-break-after: avoid !important;
      page-break-before: avoid !important;
    }
    .no-print {
      display: none !important;
    }
  }
</style>

<!-- STEPPER BAR (NO-PRINT) -->
<nav aria-label="Progreso de la Reserva" class="no-print bg-surface-container-lowest border-b border-outline-variant/30 shadow-xs py-3">
  <div class="max-w-7xl mx-auto px-4 md:px-8">
    <div class="flex items-center justify-between max-w-4xl mx-auto relative">
      @foreach (var (label, num) in new[] { ("1. Datos del Tour", 1), ("2. Recojo & Pasajeros", 2), ("3. Datos de Contacto", 3), ("4. Pago Seguro", 4) })
      {
        <div class="flex flex-col items-center group relative z-10">
          <div class="w-8 h-8 rounded-full bg-primary text-white flex items-center justify-center font-bold text-xs shadow-sm">
            <span class="material-symbols-outlined text-sm font-bold">check</span>
          </div>
          <span class="mt-1 text-label-sm font-label-sm text-secondary font-medium hidden md:inline-block">@label</span>
        </div>
        <div class="flex-1 h-0.5 bg-primary mx-2 -mt-4 md:-mt-5"></div>
      }
      <!-- Step 5: Completed & Active Voucher -->
      <div class="flex flex-col items-center group relative z-10">
        <div class="w-8 h-8 rounded-full bg-primary ring-4 ring-primary/20 text-white flex items-center justify-center font-bold text-xs shadow-md">
          <span class="material-symbols-outlined text-sm font-bold">check</span>
        </div>
        <span class="mt-1 text-label-sm font-label-sm text-primary font-bold">5. Boleto Oficial</span>
      </div>
    </div>
  </div>
</nav>

<div class="bg-surface font-body-md text-on-surface antialiased min-h-screen py-6 md:py-8">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 w-full">

    <!-- BOTONES DE ACCIÓN RÁPIDA (NO-PRINT) -->
    <div class="no-print flex flex-wrap gap-3 justify-between items-center mb-6">
      <div class="flex items-center gap-2">
        <div class="w-10 h-10 rounded-xl @(Model.Status == SIGETOUR.API.Core.Entities.BookingStatus.Confirmed ? "bg-primary-container text-primary" : "bg-amber-100 text-amber-800") flex items-center justify-center font-bold shadow-xs">
          <span class="material-symbols-outlined text-2xl">@(Model.Status == SIGETOUR.API.Core.Entities.BookingStatus.Confirmed ? "check_circle" : "pending")</span>
        </div>
        <div>
          <h1 class="text-title-md font-bold text-on-surface">@(Model.Status == SIGETOUR.API.Core.Entities.BookingStatus.Confirmed ? (Model.PaidAmount < Model.TotalAmount ? "Boleto con Adelanto Registrado" : "Boleto Turístico Confirmado") : "Reserva Provisional - Pendiente de Pago")</h1>
          <p class="text-xs text-secondary">Localizador: <strong class="text-primary font-mono">@Model.ReferenceCode</strong></p>
        </div>
      </div>

      <div class="flex items-center gap-2">
        <button type="button" class="inline-flex items-center justify-center gap-1.5 bg-primary text-on-primary hover:bg-primary/90 px-4 py-2.5 rounded-xl text-label-md font-bold shadow-sm transition-all active:scale-95 cursor-pointer" onclick="window.print()">
          <span class="material-symbols-outlined text-[18px]">print</span>
          <span>Imprimir Boleto (1 Hoja / PDF)</span>
        </button>

        <a asp-controller="Booking" asp-action="Ticket" asp-route-id="@Model.Id" target="_blank" class="inline-flex items-center justify-center gap-1.5 bg-amber-50 hover:bg-amber-100 text-amber-900 border border-amber-300 px-3.5 py-2.5 rounded-xl text-label-md font-bold transition-all shadow-xs active:scale-95" title="Imprimir comprobante en formato Ticket Térmico POS (80mm / 58mm)">
          <span class="material-symbols-outlined text-[18px]">receipt</span>
          <span>Ticket POS (80/58mm)</span>
        </a>

        @if (hasExternalPdf)
        {
          <a href="@receipt!.PdfUrl" target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-1.5 bg-blue-50 hover:bg-blue-100 text-blue-700 border border-blue-200 px-3.5 py-2.5 rounded-xl text-label-md font-bold transition-all shadow-xs active:scale-95" title="Descargar comprobante tributario oficial de SUNAT/NubeFact">
            <span class="material-symbols-outlined text-[18px]">receipt_long</span>
            <span>Descargar @receipt.ReceiptType (PDF)</span>
          </a>
        }
        @if (hasXml)
        {
          <a href="@receipt!.XmlUrl" target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-1.5 bg-gray-50 hover:bg-gray-100 text-gray-700 border border-gray-200 px-3 py-2.5 rounded-xl text-label-md font-semibold transition-all shadow-xs active:scale-95" title="Descargar archivo XML firmado">
            <span class="material-symbols-outlined text-[18px]">code</span>
            <span>XML</span>
          </a>
        }

        <a class="inline-flex items-center justify-center gap-1.5 bg-emerald-600 hover:bg-emerald-700 text-white px-4 py-2.5 rounded-xl text-label-md font-bold transition-all shadow-xs active:scale-95" href="https://wa.me/51901195392?text=Hola,%20adjunto%20mi%20código%20de%20reserva%20@Model.ReferenceCode%20para%20el%20Tour%20@(Uri.EscapeDataString(tour?.Title ?? "Cajamarca"))" target="_blank" rel="noopener noreferrer">
          <span class="material-symbols-outlined text-[18px]">chat</span>
          <span>WhatsApp</span>
        </a>

        <a asp-controller="Home" asp-action="Index" class="inline-flex items-center justify-center gap-1.5 bg-surface-container-lowest text-secondary border border-outline-variant hover:bg-surface-container-low px-3.5 py-2.5 rounded-xl text-label-md font-semibold transition-all shadow-xs">
          <span class="material-symbols-outlined text-[18px]">home</span>
          <span>Terminar</span>
        </a>
      </div>
    </div>

    <!-- BOLETO OFICIAL DE VIAJE (DISEÑADO EXACTAMENTE PARA 1 HOJA A4 IMPRESA) -->
    <div class="bg-white rounded-2xl shadow-md border-2 border-primary/30 overflow-hidden mb-6" id="print-voucher-area">
      
      <!-- 1. ENCABEZADO DEL BOLETO -->
      <div class="bg-emerald-50/70 border-b border-primary/20 px-6 py-4 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
        <div class="flex items-center gap-3.5">
          <div class="w-12 h-12 rounded-xl bg-primary text-white flex items-center justify-center font-bold shadow-xs shrink-0">
            <span class="material-symbols-outlined text-2xl">directions_bus</span>
          </div>
          <div>
            <div class="flex items-center gap-2">
              <span class="text-title-lg font-black text-primary tracking-wide">TURISMO CHILÓN</span>
              <span class="bg-primary text-white text-[10px] px-2 py-0.5 rounded-full font-bold uppercase tracking-wider">Boleto Oficial</span>
            </div>
            <p class="text-xs text-gray-700 font-semibold">Transporte &amp; Turismo Cajamarca S.A.C. • RUC: 20601234567</p>
            <p class="text-[11px] text-gray-500">DIRCETUR Cert. N° 4412 • Jr. 2 de Mayo 569, Cajamarca</p>
          </div>
        </div>

        <div class="bg-white px-4 py-2 rounded-xl border border-primary/20 text-left sm:text-right shrink-0">
          <span class="text-[10px] font-bold text-gray-500 uppercase tracking-wider block">LOCALIZADOR DE VIAJE</span>
          <span class="text-title-md font-mono font-black text-primary tracking-wider">@Model.ReferenceCode</span>
          <span class="text-[10px] text-gray-500 block">Emisión: @Model.BookingDate.ToString("dd/MM/yyyy HH:mm") hrs</span>
        </div>
      </div>

      <!-- 2. CUERPO PRINCIPAL DEL BOLETO (2 COLUMNAS COMPACTAS) -->
      <div class="p-5 grid grid-cols-1 md:grid-cols-12 gap-5 items-start">
        
        <!-- Lado Izquierdo (8 Columnas): Circuito, Fecha, Vehículo y Pasajeros -->
        <div class="md:col-span-8 space-y-3.5">
          
          <!-- Circuito Turístico -->
          <div class="bg-gray-50 rounded-xl p-3.5 border border-gray-200">
            <div class="flex items-start justify-between">
              <div>
                <span class="text-[10px] uppercase font-bold text-primary tracking-wider block">Circuito Turístico Autorizado</span>
                <h2 class="text-title-md font-extrabold text-gray-900 leading-snug">@(tour?.Title ?? "Tour Turístico Cajamarca")</h2>
              </div>
              <span class="bg-emerald-100 text-emerald-800 text-[10px] font-bold px-2 py-0.5 rounded-full shrink-0">
                Servicio Confort VIP
              </span>
            </div>
            
            <div class="grid grid-cols-3 gap-3 pt-2.5 mt-2.5 border-t border-gray-200 text-xs">
              <div>
                <span class="text-[10px] text-gray-500 block font-bold">Fecha del Viaje</span>
                <span class="font-bold text-gray-900">@Model.TravelDate.ToString("dd/MM/yyyy")</span>
              </div>
              <div>
                <span class="text-[10px] text-gray-500 block font-bold">Turno / Horario</span>
                <span class="font-bold text-primary">@(string.IsNullOrWhiteSpace(Model.ShiftName) ? "Mañana (09:00 AM)" : Model.ShiftName)</span>
              </div>
              <div>
                <span class="text-[10px] text-gray-500 block font-bold">Duración</span>
                <span class="font-semibold text-gray-800">@(tour?.Duration ?? "4 Horas aprox.")</span>
              </div>
            </div>
          </div>

          <!-- Unidad y Embarque -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs">
            <div class="rounded-xl p-3 border border-gray-200 bg-white">
              <span class="text-[10px] font-bold text-gray-500 uppercase tracking-wider block mb-1">Unidad &amp; Flota Asignada</span>
              <p class="font-bold text-gray-900">Mercedes-Benz Sprinter / HiAce VIP</p>
              <p class="text-[11px] text-gray-600 mt-0.5">Climatizada A/C • Asientos reclinables • SOAT MTC</p>
            </div>

            <div class="rounded-xl p-3 border border-gray-200 bg-white">
              <span class="text-[10px] font-bold text-gray-500 uppercase tracking-wider block mb-1">Punto de Embarque</span>
              @if (!string.IsNullOrWhiteSpace(Model.PickupLocation) && Model.PickupLocation != "agencia")
              {
                <p class="font-bold text-gray-900">Recojo: @Model.PickupLocation</p>
                <p class="text-[11px] text-amber-800 font-medium mt-0.5">Estar listo en recepción 15 min antes</p>
              }
              else
              {
                <p class="font-bold text-gray-900">Agencia Central: Jr. 2 de Mayo 569</p>
                <p class="text-[11px] text-emerald-800 font-medium mt-0.5">Presentarse 15 min antes con DNI físico</p>
              }
            </div>
          </div>

          <!-- Pasajeros Registrados -->
          <div class="rounded-xl p-3 border border-gray-200 bg-white">
            <div class="flex items-center justify-between mb-2">
              <span class="text-[11px] font-bold text-gray-700 uppercase tracking-wider flex items-center gap-1.5">
                <span class="material-symbols-outlined text-base text-primary">group</span>
                Pasajeros en Boleto (@Model.TotalPassengers Asiento@(Model.TotalPassengers > 1 ? "s" : ""))
              </span>
              <span class="text-[10px] text-gray-500 font-semibold">Cupos Garantizados</span>
            </div>

            <div class="space-y-1.5 text-xs">
              <!-- Titular -->
              <div class="flex items-center justify-between p-2 rounded-lg bg-gray-50 border border-gray-100">
                <div class="flex items-center gap-2">
                  <span class="w-5 h-5 rounded-full bg-primary text-white text-[10px] font-bold flex items-center justify-center">1</span>
                  <span class="font-bold text-gray-900">@Model.CustomerName</span>
                  <span class="text-[9px] bg-primary/10 text-primary font-bold px-1.5 py-0.2 rounded">Titular</span>
                </div>
                <div class="text-[11px] text-gray-600">
                  <span>DNI: <strong>@(string.IsNullOrWhiteSpace(Model.CustomerDni) ? "Pendiente" : Model.CustomerDni)</strong></span>
                  @if (!string.IsNullOrWhiteSpace(Model.CustomerPhone))
                  {
                    <span class="ml-2">Cel: @Model.CustomerPhone</span>
                  }
                </div>
              </div>

              <!-- Acompañantes -->
              @{
                int seatIdx = 2;
                foreach (var extra in extraPassengers)
                {
                  <div class="flex items-center justify-between p-2 rounded-lg bg-gray-50 border border-gray-100">
                    <div class="flex items-center gap-2">
                      <span class="w-5 h-5 rounded-full bg-gray-200 text-gray-700 text-[10px] font-bold flex items-center justify-center">@seatIdx</span>
                      <span class="font-bold text-gray-900">@extra.Name</span>
                    </div>
                    <div class="text-[11px] text-gray-600">
                      <span>DNI: <strong>@(string.IsNullOrWhiteSpace(extra.Dni) ? "Verificar al embarque" : extra.Dni)</strong></span>
                    </div>
                  </div>
                  seatIdx++;
                }
              }
            </div>
          </div>

        </div>

        <!-- Lado Derecho (4 Columnas): Verificación y Desglose Financiero -->
        <div class="md:col-span-4 bg-gray-50 rounded-xl p-4 border border-gray-200 flex flex-col justify-between h-full space-y-4">
          
          <!-- Verificación de Abordaje (Sin QR, exactamente 1 hoja) -->
          <div class="text-center bg-white p-3.5 rounded-xl border-2 border-dashed border-primary/40">
            <span class="text-[10px] uppercase font-bold text-gray-500 tracking-wider block">Verificación de Abordaje</span>
            <div class="w-10 h-10 rounded-full bg-primary/10 text-primary mx-auto my-1.5 flex items-center justify-center font-bold">
              <span class="material-symbols-outlined text-2xl">verified_user</span>
            </div>
            <span class="text-[10px] text-gray-500 block">Código Localizador</span>
            <span class="text-title-md font-mono font-black text-primary tracking-widest block">@Model.ReferenceCode</span>
            <div class="mt-1.5 inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full bg-emerald-100 text-emerald-800 text-[10px] font-bold">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-600"></span>
              Acceso Confirmado
            </div>
            <p class="text-[10px] text-gray-500 mt-1.5 leading-tight">
              Presentar este código y DNI físico en counter o unidad de transporte.
            </p>
          </div>

          <!-- Resumen de Pago -->
          <div class="space-y-1.5 text-xs">
            <div class="flex justify-between items-center text-gray-600">
              <span>Tarifa (@Model.TotalPassengers Pax):</span>
              <span class="font-semibold text-gray-900">S/ @((tourPrice * Model.TotalPassengers).ToString("N2"))</span>
            </div>
            @if (Model.PickupCost > 0)
            {
              <div class="flex justify-between items-center text-gray-600">
                <span>Recojo Hotel:</span>
                <span class="font-semibold text-gray-900">S/ @Model.PickupCost.ToString("N2")</span>
              </div>
            }
            <div class="flex justify-between items-center text-gray-600">
              <span>Método:</span>
              <span class="font-semibold text-gray-900">@(string.IsNullOrWhiteSpace(Model.PaymentMethod) ? "Yape / Transferencia" : Model.PaymentMethod)</span>
            </div>

            <div class="bg-white p-2.5 rounded-xl border border-gray-200 flex justify-between items-center mt-2">
              <div>
                <span class="text-[10px] text-gray-500 uppercase font-bold block">@(Model.PaidAmount > 0 ? (Model.PaidAmount < Model.TotalAmount ? "ADELANTO REGISTRADO" : "TOTAL ABONADO") : "MONTO A LIQUIDAR")</span>
                <span class="text-title-sm font-extrabold text-primary">S/ @((Model.PaidAmount > 0 ? Model.PaidAmount : Model.TotalAmount).ToString("N2"))</span>
                @if (Model.PaidAmount > 0 && Model.PaidAmount < Model.TotalAmount)
                {
                  <span class="text-[10px] text-amber-700 block font-semibold">Saldo en Counter: S/ @((Model.TotalAmount - Model.PaidAmount).ToString("N2"))</span>
                }
              </div>
              @if (Model.Status == SIGETOUR.API.Core.Entities.BookingStatus.Confirmed)
              {
                <span class="bg-emerald-100 text-emerald-800 border border-emerald-300 text-[11px] px-2.5 py-0.5 rounded-full font-extrabold flex items-center gap-1">
                  <span class="material-symbols-outlined text-xs">check_circle</span>
                  @(Model.PaidAmount < Model.TotalAmount ? "SEÑA REGISTRADA" : "PAGADO 100%")
                </span>
              }
              else
              {
                <span class="bg-amber-100 text-amber-800 border border-amber-300 text-[11px] px-2.5 py-0.5 rounded-full font-extrabold flex items-center gap-1">
                  <span class="material-symbols-outlined text-xs">schedule</span>
                  PENDIENTE PAGO
                </span>
              }
            </div>

            <p class="text-[10px] text-gray-500 text-center pt-1">
              @if (hasValidReceipt)
              {
                <span>Comprobante Tributario: <strong>@receipt!.ReceiptType @receipt.FullNumber</strong></span>
              }
              else if (Model.Status == SIGETOUR.API.Core.Entities.BookingStatus.Confirmed)
              {
                <span>Boleto Confirmado (Comprobante electrónico en emisión)</span>
              }
              else
              {
                <span>Presentar este código en Counter para efectuar tu pago</span>
              }
            </p>
          </div>

        </div>
      </div>

      <!-- 3. FRANJA INFORMATIVA INFERIOR (1 SOLA HOJA CON TÉRMINOS ESENCIALES) -->
      <div class="bg-gray-100/80 px-5 py-2.5 border-t border-gray-200 flex flex-col sm:flex-row items-center justify-between text-[11px] text-gray-600 gap-1.5">
        <span>Válido para la fecha y turno señalados. Presentar DNI físico 15 min antes del embarque. Cajamarca: 2,750 m.s.n.m. (llevar abrigo y calzado adecuado).</span>
        <span class="font-bold text-gray-900 shrink-0">Central: +51 901 195 392 / +51 944 746 364</span>
      </div>

    </div>

    <!-- DISTINCIÓN DE DOCUMENTOS: VOUCHER TURÍSTICO DE ABORDAJE VS COMPROBANTE TRIBUTARIO -->
    <div class="bg-white border border-outline-variant/60 rounded-2xl p-4 mb-6 shadow-xs flex flex-col md:flex-row items-center justify-between gap-4">
      <div class="flex items-start gap-3">
        <div class="w-10 h-10 rounded-xl bg-primary/10 text-primary flex items-center justify-center shrink-0">
          <span class="material-symbols-outlined text-2xl">verified</span>
        </div>
        <div>
          <h4 class="text-label-lg font-bold text-on-surface">Distinción de Documentos: Boleto de Abordaje vs Comprobante Tributario</h4>
          <p class="text-xs text-secondary mt-0.5">
            El <strong>Boleto Oficial de Viaje</strong> (hoja superior) acredita tu reserva e itinerario de viaje.
            @if (hasValidReceipt)
            {
              <span>Tu <strong>@receipt!.ReceiptType Electrónica (@receipt.FullNumber)</strong> está disponible para descarga oficial.</span>
            }
            else
            {
              <span>El comprobante tributario se emite de forma desacoplada tras la confirmación de la pasarela.</span>
            }
          </p>
        </div>
      </div>
      <div class="flex items-center gap-2 shrink-0">
        <a asp-controller="Booking" asp-action="Ticket" asp-route-id="@Model.Id" target="_blank" class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl bg-amber-500 hover:bg-amber-600 text-white text-xs font-bold transition-all shadow-xs" title="Imprimir ticket térmico POS">
          <span class="material-symbols-outlined text-[16px]">receipt</span>
          <span>Ticket POS (80/58mm)</span>
        </a>
        @if (hasExternalPdf)
        {
          <a href="@receipt!.PdfUrl" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl bg-blue-600 hover:bg-blue-700 text-white text-xs font-bold transition-all shadow-xs">
            <span class="material-symbols-outlined text-[16px]">download</span>
            <span>PDF @receipt.ReceiptType</span>
          </a>
        }
        @if (hasXml)
        {
          <a href="@receipt!.XmlUrl" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl bg-gray-100 hover:bg-gray-200 text-gray-800 text-xs font-bold transition-all border border-gray-300">
            <span class="material-symbols-outlined text-[16px]">code</span>
            <span>XML SUNAT</span>
          </a>
        }
      </div>
    </div>

  </div>
</div>
