@model SIGETOUR.API.Core.Entities.ElectronicReceipt?
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    Layout = null;
    var booking = ViewBag.Booking as SIGETOUR.API.Core.Entities.Booking;
    var ticketSize = ViewBag.TicketSize as string ?? "80"; // "80" o "58"
    var is58 = ticketSize == "58";
    var receipt = Model;
    var hasReceipt = receipt != null;

    // Datos del emisor obtenidos directamente de la configuración
    var tradeName = Configuration["Company:TradeName"] ?? "TURISMO CHILÓN";
    var legalName = Configuration["Company:LegalName"] ?? "TRANSPORTE & TURISMO CAJAMARCA S.A.C.";
    var ruc = Configuration["Company:Ruc"] ?? "20601234567";
    var fiscalAddress = Configuration["Company:FiscalAddress"] ?? "Jr. 2 de Mayo 569, Cajamarca - Perú";
    var phone = Configuration["Company:Phone"] ?? "+51 901 195 392 / +51 944 746 364";

    var title = (receipt?.ReceiptType == "Factura" ? "FACTURA ELECTRÓNICA" : "BOLETA DE VENTA ELECTRÓNICA");
    var fullNumber = receipt?.FullNumber ?? (booking != null ? $"PROV-{booking.ReferenceCode}" : "---");
    var totalAmount = receipt?.TotalAmount ?? (booking?.PaidAmount > 0 ? booking.PaidAmount : booking?.TotalAmount ?? 0m);
    var subtotalAmount = receipt?.SubtotalAmount ?? Math.Round(totalAmount / 1.18m, 2);
    var igvAmount = receipt?.IgvAmount ?? (totalAmount - subtotalAmount);
    var issuedDate = receipt?.IssuedAtUtc ?? booking?.BookingDate ?? DateTime.UtcNow;

    // QR tributario estricto: únicamente datos oficiales devueltos por el proveedor
    var hasValidQr = !string.IsNullOrWhiteSpace(receipt?.QrData);
    var qrString = receipt?.QrData ?? string.Empty;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Ticket POS - @fullNumber - @tradeName</title>
    <!-- Tailwind CSS para vista previa -->
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Space+Mono:wght@400;700&family=Plus+Jakarta+Sans:wght@400;600;700;800&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    <!-- QRCode JS ligero -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
    <style>
        @@page {
            size: @(is58 ? "58mm" : "80mm") auto;
            margin: 0mm !important;
        }
        @@media print {
            body {
                background: white !important;
                margin: 0 !important;
                padding: 0 !important;
                color: black !important;
            }
            .no-print {
                display: none !important;
            }
            .ticket-container {
                width: @(is58 ? "50mm" : "74mm") !important;
                max-width: @(is58 ? "50mm" : "74mm") !important;
                margin: 0 auto !important;
                padding: @(is58 ? "1mm" : "2mm") !important;
                box-shadow: none !important;
                border: none !important;
            }
        }
        .ticket-font {
            font-family: 'Space Mono', monospace, 'Courier New', Courier;
        }
    </style>
</head>
<body class="bg-gray-200 min-h-screen text-gray-900 font-sans antialiased flex flex-col items-center">

    <!-- 1. BARRA DE CONTROL SUPERIOR (SOLO PANTALLA) -->
    <header class="w-full bg-slate-900 text-white shadow-md py-3 px-4 sm:px-8 no-print sticky top-0 z-50">
        <div class="max-w-4xl mx-auto flex flex-wrap items-center justify-between gap-3">
            <div class="flex items-center gap-2">
                <a href="/Booking/Voucher/@(booking?.Id)" class="inline-flex items-center gap-1 text-gray-300 hover:text-white text-xs font-semibold py-1.5 px-3 rounded-lg bg-slate-800 transition-colors">
                    <span class="material-symbols-outlined text-[16px]">arrow_back</span>
                    <span>Volver al Boleto</span>
                </a>
                <span class="text-sm font-bold text-emerald-400 flex items-center gap-1">
                    <span class="material-symbols-outlined text-lg">receipt_long</span>
                    Comprobante POS
                </span>
            </div>

            <!-- Selector de formato térmico (80mm vs 58mm) -->
            <div class="flex items-center gap-2 bg-slate-800 p-1 rounded-xl">
                <span class="text-xs text-gray-400 font-semibold pl-2">Ancho:</span>
                <a href="?size=80" class="px-3 py-1 rounded-lg text-xs font-bold transition-all @(ticketSize == "80" ? "bg-emerald-500 text-slate-950 shadow-sm" : "text-gray-300 hover:text-white")">
                    80 mm (Estándar)
                </a>
                <a href="?size=58" class="px-3 py-1 rounded-lg text-xs font-bold transition-all @(ticketSize == "58" ? "bg-emerald-500 text-slate-950 shadow-sm" : "text-gray-300 hover:text-white")">
                    58 mm (Mini)
                </a>
            </div>

            <!-- Botones de Acción -->
            <div class="flex items-center gap-2">
                <button type="button" onclick="window.print()" class="inline-flex items-center gap-1.5 bg-emerald-600 hover:bg-emerald-500 text-white px-4 py-2 rounded-xl text-xs font-bold transition-all shadow-sm active:scale-95 cursor-pointer">
                    <span class="material-symbols-outlined text-[18px]">print</span>
                    <span>Imprimir Ticket</span>
                </button>
                @if (!string.IsNullOrWhiteSpace(receipt?.PdfUrl) && receipt.PdfUrl.StartsWith("http"))
                {
                    <a href="@receipt.PdfUrl" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 bg-blue-600 hover:bg-blue-500 text-white px-3 py-2 rounded-xl text-xs font-bold transition-all">
                        <span class="material-symbols-outlined text-[16px]">download</span>
                        <span>PDF Oficial</span>
                    </a>
                }
                @if (receipt != null && receipt.Status == "Submitted")
                {
                    <form asp-controller="Booking" asp-action="QueryReceipt" method="post" class="inline-block">
                        <input type="hidden" name="receiptId" value="@receipt.Id" />
                        <button type="submit" class="inline-flex items-center gap-1 bg-sky-600 hover:bg-sky-500 text-white px-3 py-2 rounded-xl text-xs font-bold transition-all" title="Consultar si SUNAT ya procesó el CDR">
                            <span class="material-symbols-outlined text-[16px]">sync</span>
                            <span>Consultar SUNAT</span>
                        </button>
                    </form>
                }
            </div>
        </div>
    </header>

    <!-- 2. LIENZO / CONTENEDOR DEL TICKET TÉRMICO -->
    <main class="my-6 px-2 flex justify-center w-full">
        <div class="ticket-container bg-white text-black shadow-xl border border-gray-300 ticket-font leading-tight @(is58 ? "w-[54mm] max-w-[54mm] p-2 text-[9px]" : "w-[80mm] max-w-[80mm] p-4 text-[11px]")">
            
            <!-- ENCABEZADO FISCAL (DATOS REALES DEL EMISOR) -->
            <div class="text-center">
                <div class="font-extrabold @(is58 ? "text-sm" : "text-base") tracking-tight uppercase">@tradeName</div>
                <div class="font-bold @(is58 ? "text-[8.5px]" : "text-[10px]")">@legalName</div>
                <div class="font-bold">RUC: @ruc</div>
                <div class="@(is58 ? "text-[8px]" : "text-[9.5px]") mt-0.5">@fiscalAddress</div>
                <div class="@(is58 ? "text-[8px]" : "text-[9.5px]")">Tel: @phone</div>
            </div>

            <!-- SEPARADOR -->
            <div class="border-t border-dashed border-black my-2"></div>

            <!-- ESTADO Y LEYENDA DEL COMPROBANTE -->
            @if (receipt?.Status == "Simulation")
            {
                <div class="text-center font-bold text-[9px] bg-amber-100 p-1 border border-black/30 rounded mb-1.5 uppercase">
                    *** DOCUMENTO DE PRUEBA (MOCK) ***<br />
                    SIN VALIDEZ TRIBUTARIA
                </div>
            }
            else if (receipt?.Status == "Accepted")
            {
                <div class="text-center font-bold text-[8.5px] bg-emerald-50 text-emerald-900 p-1 border border-emerald-400 rounded mb-1.5 uppercase">
                    *** COMPROBANTE DEMO NUBEFACT ***<br />
                    EMITIDO CON VALIDEZ DE PRUEBA
                </div>
            }
            else if (receipt?.Status == "Submitted")
            {
                <div class="text-center font-bold text-[8.5px] bg-sky-50 text-sky-900 p-1 border border-sky-400 rounded mb-1.5 uppercase">
                    *** COMPROBANTE EN PROCESO ***<br />
                    PENDIENTE DE RECEPCIÓN SUNAT
                </div>
            }
            else if (receipt?.Status == "Rejected")
            {
                var rawErr = receipt?.LastError ?? receipt?.ProviderDescription ?? "Rechazado por el proveedor tributario";
                string cleanErr = rawErr;
                if (cleanErr.Contains("\"errors\":") || cleanErr.Contains("{\"errors\""))
                {
                    try
                    {
                        using var errDoc = System.Text.Json.JsonDocument.Parse(cleanErr);
                        if (errDoc.RootElement.TryGetProperty("errors", out var ep))
                        {
                            cleanErr = ep.GetString() ?? cleanErr;
                        }
                    }
                    catch { }
                }
                if (cleanErr.Length > 150) cleanErr = cleanErr[..150] + "...";

                <div class="text-center font-bold text-[8.5px] bg-red-100 text-red-900 p-1.5 border border-red-500 rounded mb-1.5 break-words uppercase">
                    *** COMPROBANTE RECHAZADO ***<br />
                    <span class="normal-case font-medium block mt-0.5 text-[8px]">@cleanErr</span>
                    @if (booking != null)
                    {
                        <form asp-controller="Booking" asp-action="RetryReceipt" method="post" class="mt-1 no-print">
                            <input type="hidden" name="bookingId" value="@booking.Id" />
                            <button type="submit" class="px-2 py-0.5 bg-red-700 hover:bg-red-800 text-white rounded text-[8px] font-bold cursor-pointer transition-colors shadow-xs">
                                ↻ Reintentar Emisión NubeFact
                            </button>
                        </form>
                    }
                </div>
            }
            else if (receipt == null)
            {
                <div class="text-center font-bold text-[8.5px] bg-amber-50 text-amber-900 p-1.5 border border-amber-400 rounded mb-1.5 uppercase">
                    *** VOUCHER PROVISIONAL ***<br />
                    COMPROBANTE AÚN NO EMITIDO
                    @if (booking != null && booking.Status == SIGETOUR.API.Core.Entities.BookingStatus.Confirmed)
                    {
                        <form asp-controller="Booking" asp-action="RetryReceipt" method="post" class="mt-1 no-print">
                            <input type="hidden" name="bookingId" value="@booking.Id" />
                            <button type="submit" class="px-2 py-0.5 bg-emerald-700 hover:bg-emerald-800 text-white rounded text-[8px] font-bold cursor-pointer transition-colors shadow-xs">
                                Emitir Comprobante NubeFact
                            </button>
                        </form>
                    }
                </div>
            }

            <!-- TÍTULO DEL COMPROBANTE -->
            <div class="text-center">
                <div class="font-bold @(is58 ? "text-xs" : "text-sm") tracking-wide">@title</div>
                <div class="font-extrabold @(is58 ? "text-sm" : "text-base") mt-0.5">@fullNumber</div>
            </div>

            <!-- FECHA Y EMISIÓN -->
            <div class="mt-2 space-y-0.5">
                <div class="flex justify-between">
                    <span>Fecha Emisión:</span>
                    <span class="font-bold">@issuedDate.ToString("dd/MM/yyyy")</span>
                </div>
                <div class="flex justify-between">
                    <span>Hora Emisión:</span>
                    <span class="font-bold">@issuedDate.ToString("HH:mm:ss")</span>
                </div>
                <div class="flex justify-between">
                    <span>Moneda:</span>
                    <span class="font-bold">SOLES (PEN)</span>
                </div>
            </div>

            <!-- SEPARADOR -->
            <div class="border-t border-dashed border-black my-2"></div>

            <!-- DATOS DEL CLIENTE -->
            <div class="space-y-0.5">
                <div>
                    <span class="text-gray-600">CLIENTE:</span><br />
                    <strong class="uppercase font-bold">@(receipt?.CustomerName ?? booking?.CustomerName ?? "CLIENTE GENERAL")</strong>
                </div>
                <div class="flex justify-between">
                    <span>@(receipt?.CustomerDocType == "6" ? "RUC:" : "DNI/DOC:"):</span>
                    <strong class="font-mono">@(receipt?.CustomerDocNumber ?? booking?.CustomerDni ?? "00000000")</strong>
                </div>
                <div class="flex justify-between">
                    <span>Reserva / Boleto:</span>
                    <strong class="font-bold text-primary font-mono">@(booking?.ReferenceCode ?? "---")</strong>
                </div>
            </div>

            <!-- SEPARADOR -->
            <div class="border-t border-dashed border-black my-2"></div>

            <!-- DETALLE DE CONCEPTOS (CÁLCULO EXACTO PARA MÚLTIPLES PAQUETES O PASAJEROS) -->
            <table class="w-full text-left">
                <thead>
                    <tr class="border-b border-black @(is58 ? "text-[8.5px]" : "text-[9.5px]")">
                        <th class="py-0.5 @(is58 ? "w-4 text-center" : "w-6")">CANT</th>
                        <th class="py-0.5">DESCRIPCIÓN</th>
                        <th class="py-0.5 text-right @(is58 ? "w-11" : "w-14")">TOTAL</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-dashed divide-gray-400">
                    @{
                        var ratio = (booking != null && booking.TotalAmount > 0) ? (totalAmount / booking.TotalAmount) : 1m;
                        var isPartial = booking != null && booking.PaidAmount < booking.TotalAmount;
                        var concept = isPartial ? " (Adelanto)" : "";
                    }
                    @if (booking?.Items != null && booking.Items.Any())
                    {
                        foreach (var item in booking.Items)
                        {
                            var tourTitle = item.TourPackage?.Title ?? "Servicio Turístico";
                            var itemAmount = Math.Round(item.SubTotal * ratio, 2);
                            var itemUnit = Math.Round(item.UnitPrice * ratio, 2);
                            <tr>
                                <td class="py-1 align-top font-bold @(is58 ? "text-center" : "")">@item.Passengers</td>
                                <td class="py-1 align-top break-words">
                                    <div class="font-bold uppercase @(is58 ? "text-[8.5px]" : "text-[10px]")">@tourTitle@concept</div>
                                    <div class="@(is58 ? "text-[8px]" : "text-[9px]") text-gray-700">P.Unit: S/ @itemUnit.ToString("N2")</div>
                                </td>
                                <td class="py-1 align-top text-right font-bold whitespace-nowrap">
                                    S/ @itemAmount.ToString("N2")
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td class="py-1 align-top font-bold @(is58 ? "text-center" : "")">1</td>
                            <td class="py-1 align-top font-bold uppercase break-words @(is58 ? "text-[8.5px]" : "text-[10px]")">Servicio de Transporte Turístico@concept</td>
                            <td class="py-1 align-top text-right font-bold whitespace-nowrap">S/ @totalAmount.ToString("N2")</td>
                        </tr>
                    }
                </tbody>
            </table>

            <!-- SEPARADOR -->
            <div class="border-t border-dashed border-black my-2"></div>

            <!-- TOTALES CONTABLES -->
            <div class="space-y-0.5 text-[10px]">
                <div class="flex justify-between">
                    <span>OP. GRAVADA:</span>
                    <span>S/ @subtotalAmount.ToString("N2")</span>
                </div>
                <div class="flex justify-between">
                    <span>I.G.V. (18%):</span>
                    <span>S/ @igvAmount.ToString("N2")</span>
                </div>
                <div class="flex justify-between text-sm font-extrabold border-t border-b border-black py-1 my-1">
                    <span>TOTAL A PAGAR:</span>
                    <span>S/ @totalAmount.ToString("N2")</span>
                </div>

                @if (booking != null && booking.PaidAmount < booking.TotalAmount)
                {
                    <div class="text-[9.5px] bg-gray-100 p-1 border border-black/20 rounded mt-1">
                        <div class="flex justify-between">
                            <span>TOTAL RESERVA:</span>
                            <span class="font-bold">S/ @booking.TotalAmount.ToString("N2")</span>
                        </div>
                        <div class="flex justify-between">
                            <span>ABONADO (ADELANTO):</span>
                            <span class="font-bold">S/ @booking.PaidAmount.ToString("N2")</span>
                        </div>
                        <div class="flex justify-between font-bold text-red-700 border-t border-gray-300 pt-0.5 mt-0.5">
                            <span>SALDO PENDIENTE:</span>
                            <span>S/ @((booking.TotalAmount - booking.PaidAmount).ToString("N2"))</span>
                        </div>
                    </div>
                }
            </div>

            <!-- FORMA DE PAGO -->
            <div class="mt-2 text-[9.5px]">
                <div class="flex justify-between">
                    <span>MEDIO DE PAGO:</span>
                    <strong class="uppercase font-bold">@(booking?.PaymentMethod ?? "Tarjeta Culqi / Online")</strong>
                </div>
                @if (!string.IsNullOrWhiteSpace(booking?.OperationNumber))
                {
                    <div class="flex justify-between">
                        <span>N° OPERACIÓN:</span>
                        <strong class="font-mono">@booking.OperationNumber</strong>
                    </div>
                }
            </div>

            <!-- SEPARADOR -->
            <div class="border-t border-dashed border-black my-2"></div>

            <!-- CÓDIGO QR TRIBUTARIO REAL (ÚNICAMENTE SI PROVIENE DEL COMPROBANTE) -->
            <div class="flex flex-col items-center justify-center my-2">
                @if (hasValidQr)
                {
                    <div id="qrcode" class="p-1 bg-white border border-black inline-block"></div>
                    @if (!string.IsNullOrWhiteSpace(receipt?.DigitalHash))
                    {
                        <div class="text-[8.5px] font-mono mt-1 text-center break-all">
                            Hash: @receipt.DigitalHash
                        </div>
                    }
                }
                else
                {
                    <div class="text-[8px] text-gray-500 italic text-center py-1">
                        [Código QR tributario disponible tras validación por SUNAT]
                    </div>
                }
            </div>

            <!-- PIE DE TICKET INFORMATIVO -->
            <div class="text-center text-[8.5px] space-y-1 mt-2">
                <p>Representación impresa del Comprobante de Pago Electrónico.</p>
                <p>Consulte su validez en <strong>www.nubefact.com</strong> o portal SUNAT.</p>
                <div class="border-t border-black/30 pt-1 font-bold text-[9px]">
                    ¡GRACIAS POR VIAJAR CON @tradeName!
                </div>
            </div>

        </div>
    </main>

    <!-- INICIALIZACIÓN QR CODE (SOLO SI EXISTE QR REAL) -->
    @if (hasValidQr)
    {
        <script>
            document.addEventListener("DOMContentLoaded", function () {
                const qrText = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(qrString));
                const qrSize = @(is58 ? 84 : 124);
                const container = document.getElementById("qrcode");
                if (container && typeof QRCode !== "undefined" && qrText) {
                    new QRCode(container, {
                        text: qrText,
                        width: qrSize,
                        height: qrSize,
                        colorDark: "#000000",
                        colorLight: "#ffffff",
                        correctLevel: QRCode.CorrectLevel.M
                    });
                }
            });
        </script>
    }
</body>
</html>
