@model SIGETOUR.API.Core.Entities.TourPackage
@{
    ViewData["Title"] = "Checkout Seguro - " + Model.Title;
}

<!-- TRUST HEADER -->
<div class="bg-surface-container-low border-b border-outline-variant py-2 px-4 md:px-8 text-center sm:text-left">
    <p class="font-body-sm text-body-sm text-secondary flex items-center justify-center sm:justify-start gap-1.5">
        <span class="material-symbols-outlined text-[16px] text-primary" data-icon="verified_user">verified_user</span>
        MINCETUR & DIRCETUR Cajamarca
        <span class="hidden sm:inline mx-2 text-outline-variant">•</span>
        <span class="hidden sm:inline">Jr. 2 de Mayo 569, Cajamarca • Salidas Diarias</span>
    </p>
</div>

<!-- WIZARD PROGRESS STEPPER -->
<section class="bg-surface-container-lowest border-b border-outline-variant py-4 px-4 md:px-8">
    <div class="max-w-7xl mx-auto">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
            <!-- Paso 1 -->
            <div class="flex items-center space-x-2" id="step1-indicator">
                <div class="w-8 h-8 rounded-full bg-primary-container text-on-primary-container flex items-center justify-center font-label-md text-label-md ring-2 ring-primary ring-offset-2">
                    1
                </div>
                <div>
                    <span class="block font-label-sm text-label-sm text-primary uppercase">Paso 1</span>
                    <span class="block font-label-md text-label-md text-primary font-bold">Fecha y Turno</span>
                </div>
            </div>
            <!-- Paso 2 -->
            <div class="flex items-center space-x-2 opacity-60" id="step2-indicator">
                <div class="w-8 h-8 rounded-full bg-surface-variant text-on-surface-variant flex items-center justify-center font-label-md text-label-md">
                    2
                </div>
                <div>
                    <span class="block font-label-sm text-label-sm text-secondary font-semibold uppercase">Paso 2</span>
                    <span class="block font-label-md text-label-md text-secondary font-bold">Pasajeros</span>
                </div>
            </div>
            <!-- Paso 3 -->
            <div class="flex items-center space-x-2 opacity-60 hidden md:flex" id="step3-indicator">
                <div class="w-8 h-8 rounded-full bg-surface-variant text-on-surface-variant flex items-center justify-center font-label-md text-label-md">
                    3
                </div>
                <div>
                    <span class="block font-label-sm text-label-sm text-secondary uppercase">Paso 3</span>
                    <span class="block font-label-md text-label-md text-secondary font-bold">Datos de Contacto</span>
                </div>
            </div>
            <!-- Paso 4 -->
            <div class="flex items-center space-x-2 opacity-60 hidden md:flex">
                <div class="w-8 h-8 rounded-full bg-surface-variant text-on-surface-variant flex items-center justify-center font-label-md text-label-md">
                    4
                </div>
                <div>
                    <span class="block font-label-sm text-label-sm text-secondary uppercase">Paso 4</span>
                    <span class="block font-label-md text-label-md text-secondary font-bold">Confirmación</span>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- CHECKOUT CONTENT -->
<main class="bg-surface-container py-8 px-4 md:px-8">
    <div class="max-w-7xl mx-auto">
        <form method="post" action="/Booking/Checkout" id="checkout-form" class="grid grid-cols-1 lg:grid-cols-12 gap-8">
            <input type="hidden" name="TourId" value="@Model.Id" />
            <input type="hidden" id="tour-price" value="@Model.BasePrice" />

            <!-- FORM COLUMN (LEFT - 8 cols) -->
            <div class="lg:col-span-8 space-y-8">
                
                <!-- SECTION 1: FECHA Y TURNO -->
                <div class="bg-surface-container-lowest rounded-xl shadow-sm border border-outline-variant p-6 relative overflow-hidden">
                    <div class="absolute top-0 left-0 w-1 h-full bg-primary"></div>
                    <div class="flex items-center justify-between mb-6">
                        <h2 class="font-title-md text-title-md text-on-surface font-bold flex items-center gap-2">
                            <span class="material-symbols-outlined text-primary">calendar_month</span>
                            1. Selección de Fecha y Turno
                        </h2>
                    </div>
                    
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <!-- Date Picker -->
                        <div>
                            <label class="block font-label-md text-label-md text-on-surface mb-2 font-bold">Fecha del Recorrido</label>
                            <input name="TravelDate" id="input-date" type="date" required class="w-full bg-surface-container-low border border-outline-variant rounded-lg px-4 py-3 text-on-surface font-body-md focus:ring-2 focus:ring-primary focus:border-primary outline-none" min="@DateTime.Now.ToString("yyyy-MM-dd")" />
                        </div>
                        
                        <!-- Shift Selection -->
                        <div>
                            <label class="block font-label-md text-label-md text-on-surface mb-2 font-bold">Turno</label>
                            <div class="grid grid-cols-2 gap-3">
                                <label class="relative flex items-center justify-between p-3 border border-primary rounded-lg bg-primary/5 cursor-pointer">
                                    <div>
                                        <span class="block font-label-md text-label-md text-primary font-bold">Mañana</span>
                                        <span class="block font-label-sm text-label-sm text-primary">09:00 AM</span>
                                    </div>
                                    <input type="radio" name="Shift" value="manana" checked class="text-primary focus:ring-primary h-4 w-4" />
                                </label>
                                <label class="relative flex items-center justify-between p-3 border border-outline-variant rounded-lg bg-surface-container-lowest cursor-pointer hover:bg-surface-container-low transition-colors">
                                    <div>
                                        <span class="block font-label-md text-label-md text-on-surface font-bold">Tarde</span>
                                        <span class="block font-label-sm text-label-sm text-secondary">02:30 PM</span>
                                    </div>
                                    <input type="radio" name="Shift" value="tarde" class="text-primary focus:ring-primary h-4 w-4" />
                                </label>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- SECTION 2: RECOJO -->
                <div class="bg-surface-container-lowest rounded-xl shadow-sm border border-outline-variant p-6 relative overflow-hidden">
                    <div class="absolute top-0 left-0 w-1 h-full bg-primary-container"></div>
                    <div class="flex items-center justify-between mb-6">
                        <h2 class="font-title-md text-title-md text-on-surface font-bold flex items-center gap-2">
                            <span class="material-symbols-outlined text-primary">location_on</span>
                            2. Punto de Recojo y Embarque
                        </h2>
                    </div>

                    <div class="space-y-4">
                        <!-- Option A: Agencia -->
                        <label class="block p-4 border border-primary rounded-lg bg-primary/5 cursor-pointer relative transition-all" id="label-agencia">
                            <div class="flex items-start">
                                <input type="radio" name="BoardingPoint" value="agencia" checked class="mt-1 text-primary focus:ring-primary h-4 w-4" />
                                <div class="ml-3 flex-1">
                                    <div class="flex items-center justify-between">
                                        <span class="font-label-md text-label-md font-bold text-primary">Agencia Central Turismo Chilón</span>
                                        <span class="bg-primary text-on-primary text-xs px-2 py-0.5 rounded-full font-semibold uppercase tracking-wider">Recomendado</span>
                                    </div>
                                    <p class="text-body-sm font-body-sm text-secondary mt-1">Jr. 2 de Mayo 569, a 3 cuadras de la Plaza de Armas de Cajamarca.</p>
                                </div>
                            </div>
                        </label>
                        
                        <!-- Option B: Hotel -->
                        <label class="block p-4 border border-outline-variant rounded-lg bg-surface-container-lowest cursor-pointer relative hover:border-primary/50 transition-all" id="label-hotel">
                            <div class="flex items-start">
                                <input type="radio" name="BoardingPoint" value="hotel" class="mt-1 text-primary focus:ring-primary h-4 w-4" />
                                <div class="ml-3 flex-1">
                                    <div class="flex items-center justify-between">
                                        <span class="font-label-md text-label-md font-bold text-on-surface">Recojo en Hotel</span>
                                    </div>
                                    <p class="text-body-sm font-body-sm text-secondary mt-1">Sin costo adicional si estás en el Centro Histórico o son más de 6 pasajeros.</p>
                                    
                                    <div class="mt-4 hidden" id="hotel-form">
                                        <div class="mb-3">
                                            <label class="block font-label-sm text-label-sm text-on-surface mb-1 font-semibold">Ubicación del Hotel</label>
                                            <select name="HotelZone" id="input-hotelzone" class="w-full bg-surface-container-low border border-outline-variant rounded-lg px-3 py-2 text-on-surface font-body-sm outline-none">
                                                <option value="centro">Centro Histórico de Cajamarca (Gratis)</option>
                                                <option value="afueras">Afueras de la ciudad (Baños del Inca, etc.)</option>
                                            </select>
                                        </div>
                                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                                            <div>
                                                <label class="block font-label-sm text-label-sm text-on-surface mb-1 font-semibold">Nombre del Hotel</label>
                                                <input type="text" name="HotelName" id="input-hotelname" placeholder="Ej: Hotel Laguna Seca" class="w-full bg-surface-container-low border border-outline-variant rounded-lg px-3 py-2 text-on-surface font-body-sm outline-none focus:ring-1 focus:ring-primary" />
                                            </div>
                                            <div>
                                                <label class="block font-label-sm text-label-sm text-on-surface mb-1 font-semibold">Dirección</label>
                                                <input type="text" name="HotelAddress" id="input-hoteladdress" placeholder="Ej: Jr. Cruz de Piedra 600" class="w-full bg-surface-container-low border border-outline-variant rounded-lg px-3 py-2 text-on-surface font-body-sm outline-none focus:ring-1 focus:ring-primary" />
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </label>
                    </div>
                </div>

                <!-- SECTION 3: DATOS PASAJEROS -->
                <div class="bg-surface-container-lowest rounded-xl shadow-sm border border-outline-variant p-6 relative overflow-hidden">
                    <div class="flex items-center justify-between mb-6">
                        <h2 class="font-title-md text-title-md text-on-surface font-bold flex items-center gap-2">
                            <span class="material-symbols-outlined text-primary">group</span>
                            3. Cantidad de Pasajeros y Datos
                        </h2>
                    </div>

                    <div class="mb-6">
                        <label class="block font-label-md text-label-md text-on-surface mb-2 font-bold">Número de Pasajeros</label>
                        <input type="number" name="Passengers" id="input-passengers" value="1" min="1" max="15" required class="w-32 bg-surface-container-low border border-outline-variant rounded-lg px-4 py-3 text-on-surface font-body-md focus:ring-2 focus:ring-primary outline-none text-center" />
                    </div>

                    <!-- Datos Titular -->
                    <div class="p-4 rounded-lg bg-primary/5 border border-primary/20">
                        <div class="flex items-center justify-between mb-4">
                            <span class="font-title-sm text-title-sm text-primary font-bold flex items-center gap-1.5">
                                <span class="material-symbols-outlined text-base">person</span>
                                Pasajero Titular (Contacto)
                            </span>
                        </div>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <div class="md:col-span-2">
                                <label class="block font-label-md text-label-md text-on-surface mb-1 font-semibold">Nombres y Apellidos</label>
                                <input type="text" name="CustomerName" id="input-name" required class="w-full bg-surface-container-lowest border border-outline-variant rounded-lg px-4 py-2.5 text-on-surface font-body-md focus:ring-2 focus:ring-primary outline-none" />
                            </div>
                            <div>
                                <label class="block font-label-md text-label-md text-on-surface mb-1 font-semibold">Celular / WhatsApp</label>
                                <input type="tel" name="CustomerPhone" id="input-phone" required class="w-full bg-surface-container-lowest border border-outline-variant rounded-lg px-4 py-2.5 text-on-surface font-body-md focus:ring-2 focus:ring-primary outline-none" />
                            </div>
                            <div>
                                <label class="block font-label-md text-label-md text-on-surface mb-1 font-semibold">Correo Electrónico</label>
                                <input type="email" name="CustomerEmail" id="input-email" required class="w-full bg-surface-container-lowest border border-outline-variant rounded-lg px-4 py-2.5 text-on-surface font-body-md focus:ring-2 focus:ring-primary outline-none" />
                            </div>
                        </div>
                    </div>
                </div>

                <div class="mt-8 flex flex-col sm:flex-row items-center justify-between gap-4 pt-4 border-t border-outline-variant">
                    <a href="/Tour/Catalog" class="w-full sm:w-auto px-6 py-3 border border-outline text-secondary font-label-lg text-label-lg rounded-lg hover:bg-surface-container-low transition-all text-center">
                        Atrás / Volver
                    </a>
                    <button type="submit" class="w-full sm:w-auto px-8 py-3.5 bg-primary hover:bg-primary-container text-on-primary font-label-lg text-label-lg rounded-lg shadow-md transition-all flex items-center justify-center space-x-2">
                        <span>Confirmar Reserva</span>
                        <span class="material-symbols-outlined text-sm">arrow_forward</span>
                    </button>
                </div>
            </div>

            <!-- SUMMARY COLUMN (RIGHT - 4 cols, Sticky) -->
            <div class="lg:col-span-4 space-y-6">
                <div class="sticky top-28 bg-surface-container-lowest rounded-xl p-6 shadow-sm border border-outline-variant">
                    <div class="border-b border-outline-variant pb-4 mb-4">
                        <span class="font-label-sm text-label-sm uppercase tracking-wider text-primary font-bold">Resumen de Reserva</span>
                        <h3 class="font-title-md text-title-md text-on-surface font-bold mt-1">
                            @Model.Title
                        </h3>
                    </div>

                    <div class="space-y-3 pb-4 border-b border-outline-variant">
                        <div class="flex items-center justify-between text-body-sm font-body-sm">
                            <span class="text-secondary flex items-center gap-1.5"><span class="material-symbols-outlined text-sm">calendar_today</span> Fecha:</span>
                            <span class="font-semibold text-on-surface" id="summary-date">-</span>
                        </div>
                        <div class="flex items-center justify-between text-body-sm font-body-sm">
                            <span class="text-secondary flex items-center gap-1.5"><span class="material-symbols-outlined text-sm">alarm</span> Turno:</span>
                            <span class="font-semibold text-primary" id="summary-shift">Mañana</span>
                        </div>
                        <div class="flex items-center justify-between text-body-sm font-body-sm">
                            <span class="text-secondary flex items-center gap-1.5"><span class="material-symbols-outlined text-sm">location_on</span> Recojo:</span>
                            <span class="font-semibold text-on-surface text-right" id="summary-pickup">Agencia</span>
                        </div>
                    </div>

                    <div class="py-4 border-b border-outline-variant space-y-2">
                        <div class="flex justify-between font-body-sm text-body-sm text-secondary">
                            <span id="summary-pax-count">1x Pasajero</span>
                            <span class="font-semibold text-on-surface" id="summary-pax-total">S/ @Model.BasePrice.ToString("0.00")</span>
                        </div>
                        <div class="flex justify-between font-body-sm text-body-sm text-secondary hidden" id="summary-hotel-fee">
                            <span>Recargo Hotel (Afueras)</span>
                            <span class="font-semibold text-primary">S/ 15.00</span>
                        </div>
                        <div class="flex justify-between font-headline-sm text-headline-sm font-bold text-on-surface pt-2">
                            <span>Total a Pagar:</span>
                            <span class="text-primary" id="summary-grand-total">S/ @Model.BasePrice.ToString("0.00")</span>
                        </div>
                    </div>
                </div>
            </div>
        </form>
    </div>
</main>

<script>
    document.addEventListener("DOMContentLoaded", function() {
        const inputDate = document.getElementById('input-date');
        const inputPassengers = document.getElementById('input-passengers');
        const tourPrice = parseFloat(document.getElementById('tour-price').value);
        
        const summaryDate = document.getElementById('summary-date');
        const summaryShift = document.getElementById('summary-shift');
        const summaryPickup = document.getElementById('summary-pickup');
        const summaryPaxCount = document.getElementById('summary-pax-count');
        const summaryPaxTotal = document.getElementById('summary-pax-total');
        const summaryHotelFee = document.getElementById('summary-hotel-fee');
        const summaryGrandTotal = document.getElementById('summary-grand-total');

        const radiosShift = document.querySelectorAll('input[name="Shift"]');
        const radiosBoarding = document.querySelectorAll('input[name="BoardingPoint"]');
        
        const hotelForm = document.getElementById('hotel-form');
        const inputHotelZone = document.getElementById('input-hotelzone');

        const step1 = document.getElementById('step1-indicator');
        const step2 = document.getElementById('step2-indicator');
        const step3 = document.getElementById('step3-indicator');
        const inputName = document.getElementById('input-name');

        function formatMoney(amount) {
            return "S/ " + amount.toFixed(2);
        }

        function calculateTotal() {
            let pax = parseInt(inputPassengers.value) || 1;
            let boarding = document.querySelector('input[name="BoardingPoint"]:checked').value;
            let hotelZone = inputHotelZone.value;

            let baseCost = pax * tourPrice;
            let extraCost = 0;

            if (boarding === 'hotel' && hotelZone === 'afueras' && pax <= 6) {
                extraCost = 15;
                summaryHotelFee.classList.remove('hidden');
            } else {
                summaryHotelFee.classList.add('hidden');
            }

            let total = baseCost + extraCost;

            summaryPaxCount.innerText = pax + "x Pasajero" + (pax > 1 ? "s" : "");
            summaryPaxTotal.innerText = formatMoney(baseCost);
            summaryGrandTotal.innerText = formatMoney(total);
        }

        function updateSummary() {
            // Update Date
            summaryDate.innerText = inputDate.value ? inputDate.value : "-";
            
            // Update Shift
            let shift = document.querySelector('input[name="Shift"]:checked').value;
            summaryShift.innerText = shift === 'manana' ? "Mañana" : "Tarde";

            // Update Pickup
            let boarding = document.querySelector('input[name="BoardingPoint"]:checked').value;
            if (boarding === 'agencia') {
                summaryPickup.innerText = "Agencia";
                hotelForm.classList.add('hidden');
                document.getElementById('label-agencia').classList.replace('border-outline-variant', 'border-primary');
                document.getElementById('label-agencia').classList.replace('bg-surface-container-lowest', 'bg-primary/5');
                document.getElementById('label-hotel').classList.replace('border-primary', 'border-outline-variant');
                document.getElementById('label-hotel').classList.replace('bg-primary/5', 'bg-surface-container-lowest');
            } else {
                summaryPickup.innerText = "Hotel";
                hotelForm.classList.remove('hidden');
                document.getElementById('label-hotel').classList.replace('border-outline-variant', 'border-primary');
                document.getElementById('label-hotel').classList.replace('bg-surface-container-lowest', 'bg-primary/5');
                document.getElementById('label-agencia').classList.replace('border-primary', 'border-outline-variant');
                document.getElementById('label-agencia').classList.replace('bg-primary/5', 'bg-surface-container-lowest');
            }
            
            // Update Stepper
            if (inputDate.value) {
                step1.querySelector('div').classList.replace('bg-surface-variant', 'bg-primary-container');
                step1.querySelector('div').classList.replace('text-on-surface-variant', 'text-on-primary-container');
                step1.classList.remove('opacity-60');
                step2.classList.remove('opacity-60');
            }
            
            if (inputName.value.length > 2) {
                step3.classList.remove('opacity-60');
            }

            calculateTotal();
        }

        inputDate.addEventListener("change", updateSummary);
        inputPassengers.addEventListener("input", updateSummary);
        inputHotelZone.addEventListener("change", updateSummary);
        inputName.addEventListener("input", updateSummary);
        
        radiosShift.forEach(r => r.addEventListener("change", updateSummary));
        radiosBoarding.forEach(r => r.addEventListener("change", updateSummary));

        updateSummary();
    });
</script>

