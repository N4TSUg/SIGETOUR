@model SIGETOUR.API.Core.Entities.Booking
@{
    Layout = null;
    var booking = Model;
    var tourTitle = booking.Items.FirstOrDefault()?.TourPackage?.Title ?? "Tour";
}
<!DOCTYPE html>
<html class="light" lang="es">
<head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<title>Checkout Seguro | Turismo Chilón Cajamarca</title>
<!-- Fonts & Material Symbols -->
<link href="https://fonts.googleapis.com" rel="preconnect"/>
<link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect"/>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>
<!-- Tailwind CSS -->
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<script id="tailwind-config">
    tailwind.config = {
      darkMode: "class",
      theme: {
        extend: {
          "colors": {
            "outline-variant": "#bdc9c5",
            "inverse-on-surface": "#c3fcf5",
            "on-primary-fixed": "#00201b",
            "tertiary": "#b0251b",
            "background": "#e4fffb",
            "on-tertiary-fixed": "#410000",
            "on-primary-fixed-variant": "#005045",
            "on-background": "#00201e",
            "error-container": "#ffdad6",
            "inverse-surface": "#003734",
            "on-secondary-fixed": "#002020",
            "on-tertiary-fixed-variant": "#910a07",
            "primary": "#00685a",
            "primary-fixed": "#8ef5df",
            "secondary-container": "#beebeb",
            "on-surface-variant": "#3d4946",
            "surface-container-low": "#c6fef8",
            "on-tertiary-container": "#fffbff",
            "surface-dim": "#ade5df",
            "secondary-fixed-dim": "#a2cfcf",
            "surface": "#e4fffb",
            "on-error": "#ffffff",
            "outline": "#6d7a76",
            "surface-container-lowest": "#ffffff",
            "on-primary": "#ffffff",
            "on-tertiary": "#ffffff",
            "primary-fixed-dim": "#71d8c3",
            "on-secondary": "#ffffff",
            "surface-container-highest": "#b5ede7",
            "tertiary-fixed": "#ffdad5",
            "surface-bright": "#e4fffb",
            "surface-tint": "#006b5c",
            "on-error-container": "#93000a",
            "on-primary-container": "#f4fffa",
            "on-secondary-fixed-variant": "#224d4e",
            "surface-container-high": "#bbf3ed",
            "secondary-fixed": "#beebeb",
            "secondary": "#3b6566",
            "inverse-primary": "#71d8c3",
            "tertiary-fixed-dim": "#ffb4a9",
            "tertiary-container": "#d33f30",
            "primary-container": "#008472",
            "on-surface": "#00201e",
            "surface-container": "#c1f9f3",
            "error": "#ba1a1a",
            "surface-variant": "#b5ede7",
            "on-secondary-container": "#416b6c"
          },
          "borderRadius": {
            "DEFAULT": "0.25rem",
            "lg": "0.5rem",
            "xl": "0.75rem",
            "full": "9999px"
          },
          "fontFamily": {
            "body-md": ["Plus Jakarta Sans"],
            "display-lg": ["Plus Jakarta Sans"],
            "label-md": ["Plus Jakarta Sans"],
            "headline-lg": ["Plus Jakarta Sans"],
            "title-sm": ["Plus Jakarta Sans"],
            "body-lg": ["Plus Jakarta Sans"],
            "headline-md": ["Plus Jakarta Sans"],
            "label-sm": ["Plus Jakarta Sans"],
            "body-sm": ["Plus Jakarta Sans"],
            "label-lg": ["Plus Jakarta Sans"],
            "title-md": ["Plus Jakarta Sans"],
            "headline-sm": ["Plus Jakarta Sans"]
          },
          "fontSize": {
            "body-md": ["14px", { "lineHeight": "20px", "fontWeight": "400" }],
            "display-lg": ["48px", { "lineHeight": "56px", "letterSpacing": "-0.02em", "fontWeight": "800" }],
            "label-md": ["12px", { "lineHeight": "16px", "letterSpacing": "0.02em", "fontWeight": "600" }],
            "headline-lg": ["32px", { "lineHeight": "40px", "letterSpacing": "-0.01em", "fontWeight": "700" }],
            "title-sm": ["16px", { "lineHeight": "24px", "fontWeight": "600" }],
            "body-lg": ["16px", { "lineHeight": "24px", "fontWeight": "400" }],
            "headline-md": ["24px", { "lineHeight": "32px", "fontWeight": "700" }],
            "label-sm": ["11px", { "lineHeight": "14px", "letterSpacing": "0.05em", "fontWeight": "600" }],
            "body-sm": ["12px", { "lineHeight": "18px", "fontWeight": "400" }],
            "label-lg": ["14px", { "lineHeight": "20px", "letterSpacing": "0.04em", "fontWeight": "700" }],
            "title-md": ["18px", { "lineHeight": "26px", "fontWeight": "600" }],
            "headline-sm": ["20px", { "lineHeight": "28px", "fontWeight": "600" }]
          }
        },
      },
    }
</script>
</head>
<body class="bg-[#f2faf8] text-on-surface font-body-md antialiased min-h-screen flex flex-col selection:bg-primary-container selection:text-white">

<!-- TOP HEADER / SECURE CHECKOUT NAVBAR -->
<header class="sticky top-0 z-50 bg-surface-container-lowest shadow-sm border-b border-outline-variant/30">
  <div class="max-w-7xl mx-auto px-4 md:px-8 h-20 flex items-center justify-between">
    <!-- Brand & Back Button -->
    <div class="flex items-center gap-4 md:gap-6">
      <a class="flex items-center gap-1 text-secondary hover:text-primary transition-colors duration-150 text-label-md font-label-md group" href="/Booking/Checkout?tourId=@(booking.Items.FirstOrDefault()?.TourPackageId)">
        <span class="material-symbols-outlined text-base group-hover:-translate-x-1 transition-transform">arrow_back</span>
        <span class="hidden sm:inline">Volver al Checkout</span>
      </a>
      <div class="h-6 w-px bg-outline-variant/50 hidden sm:block"></div>
      <div class="flex items-center gap-3">
        <div class="hidden lg:block">
          <span class="block text-primary font-headline-sm text-headline-sm font-bold tracking-tight leading-none">Turismo Chilón</span>
          <span class="text-label-sm font-label-sm text-secondary tracking-wider uppercase">Transporte &amp; Turismo Cajamarca</span>
        </div>
      </div>
    </div>
    <!-- Security Trust Badge -->
    <div class="flex items-center gap-3 bg-[#e8f7f4] border border-[#a1ded5]/50 px-3.5 py-2 rounded-lg text-primary">
      <span class="material-symbols-outlined text-primary text-xl" style="font-variation-settings: 'FILL' 1;">lock</span>
      <div class="text-left">
        <div class="text-label-sm font-label-sm font-bold tracking-wide text-primary uppercase">Checkout Seguro</div>
        <div class="text-body-sm font-body-sm text-secondary hidden sm:block">Cifrado SSL 256-bit Certificado</div>
      </div>
    </div>
  </div>
</header>

<!-- STEPPER BAR -->
<nav aria-label="Progreso de la Reserva" class="bg-surface-container-lowest border-b border-outline-variant/20 shadow-xs py-4">
  <div class="max-w-7xl mx-auto px-4 md:px-8">
    <div class="flex items-center justify-between max-w-4xl mx-auto relative">
      <!-- Steps 1-3: Completed -->
      @foreach (var (label, num) in new[] { ("1. Datos del Tour", 1), ("2. Recojo & Pasajeros", 2), ("3. Datos de Contacto", 3) })
      {
        <div class="flex flex-col items-center group relative z-10">
          <div class="w-9 h-9 rounded-full bg-primary-container text-white flex items-center justify-center font-bold text-sm shadow-sm">
            <span class="material-symbols-outlined text-base font-bold">check</span>
          </div>
          <span class="mt-2 text-label-sm font-label-sm text-secondary font-medium hidden md:inline-block">@label</span>
        </div>
        <div class="flex-1 h-0.5 bg-primary-container mx-2 -mt-5 md:-mt-6"></div>
      }
      <!-- Step 4: Active -->
      <div class="flex flex-col items-center group relative z-10">
        <div class="w-9 h-9 rounded-full bg-primary ring-4 ring-primary/20 text-white flex items-center justify-center font-bold text-sm shadow-md">
          <span>4</span>
        </div>
        <span class="mt-2 text-label-sm font-label-sm text-primary font-bold">4. Pago Seguro</span>
      </div>
      <div class="flex-1 h-0.5 bg-outline-variant/40 mx-2 -mt-5 md:-mt-6"></div>
      <!-- Step 5: Upcoming -->
      <div class="flex flex-col items-center group relative z-10 opacity-60">
        <div class="w-9 h-9 rounded-full bg-surface-container-high border border-outline-variant text-on-surface-variant flex items-center justify-center font-bold text-sm">
          <span>5</span>
        </div>
        <span class="mt-2 text-label-sm font-label-sm text-on-surface-variant hidden md:inline-block">5. Voucher Oficial</span>
      </div>
    </div>
  </div>
</nav>

<!-- MAIN CHECKOUT CONTENT -->
<main class="flex-1 py-8 md:py-12">
  <div class="max-w-7xl mx-auto px-4 md:px-8">
    <!-- Headline & Context -->
    <div class="mb-8 flex flex-col md:flex-row md:items-end md:justify-between gap-4">
      <div>
        <div class="inline-flex items-center gap-2 bg-[#ecfdf5] text-primary px-3 py-1 rounded-full text-label-sm font-label-sm font-bold tracking-wide uppercase mb-2">
          <span class="w-2 h-2 rounded-full bg-primary animate-pulse"></span>
          Asientos Reservados — Confirma tu pago
        </div>
        <h1 class="text-headline-md md:text-headline-lg font-headline-lg text-inverse-surface tracking-tight">
          Finaliza tu Pago y Emite tus Boletos
        </h1>
        <p class="text-body-md font-body-md text-secondary mt-1">
          Selecciona el modo de abono y la pasarela preferida para la confirmación inmediata de tu tour.
        </p>
      </div>
      <div class="flex items-center gap-2 bg-surface-container-lowest px-4 py-2 rounded-lg border border-outline-variant/30 text-on-surface shadow-xs">
        <span class="material-symbols-outlined text-primary text-xl">confirmation_number</span>
        <span class="text-body-sm font-body-sm font-medium text-secondary">Código de reserva:</span>
        <span class="font-bold text-label-lg font-label-lg text-primary">@Model.ReferenceCode</span>
      </div>
    </div>

    <!-- Two Columns Layout (7 / 5 Grid) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">

      <!-- LEFT COLUMN: Payment Methods & Options -->
      <div class="lg:col-span-7 space-y-6">

        <!-- 1. PAYMENT MODALITY SELECTION -->
        <section class="bg-surface-container-lowest p-6 rounded-xl border border-outline-variant/40 shadow-xs">
          <div class="flex items-center justify-between mb-4">
            <h2 class="text-title-md font-title-md text-inverse-surface flex items-center gap-2">
              <span class="material-symbols-outlined text-primary">payments</span>
              1. Modalidad de Abono
            </h2>
            <span class="text-label-sm font-label-sm text-secondary">Elige cómo deseas abonar</span>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <!-- Option A: Total 100% -->
            <label class="relative flex flex-col p-4 rounded-xl border-2 border-primary bg-[#f4fffa] cursor-pointer transition-all duration-150 hover:shadow-sm">
              <div class="flex items-start justify-between mb-2">
                <div class="flex items-center gap-2">
                  <input checked class="h-4 w-4 text-primary focus:ring-primary border-outline" name="payment_modality" type="radio" value="full"/>
                  <span class="text-label-lg font-label-lg font-bold text-on-surface">Pagar Total 100%</span>
                </div>
                <span class="bg-primary text-white text-label-sm font-label-sm font-bold px-2 py-0.5 rounded uppercase">Recomendado</span>
              </div>
              <div class="text-headline-sm font-headline-sm font-extrabold text-primary mb-1">
                S/ @Model.TotalAmount.ToString("N2") <span class="text-label-md font-label-md font-normal text-secondary">PEN</span>
              </div>
              <p class="text-body-sm font-body-sm text-secondary">
                Confirmación inmediata, emisión de voucher definitivo y abordaje directo.
              </p>
            </label>
            <!-- Option B: Seña 50% -->
            <label class="relative flex flex-col p-4 rounded-xl border border-outline-variant bg-surface-container-lowest cursor-pointer transition-all duration-150 hover:border-primary/50">
              <div class="flex items-start justify-between mb-2">
                <div class="flex items-center gap-2">
                  <input class="h-4 w-4 text-primary focus:ring-primary border-outline" name="payment_modality" type="radio" value="deposit"/>
                  <span class="text-label-lg font-label-lg font-bold text-on-surface">Pagar Seña 50%</span>
                </div>
                <span class="bg-surface-container text-secondary text-label-sm font-label-sm font-medium px-2 py-0.5 rounded">Anticipo</span>
              </div>
              <div class="text-headline-sm font-headline-sm font-extrabold text-inverse-surface mb-1">
                S/ @((Model.TotalAmount / 2).ToString("N2")) <span class="text-label-md font-label-md font-normal text-secondary">PEN</span>
              </div>
              <p class="text-body-sm font-body-sm text-secondary">
                Garantiza tus asientos hoy. El saldo se abona en counter antes de partir.
              </p>
            </label>
          </div>
        </section>

        <!-- 2. PAYMENT METHODS (TABS) -->
        <section class="bg-surface-container-lowest p-6 rounded-xl border border-outline-variant/40 shadow-xs">
          <div class="flex items-center justify-between mb-4">
            <h2 class="text-title-md font-title-md text-inverse-surface flex items-center gap-2">
              <span class="material-symbols-outlined text-primary">account_balance_wallet</span>
              2. Selecciona tu Pasarela de Pago
            </h2>
            <span class="text-label-sm font-label-sm text-primary flex items-center gap-1 font-semibold">
              <span class="material-symbols-outlined text-sm">verified_user</span> Transacción Protegida
            </span>
          </div>
          <!-- Tab Navigation -->
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 p-1.5 bg-[#edf7f5] rounded-xl mb-6">
            <button class="flex flex-col items-center justify-center py-2.5 px-3 rounded-lg text-label-md font-label-lg transition-all duration-150 bg-surface-container-lowest text-primary shadow-xs font-bold" id="tab-btn-yape" onclick="switchPaymentTab('yape')" type="button">
              <span class="material-symbols-outlined text-xl mb-1 text-primary">qr_code_scanner</span>
              <span>Yape / Plin</span>
            </button>
            <button class="flex flex-col items-center justify-center py-2.5 px-3 rounded-lg text-label-md font-label-lg transition-all duration-150 text-secondary hover:text-on-surface" id="tab-btn-card" onclick="switchPaymentTab('card')" type="button">
              <span class="material-symbols-outlined text-xl mb-1">credit_card</span>
              <span>Tarjeta Déb/Créd</span>
            </button>
            <button class="flex flex-col items-center justify-center py-2.5 px-3 rounded-lg text-label-md font-label-lg transition-all duration-150 text-secondary hover:text-on-surface" id="tab-btn-transfer" onclick="switchPaymentTab('transfer')" type="button">
              <span class="material-symbols-outlined text-xl mb-1">account_balance</span>
              <span>Bancos / CCI</span>
            </button>
            <button class="flex flex-col items-center justify-center py-2.5 px-3 rounded-lg text-label-md font-label-lg transition-all duration-150 text-secondary hover:text-on-surface" id="tab-btn-cash" onclick="switchPaymentTab('cash')" type="button">
              <span class="material-symbols-outlined text-xl mb-1">storefront</span>
              <span>Pago Counter</span>
            </button>
          </div>

          <!-- TAB 1: YAPE / PLIN -->
          <div class="block space-y-6" id="tab-yape">
            <div class="p-4 bg-[#f0fdf9] border border-primary/20 rounded-xl flex flex-col md:flex-row items-center gap-6">
              <div class="bg-surface-container-lowest p-3 rounded-lg border border-outline-variant/40 shadow-xs flex flex-col items-center w-48 text-center shrink-0">
                <div class="w-36 h-36 bg-surface-container-low rounded flex items-center justify-center relative overflow-hidden border border-outline-variant/30">
                  <div class="absolute inset-2 grid grid-cols-5 gap-1 opacity-80">
                    <div class="bg-inverse-surface rounded-xs"></div><div class="bg-inverse-surface rounded-xs"></div>
                    <div class="bg-inverse-surface rounded-xs"></div><div class="bg-surface-container-lowest"></div>
                    <div class="bg-inverse-surface rounded-xs"></div><div class="bg-inverse-surface rounded-xs"></div>
                    <div class="bg-surface-container-lowest"></div><div class="bg-inverse-surface rounded-xs"></div>
                    <div class="bg-inverse-surface rounded-xs"></div><div class="bg-surface-container-lowest"></div>
                    <div class="bg-surface-container-lowest"></div><div class="bg-primary rounded-xs"></div>
                    <div class="bg-inverse-surface rounded-xs"></div><div class="bg-surface-container-lowest"></div>
                    <div class="bg-inverse-surface rounded-xs"></div><div class="bg-inverse-surface rounded-xs"></div>
                    <div class="bg-surface-container-lowest"></div><div class="bg-surface-container-lowest"></div>
                    <div class="bg-inverse-surface rounded-xs"></div><div class="bg-inverse-surface rounded-xs"></div>
                    <div class="bg-inverse-surface rounded-xs"></div><div class="bg-inverse-surface rounded-xs"></div>
                    <div class="bg-primary rounded-xs"></div><div class="bg-inverse-surface rounded-xs"></div>
                    <div class="bg-inverse-surface rounded-xs"></div>
                  </div>
                  <span class="absolute bg-white px-2 py-1 rounded text-[10px] font-bold text-primary shadow-xs border border-primary/20">YAPE / PLIN</span>
                </div>
                <span class="text-label-sm font-label-sm font-bold text-primary mt-2">Escanear para Pagar</span>
              </div>
              <div class="space-y-3 w-full">
                <div>
                  <span class="text-body-sm font-body-sm text-secondary">Línea Oficial de Billetera Digital:</span>
                  <div class="flex items-center gap-2 mt-1">
                    <span class="text-headline-sm font-headline-sm font-extrabold text-inverse-surface tracking-tight">+51 901 195 392</span>
                    <button class="text-label-sm font-label-sm text-primary hover:underline flex items-center gap-0.5 bg-surface-container-lowest px-2 py-1 rounded border border-outline-variant/30" onclick="navigator.clipboard.writeText('901195392')" type="button">
                      <span class="material-symbols-outlined text-sm">content_copy</span> Copiar
                    </button>
                  </div>
                  <p class="text-label-sm font-label-sm text-on-surface-variant mt-0.5">
                    Titular: <strong class="text-inverse-surface">TURISMO CHILÓN TRANSPORTE &amp; TURISMO S.A.C.</strong>
                  </p>
                </div>
                <ol class="space-y-1.5 text-body-sm font-body-sm text-secondary list-decimal list-inside bg-surface-container-lowest p-3 rounded-lg border border-outline-variant/30">
                  <li>Abre tu aplicación <strong class="text-on-surface">Yape</strong> o <strong class="text-on-surface">Plin</strong>.</li>
                  <li>Escanea el QR o yapea el monto al número <strong class="text-on-surface">901 195 392</strong>.</li>
                  <li>Ingresa el código de aprobación de la operación abajo.</li>
                </ol>
              </div>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 pt-2">
              <div>
                <label class="block text-label-md font-label-md text-inverse-surface mb-1">
                  Número de Operación (6 u 8 dígitos) <span class="text-tertiary">*</span>
                </label>
                <div class="relative">
                  <span class="material-symbols-outlined absolute left-3 top-2.5 text-outline text-lg">tag</span>
                  <input class="w-full pl-10 pr-3 py-2 bg-[#f8fafc] border border-[#cbd5e1] rounded-lg text-body-md font-body-md text-inverse-surface focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent" placeholder="Ej. 783921" type="text"/>
                </div>
              </div>
              <div>
                <label class="block text-label-md font-label-md text-inverse-surface mb-1">
                  Adjuntar Captura de Pago (Opcional)
                </label>
                <label class="flex items-center justify-center gap-2 px-3 py-2 bg-[#f8fafc] border border-dashed border-[#cbd5e1] rounded-lg cursor-pointer hover:bg-surface-container-low transition-colors">
                  <span class="material-symbols-outlined text-primary text-lg">upload_file</span>
                  <span class="text-body-sm font-body-sm text-secondary truncate" id="file-label">Subir comprobante JPG/PNG</span>
                  <input accept="image/*" class="hidden" onchange="document.getElementById('file-label').textContent = this.files[0] ? this.files[0].name : 'Subir comprobante JPG/PNG'" type="file"/>
                </label>
              </div>
            </div>
          </div>

          <!-- TAB 2: CREDIT / DEBIT CARD (hidden) -->
          <div class="hidden space-y-4" id="tab-card">
            <div class="flex items-center justify-between pb-2 border-b border-outline-variant/30">
              <span class="text-label-sm font-label-sm text-secondary">Aceptamos todas las tarjetas peruanas e internacionales</span>
              <div class="flex items-center gap-2">
                <span class="px-2 py-0.5 bg-blue-50 text-blue-800 text-[10px] font-bold rounded border border-blue-200">VISA</span>
                <span class="px-2 py-0.5 bg-red-50 text-red-800 text-[10px] font-bold rounded border border-red-200">MASTERCARD</span>
                <span class="px-2 py-0.5 bg-sky-50 text-sky-800 text-[10px] font-bold rounded border border-sky-200">AMEX</span>
              </div>
            </div>
            <div>
              <label class="block text-label-md font-label-md text-inverse-surface mb-1">Número de Tarjeta</label>
              <div class="relative">
                <span class="material-symbols-outlined absolute left-3 top-2.5 text-outline text-lg">credit_card</span>
                <input class="w-full pl-10 pr-3 py-2 bg-[#f8fafc] border border-[#cbd5e1] rounded-lg text-body-md font-body-md text-inverse-surface focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent font-mono" maxlength="19" placeholder="4213 5400 0000 0000" type="text"/>
              </div>
            </div>
            <div>
              <label class="block text-label-md font-label-md text-inverse-surface mb-1">Nombre del Titular (como aparece en la tarjeta)</label>
              <input class="w-full px-3 py-2 bg-[#f8fafc] border border-[#cbd5e1] rounded-lg text-body-md font-body-md text-inverse-surface focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent uppercase" type="text" placeholder="NOMBRE APELLIDO"/>
            </div>
            <div class="grid grid-cols-2 gap-4">
              <div>
                <label class="block text-label-md font-label-md text-inverse-surface mb-1">Vencimiento (MM/AA)</label>
                <input class="w-full px-3 py-2 bg-[#f8fafc] border border-[#cbd5e1] rounded-lg text-body-md font-body-md text-inverse-surface focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent text-center font-mono" maxlength="5" placeholder="08/27" type="text"/>
              </div>
              <div>
                <label class="block text-label-md font-label-md text-inverse-surface mb-1">CVV / CVC</label>
                <input class="w-full px-3 py-2 bg-[#f8fafc] border border-[#cbd5e1] rounded-lg text-body-md font-body-md text-inverse-surface focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent text-center font-mono" maxlength="4" placeholder="•••" type="password"/>
              </div>
            </div>
          </div>

          <!-- TAB 3: BANK TRANSFER (hidden) -->
          <div class="hidden space-y-4" id="tab-transfer">
            <div class="p-3 bg-[#f0fdf9] border border-primary/20 rounded-lg text-body-sm font-body-sm text-secondary">
