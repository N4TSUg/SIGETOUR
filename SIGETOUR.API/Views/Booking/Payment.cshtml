<!-- Inline JavaScript -->
<script>
    function switchPaymentTab(tabId) {
        const tabs = ['yape', 'card', 'transfer', 'cash'];
        tabs.forEach(t => {
            const el = document.getElementById('tab-' + t);
            const btn = document.getElementById('tab-btn-' + t);
            if (el && btn) {
                if (t === tabId) {
                    el.classList.remove('hidden');
                    el.classList.add('block');
                    btn.className = 'flex flex-col items-center justify-center py-2.5 px-3 rounded-lg text-label-md font-label-lg transition-all duration-150 bg-surface-container-lowest text-primary shadow-xs font-bold';
                    const icon = btn.querySelector('.material-symbols-outlined');
                    if (icon) icon.classList.add('text-primary');
                } else {
                    el.classList.add('hidden');
                    el.classList.remove('block');
                    btn.className = 'flex flex-col items-center justify-center py-2.5 px-3 rounded-lg text-label-md font-label-lg transition-all duration-150 text-secondary hover:text-on-surface';
                }
            }
        });
    }
</script>
