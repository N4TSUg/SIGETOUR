<!-- Subheader context -->
<div class="px-space-md py-space-sm mb-space-sm border-b border-outline-variant/40 flex items-center gap-space-sm">
<div class="w-8 h-8 rounded-lg bg-primary/20 flex items-center justify-center text-primary">
<span class="material-symbols-outlined text-[20px]">directions_bus</span>
</div>
<div>
<div class="text-title-sm font-title-sm font-bold text-on-surface">Panel Central</div>
<div class="text-body-sm font-body-sm text-on-surface-variant text-[11px]">Cajamarca Operaciones</div>
</div>
</div>
@{
    var action = ViewContext.RouteData.Values["Action"]?.ToString();
    var activeClass = "flex items-center gap-space-sm px-space-md py-space-sm rounded-lg bg-primary-container text-on-primary-container font-label-lg transition-all duration-150 active:scale-98";
    var inactiveClass = "flex items-center gap-space-sm px-space-md py-space-sm rounded-lg text-on-surface-variant dark:text-surface-variant font-label-md hover:bg-surface-container-high dark:hover:bg-surface-variant transition-all duration-150 active:scale-98";
    
    var dashClass = action == "Dashboard" ? activeClass : inactiveClass;
    var toursClass = action == "Tours" || action == "CreateTour" || action == "EditTour" ? activeClass : inactiveClass;
    var categoriesClass = action == "Categories" || action == "EditCategory" || action == "CreateCategory" ? activeClass : inactiveClass;
    var featuredClass = action == "Featured" || action == "EditFeatured" ? activeClass : inactiveClass;
    var fleetClass = action == "Fleet" || action == "EditVehicle" ? activeClass : inactiveClass;
    var bookingsClass = action == "Bookings" || action == "EditBooking" ? activeClass : inactiveClass;
    var usersClass = action == "Users" ? activeClass : inactiveClass;
}
  <!-- Navigation Tabs -->
<nav class="space-y-1 flex-1">
<!-- Item 1: Dashboard -->
  <a class="@dashClass" asp-controller="Admin" asp-action="Dashboard">
  <span class="material-symbols-outlined text-[20px]" style="font-variation-settings: 'FILL' 1;">dashboard</span>
  <span class="">Dashboard</span>
  </a>
<!-- Item 2: Catálogo Tours -->
    <a class="@toursClass" asp-controller="Admin" asp-action="Tours">
      <span class="material-symbols-outlined text-[20px]">tour</span>
      <span class="">Catálogo Tours</span>
    </a>
    <!-- Item 2.2: Categorías de Tours -->
    <a class="@categoriesClass" asp-controller="Admin" asp-action="Categories">
      <span class="material-symbols-outlined text-[20px]">category</span>
      <span class="">Categorías de Tours</span>
    </a>
    <!-- Item 2.5: Tours Destacados -->
    <a class="@featuredClass" asp-controller="Admin" asp-action="Featured">
      <span class="material-symbols-outlined text-[20px]">star</span>
      <span class="">Tours Destacados</span>
    </a>
<!-- Item 3: Salidas y Flota -->
  <a class="@fleetClass" asp-controller="Admin" asp-action="Fleet">
  <span class="material-symbols-outlined text-[20px]">directions_bus</span>
  <span class="">Salidas y Flota</span>
  </a>
<!-- Item 4: Despacho -->
  <a class="@bookingsClass" asp-controller="Admin" asp-action="Bookings">
  <span class="material-symbols-outlined text-[20px]">departure_board</span>
  <span class="">Despacho</span>
  </a>
<!-- Item 5: Caja y Finanzas -->
  <a class="@usersClass" asp-controller="Admin" asp-action="Users">
  <span class="material-symbols-outlined text-[20px]">group</span>
  <span class="">Usuarios y Roles</span>
  </a>
<!-- Side Action CTA -->
<div class="pt-space-md px-1">
<a asp-controller="Admin" asp-action="CreateTour" class="w-full bg-primary hover:bg-[#0e5a52] text-on-primary py-2.5 px-space-md rounded-lg font-label-lg flex items-center justify-center gap-2 shadow-sm transition-all duration-150 active:scale-95">
<span class="material-symbols-outlined text-[20px]">add_circle</span>
<span class="">Nuevo Tour</span>
</a>
</div>
</nav>
<!-- Agency Direct Contact Block -->
<div class="my-space-sm p-3 bg-surface-container/60 rounded-xl border border-outline-variant/30 text-body-sm">
<div class="text-label-sm font-label-sm text-primary font-bold mb-1">CENTRAL TELEFÓNICA</div>
<div class="text-body-sm font-body-sm font-semibold text-on-surface">+51 901 195 392</div>
<div class="text-body-sm font-body-sm text-on-surface-variant">+51 944 746 364</div>
</div>
<!-- Footer Navigation Items -->
<div class="border-t border-outline-variant/50 pt-2 space-y-1">
<a class="flex items-center gap-space-sm px-space-md py-2 rounded-lg text-on-surface-variant font-label-md hover:bg-surface-container-high transition-colors" asp-controller="Admin" asp-action="Tours">
<span class="material-symbols-outlined text-[20px]">settings</span>
<span class="">Ajustes</span>
</a>
<a class="flex items-center gap-space-sm px-space-md py-2 rounded-lg text-tertiary font-label-md hover:bg-error-container/30 transition-colors" asp-controller="Admin" asp-action="Tours">
<span class="material-symbols-outlined text-[20px]">logout</span>
<span class="">Cerrar Sesión</span>
</a>
</div>
</div>
</aside>
<!-- MAIN DASHBOARD CONTENT AREA -->
<main class="flex-1 min-h-0 overflow-y-auto custom-scrollbar p-space-lg flex flex-col gap-space-lg">
    @RenderBody()
</main>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const searchInput = document.getElementById('globalAdminSearchInput');
    const searchResults = document.getElementById('globalSearchResults');
    const clearBtn = document.getElementById('clearGlobalSearchBtn');
    let debounceTimer = null;

    if (!searchInput || !searchResults) return;

    searchInput.addEventListener('input', function() {
        const query = this.value.trim();
        if (clearBtn) {
            clearBtn.classList.toggle('hidden', query.length === 0);
        }

        clearTimeout(debounceTimer);
        if (query.length < 2) {
            searchResults.innerHTML = '';
            searchResults.classList.add('hidden');
            return;
        }

        debounceTimer = setTimeout(() => {
            fetch(`/Admin/QuickSearch?q=${encodeURIComponent(query)}`)
                .then(res => res.json())
                .then(data => {
                    renderGlobalSearchResults(data, query);
                })
                .catch(err => {
                    console.error('Error in QuickSearch:', err);
                });
        }, 250);
    });

    if (clearBtn) {
        clearBtn.addEventListener('click', function() {
            searchInput.value = '';
            searchResults.innerHTML = '';
            searchResults.classList.add('hidden');
            clearBtn.classList.add('hidden');
            searchInput.focus();
        });
    }

    document.addEventListener('click', function(e) {
        if (!searchInput.contains(e.target) && !searchResults.contains(e.target)) {
            searchResults.classList.add('hidden');
        }
    });

    searchInput.addEventListener('focus', function() {
        if (searchResults.children.length > 0 && this.value.trim().length >= 2) {
            searchResults.classList.remove('hidden');
        }
    });

    function renderGlobalSearchResults(data, query) {
        searchResults.innerHTML = '';
        const total = (data.bookings?.length || 0) + (data.tours?.length || 0) + (data.vehicles?.length || 0);

        if (total === 0) {
            searchResults.innerHTML = `
                <div class="p-4 text-center text-on-surface-variant text-body-sm">
                    <span class="material-symbols-outlined text-outline text-2xl block mb-1">search_off</span>
                    No se encontraron coincidencias para "<span class="font-bold text-on-surface">${escapeHtml(query)}</span>"
                    <p class="text-xs text-outline mt-1">Presiona <kbd class="px-1.5 py-0.5 bg-surface-container rounded border border-outline-variant font-mono">Enter</kbd> para buscar en Reservas</p>
                </div>`;
            searchResults.classList.remove('hidden');
            return;
        }

        let html = '';

        if (data.bookings && data.bookings.length > 0) {
            html += `<div class="p-2 bg-surface-container-low text-label-sm font-bold text-secondary uppercase tracking-wider flex items-center justify-between">
                <span>Reservas (${data.bookings.length})</span>
                <a href="/Admin/Bookings?search=${encodeURIComponent(query)}" class="text-primary hover:underline lowercase font-normal text-xs">ver todas &rarr;</a>
            </div>`;
            data.bookings.forEach(b => {
                html += `
                    <a href="${b.url}" class="block p-3 hover:bg-surface-container transition-colors">
                        <div class="flex items-center justify-between">
                            <span class="font-mono font-bold text-primary text-xs bg-primary/10 px-1.5 py-0.5 rounded">${escapeHtml(b.reference)}</span>
                            <span class="text-label-sm font-bold text-on-surface">S/ ${b.amount}</span>
                        </div>
                        <div class="text-body-sm font-semibold text-on-surface mt-1">${escapeHtml(b.customer)}</div>
                        <div class="text-xs text-on-surface-variant flex items-center gap-2 mt-0.5">
                            ${b.dni ? `<span>DNI: ${escapeHtml(b.dni)}</span> &bull;` : ''}
                            <span>Viaje: ${escapeHtml(b.date)}</span> &bull;
                            <span class="font-medium">${escapeHtml(b.status)}</span>
                        </div>
                    </a>
                `;
            });
        }

        if (data.tours && data.tours.length > 0) {
            html += `<div class="p-2 bg-surface-container-low text-label-sm font-bold text-secondary uppercase tracking-wider flex items-center justify-between">
                <span>Tours (${data.tours.length})</span>
                <a href="/Admin/Tours?search=${encodeURIComponent(query)}" class="text-primary hover:underline lowercase font-normal text-xs">ver todos &rarr;</a>
            </div>`;
            data.tours.forEach(t => {
                html += `
                    <a href="${t.url}" class="flex items-center gap-3 p-3 hover:bg-surface-container transition-colors">
                        <img src="${t.image}" alt="${escapeHtml(t.title)}" class="w-10 h-10 rounded-lg object-cover bg-surface-container border border-outline-variant shrink-0" onerror="this.src='/images/placeholder.jpg'" />
                        <div class="flex-1 min-w-0">
                            <div class="text-body-sm font-bold text-on-surface truncate">${escapeHtml(t.title)}</div>
                            <div class="text-xs font-semibold text-primary">S/ ${t.price}</div>
                        </div>
                        <span class="material-symbols-outlined text-outline text-[18px]">chevron_right</span>
                    </a>
                `;
            });
        }

        if (data.vehicles && data.vehicles.length > 0) {
            html += `<div class="p-2 bg-surface-container-low text-label-sm font-bold text-secondary uppercase tracking-wider flex items-center justify-between">
                <span>Vehículos (${data.vehicles.length})</span>
                <a href="/Admin/Fleet?search=${encodeURIComponent(query)}" class="text-primary hover:underline lowercase font-normal text-xs">ver todos &rarr;</a>
            </div>`;
            data.vehicles.forEach(v => {
                html += `
                    <a href="${v.url}" class="flex items-center justify-between p-3 hover:bg-surface-container transition-colors">
                        <div class="flex items-center gap-2">
                            <span class="material-symbols-outlined text-primary text-[18px]">directions_bus</span>
                            <div>
                                <span class="font-mono font-bold text-on-surface text-body-sm">${escapeHtml(v.plate)}</span>
                                <span class="text-xs text-on-surface-variant block">${escapeHtml(v.model)}</span>
                            </div>
                        </div>
                        <span class="text-label-sm px-2 py-0.5 rounded-full bg-surface-container font-medium text-xs">${escapeHtml(v.status)}</span>
                    </a>
                `;
            });
        }

        searchResults.innerHTML = html;
        searchResults.classList.remove('hidden');
    }

    function escapeHtml(str) {
        if (!str) return '';
        return str.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;").replace(/'/g, "&#039;");
    }
});
</script>

@await RenderSectionAsync("Scripts", required: false)
</body>
</html>




