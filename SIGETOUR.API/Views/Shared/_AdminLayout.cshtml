<style>
    .material-symbols-outlined {
      font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
      display: inline-block;
      vertical-align: middle;
      line-height: 1;
    }
    .custom-scrollbar {
      scrollbar-width: thin;
      scrollbar-color: #00685a #d0f7f2;
    }
    .custom-scrollbar::-webkit-scrollbar {
      width: 12px;
      height: 10px;
    }
    .custom-scrollbar::-webkit-scrollbar-track {
      background: #e4fffb;
      border-left: 1px solid #bdc9c5;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb {
      background-color: #00685a;
      border-radius: 6px;
      border: 2px solid #e4fffb;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb:hover {
      background-color: #004d42;
    }
  </style>
<link rel="icon" type="image/png" href="~/favicon.ico" />
</head>
<body class="bg-surface font-body-md text-on-surface h-screen max-h-screen flex flex-col overflow-hidden antialiased">
<!-- TOP APP BAR -->
<header class="bg-surface-container-lowest dark:bg-inverse-surface border-b border-outline-variant dark:border-outline shadow-sm flex justify-between items-center w-full px-space-lg py-space-sm shrink-0 z-30">
<div class="flex items-center gap-2 sm:gap-space-md">
<button type="button" id="admin-sidebar-toggle" onclick="toggleAdminSidebar()" class="lg:hidden p-2 rounded-xl text-primary hover:bg-surface-container active:scale-95 transition-all" aria-label="Abrir Menú">
<span class="material-symbols-outlined text-2xl" aria-hidden="true">menu</span>
</button>
<a asp-controller="Home" asp-action="Index" class="flex items-center gap-space-sm bg-white p-1 rounded-lg border border-outline-variant/30 hover:bg-surface-container-lowest cursor-pointer transition-colors" title="Volver a la página principal">
<img alt="Foto de perfil del Administrador de Turismo Chilón" class="h-10 w-auto object-contain" src="https://lh3.googleusercontent.com/aida-public/AB6AXuA418HlYgLM2V8ufbicRSZe3WiwFD80IhK7kjiUezcwFF9F_CeRFGUIPTJulkVhUOhEN5cmAaj3ta3_l3-UkTwCEYXMYTeor7kI8L2fQHDEo5sOt_FV8VWsQDU612MgYBMHH9AsPAWdl4YuPE8m8w_ZE42u43C21Iom_xU0OiAnStcNdpefRgQCdz1gi1QqB5ZI08SrQT6KVzYGfxDLj-5UPh5CbtpJ-wE1Fwr_bXVdjKYEqmFEgkTRksJJuWe00M9grak">
<span class="text-title-md font-title-md font-bold text-primary dark:text-inverse-primary tracking-wide hidden sm:inline">Turismo Chilón</span>
</a>
<!-- Quick Passenger/Booking Search -->
<form method="get" action="@Url.Action("Bookings", "Admin")" id="globalAdminSearchForm" class="relative hidden lg:block w-80 xl:w-96">
<div class="relative flex items-center">
<span class="material-symbols-outlined absolute left-3 text-outline text-[18px]">search</span>
<label for="globalAdminSearchInput" class="sr-only">Buscar pasajero, DNI, tour, reserva</label>
<input id="globalAdminSearchInput" name="search" autocomplete="off" class="w-full pl-9 pr-9 py-1.5 bg-surface/50 border border-outline-variant/60 rounded-lg text-body-sm font-body-sm text-on-surface focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-all" placeholder="Buscar pasajero, DNI, tour, reserva..." type="text">
<button type="button" id="clearGlobalSearchBtn" class="material-symbols-outlined absolute right-2.5 text-outline hover:text-on-surface text-[16px] hidden cursor-pointer">close</button>
</div>
<div id="globalSearchResults" class="absolute left-0 right-0 top-full mt-2 bg-surface-container-lowest rounded-xl shadow-2xl border border-outline-variant hidden z-50 max-h-[420px] overflow-y-auto divide-y divide-outline-variant/50">
</div>
</form>
</div>
<!-- Central Operational Status Tag -->
<div class="hidden xl:flex items-center gap-space-sm px-space-md py-1 bg-surface-container rounded-full border border-primary/20">
<span class="w-2.5 h-2.5 rounded-full bg-primary animate-pulse"></span>
<span class="text-label-sm font-label-sm text-primary font-bold">OPERACIONES Y DESPACHOS EN LÍNEA</span>
<span class="text-label-sm font-label-sm text-on-surface-variant">• Jr. 2 de Mayo 569, Cajamarca</span>
</div>
<!-- Trailing Actions Cluster -->
<div class="flex items-center gap-space-sm">
<!-- Caja Chica Quick Button -->
<a asp-controller="Admin" asp-action="Cash" asp-route-tab="petty" class="hidden sm:flex items-center gap-space-xs bg-primary/10 hover:bg-primary/20 border border-primary/20 px-space-md py-1.5 rounded-lg text-primary transition-all cursor-pointer" title="Ver Módulo de Caja Chica">
<span class="material-symbols-outlined text-[20px]">point_of_sale</span>
<div class="flex flex-col text-left">
<span class="text-label-sm font-label-sm leading-none text-primary font-bold">Caja Chica</span>
<span class="text-body-sm font-body-sm leading-tight text-on-surface font-semibold">Fondo Fijo</span>
</div>
</a>
<!-- Notifications -->
<div class="relative">
  <button id="adminNotificationsBtn" type="button" onclick="toggleNotificationsDropdown()" class="hidden sm:inline-flex relative p-2 rounded-lg text-on-surface-variant hover:bg-surface-container dark:hover:bg-surface-variant transition-colors duration-150 active:scale-95 cursor-pointer" title="Notificaciones y Alertas">
    <span class="material-symbols-outlined text-[22px]">notifications</span>
    <span id="notifBadgeDot" class="absolute top-1.5 right-1.5 w-2.5 h-2.5 bg-tertiary rounded-full ring-2 ring-white"></span>
  </button>

  <!-- Notifications Dropdown -->
  <div id="notificationsDropdown" class="hidden absolute right-0 mt-2 w-80 sm:w-96 bg-surface-container-lowest rounded-2xl shadow-2xl border border-outline-variant z-50 overflow-hidden text-left">
    <div class="p-3.5 bg-surface-container-low border-b border-outline-variant/60 flex items-center justify-between">
      <div class="flex items-center gap-2">
        <span class="material-symbols-outlined text-primary text-[20px]">notifications_active</span>
        <h3 class="font-bold text-title-sm text-on-surface">Notificaciones del Sistema</h3>
      </div>
      <button type="button" onclick="markAllNotificationsAsRead()" class="text-xs text-primary hover:underline font-semibold cursor-pointer">Marcar leídas</button>
    </div>
    <div id="notificationsList" class="max-h-80 overflow-y-auto divide-y divide-outline-variant/40">
      <div class="p-6 text-center text-xs text-outline">
        <span class="material-symbols-outlined text-2xl text-primary animate-spin block mb-1">refresh</span>
        Cargando notificaciones...
      </div>
    </div>
    <div class="p-2.5 bg-surface-container-low border-t border-outline-variant/60 flex items-center justify-between text-xs">
      <a href="/Admin/Bookings" class="font-bold text-primary hover:underline flex items-center gap-1">
        <span>Todas las reservas</span>
        <span class="material-symbols-outlined text-[14px]">arrow_forward</span>
      </a>
      <a href="/Admin/Despacho" class="font-bold text-secondary hover:underline flex items-center gap-1">
        <span>Despacho en vivo</span>
        <span class="material-symbols-outlined text-[14px]">arrow_forward</span>
      </a>
    </div>
  </div>
</div>

<!-- Help Desk -->
<button id="adminHelpBtn" type="button" onclick="openAdminHelpModal()" class="hidden sm:inline-flex p-2 rounded-lg text-on-surface-variant hover:bg-surface-container dark:hover:bg-surface-variant transition-colors duration-150 active:scale-95 cursor-pointer" title="Centro de Ayuda y Manual Operativo">
  <span class="material-symbols-outlined text-[22px]">help</span>
</button>
<!-- User Profile Lockup -->
<div class="h-6 w-px bg-outline-variant/60 mx-1"></div>
<div class="flex items-center gap-space-xs pl-1">
<div class="w-9 h-9 rounded-full bg-primary text-on-primary flex items-center justify-center font-bold text-label-md">
    @(User.Identity?.Name?.Length >= 2 ? User.Identity.Name.Substring(0, 2).ToUpper() : "TC")
</div>
<div class="hidden md:flex flex-col text-left">
<span class="text-label-md font-label-md font-bold text-on-surface">@(User.Identity?.Name ?? "Admin Central")</span>
<span class="text-label-sm font-label-sm text-outline">@(User.IsInRole("Administrator") ? "Administrador General" : "Operaciones Cajamarca")</span>
</div>
</div>
</div>
</header>
<div class="flex flex-1 min-h-0 min-w-0 w-full overflow-hidden">
<!-- Mobile Backdrop Overlay -->
<button type="button" id="admin-sidebar-backdrop" class="fixed inset-0 bg-black/50 z-40 hidden lg:hidden backdrop-blur-xs transition-opacity duration-300 border-none outline-none cursor-pointer" 
        onclick="toggleAdminSidebar()" 
        aria-label="Cerrar barra lateral de navegación"></button>
<!-- SIDE NAV BAR (Off-canvas Drawer on mobile, static on lg+) -->
<aside id="admin-sidebar" class="fixed inset-y-0 left-0 z-50 w-64 -translate-x-full lg:translate-x-0 lg:static lg:flex lg:shrink-0 bg-surface-container-low dark:bg-inverse-surface border-r border-outline-variant dark:border-outline h-full flex flex-col justify-between select-none overflow-y-auto custom-scrollbar transition-transform duration-300 ease-in-out shadow-2xl lg:shadow-none">
<div class="flex flex-col h-full py-space-md px-space-sm shrink-0">
<!-- Subheader context with Mobile Close Button -->
<div class="px-space-md py-space-sm mb-space-sm border-b border-outline-variant/40 flex items-center justify-between gap-space-sm">
<div class="flex items-center gap-space-sm">
<div class="w-8 h-8 rounded-lg bg-primary/20 flex items-center justify-center text-primary">
<span class="material-symbols-outlined text-[20px]">directions_bus</span>
</div>
<div>
<div class="text-title-sm font-title-sm font-bold text-on-surface">Panel Central</div>
<div class="text-body-sm font-body-sm text-on-surface-variant text-[11px]">Cajamarca Operaciones</div>
</div>
</div>
<button type="button" class="lg:hidden p-1 rounded-lg text-outline hover:text-on-surface hover:bg-surface-container" onclick="toggleAdminSidebar()" aria-label="Cerrar Menú">
<span class="material-symbols-outlined text-xl" aria-hidden="true">close</span>
</button>
</div>
@{
    var action = ViewContext.RouteData.Values["Action"]?.ToString();
    var activeClass = "flex items-center gap-space-sm px-space-md py-space-sm rounded-lg bg-primary-container text-on-primary-container font-label-lg transition-all duration-150 active:scale-98";
    var inactiveClass = "flex items-center gap-space-sm px-space-md py-space-sm rounded-lg text-on-surface-variant dark:text-surface-variant font-label-md hover:bg-surface-container-high dark:hover:bg-surface-variant transition-all duration-150 active:scale-98";
    
    var dashClass = action == "Dashboard" ? activeClass : inactiveClass;
    var toursClass = action == "Tours" || action == "CreateTour" || action == "EditTour" ? activeClass : inactiveClass;
    var categoriesClass = action == "Categories" || action == "EditCategory" || action == "CreateCategory" ? activeClass : inactiveClass;
    var featuredClass = action == "Featured" || action == "EditFeatured" ? activeClass : inactiveClass;
    var reviewsClass = action == "Reviews" ? activeClass : inactiveClass;
    var fleetClass = action == "Fleet" || action == "EditVehicle" ? activeClass : inactiveClass;
    var bookingsClass = action == "Bookings" || action == "EditBooking" ? activeClass : inactiveClass;
    var cashClass = action == "Cash" ? activeClass : inactiveClass;
    var usersClass = action == "Users" ? activeClass : inactiveClass;
    var supervisionClass = action == "Supervision" ? activeClass : inactiveClass;
}
  <!-- Navigation Tabs -->
<nav class="space-y-1 flex-1">
<!-- Item 1: Dashboard -->
  <a class="@dashClass" asp-controller="Admin" asp-action="Dashboard">
  <span class="material-symbols-outlined text-[20px]" style="font-variation-settings: 'FILL' 1;">dashboard</span>
  <span class="">Dashboard</span>
  </a>
<!-- Item 2: Catálogo Tours -->
    <a class="@toursClass" asp-controller="Admin" asp-action="Tours">
      <span class="material-symbols-outlined text-[20px]">tour</span>
      <span class="">Catálogo Tours</span>
    </a>
    <!-- Item 2.2: Categorías de Tours -->
    <a class="@categoriesClass" asp-controller="Admin" asp-action="Categories">
      <span class="material-symbols-outlined text-[20px]">category</span>
      <span class="">Categorías de Tours</span>
    </a>
    <!-- Item 2.5: Tours Destacados -->
    <a class="@featuredClass" asp-controller="Admin" asp-action="Featured">
      <span class="material-symbols-outlined text-[20px]">star</span>
      <span class="">Tours Destacados</span>
    </a>
    <!-- Item 2.6: Testimonios & Reseñas -->
    <a class="@reviewsClass" asp-controller="Admin" asp-action="Reviews">
      <span class="material-symbols-outlined text-[20px]">rate_review</span>
      <span class="">Testimonios & Reseñas</span>
    </a>
<!-- Item 3: Salidas y Flota -->
  <a class="@fleetClass" asp-controller="Admin" asp-action="Fleet">
  <span class="material-symbols-outlined text-[20px]">directions_bus</span>
  <span class="">Salidas y Flota</span>
  </a>
<!-- Item 4: Despacho -->
  <a class="@bookingsClass" asp-controller="Admin" asp-action="Bookings">
  <span class="material-symbols-outlined text-[20px]">departure_board</span>
  <span class="">Despacho</span>
  </a>
<!-- Item 5: Caja y Finanzas -->
  <a class="@cashClass" asp-controller="Admin" asp-action="Cash">
  <span class="material-symbols-outlined text-[20px]">point_of_sale</span>
  <span class="">Caja y Finanzas</span>
  </a>
@if (User.IsInRole("SuperAdmin"))
{
<!-- Item: Supervisión de Incidencias -->
  <a class="@supervisionClass" asp-controller="Admin" asp-action="Supervision">
  <span class="material-symbols-outlined text-[20px]">policy</span>
  <span class="">Supervisión</span>
  </a>
<!-- Item 6: Usuarios y Roles -->
  <a class="@usersClass" asp-controller="Admin" asp-action="Users">
  <span class="material-symbols-outlined text-[20px]">group</span>
  <span class="">Usuarios y Roles</span>
  </a>
}
<!-- Side Action CTA -->
<div class="pt-space-md px-1">
<a asp-controller="Admin" asp-action="CreateTour" class="w-full bg-primary hover:bg-[#0e5a52] text-on-primary py-2.5 px-space-md rounded-lg font-label-lg flex items-center justify-center gap-2 shadow-sm transition-all duration-150 active:scale-95">
<span class="material-symbols-outlined text-[20px]">add_circle</span>
<span class="">Nuevo Tour</span>
</a>
</div>
</nav>
<!-- Agency Direct Contact Block -->
<div class="my-space-sm p-3 bg-surface-container/60 rounded-xl border border-outline-variant/30 text-body-sm">
<div class="text-label-sm font-label-sm text-primary font-bold mb-1">CENTRAL TELEFÓNICA</div>
<div class="text-body-sm font-body-sm font-semibold text-on-surface">@ContactService.WhatsAppFormatted</div>
<div class="text-body-sm font-body-sm text-on-surface-variant">@ContactService.PhoneCallFormatted</div>
</div>
<!-- Footer Navigation Items -->
<div class="border-t border-outline-variant/50 pt-2 space-y-1">
<a class="flex items-center gap-space-sm px-space-md py-2 rounded-lg text-on-surface-variant font-label-md hover:bg-surface-container-high transition-colors" asp-controller="Admin" asp-action="Users">
<span class="material-symbols-outlined text-[20px]">settings</span>
<span class="">Ajustes</span>
</a>
<form asp-controller="Account" asp-action="Logout" method="post" class="w-full m-0 p-0">
@Html.AntiForgeryToken()
<button type="submit" class="w-full flex items-center gap-space-sm px-space-md py-2 rounded-lg text-tertiary font-label-md hover:bg-error-container/30 transition-colors text-left border-0 bg-transparent cursor-pointer">
<span class="material-symbols-outlined text-[20px]">logout</span>
<span class="">Cerrar Sesión</span>
</button>
</form>
</div>
</div>
</aside>
<!-- MAIN DASHBOARD CONTENT AREA -->
<main class="flex-1 min-h-0 min-w-0 w-full overflow-y-auto overflow-x-hidden custom-scrollbar p-4 sm:p-6 lg:p-8 pb-24">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="mb-4 p-4 rounded-xl bg-green-50 border border-green-200 text-green-800 flex items-center justify-between shadow-sm animate-fade-in">
            <div class="flex items-center gap-3">
                <span class="material-symbols-outlined text-green-600">check_circle</span>
                <span class="text-body-sm font-semibold">@TempData["SuccessMessage"]</span>
            </div>
            <button type="button" onclick="this.parentElement.remove()" class="text-green-600 hover:text-green-800 p-1">
                <span class="material-symbols-outlined text-sm">close</span>
            </button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="mb-4 p-4 rounded-xl bg-red-50 border border-red-200 text-red-800 flex items-center justify-between shadow-sm animate-fade-in">
            <div class="flex items-center gap-3">
                <span class="material-symbols-outlined text-red-600">error</span>
                <span class="text-body-sm font-semibold">@TempData["ErrorMessage"]</span>
            </div>
            <button type="button" onclick="this.parentElement.remove()" class="text-red-600 hover:text-red-800 p-1">
                <span class="material-symbols-outlined text-sm">close</span>
            </button>
        </div>
    }
    @RenderBody()
</main>
</div>

<script>
function toggleAdminSidebar() {
    const sidebar = document.getElementById('admin-sidebar');
    const backdrop = document.getElementById('admin-sidebar-backdrop');
    if (!sidebar || !backdrop) return;
    const isClosed = sidebar.classList.contains('-translate-x-full');
    if (isClosed) {
        sidebar.classList.remove('-translate-x-full');
        sidebar.classList.add('translate-x-0');
        backdrop.classList.remove('hidden');
    } else {
        sidebar.classList.add('-translate-x-full');
        sidebar.classList.remove('translate-x-0');
        backdrop.classList.add('hidden');
    }
}

document.addEventListener('DOMContentLoaded', function() {
    const adminSidebar = document.getElementById('admin-sidebar');
    if (adminSidebar) {
        adminSidebar.querySelectorAll('a').forEach(link => {
            link.addEventListener('click', () => {
                if (window.innerWidth < 1024) {
                    toggleAdminSidebar();
                }
            });
        });
    }
    const searchInput = document.getElementById('globalAdminSearchInput');
    const searchResults = document.getElementById('globalSearchResults');
    const clearBtn = document.getElementById('clearGlobalSearchBtn');
    let debounceTimer = null;

    if (!searchInput || !searchResults) return;

    searchInput.addEventListener('input', function() {
        const query = this.value.trim();
        if (clearBtn) {
            clearBtn.classList.toggle('hidden', query.length === 0);
        }

        clearTimeout(debounceTimer);
        if (query.length < 2) {
            searchResults.innerHTML = '';
            searchResults.classList.add('hidden');
            return;
        }

        debounceTimer = setTimeout(() => {
            fetch(`/Admin/QuickSearch?q=${encodeURIComponent(query)}`)
                .then(res => res.json())
                .then(data => {
                    renderGlobalSearchResults(data, query);
                })
                .catch(err => {
                    console.error('Error in QuickSearch:', err);
                });
        }, 250);
    });

    if (clearBtn) {
        clearBtn.addEventListener('click', function() {
            searchInput.value = '';
            searchResults.innerHTML = '';
            searchResults.classList.add('hidden');
            clearBtn.classList.add('hidden');
            searchInput.focus();
        });
    }

    document.addEventListener('click', function(e) {
        if (!searchInput.contains(e.target) && !searchResults.contains(e.target)) {
            searchResults.classList.add('hidden');
        }
    });

    searchInput.addEventListener('focus', function() {
        if (searchResults.children.length > 0 && this.value.trim().length >= 2) {
            searchResults.classList.remove('hidden');
        }
    });

    function renderGlobalSearchResults(data, query) {
        searchResults.innerHTML = '';
        const total = (data.bookings?.length || 0) + (data.tours?.length || 0) + (data.vehicles?.length || 0);

        if (total === 0) {
            searchResults.innerHTML = `
                <div class="p-4 text-center text-on-surface-variant text-body-sm">
                    <span class="material-symbols-outlined text-outline text-2xl block mb-1">search_off</span>
                    No se encontraron coincidencias para "<span class="font-bold text-on-surface">${escapeHtml(query)}</span>"
                    <p class="text-xs text-outline mt-1">Presiona <kbd class="px-1.5 py-0.5 bg-surface-container rounded border border-outline-variant font-mono">Enter</kbd> para buscar en Reservas</p>
                </div>`;
            searchResults.classList.remove('hidden');
            return;
        }

        let html = '';

        if (data.bookings && data.bookings.length > 0) {
            html += `<div class="p-2 bg-surface-container-low text-label-sm font-bold text-secondary uppercase tracking-wider flex items-center justify-between">
                <span>Reservas (${data.bookings.length})</span>
                <a href="/Admin/Bookings?search=${encodeURIComponent(query)}" class="text-primary hover:underline lowercase font-normal text-xs">ver todas &rarr;</a>
            </div>`;
            data.bookings.forEach(b => {
                html += `
                    <a href="${b.url}" class="block p-3 hover:bg-surface-container transition-colors">
                        <div class="flex items-center justify-between">
                            <span class="font-mono font-bold text-primary text-xs bg-primary/10 px-1.5 py-0.5 rounded">${escapeHtml(b.reference)}</span>
                            <span class="text-label-sm font-bold text-on-surface">S/ ${b.amount}</span>
                        </div>
                        <div class="text-body-sm font-semibold text-on-surface mt-1">${escapeHtml(b.customer)}</div>
                        <div class="text-xs text-on-surface-variant flex items-center gap-2 mt-0.5">
                            ${b.dni ? `<span>DNI: ${escapeHtml(b.dni)}</span> &bull;` : ''}
                            <span>Viaje: ${escapeHtml(b.date)}</span> &bull;
                            <span class="font-medium">${escapeHtml(b.status)}</span>
                        </div>
                    </a>
                `;
            });
        }

        if (data.tours && data.tours.length > 0) {
            html += `<div class="p-2 bg-surface-container-low text-label-sm font-bold text-secondary uppercase tracking-wider flex items-center justify-between">
                <span>Tours (${data.tours.length})</span>
                <a href="/Admin/Tours?search=${encodeURIComponent(query)}" class="text-primary hover:underline lowercase font-normal text-xs">ver todos &rarr;</a>
            </div>`;
            data.tours.forEach(t => {
                html += `
                    <a href="${t.url}" class="flex items-center gap-3 p-3 hover:bg-surface-container transition-colors">
                        <img src="${t.image}" alt="${escapeHtml(t.title)}" class="w-10 h-10 rounded-lg object-cover bg-surface-container border border-outline-variant shrink-0" onerror="this.src='/images/placeholder.jpg'" />
                        <div class="flex-1 min-w-0">
                            <div class="text-body-sm font-bold text-on-surface truncate">${escapeHtml(t.title)}</div>
                            <div class="text-xs font-semibold text-primary">S/ ${t.price}</div>
                        </div>
                        <span class="material-symbols-outlined text-outline text-[18px]">chevron_right</span>
                    </a>
                `;
            });
        }

        if (data.vehicles && data.vehicles.length > 0) {
            html += `<div class="p-2 bg-surface-container-low text-label-sm font-bold text-secondary uppercase tracking-wider flex items-center justify-between">
                <span>Vehículos (${data.vehicles.length})</span>
                <a href="/Admin/Fleet?search=${encodeURIComponent(query)}" class="text-primary hover:underline lowercase font-normal text-xs">ver todos &rarr;</a>
            </div>`;
            data.vehicles.forEach(v => {
                html += `
                    <a href="${v.url}" class="flex items-center justify-between p-3 hover:bg-surface-container transition-colors">
                        <div class="flex items-center gap-2">
                            <span class="material-symbols-outlined text-primary text-[18px]">directions_bus</span>
                            <div>
                                <span class="font-mono font-bold text-on-surface text-body-sm">${escapeHtml(v.plate)}</span>
                                <span class="text-xs text-on-surface-variant block">${escapeHtml(v.model)}</span>
                            </div>
                        </div>
                        <span class="text-label-sm px-2 py-0.5 rounded-full bg-surface-container font-medium text-xs">${escapeHtml(v.status)}</span>
                    </a>
                `;
            });
        }

        searchResults.innerHTML = html;
        searchResults.classList.remove('hidden');
    }

    function escapeHtml(str) {
        if (!str) return '';
        return str.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;").replace(/'/g, "&#039;");
    }
});
</script>

<!-- MODAL: Centro de Ayuda y Manual Operativo SIGETOUR -->
<div id="adminHelpModal" class="fixed inset-0 z-50 bg-black/60 backdrop-blur-xs flex items-center justify-center p-4 hidden">
  <div class="bg-surface-container-lowest rounded-2xl w-full max-w-2xl border border-outline-variant shadow-2xl overflow-hidden flex flex-col max-h-[90vh]">
    <!-- Header -->
    <div class="p-4 bg-primary text-white flex items-center justify-between">
      <div class="flex items-center gap-2.5">
        <div class="w-8 h-8 rounded-lg bg-white/20 flex items-center justify-center">
          <span class="material-symbols-outlined text-[20px]">help_center</span>
        </div>
        <div>
          <h2 class="font-bold text-title-md leading-tight">Centro de Ayuda y Guía Operativa</h2>
          <p class="text-xs text-white/80">Turismo Chilón • SIGETOUR v2.5</p>
        </div>
      </div>
      <button type="button" onclick="closeAdminHelpModal()" class="p-1.5 rounded-lg text-white/80 hover:text-white hover:bg-white/10 transition-colors cursor-pointer" title="Cerrar">
        <span class="material-symbols-outlined text-[22px]">close</span>
      </button>
    </div>

    <!-- Body / Accordion Guides -->
    <div class="p-6 overflow-y-auto space-y-4 text-on-surface">
      <!-- Item 1: Ventas y Reservas -->
      <div class="p-4 rounded-xl border border-outline-variant/60 bg-surface-container-low/50">
        <div class="flex items-center gap-2.5 mb-2 text-primary font-bold text-title-sm">
          <span class="material-symbols-outlined text-[22px]">point_of_sale</span>
          <span>1. Registro de Reservas y Venta en Mostrador</span>
        </div>
        <p class="text-body-sm text-on-surface-variant leading-relaxed">
          En <strong>"Nueva Reserva"</strong> ingresas los datos del pasajero titular (Nombre, DNI, Teléfono y Correo), el circuito seleccionado y los acompañantes. El sistema calcula automáticamente la tarifa (incluyendo descuentos promocionales de <em>Tours Destacados</em>) y permite emitir boletos electrónicos o recibos de venta POS.
        </p>
      </div>

      <!-- Item 2: Despacho y Manifiesto MTC -->
      <div class="p-4 rounded-xl border border-outline-variant/60 bg-surface-container-low/50">
        <div class="flex items-center gap-2.5 mb-2 text-secondary font-bold text-title-sm">
          <span class="material-symbols-outlined text-[22px]">local_shipping</span>
          <span>2. Despacho de Unidades y Manifiesto SUTRAN</span>
        </div>
        <p class="text-body-sm text-on-surface-variant leading-relaxed">
          En el módulo <strong>"Despacho"</strong> o en el <strong>"Tablero en Vivo"</strong> asignas la van turística autorizada (Mercedes Sprinter o Toyota HiAce) y el conductor con licencia A-IIIa. Al despachar la salida, el sistema genera la hoja de ruta y el Manifiesto Oficial de Pasajeros para fiscalización vial.
        </p>
      </div>

      <!-- Item 3: Flota y Capacidad Operativa -->
      <div class="p-4 rounded-xl border border-outline-variant/60 bg-surface-container-low/50">
        <div class="flex items-center gap-2.5 mb-2 text-amber-700 font-bold text-title-sm">
          <span class="material-symbols-outlined text-[22px]">directions_bus</span>
          <span>3. Capacidad de Pasajeros y Movimiento Diario</span>
        </div>
        <p class="text-body-sm text-on-surface-variant leading-relaxed">
          La capacidad simultánea de la empresa corresponde a la suma de plazas de sus vehículos activos (33 asientos en 2 vans). Con salidas en turnos Mañana y Tarde, la capacidad diaria de la empresa es de <strong>66 o más pasajeros por día</strong>.
        </p>
      </div>

      <!-- Item 4: Canales de Soporte -->
      <div class="p-4 rounded-xl bg-primary/10 border border-primary/20 text-on-surface">
        <h4 class="font-bold text-label-lg text-primary mb-1 flex items-center gap-1.5">
          <span class="material-symbols-outlined text-[18px]">support_agent</span>
          <span>Central Telefónica y Asistencia Operativa</span>
        </h4>
        <p class="text-xs text-on-surface-variant mb-3">Atención operativa de lunes a domingo de 07:00 AM a 08:00 PM.</p>
        <div class="flex flex-wrap gap-3 text-xs font-semibold">
          <a href="@ContactService.GetWhatsAppUrl()" target="_blank" class="flex items-center gap-1 text-emerald-700 hover:underline bg-white px-3 py-1.5 rounded-lg border border-emerald-300">
            <span class="material-symbols-outlined text-[16px]">chat</span> WhatsApp: @ContactService.WhatsAppFormatted
          </a>
          <a href="tel:@ContactService.PhoneCall" class="flex items-center gap-1 text-primary hover:underline bg-white px-3 py-1.5 rounded-lg border border-primary/30">
            <span class="material-symbols-outlined text-[16px]">call</span> Fijo: @ContactService.PhoneCallFormatted
          </a>
          <span class="flex items-center gap-1 text-outline bg-white px-3 py-1.5 rounded-lg border border-outline-variant/60">
            <span class="material-symbols-outlined text-[16px]">location_on</span> Jr. 2 de Mayo 569, Cajamarca
          </span>
        </div>
      </div>
    </div>

    <!-- Footer -->
    <div class="p-3.5 bg-surface-container-low border-t border-outline-variant/60 flex justify-end">
      <button type="button" onclick="closeAdminHelpModal()" class="px-5 py-2 rounded-xl bg-primary text-white font-bold text-xs hover:bg-primary/90 transition-all cursor-pointer">
        Entendido
      </button>
    </div>
  </div>
</div>

<script>
let notifsLoaded = false;
function toggleNotificationsDropdown() {
    const dropdown = document.getElementById('notificationsDropdown');
    if (!dropdown) return;
    const isHidden = dropdown.classList.contains('hidden');
    if (isHidden) {
        dropdown.classList.remove('hidden');
        if (!notifsLoaded) {
            fetchNotifications();
        }
    } else {
        dropdown.classList.add('hidden');
    }
}

function fetchNotifications() {
    fetch('/Admin/GetNotifications')
    .then(r => {
        if (!r.ok) throw new Error("HTTP error " + r.status);
        return r.json();
    })
    .then(data => {
        notifsLoaded = true;
        const list = document.getElementById('notificationsList');
        if (!list) return;
        if (!data.notifications || data.notifications.length === 0) {
            list.innerHTML = '<div class="p-6 text-center text-xs text-outline">No hay notificaciones pendientes en este momento.</div>';
            return;
        }
        let html = '';
        data.notifications.forEach(n => {
            let icon = 'info';
            let iconColor = 'text-primary bg-primary/10';
            if (n.type === 'alert') {
                icon = 'warning';
                iconColor = 'text-amber-700 bg-amber-100';
            } else if (n.type === 'fleet') {
                icon = 'directions_bus';
                iconColor = 'text-sky-700 bg-sky-100';
            } else if (n.type === 'booking') {
                icon = 'confirmation_number';
                iconColor = 'text-emerald-700 bg-emerald-100';
            }
            html += `
                <a href="${n.url}" class="p-3.5 hover:bg-surface-container transition-colors flex items-start gap-3 block">
                    <div class="w-8 h-8 rounded-lg ${iconColor} flex items-center justify-center shrink-0 mt-0.5">
                        <span class="material-symbols-outlined text-[18px]">${icon}</span>
                    </div>
                    <div class="flex-1 min-w-0">
                        <div class="flex items-center justify-between gap-1">
                            <span class="font-bold text-xs text-on-surface truncate">${escapeHtml(n.title)}</span>
                            <span class="text-[10px] font-semibold px-1.5 py-0.5 rounded bg-surface-container text-on-surface-variant shrink-0">${escapeHtml(n.badge)}</span>
                        </div>
                        <p class="text-xs text-on-surface-variant truncate mt-0.5">${escapeHtml(n.detail)}</p>
                        <span class="text-[10px] text-outline block mt-1">${escapeHtml(n.date)}</span>
                    </div>
                </a>
            `;
        });
        list.innerHTML = html;
    })
    .catch(() => {
        const list = document.getElementById('notificationsList');
        if (list) list.innerHTML = '<div class="p-6 text-center text-xs text-red-600">No se pudieron cargar las notificaciones.</div>';
    });
}

function markAllNotificationsAsRead() {
    const dot = document.getElementById('notifBadgeDot');
    if (dot) dot.classList.add('hidden');
    const list = document.getElementById('notificationsList');
    if (list) list.innerHTML = '<div class="p-6 text-center text-xs text-outline">Todas las notificaciones marcadas como leídas.</div>';
}

function openAdminHelpModal() {
    const modal = document.getElementById('adminHelpModal');
    if (modal) modal.classList.remove('hidden');
}

function closeAdminHelpModal() {
    const modal = document.getElementById('adminHelpModal');
    if (modal) modal.classList.add('hidden');
}

document.addEventListener('click', function(e) {
    const btn = document.getElementById('adminNotificationsBtn');
    const dropdown = document.getElementById('notificationsDropdown');
    if (dropdown && !dropdown.classList.contains('hidden') && btn && !btn.contains(e.target) && !dropdown.contains(e.target)) {
        dropdown.classList.add('hidden');
    }
});
</script>

@await RenderSectionAsync("Scripts", required: false)
</body>
</html>




