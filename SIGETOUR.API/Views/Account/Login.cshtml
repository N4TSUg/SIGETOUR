</main>
<!-- Bottom System Micro Bar -->
<footer class="w-full py-2.5 px-4 bg-surface-container-lowest/70 backdrop-blur-sm border-t border-outline-variant/30 flex flex-col sm:flex-row justify-between items-center text-on-surface-variant font-label-sm text-label-sm z-10 gap-2">
<div class="flex items-center gap-2">
<span class="w-2 h-2 rounded-full bg-emerald-600"></span>
<span class="">Base de Díatos Operaciones: Online (Latencia: 24ms)</span>
</div>
<div>
<span class="">Versión del Sistema v4.8.2-PROD • Servidor Central Cajamarca</span>
</div>
</footer>
<!-- Vanilla JS Interactions -->
<script>
    function togglePasswordVisibility() {
      const passwordInput = document.getElementById('password');
      const passwordIcon = document.getElementById('passwordIcon');
      
      if (passwordInput.type === 'password') {
        passwordInput.type = 'text';
        passwordIcon.textContent = 'visibility_off';
      } else {
        passwordInput.type = 'password';
        passwordIcon.textContent = 'visibility';
      }
    }



</script>
</body></html>



