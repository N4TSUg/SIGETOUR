<body class="bg-background text-on-surface font-body-md min-h-full flex flex-col justify-between backdrop-patron antialiased relative selection:bg-primary selection:text-on-primary">
<!-- Top Security Status Bar -->
<header class="w-full bg-surface-container-lowest/80 backdrop-blur-md px-space-md py-space-sm flex justify-between items-center z-10">
<div class="flex items-center gap-space-sm">
<span class="inline-flex items-center justify-center w-7 h-7 rounded-lg bg-surface-container text-primary font-bold">
<span class="material-symbols-outlined text-[18px]">verified_user</span>
</span>
<div class="flex flex-col">
<span class="font-label-md text-label-md text-primary font-bold tracking-wide">TURISMO CHILÓN</span>
<span class="font-label-sm text-label-sm text-on-surface-variant">Transporte &amp; Turismo | Cajamarca, Perú</span>
</div>
</div>
<!-- Security Badges -->
<div class="hidden sm:flex items-center gap-space-sm">
<div class="flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-surface-bright border border-outline-variant/50 text-on-surface-variant font-label-sm text-label-sm">
<span class="material-symbols-outlined text-[14px] text-primary" style="font-variation-settings: &quot;FILL&quot; 1;">lock</span>
<span class="">Conexión Segura SSL 256-bit</span>
</div>
<div class="flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-surface-container text-primary font-label-sm text-label-sm">
<span class="w-2 h-2 rounded-full bg-primary animate-pulse"></span>
<span class="">Terminal Operativo Activo</span>
</div>
</div>
</header>
<!-- Main Login Canvas -->
<main class="flex-grow flex flex-col items-center justify-center px-4 py-8 sm:px-6 lg:px-8 z-10">
<div class="w-full max-w-[500px]">
<!-- Primary Card Container -->
<div class="bg-surface-container-lowest rounded-xl border border-outline-variant/60 custom-auth-shadow overflow-hidden relative">
<!-- Top Emerald Accent Bar -->
<div class="h-1.5 w-full bg-gradient-to-r from-primary via-primary-container to-secondary"></div>
<div class="p-6 sm:p-8">
<!-- Logo & Header Section -->
<div class="flex flex-col items-center text-center mb-6">
<div class="w-24 h-24 sm:w-28 sm:h-28 rounded-2xl p-2 bg-surface-container-lowest flex items-center justify-center shadow-sm border border-outline-variant/40 mb-4 transition-transform hover:scale-105 duration-200">
<img alt="Logotipo Oficial Turismo Chilón Cajamarca" class="w-full h-full object-contain" src="https://lh3.googleusercontent.com/aida-public/AB6AXuCUXvgeImb3N-pe8T2oxVP1tqWA2SaBvi-TQq0GO16m6UceRfxr8AGOuFJlrwW92Vkdi_OcR5ks3aBWBK-Ze8X8_8q3YbGxFYMn1eMIoFV9b2AZlqXJ4qCdH-v-YXOii-CtMAlTYbZ1wXOkBfK75P6AEsBg3tEHg-yS8_SSjTEGwG6JlXG863L-AQuldVoiABQP_eRPI7df1VaXCUW5LYXY3Vz7-H13xfabnWJX3VA7HEMaokQo6WtNEn61Rxe-eLKkCsk">
</div>
<span class="px-3 py-0.5 rounded-full bg-surface-container-low text-primary font-label-sm text-label-sm font-semibold tracking-wider mb-2">
              SISTEMA INTEGRADO DE GESTIÓN
            </span>
<h1 class="font-headline-sm text-headline-sm text-on-surface font-bold">
              Acceso Administrativo al Sistema
            </h1>
<p class="font-body-sm text-body-sm text-on-surface-variant mt-1 max-w-sm">
              Plataforma de Despacho, Control de Flota y Gestión de Tours
            </p>
</div>
<!-- Restricted Access Notice -->
<div class="mb-5 flex items-start gap-2.5 p-3 rounded-lg bg-surface-bright border border-primary/20 text-on-surface-variant">
<span class="material-symbols-outlined text-primary text-[20px] shrink-0 mt-0.5" style="font-variation-settings: &quot;FILL&quot; 1;">shield</span>
<p class="font-label-sm text-label-sm leading-snug">
<strong class="text-primary font-bold">Acceso Restringido:</strong> Exclusivo para despachadores autorizados, supervisores de flota y administración DIRCETUR / Gerencia.
            </p>
</div>
<!-- Login Form -->
<form asp-controller="Account" asp-action="Login" method="post" class="space-y-4" id="adminLoginForm">
    <div asp-validation-summary="ModelOnly" class="text-error font-body-sm bg-error-container p-2 rounded-md"></div>
    <div>
        <label asp-for="EmailOrUsername" class="block font-label-md text-label-md text-on-surface font-semibold mb-1.5 flex items-center gap-1.5">
            <span class="material-symbols-outlined text-[16px] text-primary">badge</span>
            Usuario o Correo Corporativo
        </label>
        <div class="relative">
            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-outline">
                <span class="material-symbols-outlined text-[20px]">person</span>
            </div>
            <input asp-for="EmailOrUsername" class="w-full pl-10 pr-3 py-2.5 rounded-lg border border-outline-variant bg-surface-container-lowest text-on-surface placeholder:text-outline/70 font-body-md text-body-md focus:border-primary focus:ring-2 focus:ring-primary/20 focus:outline-none transition-all" placeholder="admin@sigetour.com o admin" required />
            <span asp-validation-for="EmailOrUsername" class="text-error text-[11px] block mt-1"></span>
        </div>
    </div>
    
    <div>
        <div class="flex justify-between items-center mb-1.5">
            <label asp-for="Password" class="font-label-md text-label-md text-on-surface font-semibold flex items-center gap-1.5">
                <span class="material-symbols-outlined text-[16px] text-primary">key</span>
                Contraseña de acceso
            </label>
        </div>
        <div class="relative">
            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-outline">
                <span class="material-symbols-outlined text-[20px]">lock</span>
            </div>
            <input asp-for="Password" class="w-full pl-10 pr-10 py-2.5 rounded-lg border border-outline-variant bg-surface-container-lowest text-on-surface placeholder:text-outline/70 font-body-md text-body-md focus:border-primary focus:ring-2 focus:ring-primary/20 focus:outline-none transition-all" placeholder="" required />
            <button aria-label="Mostrar u ocultar Contraseña" class="absolute inset-y-0 right-0 pr-3 flex items-center text-outline hover:text-on-surface focus:outline-none transition-colors" id="togglePasswordBtn" onclick="togglePasswordVisibility()" type="button">
                <span class="material-symbols-outlined text-[20px]" id="passwordIcon">visibility</span>
            </button>
            <span asp-validation-for="Password" class="text-error text-[11px] block mt-1"></span>
        </div>
    </div>

    <div class="flex items-center pt-1">
        <input asp-for="RememberMe" class="h-4 w-4 rounded border-outline-variant text-primary focus:ring-primary focus:ring-offset-0 transition-colors" />
        <label asp-for="RememberMe" class="ml-2.5 block font-body-sm text-body-sm text-on-surface-variant cursor-pointer select-none">
            Recordar sesión en este equipo de caja/despacho
        </label>
    </div>

    <div class="pt-2">
        <button class="w-full min-h-[46px] flex justify-center items-center gap-2 px-6 py-3 rounded-lg bg-primary-container hover:bg-primary text-on-primary-container font-label-lg text-label-lg tracking-wide uppercase shadow-sm active:scale-[0.99] transition-all duration-150 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary" id="submitButton" type="submit">
            <span class="material-symbols-outlined text-[20px]">login</span>
            <span>Iniciar sesión en el Panel</span>
        </button>
    </div>
</form>
</div><!-- Terminal System Support Footer -->
<div class="px-6 py-4 bg-surface-container-low/70 border-t border-outline-variant/40 flex flex-col sm:flex-row items-center justify-between gap-3 text-center sm:text-left">
<div class="flex items-center gap-2">
<span class="material-symbols-outlined text-[20px] text-secondary">contact_support</span>
<div class="flex flex-col">
<span class="font-label-sm text-label-sm font-bold text-on-surface">Mesa de Ayuda y Soporte TI:</span>
<span class="font-body-sm text-body-sm text-on-surface-variant">Sistemas &amp; Despacho 24/7</span>
</div>
</div>
<div class="flex items-center gap-2 font-label-sm text-label-sm font-semibold text-primary">
<a class="hover:underline flex items-center gap-1" href="tel:+51901195392">
<span class="material-symbols-outlined text-[14px]">call</span> +51 901 195 392
            </a>
<span class="text-outline-variant">|</span>
<a class="hover:underline" href="tel:+51944746364">
              +51 944 746 364
            </a>
</div>
</div>
</div></div>
<!-- Footer Disclaimer -->
<div class="mt-6 text-center space-y-1">
<p class="font-body-sm text-body-sm text-on-surface-variant">
          Turismo Chilón S.A.C. • RUC 20601248901 • Cajamarca - Perú
        </p>
<p class="font-label-sm text-label-sm text-outline">
          Autorizado por MTC &amp; DIRCETUR Cajamarca para Transporte Turístico y Regular
        </p>
</div>
