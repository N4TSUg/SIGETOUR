@model SIGETOUR.API.Models.VehicleCatalogViewModel
@{
    ViewData["Title"] = "Flota Turística Certificada en Cajamarca | Turismo Chilón";
    Layout = "_Layout";

    var heroVehicle = Model.Vehicles?.FirstOrDefault(v => v.IsFlagship && v.ExistingImages != null && v.ExistingImages.Any())
        ?? Model.Vehicles?.FirstOrDefault(v => v.IsFlagship)
        ?? Model.Vehicles?.FirstOrDefault(v => v.ExistingImages != null && v.ExistingImages.Any())
        ?? Model.Vehicles?.FirstOrDefault();
    var heroImgUrl = heroVehicle?.ExistingImages.FirstOrDefault(i => i.IsCover)?.ImageUrl 
        ?? heroVehicle?.ExistingImages.FirstOrDefault()?.ImageUrl 
        ?? "/images/vehicles/c2e81465587b4d158cb22c87908d0380.png";
    var heroVehicleName = heroVehicle?.Model ?? "Mercedes-Benz Sprinter 515 VIP";
    var heroVehicleSeats = heroVehicle != null ? $"{heroVehicle.SeatCapacity} Pasajeros VIP" : "19 Pasajeros VIP";
}

<main class="min-h-screen bg-background">
  <!-- BREADCRUMB -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-6">
    <nav class="flex items-center text-label-md text-secondary space-x-2">
      <a class="hover:text-primary transition-colors flex items-center gap-1 font-medium" asp-controller="Home" asp-action="Index">
        <span class="material-symbols-outlined text-[16px]">home</span>
        <span>Inicio</span>
      </a>
      <span class="material-symbols-outlined text-outline-variant text-[14px]">chevron_right</span>
      <span class="text-primary font-bold">Flota Turística Oficial</span>
    </nav>
  </div>

  <!-- HERO SECTION -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 md:py-12">
    <div class="relative rounded-3xl overflow-hidden bg-gradient-to-r from-secondary via-[#0a4843] to-primary p-8 md:p-12 text-white shadow-xl">
      <!-- Glow effects -->
      <div class="absolute -right-16 -top-16 w-80 h-80 bg-primary-light/10 rounded-full blur-3xl pointer-events-none"></div>
      <div class="absolute -left-16 -bottom-16 w-72 h-72 bg-accent-red/10 rounded-full blur-3xl pointer-events-none"></div>

      <div class="relative z-10 grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        <!-- Left Column: Copy & Highlights Pills -->
        <div class="lg:col-span-7 space-y-4">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/10 backdrop-blur-md text-primary-fixed text-xs font-bold uppercase tracking-wider border border-white/15">
            <span class="w-2 h-2 rounded-full bg-accent-red animate-pulse"></span>
            <span>Transporte Turístico Homologado • MTC & DIRCETUR</span>
          </div>
          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight leading-tight text-white">
            Nuestra Flota Moderna y Confortable
          </h1>
          <p class="text-base sm:text-lg text-surface-container-high/90 leading-relaxed">
            Vehículos inspeccionados y mantenidos rigurosamente para garantizar traslados seguros y confortables en las rutas andinas de Cajamarca. Disponibles para circuitos compartidos y servicios 100% privados.
          </p>
          
          <!-- Highlights Pills -->
          <div class="flex flex-wrap items-center gap-2.5 pt-2 text-xs font-semibold text-primary-fixed">
            <span class="flex items-center gap-1.5 bg-white/10 px-3 py-1.5 rounded-lg border border-white/10 backdrop-blur-xs">
              <span class="material-symbols-outlined text-[17px] text-accent-red">verified_user</span> SOAT Turístico Vigente
            </span>
            <span class="flex items-center gap-1.5 bg-white/10 px-3 py-1.5 rounded-lg border border-white/10 backdrop-blur-xs">
              <span class="material-symbols-outlined text-[17px] text-primary-fixed">ac_unit</span> Aire Acondicionado
            </span>
            <span class="flex items-center gap-1.5 bg-white/10 px-3 py-1.5 rounded-lg border border-white/10 backdrop-blur-xs">
              <span class="material-symbols-outlined text-[17px] text-primary-fixed">airline_seat_recline_extra</span> Asientos VIP Reclinables
            </span>
            <span class="flex items-center gap-1.5 bg-white/10 px-3 py-1.5 rounded-lg border border-white/10 backdrop-blur-xs">
              <span class="material-symbols-outlined text-[17px] text-primary-fixed">medical_services</span> Botiquín de Emergencia
            </span>
          </div>
        </div>

        <!-- Right Column: Featured Vehicle Showcase Image -->
        <div class="lg:col-span-5 relative flex justify-center lg:justify-end">
          <div class="relative w-full max-w-md lg:max-w-none group">
            <!-- Ambient Glow -->
            <div class="absolute -inset-1.5 bg-gradient-to-r from-primary-light/30 to-tertiary/30 rounded-3xl blur-xl opacity-70 group-hover:opacity-100 transition-opacity duration-500"></div>
            
            <!-- Vehicle Showcase Card -->
            <div class="relative rounded-2xl overflow-hidden border border-white/20 bg-surface-container-lowest/10 backdrop-blur-md shadow-2xl">
              <div class="relative h-56 sm:h-64 lg:h-68 w-full overflow-hidden bg-black/30">
                <img class="w-full h-full object-cover object-center transform group-hover:scale-105 transition-transform duration-700" 
                     src="@heroImgUrl" 
                     alt="@heroVehicleName" 
                     loading="eager" />
                
                <!-- Gradient overlay -->
                <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent pointer-events-none"></div>

                <!-- Top Floating Tag -->
                <div class="absolute top-3 left-3 right-3 flex items-center justify-between pointer-events-none">
                  <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-white/95 backdrop-blur-md text-primary font-bold text-[11px] shadow-md">
                    <span class="w-2 h-2 rounded-full bg-primary animate-pulse"></span>
                    <span>Flota Oficial</span>
                  </span>
                  <span class="px-2.5 py-1 rounded-lg bg-black/60 backdrop-blur-md text-white font-mono text-xs font-bold border border-white/20 shadow-sm">
                    @heroVehicleSeats
                  </span>
                </div>

                <!-- Bottom Vehicle Model Label -->
                <div class="absolute bottom-3 left-3 right-3 flex items-end justify-between pointer-events-none text-white">
                  <div>
                    <span class="text-[10px] uppercase tracking-wider text-surface-container-high/80 block font-semibold">Unidad de Transporte</span>
                    <h3 class="text-sm sm:text-base font-extrabold text-white drop-shadow-sm leading-tight">
                      @heroVehicleName
                    </h3>
                  </div>
                  <span class="material-symbols-outlined text-primary-light text-2xl drop-shadow-sm">verified</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CATEGORY FILTER & METRICS BAR -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-8">
    <div class="bg-surface-container-lowest rounded-2xl p-4 sm:p-5 border border-outline-variant shadow-sm flex flex-col md:flex-row items-center justify-between gap-4">
      <!-- Filter Buttons -->
      <div class="flex flex-wrap items-center gap-2 w-full md:w-auto">
        <a asp-action="Catalog" asp-route-category="Todos"
           class="px-4 py-2 rounded-xl text-xs font-bold transition-all @(Model.SelectedCategory == "Todos" ? "bg-primary text-white shadow-sm" : "bg-surface-container-low text-secondary hover:bg-surface-container")">
          Todas las Unidades (@(Model?.Vehicles?.Count ?? 0))
        </a>
        @foreach (var cat in Model.AvailableCategories)
        {
            <a asp-action="Catalog" asp-route-category="@cat"
               class="px-4 py-2 rounded-xl text-xs font-bold transition-all @(Model.SelectedCategory == cat ? "bg-primary text-white shadow-sm" : "bg-surface-container-low text-secondary hover:bg-surface-container")">
              @cat
            </a>
        }
      </div>

      <!-- Live Counter -->
      <div class="flex items-center gap-2 text-xs font-medium text-secondary whitespace-nowrap self-end md:self-center">
        <span class="w-2.5 h-2.5 rounded-full bg-primary animate-pulse"></span>
        <span>Flota activa en Cajamarca: <strong class="text-primary font-bold">@Model.OperationalUnits unidades</strong></span>
      </div>
    </div>
  </section>

  <!-- VEHICLES HORIZONTAL SHOWCASE CARDS -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-16">
    @if (Model.Vehicles != null && Model.Vehicles.Any())
    {
        <div class="space-y-8">
          @foreach (var vehicle in Model.Vehicles)
          {
              var coverImage = vehicle.ExistingImages.FirstOrDefault(i => i.IsCover) ?? vehicle.ExistingImages.FirstOrDefault();
              var amenities = vehicle.SelectedEquipment;
              
              <article class="bg-surface-container-lowest rounded-3xl overflow-hidden border border-outline-variant hover:border-primary/50 shadow-md hover:shadow-xl transition-all duration-300 flex flex-col lg:flex-row group">
                <!-- Vehicle Visual Showcase (Left 42% on desktop) -->
                <div class="lg:w-5/12 relative flex flex-col bg-surface-container-low overflow-hidden">
                  <div class="relative h-64 sm:h-72 lg:h-full min-h-[260px] w-full overflow-hidden">
                    @if (coverImage != null && !string.IsNullOrEmpty(coverImage.ImageUrl))
                    {
                        <img class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" 
                             src="@coverImage.ImageUrl" 
                             alt="Foto de @vehicle.Model - @vehicle.LicensePlate" 
                             loading="lazy" />
                    }
                    else
                    {
                        <div class="w-full h-full flex flex-col items-center justify-center text-outline bg-gradient-to-br from-surface-container-low to-surface-container">
                          <span class="material-symbols-outlined text-6xl mb-2 text-primary/40">directions_bus</span>
                          <span class="text-sm font-semibold">Turismo Chilón • Flota</span>
                        </div>
                    }

                    <!-- Gradient Overlays -->
                    <div class="absolute inset-0 bg-gradient-to-t from-black/75 via-transparent to-black/30 pointer-events-none"></div>

                    <!-- Top Floating Badges -->
                    <div class="absolute top-4 left-4 right-4 flex items-center justify-between gap-2">
                      <span class="bg-white/95 backdrop-blur-md text-primary font-bold text-xs px-3.5 py-1.5 rounded-full shadow-md">
                        @(string.IsNullOrEmpty(vehicle.Category) ? "Van Turística VIP" : vehicle.Category)
                      </span>
                      <span class="bg-secondary/90 backdrop-blur-md text-white font-bold text-xs px-3 py-1.5 rounded-full shadow-md flex items-center gap-1.5">
                        <span class="material-symbols-outlined text-[16px] text-primary-light">airline_seat_recline_normal</span>
                        <span>@vehicle.SeatCapacity Pasajeros</span>
                      </span>
                    </div>

                    <!-- Bottom Tag: License Plate + Live Status -->
                    <div class="absolute bottom-4 left-4 right-4 flex items-center justify-between text-white">
                      <div class="flex items-center gap-2">
                        <span class="bg-inverse-surface/90 backdrop-blur-md font-mono text-xs sm:text-sm px-3 py-1 rounded-lg font-bold tracking-wider border border-white/20 flex items-center gap-1.5 shadow-sm">
                          <span class="text-[9px] bg-primary-container text-on-primary-container px-1 rounded font-sans">PE</span>
                          @vehicle.LicensePlate
                        </span>
                      </div>
                      <span class="inline-flex items-center gap-1.5 text-xs font-semibold bg-emerald-950/80 backdrop-blur-md text-emerald-300 border border-emerald-500/30 px-3 py-1 rounded-full shadow-sm">
                        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                        <span>@vehicle.Status</span>
                      </span>
                    </div>
                  </div>
                </div>

                <!-- Vehicle Info & Specs Body (Right 58% on desktop) -->
                <div class="lg:w-7/12 p-6 sm:p-8 flex flex-col justify-between space-y-6">
                  <!-- Header: Title, Category & Basic Data -->
                  <div>
                    <div class="flex flex-wrap items-center justify-between gap-2 text-xs font-semibold text-on-surface-variant mb-1.5">
                      <div class="flex items-center gap-3">
                        <span class="flex items-center gap-1 text-primary">
                          <span class="material-symbols-outlined text-[16px]">calendar_today</span>
                          <span>Año @vehicle.ManufactureYear</span>
                        </span>
                        <span>•</span>
                        <span class="flex items-center gap-1">
                          <span class="material-symbols-outlined text-[16px] text-outline">palette</span>
                          <span>@(string.IsNullOrEmpty(vehicle.Color) ? "Blanco Oficial" : vehicle.Color)</span>
                        </span>
                        <span>•</span>
                        <span class="flex items-center gap-1">
                          <span class="material-symbols-outlined text-[16px] text-outline">local_gas_station</span>
                          <span>@(string.IsNullOrEmpty(vehicle.FuelType) ? "Diésel B5 S-50" : vehicle.FuelType.Split('(')[0].Trim())</span>
                        </span>
                      </div>
                    </div>

                    <h2 class="text-2xl sm:text-3xl font-extrabold text-secondary group-hover:text-primary transition-colors tracking-tight">
                      @vehicle.Model
                    </h2>
                    
                    <p class="text-xs sm:text-sm text-on-surface-variant mt-2 leading-relaxed">
                      Unidad de alta gama para transporte turístico interprovincial. Equipada con altos estándares de confort para recorridos panorámicos en Cajamarca, Cumbemayo, Granja Porcón y traslados privados corporativos.
                    </p>
                  </div>

                  <!-- Dynamic Equipment & Amenities (From SelectedEquipment in Admin) -->
                  <div>
                    <span class="text-[11px] font-bold text-outline uppercase tracking-wider block mb-2">Equipamiento y Comodidades a Bordo:</span>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
                      @foreach (var item in amenities)
                      {
                          string icon = "check_circle";
                          if (item.Contains("Aire", StringComparison.OrdinalIgnoreCase) || item.Contains("Climat", StringComparison.OrdinalIgnoreCase)) icon = "ac_unit";
                          else if (item.Contains("Asiento", StringComparison.OrdinalIgnoreCase)) icon = "airline_seat_recline_extra";
                          else if (item.Contains("USB", StringComparison.OrdinalIgnoreCase)) icon = "usb";
                          else if (item.Contains("Botiquín", StringComparison.OrdinalIgnoreCase)) icon = "medical_services";
                          else if (item.Contains("Extintor", StringComparison.OrdinalIgnoreCase)) icon = "fire_extinguisher";
                          else if (item.Contains("Micrófono", StringComparison.OrdinalIgnoreCase) || item.Contains("Audio", StringComparison.OrdinalIgnoreCase)) icon = "volume_up";
                          else if (item.Contains("Maletero", StringComparison.OrdinalIgnoreCase) || item.Contains("Equipaje", StringComparison.OrdinalIgnoreCase)) icon = "luggage";
                          else if (item.Contains("Cinturón", StringComparison.OrdinalIgnoreCase)) icon = "health_and_safety";
                          else if (item.Contains("Suspensión", StringComparison.OrdinalIgnoreCase)) icon = "car_repair";
                          else if (item.Contains("Cortina", StringComparison.OrdinalIgnoreCase)) icon = "curtains";

                          <div class="flex items-center gap-2 p-2 rounded-xl bg-surface-bright/50 border border-outline-variant/60 text-xs font-semibold text-secondary">
                            <span class="material-symbols-outlined text-[18px] text-primary shrink-0">@icon</span>
                            <span class="truncate">@item</span>
                          </div>
                      }
                    </div>
                  </div>

                  <!-- Legal & Compliance Pills Bar -->
                  <div class="p-3 rounded-2xl bg-surface-container-low/60 border border-outline-variant/60 flex flex-wrap items-center justify-between gap-3 text-xs">
                    <div class="flex items-center gap-1.5 text-secondary font-semibold">
                      <span class="material-symbols-outlined text-[18px] text-emerald-600">verified</span>
                      <span>SOAT Turístico: <strong class="text-on-surface">@(string.IsNullOrEmpty(vehicle.SoatProvider) ? "Rímac Seguros" : vehicle.SoatProvider)</strong></span>
                    </div>
                    <div class="flex items-center gap-1.5 text-secondary font-semibold">
                      <span class="material-symbols-outlined text-[18px] text-primary">car_repair</span>
                      <span>CITV Técnico: <strong class="text-on-surface">Inspeccionado</strong></span>
                    </div>
                    <div class="flex items-center gap-1.5 text-secondary font-semibold">
                      <span class="material-symbols-outlined text-[18px] text-primary">badge</span>
                      <span>Autorización: <strong class="text-on-surface">MTC / DRTC</strong></span>
                    </div>
                  </div>

                  <!-- Actions / CTA -->
                  <div class="pt-2 flex flex-col sm:flex-row items-center gap-3">
                    <a asp-action="Details" asp-route-id="@vehicle.Id" 
                       class="w-full sm:w-auto flex-1 py-3 px-6 rounded-xl bg-primary hover:bg-primary-dark text-white font-bold text-xs sm:text-sm text-center transition-all duration-150 shadow-md hover:shadow-lg flex items-center justify-center gap-2">
                      <span class="material-symbols-outlined text-[18px]">visibility</span>
                      <span>Ver Ficha Técnica y Fotos</span>
                    </a>
                    
                    <a href="@ContactService.GetWhatsAppUrl($"Hola Turismo Chilón, deseo cotizar el alquiler o servicio privado de la unidad {vehicle.Model} (Placa {vehicle.LicensePlate}) con capacidad de {vehicle.SeatCapacity} pasajeros", true)"
                       target="_blank" rel="noopener noreferrer"
                       class="w-full sm:w-auto py-3 px-6 rounded-xl bg-[#25D366] hover:bg-[#1ebe5d] text-white font-bold text-xs sm:text-sm transition-all duration-150 shadow-md flex items-center justify-center gap-2"
                       title="Cotizar alquiler por WhatsApp">
                      <span class="material-symbols-outlined text-[20px]">chat</span>
                      <span>Cotizar Alquiler / Privado</span>
                    </a>
                  </div>
                </div>
              </article>
          }
        </div>
    }
    else
    {
        <div class="bg-surface-container-lowest rounded-2xl p-12 text-center border border-outline-variant max-w-xl mx-auto space-y-4">
          <div class="w-16 h-16 rounded-full bg-surface-container flex items-center justify-center mx-auto text-primary">
            <span class="material-symbols-outlined text-3xl">directions_bus</span>
          </div>
          <h3 class="text-xl font-bold text-secondary">No se encontraron unidades en esta categoría</h3>
          <p class="text-sm text-on-surface-variant">Prueba seleccionando otra categoría o restablece los filtros para ver la flota completa.</p>
          <a asp-action="Catalog" asp-route-category="Todos" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-primary text-white text-xs font-bold hover:bg-primary-dark transition-all">
            Ver Todas las Unidades
          </a>
        </div>
    }
  </section>

  <!-- MODALIDADES DE SERVICIO DE TRANSPORTE -->
  <section class="py-14 bg-white border-y border-outline-variant/60">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-10">
        <span class="text-xs font-bold text-primary uppercase tracking-wider">Modalidades de Transporte</span>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-secondary mt-1">¿Cómo puedes contratar nuestra flota?</h2>
        <p class="text-sm text-on-surface-variant mt-2">Adaptamos nuestras unidades para cualquier tipo de viaje en Cajamarca y el norte del Perú.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Servicio 1 -->
        <div class="bg-surface-container-lowest p-6 rounded-2xl border border-outline-variant shadow-sm space-y-3 hover:border-primary/40 transition-colors">
          <div class="w-12 h-12 rounded-xl bg-primary-container/20 text-primary flex items-center justify-center">
            <span class="material-symbols-outlined text-2xl">tour</span>
          </div>
          <h3 class="text-lg font-bold text-secondary">Circuitos Turísticos Diarios</h3>
          <p class="text-xs text-on-surface-variant leading-relaxed">
            Reserva tus asientos individuales en nuestras salidas diarias a Cumbemayo, Granja Porcón, Baños del Inca, Otuzco y Namora con guía oficial.
          </p>
          <a asp-controller="Tour" asp-action="Catalog" class="inline-flex items-center gap-1 text-xs font-bold text-primary hover:underline pt-2">
            Ver Catálogo de Tours <span class="material-symbols-outlined text-[15px]">arrow_forward</span>
          </a>
        </div>

        <!-- Servicio 2 -->
        <div class="bg-surface-container-lowest p-6 rounded-2xl border border-outline-variant shadow-sm space-y-3 hover:border-primary/40 transition-colors">
          <div class="w-12 h-12 rounded-xl bg-secondary-container/30 text-secondary flex items-center justify-center">
            <span class="material-symbols-outlined text-2xl">groups</span>
          </div>
          <h3 class="text-lg font-bold text-secondary">Servicio Exclusivo & Familiar</h3>
          <p class="text-xs text-on-surface-variant leading-relaxed">
            Unidad completa para tu familia o grupo privado. Salidas a tu propio ritmo, recojo puerta a puerta en tu hotel y paradas fotográficas libres.
          </p>
          <a href="@ContactService.GetWhatsAppUrl("Hola Turismo Chilón, solicito cotización para un servicio privado")" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 text-xs font-bold text-primary hover:underline pt-2">
            Cotizar por WhatsApp <span class="material-symbols-outlined text-[15px]">arrow_forward</span>
          </a>
        </div>

        <!-- Servicio 3 -->
        <div class="bg-surface-container-lowest p-6 rounded-2xl border border-outline-variant shadow-sm space-y-3 hover:border-primary/40 transition-colors">
          <div class="w-12 h-12 rounded-xl bg-accent-red/10 text-accent-red flex items-center justify-center">
            <span class="material-symbols-outlined text-2xl">flight_takeoff</span>
          </div>
          <h3 class="text-lg font-bold text-secondary">Traslados Aeropuerto Caxamarca</h3>
          <p class="text-xs text-on-surface-variant leading-relaxed">
            Puntualidad garantizada para vuelos comerciales LATAM y SKY. Chofer en sala de llegadas con asistencia de maletas y traslado directo.
          </p>
          <a href="tel:@ContactService.PhoneCall" class="inline-flex items-center gap-1 text-xs font-bold text-primary hover:underline pt-2">
            Llamar al @ContactService.PhoneFormatted <span class="material-symbols-outlined text-[15px]">call</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- GARANTIAS DE SEGURIDAD Y ESTANDARES -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14">
    <div class="bg-surface-container-low rounded-3xl p-8 md:p-10 border border-outline-variant shadow-sm grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      <div class="flex items-start gap-3.5">
        <div class="w-10 h-10 rounded-xl bg-primary text-white flex items-center justify-center shrink-0 shadow-xs">
          <span class="material-symbols-outlined text-[22px]">policy</span>
        </div>
        <div>
          <h4 class="text-sm font-bold text-secondary">SOAT Turístico Nacional</h4>
          <p class="text-xs text-on-surface-variant mt-1 leading-relaxed">Cobertura total médica para cada pasajero durante todo el viaje.</p>
        </div>
      </div>

      <div class="flex items-start gap-3.5">
        <div class="w-10 h-10 rounded-xl bg-primary text-white flex items-center justify-center shrink-0 shadow-xs">
          <span class="material-symbols-outlined text-[22px]">fact_check</span>
        </div>
        <div>
          <h4 class="text-sm font-bold text-secondary">Inspección Técnica CITV</h4>
          <p class="text-xs text-on-surface-variant mt-1 leading-relaxed">Certificado de inspección técnica vehicular homologado ante el MTC.</p>
        </div>
      </div>

      <div class="flex items-start gap-3.5">
        <div class="w-10 h-10 rounded-xl bg-primary text-white flex items-center justify-center shrink-0 shadow-xs">
          <span class="material-symbols-outlined text-[22px]">badge</span>
        </div>
        <div>
          <h4 class="text-sm font-bold text-secondary">Conductores Acreditados</h4>
          <p class="text-xs text-on-surface-variant mt-1 leading-relaxed">Choferes profesionales expertos en geografía y clima de sierra.</p>
        </div>
      </div>

