@model IEnumerable<SIGETOUR.API.Core.Entities.TourPackage>
@{ Layout = "_Layout"; }
<main class="flex-1">
<!-- HERO SECTION: Destinos y Circuitos Turísticos -->
<section class="relative bg-gradient-to-b from-surface-container-low via-surface to-surface-bright py-12 md:py-16 border-b border-outline-variant/60">
<div class="max-w-7xl mx-auto px-4 md:px-8 relative z-10">
<!-- Breadcrumb & Badge -->
<div class="flex flex-wrap items-center gap-2 mb-4">
<span class="px-3 py-1 bg-surface-container text-primary text-label-sm font-label-sm rounded-full border border-primary/20 flex items-center gap-1">
<span class="material-symbols-outlined text-[14px]">explore</span> Catálogo Oficial 2025
          </span>
<span class="text-outline text-xs">/</span>
<span class="text-secondary text-body-sm font-body-sm">Cajamarca, Perú</span>
<span class="text-outline text-xs">/</span>
<span class="text-on-surface font-semibold text-body-sm font-body-sm">Salidas Diarias Garantizadas</span>
</div>
<div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-end">
<div class="lg:col-span-8">
<h1 class="text-headline-lg md:text-display-lg font-display-lg text-inverse-surface tracking-tight leading-tight mb-4">
              Explora los Mejores Destinos y Circuitos Turísticos de Cajamarca
            </h1>
<p class="text-body-lg font-body-lg text-on-surface-variant max-w-3xl leading-relaxed">Viaja seguro con nuestra moderna flota de Mercedes-Benz Sprinter y Toyota HiAce, asistencia permanente y cobertura SOAT turística integral con asistencia permanente.</p>
</div>
<!-- Mini trust counters -->
<div class="lg:col-span-4 flex lg:justify-end">
<div class="bg-surface-container-lowest/90 backdrop-blur p-4 rounded-xl border border-outline-variant/70 shadow-sm flex items-center gap-4">
<div class="w-12 h-12 rounded-lg bg-surface-container flex items-center justify-center text-primary">
<span class="material-symbols-outlined text-[28px]">verified_user</span>
</div>
<div>
<div class="flex items-center gap-1 text-tertiary font-bold text-headline-sm">
<span class="">100%</span>
<span class="text-xs bg-tertiary-fixed text-on-tertiary-fixed px-1.5 py-0.5 rounded">Garantizado</span>
</div>
<p class="text-body-sm text-secondary font-medium">Cumplimiento de itinerario y protocolos</p>
</div>
</div>
</div>
</div>
<!-- FAST ROUTE SEARCH BAR -->
<div class="mt-8 bg-surface-container-lowest rounded-2xl p-4 md:p-5 shadow-lg border border-outline-variant/80">
<form method="get" action="@Url.Action("Catalog", "Tour")" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-12 gap-3 md:gap-4 items-center">
@if (ViewBag.CurrentCategoryId != null)
{
    <input type="hidden" name="categoryId" value="@ViewBag.CurrentCategoryId" />
}
@if (ViewBag.CurrentSortBy != null)
{
    <input type="hidden" name="sortBy" value="@ViewBag.CurrentSortBy" />
}
<!-- Search Destination -->
<div class="lg:col-span-4">
<label class="block text-label-sm font-label-sm text-secondary mb-1">Destino o Circuito</label>
<div class="relative flex items-center">
<span class="material-symbols-outlined absolute left-3 text-secondary text-[20px]">tour</span>
<input name="q" value="@ViewBag.CurrentQ" class="w-full pl-10 pr-4 py-2.5 bg-surface-bright/50 border border-outline-variant rounded-lg text-body-md focus:border-primary focus:ring-2 focus:ring-primary/20 text-on-surface placeholder:text-outline outline-none" placeholder="Ej. Cumbemayo, Otuzco, Porcón..." type="text">
</div>
</div>
<!-- Date Selector -->
<div class="lg:col-span-3">
<label class="block text-label-sm font-label-sm text-secondary mb-1">Fecha del Tour</label>
<div class="relative flex items-center">
<span class="material-symbols-outlined absolute left-3 text-secondary text-[20px]">calendar_month</span>
<input name="date" class="w-full pl-10 pr-3 py-2.5 bg-surface-bright/50 border border-outline-variant rounded-lg text-body-md focus:border-primary focus:ring-2 focus:ring-primary/20 text-on-surface outline-none" type="date" min="@DateTime.Today.ToString("yyyy-MM-dd")" value="@(string.IsNullOrEmpty(ViewBag.CurrentDate) ? DateTime.Today.ToString("yyyy-MM-dd") : ViewBag.CurrentDate)">
</div>
</div>
<!-- Turno / Horario -->
<div class="lg:col-span-3">
<label class="block text-label-sm font-label-sm text-secondary mb-1">Turno de Salida</label>
<div class="relative flex items-center">
<span class="material-symbols-outlined absolute left-3 text-secondary text-[20px]">schedule</span>
<select name="shift" class="w-full pl-10 pr-8 py-2.5 bg-surface-bright/50 border border-outline-variant rounded-lg text-body-md focus:border-primary focus:ring-2 focus:ring-primary/20 text-on-surface outline-none appearance-none">
<option value="Todos" selected="@(ViewBag.CurrentShift == "Todos" || string.IsNullOrEmpty(ViewBag.CurrentShift))">Cualquier Turno</option>
<option value="Mañana" selected="@(ViewBag.CurrentShift == "Mañana")">Mañana (09:00 AM - 09:30 AM)</option>
<option value="Tarde" selected="@(ViewBag.CurrentShift == "Tarde")">Tarde (02:30 PM - 03:30 PM)</option>
</select>
<span class="material-symbols-outlined absolute right-3 pointer-events-none text-secondary text-[18px]">expand_more</span>
</div>
</div>
<!-- Submit Button -->
<div class="lg:col-span-2 pt-1 sm:pt-5 lg:pt-0">
<button class="w-full h-[42px] bg-primary hover:bg-primary-container text-on-primary font-label-lg font-bold rounded-lg shadow transition-all flex items-center justify-center gap-2 active:scale-95 cursor-pointer" type="submit">
<span class="material-symbols-outlined text-[20px]">search</span>
<span class="">Buscar</span>
</button>
</div>
</form>
</div>
</div>
</section>
<!-- CATALOG MAIN LAYOUT: Sticky Sidebar Filters + Tour Cards Grid -->
<div class="max-w-7xl mx-auto px-4 md:px-8 py-10" id="catalogo">
<div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
<!-- LEFT COLUMN: Advanced Filters Sidebar -->
<aside class="lg:col-span-4 xl:col-span-3 sticky top-24 bg-surface-container-lowest rounded-2xl p-5 border border-outline-variant shadow-sm">
<div class="flex items-center justify-between pb-4 border-b border-outline-variant/60">
<div class="flex items-center gap-2 text-inverse-surface font-title-sm">
<span class="material-symbols-outlined text-primary text-[22px]">tune</span>
<span class="font-bold">Filtrar Circuitos</span>
</div>
<a href="@Url.Action("Catalog", "Tour")" class="text-label-sm text-tertiary hover:underline font-semibold cursor-pointer">
              Limpiar Filtros
</a>
</div>
<div class="space-y-6 pt-5">
<!-- Category Filter -->
<div>
<h2 class="text-label-md font-label-md uppercase tracking-wider text-secondary mb-3 flex items-center justify-between">
<span class="">Categoría</span>
<span class="text-[11px] text-outline font-normal">@Model.Count() tours</span>
</h2>
<div class="space-y-1.5 text-body-sm">
@{
    var curCatId = ViewBag.CurrentCategoryId as Guid?;
}
<a href="@Url.Action("Catalog", "Tour", new { q = ViewBag.CurrentQ, date = ViewBag.CurrentDate, shift = ViewBag.CurrentShift, modality = ViewBag.CurrentModality, difficulty = ViewBag.CurrentDifficulty, maxPrice = ViewBag.CurrentMaxPrice, sortBy = ViewBag.CurrentSortBy })" class="flex items-center justify-between cursor-pointer group p-1.5 rounded-lg hover:bg-surface-container-low transition-colors @(!curCatId.HasValue ? "font-bold text-primary bg-surface-container-low" : "text-on-surface")">
<div class="flex items-center gap-2">
<span class="w-2 h-2 rounded-full @(!curCatId.HasValue ? "bg-primary" : "bg-outline-variant")"></span>
<span class="group-hover:text-primary transition-colors font-medium">Todos los Circuitos</span>
</div>
<span class="text-xs bg-surface-container text-secondary px-2 py-0.5 rounded-full font-bold">@Model.Count()</span>
</a>
@if (ViewBag.Categories != null)
{
    foreach (var cat in (IEnumerable<SIGETOUR.API.Core.Entities.Category>)ViewBag.Categories)
    {
        var isSelected = curCatId == cat.Id;
        <a href="@Url.Action("Catalog", "Tour", new { q = ViewBag.CurrentQ, categoryId = cat.Id, date = ViewBag.CurrentDate, shift = ViewBag.CurrentShift, modality = ViewBag.CurrentModality, difficulty = ViewBag.CurrentDifficulty, maxPrice = ViewBag.CurrentMaxPrice, sortBy = ViewBag.CurrentSortBy })" class="flex items-center justify-between cursor-pointer group p-1.5 rounded-lg hover:bg-surface-container-low transition-colors @(isSelected ? "font-bold text-primary bg-primary-container/20" : "text-on-surface-variant hover:text-primary")">
            <div class="flex items-center gap-2">
                <span class="material-symbols-outlined text-[16px] @(isSelected ? "text-primary" : "text-outline")">@(string.IsNullOrWhiteSpace(cat.Icon) ? "landscape" : cat.Icon)</span>
                <span>@cat.Name</span>
            </div>
            <span class="text-xs bg-surface-container-low text-secondary px-2 py-0.5 rounded-full">@cat.TourPackages.Count</span>
        </a>
    }
}
</div>
</div>
<!-- Duración -->
<div class="pt-4 border-t border-outline-variant/60">
<h2 class="text-label-md font-label-md uppercase tracking-wider text-secondary mb-3">Duración del Recorrido</h2>
<div class="grid grid-cols-2 gap-2 text-body-sm">
<button class="px-3 py-2 border border-primary bg-surface-container-low text-primary font-semibold rounded-lg text-center text-xs transition-all" type="button">
                  Medio Día <span class="block text-[10px] font-normal text-secondary">3 - 4.5 hrs</span>
</button>
<button class="px-3 py-2 border border-outline-variant hover:border-primary text-secondary rounded-lg text-center text-xs transition-all" type="button">
                  Día Completo <span class="block text-[10px] font-normal text-outline">6 - 8 hrs</span>
</button>
</div>
</div>
<!-- Turno de Salida -->
<div class="pt-4 border-t border-outline-variant/60">
<h2 class="text-label-md font-label-md uppercase tracking-wider text-secondary mb-2.5">Turno de Salida</h2>
<div class="space-y-2">
<label class="flex items-center gap-2 text-body-sm cursor-pointer">
<input checked="" class="rounded text-primary focus:ring-primary border-outline-variant" type="checkbox">
<span class="">Mañana (9:00 AM / 9:30 AM)</span>
</label>
<label class="flex items-center gap-2 text-body-sm cursor-pointer">
<input checked="" class="rounded text-primary focus:ring-primary border-outline-variant" type="checkbox">
<span class="">Tarde (2:30 PM / 3:30 PM)</span>
</label>
</div>
</div>
<!-- Rango de Precios -->
<div class="pt-4 border-t border-outline-variant/60">
<div class="flex justify-between items-center mb-2">
<h2 class="text-label-md font-label-md uppercase tracking-wider text-secondary">Presupuesto por Persona</h2>
<span class="text-xs font-bold text-primary">S/ 25 - S/ 50</span>
</div>
<input class="w-full accent-primary h-2 bg-secondary-container rounded-lg cursor-pointer" max="80" min="25" type="range" value="50">
<div class="flex justify-between text-[11px] text-outline mt-1 font-medium">
<span class="">S/ 25 min</span>
<span class="">S/ 80+ max</span>
</div>
</div>
<!-- Exigencia Física -->
<div class="pt-4 border-t border-outline-variant/60">
<h2 class="text-label-md font-label-md uppercase tracking-wider text-secondary mb-2.5">Nivel de Exigencia</h2>
<div class="flex flex-wrap gap-1.5">
<a href="@Url.Action("Catalog", "Tour", new { q = ViewBag.CurrentQ, categoryId = ViewBag.CurrentCategoryId, difficulty = "Todos", date = ViewBag.CurrentDate, shift = ViewBag.CurrentShift, sortBy = ViewBag.CurrentSortBy })" class="px-2.5 py-1 text-xs rounded-md border transition-colors @(string.IsNullOrEmpty(ViewBag.CurrentDifficulty) || ViewBag.CurrentDifficulty == "Todos" ? "bg-primary text-on-primary font-bold border-primary" : "bg-surface-bright text-secondary border-outline-variant hover:border-primary")">Todos</a>
<a href="@Url.Action("Catalog", "Tour", new { q = ViewBag.CurrentQ, categoryId = ViewBag.CurrentCategoryId, difficulty = "Ligero", date = ViewBag.CurrentDate, shift = ViewBag.CurrentShift, sortBy = ViewBag.CurrentSortBy })" class="px-2.5 py-1 text-xs rounded-md border transition-colors @(ViewBag.CurrentDifficulty == "Ligero" ? "bg-primary text-on-primary font-bold border-primary" : "bg-surface-bright text-secondary border-outline-variant hover:border-primary")">Ligero</a>
<a href="@Url.Action("Catalog", "Tour", new { q = ViewBag.CurrentQ, categoryId = ViewBag.CurrentCategoryId, difficulty = "Moderado", date = ViewBag.CurrentDate, shift = ViewBag.CurrentShift, sortBy = ViewBag.CurrentSortBy })" class="px-2.5 py-1 text-xs rounded-md border transition-colors @(ViewBag.CurrentDifficulty == "Moderado" ? "bg-primary text-on-primary font-bold border-primary" : "bg-surface-bright text-secondary border-outline-variant hover:border-primary")">Moderado</a>
<a href="@Url.Action("Catalog", "Tour", new { q = ViewBag.CurrentQ, categoryId = ViewBag.CurrentCategoryId, difficulty = "Exigente", date = ViewBag.CurrentDate, shift = ViewBag.CurrentShift, sortBy = ViewBag.CurrentSortBy })" class="px-2.5 py-1 text-xs rounded-md border transition-colors @(ViewBag.CurrentDifficulty == "Exigente" ? "bg-primary text-on-primary font-bold border-primary" : "bg-surface-bright text-secondary border-outline-variant hover:border-primary")">Exigente</a>
</div>
</div>
<!-- Garantías Chilón -->
<div class="pt-4 border-t border-outline-variant/60 bg-surface-bright/60 -mx-5 -mb-5 p-5 rounded-b-2xl">
<h2 class="text-label-sm font-label-sm font-bold text-on-surface mb-2 flex items-center gap-1.5">
<span class="material-symbols-outlined text-[16px] text-primary">shield</span>
                Garantías de Viaje Chilón
              </h2>
<div class="space-y-1.5 text-body-sm">
<label class="flex items-center gap-2 cursor-pointer">
<input checked="" class="rounded text-primary focus:ring-primary border-outline-variant" disabled="" type="checkbox">
<span class="text-xs">Salida Diaria Garantizada</span>
</label>
<label class="flex items-center gap-2 cursor-pointer">
<input checked="" class="rounded text-primary focus:ring-primary border-outline-variant" disabled="" type="checkbox">
<span class="text-xs">Recojo en Hotel Céntrico</span>
</label>

</div>
</div>
</div>
</aside>
<!-- RIGHT COLUMN: Tours Grid & Results Header -->
<section class="lg:col-span-8 xl:col-span-9 space-y-6">
<!-- Results Top Bar -->
<div class="bg-surface-container-lowest rounded-xl p-4 border border-outline-variant flex flex-col sm:flex-row items-center justify-between gap-4 shadow-sm">
<div class="flex items-center gap-2">
<span class="w-2.5 h-2.5 rounded-full bg-primary animate-pulse"></span>
<p class="text-body-md font-body-md text-on-surface">
    Mostrando <strong class="font-bold text-primary">@Model.Count() circuitos disponibles</strong>@(string.IsNullOrEmpty(ViewBag.CurrentQ) ? "" : $" para \"{ViewBag.CurrentQ}\"") en Cajamarca
</p>
</div>
<div class="flex items-center gap-3 w-full sm:w-auto justify-end">
<label class="text-label-sm font-label-sm text-secondary whitespace-nowrap">Ordenar por:</label>
<select onchange="window.location.href=this.value" class="py-1.5 px-3 bg-surface-bright border border-outline-variant rounded-lg text-body-sm text-on-surface focus:border-primary focus:ring-1 focus:ring-primary outline-none">
<option value="@Url.Action("Catalog", "Tour", new { q = ViewBag.CurrentQ, categoryId = ViewBag.CurrentCategoryId, date = ViewBag.CurrentDate, shift = ViewBag.CurrentShift, modality = ViewBag.CurrentModality, difficulty = ViewBag.CurrentDifficulty, maxPrice = ViewBag.CurrentMaxPrice, sortBy = "" })" selected="@(string.IsNullOrEmpty(ViewBag.CurrentSortBy))">Más populares y recomendados</option>
<option value="@Url.Action("Catalog", "Tour", new { q = ViewBag.CurrentQ, categoryId = ViewBag.CurrentCategoryId, date = ViewBag.CurrentDate, shift = ViewBag.CurrentShift, modality = ViewBag.CurrentModality, difficulty = ViewBag.CurrentDifficulty, maxPrice = ViewBag.CurrentMaxPrice, sortBy = "price-asc" })" selected="@(ViewBag.CurrentSortBy == "price-asc")">Precio: menor a mayor</option>
<option value="@Url.Action("Catalog", "Tour", new { q = ViewBag.CurrentQ, categoryId = ViewBag.CurrentCategoryId, date = ViewBag.CurrentDate, shift = ViewBag.CurrentShift, modality = ViewBag.CurrentModality, difficulty = ViewBag.CurrentDifficulty, maxPrice = ViewBag.CurrentMaxPrice, sortBy = "price-desc" })" selected="@(ViewBag.CurrentSortBy == "price-desc")">Precio: mayor a menor</option>
<option value="@Url.Action("Catalog", "Tour", new { q = ViewBag.CurrentQ, categoryId = ViewBag.CurrentCategoryId, date = ViewBag.CurrentDate, shift = ViewBag.CurrentShift, modality = ViewBag.CurrentModality, difficulty = ViewBag.CurrentDifficulty, maxPrice = ViewBag.CurrentMaxPrice, sortBy = "title" })" selected="@(ViewBag.CurrentSortBy == "title")">Alfabético (A - Z)</option>
</select>
</div>
</div>
<!-- GRID OF TOUR CARDS -->
@if (Model != null && Model.Any())
{
<div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-2 gap-6">
    @foreach (var tour in Model)
    {
        <article class="bg-surface-container-lowest rounded-2xl overflow-hidden border border-outline-variant hover:border-primary/50 shadow-sm hover:shadow-lg transition-all duration-300 flex flex-col group">
            <div class="relative h-52 w-full overflow-hidden bg-surface-dim">
                @if (tour.Images != null && tour.Images.Any())
                {
                    var mainImage = tour.Images.FirstOrDefault(i => i.IsMain) ?? tour.Images.First();
                    <img class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" src="@mainImage.ImageUrl" alt="@tour.Title">
                }
                else
                {
                    <div class="w-full h-full flex items-center justify-center bg-surface-variant text-on-surface-variant">
                        <span class="font-semibold">Sin imágenes referenciales</span>
                    </div>
                }
                <div class="absolute inset-0 bg-gradient-to-t from-inverse-surface/80 via-transparent to-black/20"></div>
                <div class="absolute top-3 left-3 flex flex-wrap gap-1.5">
                    <span class="bg-surface-container-lowest/90 backdrop-blur text-primary text-[11px] font-bold px-2 py-1 rounded-md shadow-sm">Acreditado DIRCETUR</span>
                </div>
            </div>
            <div class="p-5 flex-1 flex flex-col justify-between">
                <div>
                    <div class="flex items-center justify-between text-xs text-secondary mb-2">
                        <span class="flex items-center gap-1 font-semibold text-primary">
                            <span class="material-symbols-outlined text-[16px]">@(tour.Category?.Icon ?? "explore")</span> @(tour.Category?.Name ?? "Circuito")
                        </span>
                        <span class="flex items-center gap-1">
                            <span class="material-symbols-outlined text-[16px]">schedule</span> @tour.Duration
                        </span>
                    </div>
                    <h3 class="text-headline-sm font-headline-sm text-inverse-surface group-hover:text-primary transition-colors font-bold mb-2">
                        @tour.Title
                    </h3>
                    <p class="text-body-sm font-body-sm text-on-surface-variant line-clamp-2 mb-4">
                        @tour.Subtitle
                    </p>
                </div>
                <div class="pt-4 border-t border-outline-variant/60 flex items-center justify-between">
                    <div>
                        <span class="text-[11px] uppercase tracking-wider text-secondary block">Precio por pasajero</span>
                        <div class="flex items-baseline gap-1">
                            <span class="text-headline-md font-headline-md font-extrabold text-tertiary">S/ @tour.BasePrice.ToString("0.00")</span>
                            <span class="text-xs text-outline">PEN</span>
                        </div>
                    </div>
                    <div class="flex items-center gap-2">
                        <a href="/Tour/Details/@tour.Slug" class="p-2 border border-outline-variant hover:border-primary text-secondary hover:text-primary rounded-lg text-xs font-bold transition-all" title="Ver Itinerario Completo">
                            <span class="material-symbols-outlined text-[20px]">description</span>
                        </a>
                        <a href="/Booking/Checkout?tourId=@tour.Id" class="px-4 py-2.5 bg-primary hover:bg-primary-container text-on-primary rounded-lg font-label-md font-bold text-xs uppercase tracking-wider flex items-center gap-1.5 shadow-sm active:scale-95 transition-all">
                            <span>Reservar</span>
                            <span class="material-symbols-outlined text-[16px]">arrow_forward</span>
                        </a>
                    </div>
                </div>
            </div>
        </article>
    }
</div>
}
else
{
    <div class="py-16 text-center bg-surface-container-lowest rounded-2xl border border-outline-variant p-8 shadow-sm">
        <span class="material-symbols-outlined text-5xl text-outline mb-3">search_off</span>
        <h3 class="text-title-md font-bold text-on-surface">No se encontraron circuitos para tu búsqueda</h3>
        <p class="text-body-md text-on-surface-variant mt-1">Prueba cambiando los términos o limpiando los filtros aplicados.</p>
        <a href="@Url.Action("Catalog", "Tour")" class="inline-flex items-center gap-2 mt-4 px-5 py-2.5 rounded-lg bg-primary text-on-primary font-bold shadow-sm hover:bg-primary/90 transition-all">
            <span class="material-symbols-outlined text-[18px]">refresh</span>
            <span>Ver todos los circuitos</span>
        </a>
    </div>
}
<!-- Bottom Notice for Travelers -->
<div class="p-4 rounded-xl bg-surface-container-high/40 border border-primary/20 flex items-center gap-3 text-secondary text-body-sm">
<span class="material-symbols-outlined text-primary text-[24px]">info</span>
<div>
<p class="font-medium text-on-surface">Todos los tours incluyen recojo gratuito en hoteles ubicados en el perímetro del Centro Histórico de Cajamarca.</p>
<p class="text-xs text-secondary">Para salidas desde zonas rurales o traslados al Aeropuerto de Cajamarca (CJA), consulta nuestras tarifas preferenciales.</p>
</div>
</div>
</section>
</div>
</div>
<!-- SECTION: ARMA TU TOUR PRIVADO O EXCLUSIVO -->
<section class="max-w-7xl mx-auto px-4 md:px-8 py-10">
<div class="relative rounded-3xl overflow-hidden bg-gradient-to-r from-inverse-surface via-primary to-primary-container p-8 md:p-12 text-on-primary shadow-xl">
<!-- Geometric Accent Shapes -->
<div class="absolute -right-16 -top-16 w-80 h-80 bg-surface-container-high/10 rounded-full blur-2xl pointer-events-none"></div>
<div class="absolute right-1/4 -bottom-20 w-64 h-64 bg-tertiary/20 rounded-full blur-xl pointer-events-none"></div>
<div class="relative z-10 grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
<div class="lg:col-span-8 space-y-4">
<span class="inline-flex items-center gap-1.5 px-3 py-1 bg-surface-container-lowest/20 backdrop-blur rounded-full text-xs font-bold tracking-wider uppercase text-inverse-on-surface">
<span class="material-symbols-outlined text-[16px] text-tertiary-fixed-dim">groups</span> Servicio Corporativo y Delegaciones
            </span>
<h2 class="text-headline-lg font-headline-lg font-bold text-white tracking-tight">
              ¿Viajas en Familia o Grupo? Arma tu Tour 100% Privado
            </h2>
<p class="text-body-lg font-body-lg text-surface-container-lowest/90 max-w-2xl leading-relaxed">Disfruta de vans exclusivas puerta a puerta, horarios personalizados a tu ritmo, traslados directos y traslados cómodos hacia el Aeropuerto Mayor General FAP Armando Revoredo Iglesias.</p>
<div class="flex flex-wrap gap-4 pt-2">
<div class="flex items-center gap-2 text-sm text-surface-bright">
<span class="material-symbols-outlined text-tertiary-fixed text-[20px]">check_circle</span> Vans de 11 a 19 pasajeros
              </div>
<div class="flex items-center gap-2 text-sm text-surface-bright">
<span class="material-symbols-outlined text-tertiary-fixed text-[20px]">check_circle</span> Factura Comercial &amp; Convenios
              </div>
<div class="flex items-center gap-2 text-sm text-surface-bright">
