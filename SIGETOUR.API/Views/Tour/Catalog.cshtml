<script>
let catalogCurrentRequestId = 0;

function loadCatalogAjax(url, push = true) {
    const reqId = ++catalogCurrentRequestId;
    const resultsContainer = document.getElementById('catalog-results-section');
    const loadingBadge = document.getElementById('catalog-loading-badge');
    const drawer = document.getElementById('catalog-filters-drawer');

    if (resultsContainer) {
        resultsContainer.classList.add('opacity-40', 'transition-opacity', 'duration-200', 'pointer-events-none');
    }
    if (loadingBadge) {
        loadingBadge.classList.remove('hidden');
    }

    fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
        .then(response => {
            if (!response.ok) throw new Error('Error al conectar con el servidor: ' + response.status);
            return response.text();
        })
        .then(html => {
            if (reqId !== catalogCurrentRequestId) return; // Ignore stale request

            const parser = new DOMParser();
            const doc = parser.parseFromString(html, 'text/html');

            // 1. Update results section (cards + top bar)
            const newResults = doc.getElementById('catalog-results-section');
            if (newResults && resultsContainer) {
                resultsContainer.innerHTML = newResults.innerHTML;
            }

            // 2. Update sidebar filters (categories, duration, checkboxes, difficulty)
            const newDrawer = doc.getElementById('catalog-filters-drawer');
            if (newDrawer && drawer) {
                drawer.innerHTML = newDrawer.innerHTML;
            }

            // 3. Update mobile toggle count
            const newMobileCount = doc.getElementById('mobile-filter-count');
            const curMobileCount = document.getElementById('mobile-filter-count');
            if (newMobileCount && curMobileCount) {
                curMobileCount.innerHTML = newMobileCount.innerHTML;
            }

            // 4. Update top search form hidden inputs and values
            const newSearchForm = doc.getElementById('catalog-search-form');
            const curSearchForm = document.getElementById('catalog-search-form');
            if (newSearchForm && curSearchForm) {
                curSearchForm.innerHTML = newSearchForm.innerHTML;
            }

            // 5. Update browser history
            if (push && window.location.href !== url) {
                window.history.pushState({ catalogUrl: url }, '', url);
            }

            // 6. Re-init interactive slider
            initPriceSlider();

            // 7. Remove loading state
            if (resultsContainer) {
                resultsContainer.classList.remove('opacity-40', 'pointer-events-none');
            }

            // On mobile, if user changed a filter, scroll smoothly to the catalog start
            if (window.innerWidth < 1024) {
                const targetEl = document.getElementById('catalogo');
                if (targetEl) {
                    targetEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
                }
            }
        })
        .catch(err => {
            console.warn('Fallo AJAX parcial, redirigiendo normalmente:', err);
            window.location.href = url;
        });
}

function onCatalogShiftChange() {
    const manana = document.getElementById('catalog_shift_manana');
    const tarde = document.getElementById('catalog_shift_tarde');
    const isManana = manana ? manana.checked : false;
    const isTarde = tarde ? tarde.checked : false;

    let newShift = 'Todos';
    if (isManana && !isTarde) newShift = 'Mañana';
    else if (!isManana && isTarde) newShift = 'Tarde';
    else if (!isManana && !isTarde) newShift = 'Todos';

    const url = new URL(window.location.href);
    if (newShift === 'Todos') {
        url.searchParams.delete('shift');
    } else {
        url.searchParams.set('shift', newShift);
    }
    loadCatalogAjax(url.toString());
}

function resetPriceFilter() {
    const url = new URL(window.location.href);
    url.searchParams.delete('maxPrice');
    loadCatalogAjax(url.toString());
}

function initPriceSlider() {
    const slider = document.getElementById('priceRangeSlider');
    const priceLabel = document.getElementById('priceLabel');
    if (slider && priceLabel) {
        slider.oninput = function() {
            const val = parseInt(this.value);
            if (val >= 80) {
                priceLabel.textContent = 'Todos los Precios';
            } else {
                priceLabel.textContent = 'Hasta S/ ' + val;
            }
        };
        slider.onchange = function() {
            const val = parseInt(this.value);
            const url = new URL(window.location.href);
            if (val >= 80) {
                url.searchParams.delete('maxPrice');
            } else {
                url.searchParams.set('maxPrice', val);
            }
            loadCatalogAjax(url.toString());
        };
    }
}

document.addEventListener('DOMContentLoaded', function() {
    initPriceSlider();

    // Intercept clicks on any filter link inside sidebar drawer
    const drawer = document.getElementById('catalog-filters-drawer');
    if (drawer) {
        drawer.addEventListener('click', function(e) {
            const link = e.target.closest('a');
            if (link && link.href) {
                e.preventDefault();
                loadCatalogAjax(link.href);
            }
        });
    }

    // Intercept top hero search form submit
    const searchForm = document.getElementById('catalog-search-form');
    if (searchForm) {
        searchForm.addEventListener('submit', function(e) {
            e.preventDefault();
            const formData = new FormData(searchForm);
            const url = new URL(searchForm.action, window.location.origin);
            for (const [key, val] of formData.entries()) {
                const sVal = (val || '').toString().trim();
                if (sVal !== '' && sVal !== 'Todos' && sVal !== 'Cualquier Turno') {
                    url.searchParams.set(key, sVal);
                } else {
                    url.searchParams.delete(key);
                }
            }
            loadCatalogAjax(url.toString());
        });
    }

    // Intercept browser back / forward
    window.addEventListener('popstate', function(e) {
        loadCatalogAjax(window.location.href, false);
    });
});
</script>
