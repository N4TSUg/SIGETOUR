@model IEnumerable<SIGETOUR.API.Core.Entities.TourPackage>
@{ 
    Layout = "_Layout"; 
    var curCatId = ViewBag.CurrentCategoryId as Guid?;
    var curDuration = ViewBag.CurrentDuration as string;
    var curShift = ViewBag.CurrentShift as string;
    var curDifficulty = ViewBag.CurrentDifficulty as string;
    var curMaxPrice = ViewBag.CurrentMaxPrice as decimal?;
    var curSortBy = ViewBag.CurrentSortBy as string;
    var curQ = ViewBag.CurrentQ as string;
    var curDate = ViewBag.CurrentDate as string;
    var curModality = ViewBag.CurrentModality as string;

    var topFeatured = ViewBag.TopFeatured as SIGETOUR.API.Core.Entities.FeaturedPackage;
    var activeFeatured = ViewBag.ActiveFeatured as Dictionary<Guid, SIGETOUR.API.Core.Entities.FeaturedPackage>;

    var featuredTour = topFeatured?.TourPackage 
        ?? Model?.FirstOrDefault(t => t.Images != null && t.Images.Any(i => i.IsMain)) 
        ?? Model?.FirstOrDefault(t => t.Images != null && t.Images.Any())
        ?? Model?.FirstOrDefault();
    var featuredTourImg = featuredTour?.Images?.FirstOrDefault(i => i.IsMain)?.ImageUrl 
        ?? featuredTour?.Images?.FirstOrDefault()?.ImageUrl
        ?? "/images/tours/0fca1e9d-4750-4257-b311-1846dec19498_1787801341422.jpg";

    var heroFp = topFeatured ?? ((featuredTour != null && activeFeatured != null && activeFeatured.TryGetValue(featuredTour.Id, out var hFp)) ? hFp : null);
    var featuredTourTitle = !string.IsNullOrWhiteSpace(heroFp?.CommercialTitle) ? heroFp.CommercialTitle : (featuredTour?.Title ?? "Cumbemayo & Bosque de Piedras");
    var featuredTourBadge = !string.IsNullOrWhiteSpace(heroFp?.PromoBadge) && heroFp.PromoBadge != "none" ? heroFp.PromoBadge : "Circuito Recomendado";
    var featuredTourCategory = featuredTour?.Category?.Name ?? "Arqueología y Naturaleza";

    var heroEffectivePrice = (heroFp != null && heroFp.PromoPrice.HasValue) ? heroFp.PromoPrice.Value : (featuredTour?.BasePrice ?? 40.00m);
    var hasHeroPromo = heroFp != null && heroFp.PromoPrice.HasValue && heroFp.PromoPrice.Value < (featuredTour?.BasePrice ?? 0);
    var featuredTourPrice = heroEffectivePrice.ToString("0.00");
    var featuredTourDuration = featuredTour?.Duration ?? "4 Horas (Medio Día)";
    var featuredTourSlug = featuredTour?.Slug ?? "cumbemayo-bosque-de-piedras";
    var totalTours = Model?.Count() ?? 0;
}
<main class="flex-1">
<!-- HERO SECTION: Destinos y Circuitos Turísticos -->
<section class="relative bg-gradient-to-b from-surface-container-low via-surface to-surface-bright py-12 md:py-16 border-b border-outline-variant/60">
<div class="max-w-7xl mx-auto px-4 md:px-8 relative z-10">
<!-- Breadcrumb & Badge -->
<div class="flex flex-wrap items-center gap-2 mb-4">
<span class="px-3 py-1 bg-surface-container text-primary text-label-sm font-label-sm rounded-full border border-primary/20 flex items-center gap-1">
<span class="material-symbols-outlined text-[14px]">explore</span> Catálogo Oficial 2026
</span>
<span class="text-outline text-xs">/</span>
<span class="text-secondary text-body-sm font-body-sm">Cajamarca, Perú</span>
<span class="text-outline text-xs">/</span>
<span class="text-on-surface font-semibold text-body-sm font-body-sm">Salidas Diarias Garantizadas</span>
</div>
<div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
  <!-- Left Column: Copy & Guarantees (7 cols) -->
  <div class="lg:col-span-7 space-y-4">
    <h1 class="text-headline-lg md:text-display-lg font-display-lg text-inverse-surface tracking-tight leading-tight">
      Explora los Mejores Destinos y Circuitos Turísticos de Cajamarca
    </h1>
    <p class="text-body-lg font-body-lg text-on-surface-variant max-w-2xl leading-relaxed">
      Viaja seguro con nuestra moderna flota de Mercedes-Benz Sprinter y Toyota HiAce, guías certificados y cobertura SOAT turística integral con asistencia permanente.
    </p>

    <!-- Trust Badges & Guarantees -->
    <div class="flex flex-wrap items-center gap-2.5 pt-1 text-xs font-semibold text-secondary">
      <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-surface-container-lowest border border-outline-variant/70 shadow-xs">
        <span class="material-symbols-outlined text-[17px] text-primary">verified_user</span> 100% Salidas Diarias
      </span>
      <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-surface-container-lowest border border-outline-variant/70 shadow-xs">
        <span class="material-symbols-outlined text-[17px] text-primary">badge</span> Guías Oficiales DIRCETUR
      </span>
      <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-surface-container-lowest border border-outline-variant/70 shadow-xs">
        <span class="material-symbols-outlined text-[17px] text-primary">hotel</span> Recojo en Hotel Céntrico
      </span>
      <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-surface-container-lowest border border-outline-variant/70 shadow-xs">
        <span class="material-symbols-outlined text-[17px] text-primary">directions_bus</span> Flota Sprinter Climatizada
      </span>
    </div>
  </div>

  <!-- Right Column: Tour Showcase Card Frame (5 cols) -->
  <div class="lg:col-span-5 relative flex justify-center lg:justify-end">
    <div class="relative w-full max-w-md lg:max-w-none group">
      <!-- Ambient Glow -->
      <div class="absolute -inset-1.5 bg-gradient-to-r from-primary/20 via-tertiary/20 to-secondary/20 rounded-3xl blur-xl opacity-70 group-hover:opacity-100 transition-opacity duration-500"></div>

      <!-- Tour Showcase Card Frame -->
      <a href="/Tour/Details/@featuredTourSlug" class="block relative rounded-2xl overflow-hidden border border-outline-variant/80 bg-surface-container-lowest shadow-xl hover:shadow-2xl hover:border-primary/50 transition-all duration-300">
        <div class="relative h-56 sm:h-64 lg:h-68 w-full overflow-hidden bg-surface-dim">
          <img class="w-full h-full object-cover object-center transform group-hover:scale-105 transition-transform duration-700" 
               src="@featuredTourImg" 
               alt="@featuredTourTitle" 
               loading="eager" />
          
          <!-- Gradient Vignette -->
          <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/25 to-transparent pointer-events-none"></div>

          <!-- Top Floating Badges -->
          <div class="absolute top-3 left-3 right-3 flex items-center justify-between pointer-events-none">
            <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full bg-white/95 backdrop-blur-md text-primary font-bold text-[11px] shadow-sm">
              <span class="material-symbols-outlined text-[14px] text-amber-500">star</span>
              <span>@featuredTourBadge</span>
            </span>
            <span class="px-2.5 py-1 rounded-lg bg-black/60 backdrop-blur-md text-white text-xs font-semibold border border-white/20 shadow-sm flex items-center gap-1 font-mono">
              <span class="material-symbols-outlined text-[14px] text-tertiary-fixed">schedule</span>
              <span>@featuredTourDuration</span>
            </span>
          </div>

          <!-- Bottom Tour Info Overlay -->
          <div class="absolute bottom-3 left-3 right-3 flex items-end justify-between text-white pointer-events-none">
            <div class="pr-2">
              <span class="text-[10px] uppercase tracking-wider text-primary-fixed block font-bold">
                @featuredTourCategory
              </span>
              <h3 class="text-sm sm:text-base font-extrabold text-white drop-shadow-sm leading-tight line-clamp-1">
                @featuredTourTitle
              </h3>
              <span class="inline-flex items-center gap-1 text-[11px] text-emerald-300 font-medium mt-0.5">
                <span class="material-symbols-outlined text-[13px]">check_circle</span> Salida diaria garantizada
              </span>
            </div>
            <div class="text-right shrink-0">
              @if (hasHeroPromo)
              {
                <span class="text-[9px] uppercase tracking-wider text-amber-300 block line-through">Antes S/ @(featuredTour?.BasePrice.ToString("0.00"))</span>
                <span class="text-base sm:text-lg font-extrabold text-amber-400 drop-shadow-sm">
                  S/ @featuredTourPrice
                </span>
              }
              else
              {
                <span class="text-[9px] uppercase tracking-wider text-white/70 block">Desde</span>
                <span class="text-base sm:text-lg font-extrabold text-tertiary-fixed drop-shadow-sm">
                  S/ @featuredTourPrice
                </span>
              }
            </div>
          </div>
        </div>
      </a>
    </div>
  </div>
</div>
<!-- FAST ROUTE SEARCH BAR -->
<div class="mt-8 bg-surface-container-lowest rounded-2xl p-4 md:p-5 shadow-lg border border-outline-variant/80">
<form id="catalog-search-form" method="get" action="@Url.Action("Catalog", "Tour")" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-12 gap-3 md:gap-4 items-center">
@if (curCatId.HasValue)
{
    <input type="hidden" name="categoryId" value="@curCatId" />
}
@if (!string.IsNullOrEmpty(curSortBy))
{
    <input type="hidden" name="sortBy" value="@curSortBy" />
}
@if (!string.IsNullOrEmpty(curDuration))
{
    <input type="hidden" name="duration" value="@curDuration" />
}
@if (!string.IsNullOrEmpty(curDifficulty))
{
    <input type="hidden" name="difficulty" value="@curDifficulty" />
}
@if (curMaxPrice.HasValue)
{
    <input type="hidden" name="maxPrice" value="@curMaxPrice" />
}
<!-- Search Destination -->
<div class="lg:col-span-4">
<label for="q" class="block text-label-sm font-label-sm text-secondary mb-1">Destino o Circuito</label>
<div class="relative flex items-center">
<span class="material-symbols-outlined absolute left-3 text-secondary text-[20px]">tour</span>
<input id="q" name="q" value="@curQ" class="w-full pl-10 pr-4 py-2.5 bg-surface-bright/50 border border-outline-variant rounded-lg text-body-md focus:border-primary focus:ring-2 focus:ring-primary/20 text-on-surface placeholder:text-outline outline-none" placeholder="Ej. Cumbemayo, Otuzco, Porcón..." type="text">
</div>
</div>
<!-- Date Selector -->
<div class="lg:col-span-3">
<label for="date" class="block text-label-sm font-label-sm text-secondary mb-1">Fecha del Tour</label>
<div class="relative flex items-center">
<span class="material-symbols-outlined absolute left-3 text-secondary text-[20px]">calendar_month</span>
<input id="date" name="date" class="w-full pl-10 pr-3 py-2.5 bg-surface-bright/50 border border-outline-variant rounded-lg text-body-md focus:border-primary focus:ring-2 focus:ring-primary/20 text-on-surface outline-none" type="date" min="@DateTime.Today.ToString("yyyy-MM-dd")" value="@(string.IsNullOrEmpty(curDate) ? DateTime.Today.ToString("yyyy-MM-dd") : curDate)">
</div>
</div>
<!-- Turno / Horario -->
<div class="lg:col-span-3">
<label for="shift" class="block text-label-sm font-label-sm text-secondary mb-1">Turno de Salida</label>
<div class="relative flex items-center">
<span class="material-symbols-outlined absolute left-3 text-secondary text-[20px]">schedule</span>
<select id="shift" name="shift" class="w-full pl-10 pr-8 py-2.5 bg-surface-bright/50 border border-outline-variant rounded-lg text-body-md focus:border-primary focus:ring-2 focus:ring-primary/20 text-on-surface outline-none appearance-none">
<option value="Todos" selected="@(curShift == "Todos" || string.IsNullOrEmpty(curShift))">Cualquier Turno</option>
<option value="Mañana" selected="@(curShift == "Mañana")">Mañana (09:00 AM - 09:30 AM)</option>
<option value="Tarde" selected="@(curShift == "Tarde")">Tarde (02:30 PM - 03:30 PM)</option>
</select>
<span class="material-symbols-outlined absolute right-3 pointer-events-none text-secondary text-[18px]">expand_more</span>
</div>
</div>
<!-- Submit Button -->
<div class="lg:col-span-2 pt-1 sm:pt-5 lg:pt-0">
<button class="w-full h-[42px] bg-primary hover:bg-primary-container text-on-primary font-label-lg font-bold rounded-lg shadow transition-all flex items-center justify-center gap-2 active:scale-95 cursor-pointer" type="submit">
<span class="material-symbols-outlined text-[20px]">search</span>
<span class="">Buscar</span>
</button>
</div>
</form>
</div>
</div>
</section>
<!-- CATALOG MAIN LAYOUT: Sticky Sidebar Filters + Tour Cards Grid -->
<div class="max-w-7xl mx-auto px-4 md:px-8 py-8 md:py-10" id="catalogo">
<!-- Mobile Filters Toggle Button -->
<div class="lg:hidden mb-4">
  <button type="button" onclick="const f = document.getElementById('catalog-filters-drawer'); f.classList.toggle('hidden'); const isH = f.classList.contains('hidden'); document.getElementById('filter-toggle-icon').textContent = isH ? 'expand_more' : 'expand_less';" class="w-full py-3 px-4 bg-surface-container-lowest border border-primary/30 rounded-xl shadow-xs text-primary font-bold text-sm flex items-center justify-between active:scale-[0.99] transition-all">
    <span class="flex items-center gap-2">
      <span class="material-symbols-outlined text-lg">tune</span>
      <span id="mobile-filter-count">Filtrar Circuitos (@totalTours tours)</span>
    </span>
    <span class="material-symbols-outlined text-lg" id="filter-toggle-icon">expand_more</span>
  </button>
</div>
<div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
<!-- LEFT COLUMN: Advanced Filters Sidebar -->
<aside id="catalog-filters-drawer" class="hidden lg:block lg:col-span-4 xl:col-span-3 sticky top-24 bg-surface-container-lowest rounded-2xl p-5 border border-outline-variant shadow-sm mb-6 lg:mb-0">
<div class="flex items-center justify-between pb-4 border-b border-outline-variant/60">
<div class="flex items-center gap-2 text-inverse-surface font-title-sm">
<span class="material-symbols-outlined text-primary text-[22px]">tune</span>
<span class="font-bold">Filtrar Circuitos</span>
</div>
<a href="@Url.Action("Catalog", "Tour")" class="text-label-sm text-tertiary hover:underline font-semibold cursor-pointer">
  Limpiar Filtros
</a>
</div>
<div class="space-y-6 pt-5">
<!-- Category Filter -->
<div>
<h2 class="text-label-md font-label-md uppercase tracking-wider text-secondary mb-3 flex items-center justify-between">
<span>Categoría</span>
<span class="text-[11px] text-outline font-normal">@totalTours tours</span>
</h2>
<div class="space-y-1.5 text-body-sm">
<a href="@Url.Action("Catalog", "Tour", new { q = curQ, date = curDate, shift = curShift, modality = curModality, difficulty = curDifficulty, maxPrice = curMaxPrice, duration = curDuration, sortBy = curSortBy })" class="flex items-center justify-between cursor-pointer group p-1.5 rounded-lg hover:bg-surface-container-low transition-colors @(!curCatId.HasValue ? "font-bold text-primary bg-surface-container-low" : "text-on-surface")">
<div class="flex items-center gap-2">
<span class="w-2 h-2 rounded-full @(!curCatId.HasValue ? "bg-primary" : "bg-outline-variant")"></span>
<span class="group-hover:text-primary transition-colors font-medium">Todos los Circuitos</span>
</div>
<span class="text-xs bg-surface-container text-secondary px-2 py-0.5 rounded-full font-bold">@totalTours</span>
</a>
@if (ViewBag.Categories != null)
{
    foreach (var cat in (IEnumerable<SIGETOUR.API.Core.Entities.Category>)ViewBag.Categories)
    {
        var isSelected = curCatId == cat.Id;
        <a href="@Url.Action("Catalog", "Tour", new { q = curQ, categoryId = cat.Id, date = curDate, shift = curShift, modality = curModality, difficulty = curDifficulty, maxPrice = curMaxPrice, duration = curDuration, sortBy = curSortBy })" class="flex items-center justify-between cursor-pointer group p-1.5 rounded-lg hover:bg-surface-container-low transition-colors @(isSelected ? "font-bold text-primary bg-primary-container/20" : "text-on-surface-variant hover:text-primary")">
            <div class="flex items-center gap-2">
                <span class="material-symbols-outlined text-[16px] @(isSelected ? "text-primary" : "text-outline")">@(string.IsNullOrWhiteSpace(cat.Icon) ? "landscape" : cat.Icon)</span>
                <span>@cat.Name</span>
            </div>
            <span class="text-xs bg-surface-container-low text-secondary px-2 py-0.5 rounded-full">@cat.TourPackages.Count</span>
        </a>
    }
}
</div>
</div>
<!-- Duración del Recorrido -->
<div class="pt-4 border-t border-outline-variant/60">
<div class="flex items-center justify-between mb-3">
  <h2 class="text-label-md font-label-md uppercase tracking-wider text-secondary">Duración del Recorrido</h2>
  @if (!string.IsNullOrEmpty(curDuration) && curDuration != "Todos")
  {
    <a href="@Url.Action("Catalog", "Tour", new { q = curQ, categoryId = curCatId, date = curDate, shift = curShift, modality = curModality, difficulty = curDifficulty, maxPrice = curMaxPrice, duration = "", sortBy = curSortBy })" class="text-[11px] text-primary hover:underline font-semibold">Todas</a>
  }
</div>
<div class="grid grid-cols-2 gap-2 text-body-sm">
  <a href="@Url.Action("Catalog", "Tour", new { q = curQ, categoryId = curCatId, date = curDate, shift = curShift, modality = curModality, difficulty = curDifficulty, maxPrice = curMaxPrice, duration = (curDuration == "Medio Día" ? "" : "Medio Día"), sortBy = curSortBy })" class="px-3 py-2 border rounded-lg text-center text-xs transition-all flex flex-col items-center justify-center cursor-pointer @(curDuration == "Medio Día" ? "border-primary bg-primary text-white font-bold shadow-xs" : "border-outline-variant hover:border-primary text-secondary hover:text-primary bg-surface-container-lowest")">
    <span>Medio Día</span>
    <span class="block text-[10px] font-normal @(curDuration == "Medio Día" ? "text-white/80" : "text-secondary")">3 - 4.5 hrs</span>
  </a>
  <a href="@Url.Action("Catalog", "Tour", new { q = curQ, categoryId = curCatId, date = curDate, shift = curShift, modality = curModality, difficulty = curDifficulty, maxPrice = curMaxPrice, duration = (curDuration == "Día Completo" ? "" : "Día Completo"), sortBy = curSortBy })" class="px-3 py-2 border rounded-lg text-center text-xs transition-all flex flex-col items-center justify-center cursor-pointer @(curDuration == "Día Completo" ? "border-primary bg-primary text-white font-bold shadow-xs" : "border-outline-variant hover:border-primary text-secondary hover:text-primary bg-surface-container-lowest")">
    <span>Día Completo</span>
    <span class="block text-[10px] font-normal @(curDuration == "Día Completo" ? "text-white/80" : "text-outline")">6 - 8 hrs</span>
  </a>
</div>
</div>
<!-- Turno de Salida (Checkboxes Interactivos) -->
<div class="pt-4 border-t border-outline-variant/60">
<div class="flex items-center justify-between mb-2.5">
  <h2 class="text-label-md font-label-md uppercase tracking-wider text-secondary">Turno de Salida</h2>
  @if (!string.IsNullOrEmpty(curShift) && curShift != "Todos")
  {
    <a href="@Url.Action("Catalog", "Tour", new { q = curQ, categoryId = curCatId, date = curDate, shift = "", modality = curModality, difficulty = curDifficulty, maxPrice = curMaxPrice, duration = curDuration, sortBy = curSortBy })" class="text-[11px] text-primary hover:underline font-semibold">Cualquiera</a>
  }
</div>
<div class="space-y-2">
<label class="flex items-center gap-2 text-body-sm cursor-pointer select-none">
  <input id="catalog_shift_manana" type="checkbox" onchange="onCatalogShiftChange()" class="rounded text-primary focus:ring-primary border-outline-variant cursor-pointer" @(curShift == "Mañana" || string.IsNullOrEmpty(curShift) || curShift == "Todos" ? "checked" : "")>
  <span class="@(curShift == "Mañana" ? "font-bold text-primary" : "")">Mañana (9:00 AM / 9:30 AM)</span>
</label>
<label class="flex items-center gap-2 text-body-sm cursor-pointer select-none">
  <input id="catalog_shift_tarde" type="checkbox" onchange="onCatalogShiftChange()" class="rounded text-primary focus:ring-primary border-outline-variant cursor-pointer" @(curShift == "Tarde" || string.IsNullOrEmpty(curShift) || curShift == "Todos" ? "checked" : "")>
  <span class="@(curShift == "Tarde" ? "font-bold text-primary" : "")">Tarde (2:30 PM / 3:30 PM)</span>
</label>
</div>
</div>
<!-- Rango de Precios (Slider Interactivo) -->
<div class="pt-4 border-t border-outline-variant/60">
<div class="flex justify-between items-center mb-2">
<h2 class="text-label-md font-label-md uppercase tracking-wider text-secondary">Presupuesto Máximo</h2>
<span id="priceLabel" class="text-xs font-bold text-primary">@(curMaxPrice.HasValue && curMaxPrice.Value < 80 ? $"Hasta S/ {curMaxPrice.Value:F0}" : "Todos los Precios")</span>
</div>
<label for="priceRangeSlider" class="sr-only">Presupuesto por persona</label>
<input id="priceRangeSlider" class="w-full accent-primary h-2 bg-secondary-container rounded-lg cursor-pointer" max="80" min="25" step="5" type="range" value="@(curMaxPrice.HasValue && curMaxPrice.Value < 80 ? curMaxPrice.Value.ToString("F0") : "80")">
<div class="flex justify-between text-[11px] text-outline mt-1 font-medium">
<span>S/ 25 min</span>
@if (curMaxPrice.HasValue && curMaxPrice.Value < 80)
{
    <button type="button" onclick="resetPriceFilter()" class="text-primary hover:underline font-bold text-[11px] cursor-pointer">Ver todos</button>
}
<span>S/ 80+ max</span>
</div>
</div>
<!-- Exigencia Física -->
<div class="pt-4 border-t border-outline-variant/60">
<h2 class="text-label-md font-label-md uppercase tracking-wider text-secondary mb-2.5">Nivel de Exigencia</h2>
<div class="flex flex-wrap gap-1.5">
<a href="@Url.Action("Catalog", "Tour", new { q = curQ, categoryId = curCatId, difficulty = "Todos", date = curDate, shift = curShift, maxPrice = curMaxPrice, duration = curDuration, sortBy = curSortBy })" class="px-2.5 py-1 text-xs rounded-md border transition-colors @(string.IsNullOrEmpty(curDifficulty) || curDifficulty == "Todos" ? "bg-primary text-on-primary font-bold border-primary" : "bg-surface-bright text-secondary border-outline-variant hover:border-primary")">Todos</a>
<a href="@Url.Action("Catalog", "Tour", new { q = curQ, categoryId = curCatId, difficulty = "Ligero", date = curDate, shift = curShift, maxPrice = curMaxPrice, duration = curDuration, sortBy = curSortBy })" class="px-2.5 py-1 text-xs rounded-md border transition-colors @(curDifficulty == "Ligero" ? "bg-primary text-on-primary font-bold border-primary" : "bg-surface-bright text-secondary border-outline-variant hover:border-primary")">Ligero</a>
<a href="@Url.Action("Catalog", "Tour", new { q = curQ, categoryId = curCatId, difficulty = "Moderado", date = curDate, shift = curShift, maxPrice = curMaxPrice, duration = curDuration, sortBy = curSortBy })" class="px-2.5 py-1 text-xs rounded-md border transition-colors @(curDifficulty == "Moderado" ? "bg-primary text-on-primary font-bold border-primary" : "bg-surface-bright text-secondary border-outline-variant hover:border-primary")">Moderado</a>
<a href="@Url.Action("Catalog", "Tour", new { q = curQ, categoryId = curCatId, difficulty = "Exigente", date = curDate, shift = curShift, maxPrice = curMaxPrice, duration = curDuration, sortBy = curSortBy })" class="px-2.5 py-1 text-xs rounded-md border transition-colors @(curDifficulty == "Exigente" ? "bg-primary text-on-primary font-bold border-primary" : "bg-surface-bright text-secondary border-outline-variant hover:border-primary")">Exigente</a>
</div>
</div>
<!-- Garantías Chilón -->
<div class="pt-4 border-t border-outline-variant/60 bg-surface-bright/60 -mx-5 -mb-5 p-5 rounded-b-2xl">
<h2 class="text-label-sm font-label-sm font-bold text-on-surface mb-2 flex items-center gap-1.5">
<span class="material-symbols-outlined text-[16px] text-primary">shield</span>
Garantías de Viaje Chilón
</h2>
<div class="space-y-1.5 text-body-sm">
<label class="flex items-center gap-2 cursor-pointer">
