@model SIGETOUR.API.Core.Entities.TourPackage
@{ Layout = "_Layout"; }

<main class="max-w-7xl mx-auto px-4 md:px-8 py-6 space-y-8">
  <nav class="flex items-center text-label-md font-label-md text-secondary space-x-2 py-1">
    <a class="hover:text-primary transition-colors flex items-center gap-1" href="/Tour/Catalog">
      <span class="material-symbols-outlined text-[16px]">explore</span>
      <span>Catálogo Oficial</span>
    </a>
    <span class="material-symbols-outlined text-outline-variant text-[14px]">chevron_right</span>
    <span class="text-primary font-semibold">@Model.Title</span>
  </nav>

  <section class="space-y-2">
    <div class="flex flex-wrap items-center gap-2.5">
      <span class="px-3 py-1 bg-surface-container-highest text-primary font-label-sm rounded-full flex items-center gap-1 font-bold border border-primary/20">
        <span class="material-symbols-outlined text-[15px]" style="font-variation-settings: 'FILL' 1;">@(Model.Category?.Icon ?? "landscape")</span>
        @(Model.Category?.Name ?? "Circuito Turístico")
      </span>
    </div>
    <h1 class="text-3xl md:text-5xl font-bold text-on-surface tracking-tight leading-tight">
      @Model.Title
    </h1>
    <div class="flex items-center gap-1 text-body-md text-secondary">
      <span class="material-symbols-outlined text-primary text-[20px]">location_on</span>
      <span>Cajamarca, Perú</span>
    </div>
  </section>

@{
    var allImages = Model.Images?.OrderByDescending(i => i.IsMain).ToList() ?? new List<SIGETOUR.API.Core.Entities.TourImage>();
    var mainImage = allImages.FirstOrDefault(i => i.IsMain) ?? allImages.FirstOrDefault();
    var sideImages = allImages.Where(i => mainImage == null || i.Id != mainImage.Id).ToList();
}

@if (allImages.Count == 0)
{
    <section class="rounded-2xl overflow-hidden shadow-sm bg-surface-variant min-h-[220px] flex flex-col items-center justify-center text-on-surface-variant p-8 border border-outline-variant">
        <span class="material-symbols-outlined text-5xl mb-2 text-outline">landscape</span>
        <span class="text-title-md font-bold">Sin fotografías referenciales</span>
    </section>
}
else if (allImages.Count == 1)
{
    <section class="relative rounded-2xl overflow-hidden shadow-md group cursor-pointer h-[320px] sm:h-[420px] md:h-[480px] bg-black/5" 
             onclick="openLightbox(0)"
             onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();openLightbox(0);}"
             role="button"
             tabindex="0"
             aria-label="Ver imagen completa">
        <img class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" src="@mainImage!.ImageUrl" alt="@Model.Title" />
        <div class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity flex items-end p-4">
            <span class="text-white text-xs sm:text-sm font-bold flex items-center gap-1.5 bg-black/60 px-3.5 py-1.5 rounded-xl backdrop-blur-sm">
                <span class="material-symbols-outlined text-[18px]" aria-hidden="true">zoom_in</span> Ver imagen completa
            </span>
        </div>
    </section>
}
else
{
    <section class="relative rounded-2xl overflow-hidden shadow-md bg-surface-container-low border border-outline-variant/60">
        <!-- Desktop / Tablet Mosaic Grid (Visible on >= md) -->
        <div class="hidden md:grid @(allImages.Count == 2 ? "grid-cols-2" : (allImages.Count == 3 ? "grid-cols-3" : "grid-cols-4")) grid-rows-2 gap-2 sm:gap-2.5 h-[420px] lg:h-[480px]">
            <!-- Main Cover Photo -->
            <div class="@(allImages.Count == 2 ? "col-span-1 row-span-2" : "col-span-2 row-span-2") relative group overflow-hidden cursor-pointer" 
                 onclick="openLightbox(0)"
                 onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();openLightbox(0);}"
                 role="button"
                 tabindex="0"
                 aria-label="Ver Completa">
                <img class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" src="@mainImage!.ImageUrl" alt="@Model.Title" />
                <div class="absolute inset-0 bg-black/25 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center">
                    <span class="bg-black/60 text-white text-xs font-bold px-3 py-1.5 rounded-xl flex items-center gap-1.5 backdrop-blur-sm shadow-md">
                        <span class="material-symbols-outlined text-base" aria-hidden="true">zoom_in</span> Ver Completa
                    </span>
                </div>
            </div>

            @if (allImages.Count == 2)
            {
                <div class="col-span-1 row-span-2 relative group overflow-hidden cursor-pointer" 
                     onclick="openLightbox(1)"
                     onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();openLightbox(1);}"
                     role="button"
                     tabindex="0"
                     aria-label="Ver Completa">
                    <img class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" src="@sideImages[0].ImageUrl" alt="@Model.Title" />
                    <div class="absolute inset-0 bg-black/25 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center">
                        <span class="bg-black/60 text-white text-xs font-bold px-3 py-1.5 rounded-xl flex items-center gap-1.5 backdrop-blur-sm shadow-md">
                            <span class="material-symbols-outlined text-base" aria-hidden="true">zoom_in</span> Ver Completa
                        </span>
                    </div>
                </div>
            }
            else if (allImages.Count == 3)
            {
                <div class="col-span-1 row-span-1 relative group overflow-hidden cursor-pointer" 
                     onclick="openLightbox(1)"
                     onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();openLightbox(1);}"
                     role="button"
                     tabindex="0"
                     aria-label="Ver segunda imagen en pantalla completa">
                    <img class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" src="@sideImages[0].ImageUrl" alt="@Model.Title" />
                    <div class="absolute inset-0 bg-black/25 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center">
                        <span class="material-symbols-outlined text-white text-xl" aria-hidden="true">zoom_in</span>
                    </div>
                </div>
                <div class="col-span-1 row-span-1 relative group overflow-hidden cursor-pointer" 
                     onclick="openLightbox(2)"
                     onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();openLightbox(2);}"
                     role="button"
                     tabindex="0"
                     aria-label="Ver tercera imagen en pantalla completa">
                    <img class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" src="@sideImages[1].ImageUrl" alt="@Model.Title" />
                    <div class="absolute inset-0 bg-black/25 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center">
                        <span class="material-symbols-outlined text-white text-xl" aria-hidden="true">zoom_in</span>
                    </div>
                </div>
            }
            else if (allImages.Count == 4)
            {
                <div class="col-span-1 row-span-1 relative group overflow-hidden cursor-pointer" 
                     onclick="openLightbox(1)"
                     onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();openLightbox(1);}"
                     role="button"
                     tabindex="0"
                     aria-label="Ver segunda imagen en pantalla completa">
                    <img class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" src="@sideImages[0].ImageUrl" alt="@Model.Title" />
                    <div class="absolute inset-0 bg-black/25 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center">
                        <span class="material-symbols-outlined text-white text-xl" aria-hidden="true">zoom_in</span>
                    </div>
                </div>
                <div class="col-span-1 row-span-1 relative group overflow-hidden cursor-pointer" 
                     onclick="openLightbox(2)"
                     onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();openLightbox(2);}"
                     role="button"
                     tabindex="0"
                     aria-label="Ver tercera imagen en pantalla completa">
                    <img class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" src="@sideImages[1].ImageUrl" alt="@Model.Title" />
                    <div class="absolute inset-0 bg-black/25 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center">
                        <span class="material-symbols-outlined text-white text-xl" aria-hidden="true">zoom_in</span>
                    </div>
                </div>
                <div class="col-span-1 row-span-2 relative group overflow-hidden cursor-pointer" 
                     onclick="openLightbox(3)"
                     onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();openLightbox(3);}"
                     role="button"
                     tabindex="0"
                     aria-label="Ver cuarta imagen en pantalla completa">
                    <img class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" src="@sideImages[2].ImageUrl" alt="@Model.Title" />
                    <div class="absolute inset-0 bg-black/25 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center">
                        <span class="material-symbols-outlined text-white text-xl" aria-hidden="true">zoom_in</span>
                    </div>
                </div>
            }
            else
            {
                <!-- 5 o más fotos (Mosaico clásico de 5 slots con proporciones perfectas) -->
                <div class="col-span-1 row-span-1 relative group overflow-hidden cursor-pointer" 
                     onclick="openLightbox(1)"
                     onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();openLightbox(1);}"
                     role="button"
                     tabindex="0"
                     aria-label="Ver segunda imagen en pantalla completa">
                    <img class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" src="@sideImages[0].ImageUrl" alt="@Model.Title" />
                    <div class="absolute inset-0 bg-black/25 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center">
                        <span class="material-symbols-outlined text-white text-xl" aria-hidden="true">zoom_in</span>
                    </div>
                </div>
                <div class="col-span-1 row-span-1 relative group overflow-hidden cursor-pointer" 
                     onclick="openLightbox(2)"
                     onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();openLightbox(2);}"
                     role="button"
                     tabindex="0"
                     aria-label="Ver tercera imagen en pantalla completa">
                    <img class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" src="@sideImages[1].ImageUrl" alt="@Model.Title" />
                    <div class="absolute inset-0 bg-black/25 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center">
                        <span class="material-symbols-outlined text-white text-xl" aria-hidden="true">zoom_in</span>
                    </div>
                </div>
                <div class="col-span-1 row-span-1 relative group overflow-hidden cursor-pointer" 
                     onclick="openLightbox(3)"
                     onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();openLightbox(3);}"
                     role="button"
                     tabindex="0"
                     aria-label="Ver cuarta imagen en pantalla completa">
                    <img class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" src="@sideImages[2].ImageUrl" alt="@Model.Title" />
                    <div class="absolute inset-0 bg-black/25 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center">
                        <span class="material-symbols-outlined text-white text-xl" aria-hidden="true">zoom_in</span>
                    </div>
                </div>
                <div class="col-span-1 row-span-1 relative group overflow-hidden cursor-pointer" 
                     onclick="openLightbox(4)"
                     onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();openLightbox(4);}"
                     role="button"
                     tabindex="0"
                     >
                    <img class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" src="@sideImages[3].ImageUrl" alt="@Model.Title" />
                    @if (allImages.Count > 5)
                    {
                        <div class="absolute inset-0 bg-black/60 group-hover:bg-black/75 flex flex-col items-center justify-center text-white p-2 transition-all">
                            <span class="material-symbols-outlined text-2xl sm:text-3xl mb-0.5" aria-hidden="true">photo_library</span>
                            <span class="text-sm font-bold leading-tight">+@(allImages.Count - 4) fotos</span>
                            <span class="text-[10px] text-white/80">Ver galería</span>
                        </div>
                    }
                    else
                    {
                        <div class="absolute inset-0 bg-black/25 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center">
                            <span class="material-symbols-outlined text-white text-xl" aria-hidden="true">zoom_in</span>
                        </div>
                    }
                </div>
            }
        </div>

        <!-- Mobile View (Visible on < md) -->
        <div class="md:hidden flex flex-col gap-2 p-1.5">
            <div class="relative h-64 sm:h-72 w-full overflow-hidden rounded-xl cursor-pointer" 
                 onclick="openLightbox(0)"
                 onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();openLightbox(0);}"
                 role="button"
                 tabindex="0"
                 aria-label="Tocar para ampliar">
                <img class="w-full h-full object-cover" src="@mainImage!.ImageUrl" alt="@Model.Title" />
                <span class="absolute bottom-3 left-3 bg-black/60 text-white text-xs font-bold px-2.5 py-1 rounded-lg backdrop-blur-sm flex items-center gap-1">
                    <span class="material-symbols-outlined text-[15px]" aria-hidden="true">photo_camera</span> 1 / @allImages.Count
                </span>
                <span class="absolute bottom-3 right-3 bg-white/95 text-secondary text-xs font-bold px-2.5 py-1 rounded-lg shadow-sm flex items-center gap-1">
                    <span class="material-symbols-outlined text-[15px]" aria-hidden="true">zoom_in</span> Tocar para ampliar
                </span>
            </div>
            
            @if (allImages.Count > 1)
            {
                <div class="flex items-center gap-2 overflow-x-auto py-1 no-scrollbar">
                    @for (int idx = 0; idx < allImages.Count; idx++)
                    {
                        var thumb = allImages[idx];
                        <div onclick="openLightbox(@idx)" 
                             onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();openLightbox(@idx);}"
                             role="button"
                             tabindex="0"
                             aria-label="Ver miniatura @(idx + 1) en pantalla completa"
                             class="w-20 h-16 shrink-0 rounded-xl overflow-hidden border-2 @(idx == 0 ? "border-primary" : "border-transparent") relative cursor-pointer active:scale-95 transition-all shadow-xs">
                            <img src="@thumb.ImageUrl" class="w-full h-full object-cover" alt="Foto @(idx+1)" />
                        </div>
                    }
                </div>
            }
        </div>

        <!-- Floating Button "Ver todas las fotos" on Desktop -->
        @if (allImages.Count > 1)
        {
            <button type="button" onclick="openLightbox(0)" class="hidden md:flex absolute bottom-3.5 right-3.5 bg-white/95 hover:bg-white text-secondary font-bold text-xs sm:text-sm px-3.5 py-2 rounded-xl shadow-lg border border-outline-variant items-center gap-1.5 transition-all active:scale-95 z-20 backdrop-blur-sm cursor-pointer hover:shadow-xl hover:text-primary">
                <span class="material-symbols-outlined text-[18px] text-primary">photo_library</span>
                <span>Ver todas las fotos (@allImages.Count)</span>
            </button>
        }
    </section>
}

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
    <div class="lg:col-span-8 space-y-8">
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 bg-surface-container-lowest p-4 rounded-xl border border-outline-variant shadow-sm">
        <div class="flex items-center gap-3 p-2">
          <div class="w-10 h-10 rounded-lg bg-surface-variant flex items-center justify-center text-primary">
            <span class="material-symbols-outlined text-[24px]">schedule</span>
          </div>
          <div>
            <p class="text-label-sm text-secondary uppercase font-semibold">Duración</p>
            <p class="text-title-sm font-title-sm text-on-surface">@Model.Duration</p>
          </div>
        </div>
        <div class="flex items-center gap-3 p-2 border-t sm:border-t-0 sm:border-l border-outline-variant">
          <div class="w-10 h-10 rounded-lg bg-surface-variant flex items-center justify-center text-primary">
            <span class="material-symbols-outlined text-[24px]">hiking</span>
          </div>
          <div>
            <p class="text-label-sm text-secondary uppercase font-semibold">Exigencia</p>
            <p class="text-title-sm font-title-sm text-on-surface">@(Model.Difficulty switch {
    SIGETOUR.API.Core.Enums.TourDifficulty.Ligero => "Ligero",
    SIGETOUR.API.Core.Enums.TourDifficulty.Moderado => "Moderado",
    SIGETOUR.API.Core.Enums.TourDifficulty.Exigente => "Exigente",
    _ => "No especificado"
})</p>
          </div>
        </div>
      </div>

      <section class="bg-surface-container-lowest p-6 rounded-xl border border-outline-variant shadow-sm space-y-4">
        <div class="flex items-center gap-2 border-b border-outline-variant pb-3">
          <span class="material-symbols-outlined text-primary text-[24px]">description</span>
          <h2 class="text-headline-sm font-headline-sm text-primary">Resumen del Circuito Turístico</h2>
        </div>
        <p class="text-body-lg font-body-lg text-on-surface-variant leading-relaxed">
          @Model.Description
        </p>
      </section>

      @if (Model.ItineraryStops != null && Model.ItineraryStops.Any())
      {
          <section class="bg-surface-container-lowest p-6 rounded-xl border border-outline-variant shadow-sm space-y-6">
            <div class="flex items-center justify-between border-b border-outline-variant pb-3">
              <div class="flex items-center gap-2">
                <span class="material-symbols-outlined text-primary text-[24px]">route</span>
                <h2 class="text-headline-sm font-headline-sm text-primary">Itinerario Paso a Paso</h2>
              </div>
            </div>
            <div class="relative pl-6 sm:pl-8 space-y-8 before:absolute before:left-[11px] sm:before:left-[15px] before:top-3 before:bottom-3 before:w-0.5 before:bg-outline-variant">
                @{ int step = 1; }
                @foreach (var stop in Model.ItineraryStops.OrderBy(s => s.OrderIndex))
                {
                    <div class="relative flex items-start gap-4">
                      <div class="absolute -left-[23px] sm:-left-[31px] top-0 w-8 h-8 rounded-full bg-primary text-on-primary flex items-center justify-center font-bold text-label-sm ring-4 ring-surface-container-lowest shadow-sm">
                        @step
                      </div>
                      <div class="bg-surface-container-low p-4 rounded-lg w-full border border-outline-variant">
                        <div class="flex flex-wrap items-center justify-between gap-2">
                          <span class="text-label-md font-label-md text-primary font-bold">@(stop.EstimatedTime ?? "Hora por definir")</span>
                        </div>
                        <h3 class="text-title-sm font-title-sm text-on-surface mt-1">@stop.Name</h3>
                        <p class="text-body-md text-on-surface-variant mt-1">
                          
                        </p>
                      </div>
                    </div>
                    step++;
                }
            </div>
          </section>
      }

      <section class="grid grid-cols-1 gap-4">
        <div class="bg-surface-container-lowest p-6 rounded-xl border border-outline-variant shadow-sm space-y-4">
          <div class="flex items-center gap-2 text-primary border-b border-outline-variant pb-3">
            <span class="material-symbols-outlined text-[24px]">check_circle</span>
            <h2 class="text-title-md font-title-md font-bold">Qué Incluye</h2>
          </div>
          <ul class="space-y-3 text-body-sm text-on-surface">
            @if (Model.Inclusions != null)
            {
                foreach (var inc in Model.Inclusions)
                {
                    <li class="flex items-start gap-2">
                      <span class="material-symbols-outlined text-primary text-[18px]">check</span>
                      @inc.Description
                    </li>
                }
            }
          </ul>
        </div>
      </section>

      <!-- SECCIÓN: Opiniones y Comentarios de Viajeros (Sin estrellas) -->
      <section class="bg-surface-container-lowest p-6 rounded-xl border border-outline-variant shadow-sm space-y-6">
        <div class="flex items-center justify-between border-b border-outline-variant pb-3">
          <div class="flex items-center gap-2 text-secondary">
            <span class="material-symbols-outlined text-[24px] text-primary">chat</span>
            <h2 class="text-title-md font-title-md font-bold">Experiencias y Comentarios de Viajeros</h2>
          </div>
          <span class="text-xs text-on-surface-variant font-medium">Turismo Chilón S.A.C.</span>
        </div>

        @if (TempData["SuccessMessage"] != null)
        {
          <div class="p-3.5 rounded-lg bg-emerald-50 border border-emerald-200 text-emerald-800 text-body-sm flex items-center gap-2">
            <span class="material-symbols-outlined text-emerald-600">check_circle</span>
            <span>@TempData["SuccessMessage"]</span>
          </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
          <div class="p-3.5 rounded-lg bg-red-50 border border-red-200 text-red-800 text-body-sm flex items-center gap-2">
            <span class="material-symbols-outlined text-red-600">error</span>
            <span>@TempData["ErrorMessage"]</span>
          </div>
        }

        @{
          var reviews = ViewBag.Reviews as IEnumerable<SIGETOUR.API.Core.Entities.TourReview>;
        }

        @if (reviews != null && reviews.Any())
        {
          <div class="space-y-4">
            @foreach (var rev in reviews)
            {
              var initials = string.Join("", rev.AuthorName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(w => w[0])).ToUpper();
              if (string.IsNullOrEmpty(initials)) initials = "TC";
              <div class="p-4 rounded-xl bg-surface-container-low border border-outline-variant/60 flex items-start gap-3.5">
                <div class="w-10 h-10 rounded-full bg-secondary text-white flex items-center justify-center font-bold text-sm shrink-0">
                  @initials
                </div>
                <div class="flex-grow space-y-1">
                  <div class="flex items-center justify-between flex-wrap gap-1">
                    <h4 class="text-label-lg font-bold text-secondary">@rev.AuthorName</h4>
                    <span class="text-[11px] text-outline font-medium">@rev.CreatedAt.ToString("dd MMM yyyy")</span>
                  </div>
                  @if (!string.IsNullOrWhiteSpace(rev.AuthorCity))
                  {
                    <p class="text-[11px] text-primary font-semibold">@rev.AuthorCity</p>
                  }
                  <p class="text-body-sm text-on-surface-variant pt-1 leading-relaxed">
                    "@rev.Comment"
                  </p>
                </div>
              </div>
            }
          </div>
        }
        else
        {
          <p class="text-body-sm text-outline italic">Aún no hay comentarios publicados para este tour. ¡Sé el primero en compartir tu experiencia!</p>
        }

        <!-- Formulario para dejar comentario (Público, sin autenticación) -->
        <div class="mt-6 pt-6 border-t border-outline-variant space-y-4">
          <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2">
            <h3 class="text-title-sm font-bold text-secondary flex items-center gap-1.5">
              <span class="material-symbols-outlined text-primary text-[20px]">rate_review</span>
              ¿Viajaste en este tour? Comparte tu experiencia
            </h3>
            <span class="text-xs text-on-surface-variant flex items-center gap-1 bg-surface-container-low px-2.5 py-1 rounded-full border border-outline-variant/60">
              <span class="material-symbols-outlined text-[15px] text-primary">public</span>
              Público y libre (no requiere registro ni inicio de sesión)
            </span>
          </div>

          <form asp-controller="Tour" asp-action="SubmitReview" method="post" class="space-y-3">
            @Html.AntiForgeryToken()
            <input type="hidden" name="tourId" value="@Model.Id" />
            <div>
              <label for="authorName" class="block text-label-sm font-bold text-on-surface-variant mb-1">Tu Nombre <span class="text-red-500">*</span></label>
              <input id="authorName" type="text" name="authorName" required placeholder="Ingresa tu nombre o cómo te gustaría figurar" class="w-full px-3.5 py-2.5 text-body-sm bg-surface border border-outline-variant rounded-lg text-on-surface focus:border-primary outline-none transition-colors" />
            </div>
            <div>
              <label for="comment" class="block text-label-sm font-bold text-on-surface-variant mb-1">Descripción de tu experiencia <span class="text-red-500">*</span></label>
              <textarea id="comment" name="comment" required rows="3" placeholder="Describe cómo estuvo el recorrido, los paisajes, el transporte, la puntualidad o la atención del guía..." class="w-full px-3.5 py-2.5 text-body-sm bg-surface border border-outline-variant rounded-lg text-on-surface focus:border-primary outline-none transition-colors"></textarea>
            </div>
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 pt-1">
              <span class="text-[11px] text-outline">Tu testimonio será visible en este circuito tras una breve validación de nuestro equipo.</span>
              <button type="submit" class="px-5 py-2.5 rounded-lg bg-primary hover:bg-primary/90 text-white font-bold text-label-md flex items-center justify-center gap-2 shadow-xs transition-colors cursor-pointer shrink-0">
                <span class="material-symbols-outlined text-sm">send</span>
                <span>Publicar Reseña</span>
              </button>
            </div>
          </form>
        </div>
      </section>
    </div> <!-- END LEFT COLUMN -->
    <!-- RIGHT COLUMN: STICKY BOOKING PANEL (4 Cols) -->
    <aside class="lg:col-span-4 sticky top-24">
      <div class="bg-surface-container-lowest rounded-2xl p-6 border border-primary/20 shadow-lg relative overflow-hidden">
        <div class="absolute top-0 right-0 p-3">
          <span class="material-symbols-outlined text-[48px] text-primary/10" style="font-variation-settings: 'FILL' 1;">tour</span>
        </div>
        <div class="relative z-10 space-y-6">
          <div class="border-b border-outline-variant/60 pb-5">
            @{
                decimal? promoPrice = ViewBag.PromoPrice as decimal?;
                string? promoBadge = ViewBag.PromoBadge as string;
            }
            @if (promoPrice.HasValue)
            {
                <div class="flex items-center gap-2 mb-2">
                    <span class="px-2.5 py-1 rounded-full text-xs font-extrabold bg-amber-100 text-amber-900 border border-amber-300 flex items-center gap-1 shadow-2xs">
                        <span class="material-symbols-outlined text-[15px]">local_offer</span>
                        <span>@(string.IsNullOrEmpty(promoBadge) ? "¡Oferta de Portada!" : promoBadge)</span>
                    </span>
                </div>
                <p class="text-label-sm font-label-sm text-secondary uppercase tracking-wider font-semibold mb-1">Precio Promocional en Portada</p>
                <div class="flex items-baseline gap-2 text-primary">
                    <span class="text-label-lg font-bold pb-1">S/</span>
                    <span class="text-display-lg font-display-lg leading-none font-black text-primary">@promoPrice.Value.ToString("0.00")</span>
                    <span class="text-body-md text-on-surface-variant line-through ml-2">Antes S/ @Model.BasePrice.ToString("0.00")</span>
                </div>
            }
            else
            {
                <p class="text-label-sm font-label-sm text-secondary uppercase tracking-wider font-semibold mb-1">Precio Oficial de Mostrador</p>
                <div class="flex items-end gap-2 text-primary">
                    <span class="text-label-lg font-bold pb-1">S/</span>
                    <span class="text-display-lg font-display-lg leading-none">@Model.BasePrice.ToString("0.00")</span>
                </div>
            }
            <p class="text-xs text-outline font-medium mt-1">Por persona (No incluye IGV si requiere factura)</p>
          </div>
          <a asp-controller="Booking" asp-action="Checkout" asp-route-tourId="@Model.Id" class="w-full flex justify-center items-center gap-2 px-6 py-4 rounded-xl bg-primary hover:bg-primary-container text-on-primary font-label-lg text-label-lg uppercase tracking-wider shadow-md active:scale-95 transition-all">
            <span class="material-symbols-outlined text-[20px]">how_to_reg</span>
            <span>Reservar Ahora</span>
          </a>
        </div>
      </div>
    </aside>
  </div>

  <!-- MOBILE STICKY BOOKING BAR (Activo únicamente en celulares) -->
  <div class="lg:hidden fixed bottom-0 left-0 right-0 z-40 bg-white/95 backdrop-blur-md border-t border-outline-variant p-3 px-4 flex items-center justify-between shadow-2xl">
    <div>
      <span class="text-[10px] text-secondary font-bold uppercase tracking-wider block">Tarifa por Pasajero</span>
      <div class="flex items-baseline gap-1">
        <span class="text-xs font-bold text-primary">S/</span>
        <span class="text-xl font-black text-primary">@((ViewBag.PromoPrice as decimal?)?.ToString("0.00") ?? Model.BasePrice.ToString("0.00"))</span>
        @if (ViewBag.PromoPrice != null)
        {
          <span class="text-xs text-outline line-through">S/ @Model.BasePrice.ToString("0.00")</span>
        }
      </div>
    </div>
    <a asp-controller="Booking" asp-action="Checkout" asp-route-tourId="@Model.Id" class="px-5 py-2.5 rounded-xl bg-primary hover:bg-primary-container text-white font-bold text-xs uppercase tracking-wider flex items-center gap-1.5 shadow-md active:scale-95 transition-all">
      <span class="material-symbols-outlined text-[18px]">how_to_reg</span>
      <span>Reservar</span>
    </a>
  </div>

  <!-- LIGHTBOX MODAL (VISOR DE FOTOS EN PANTALLA COMPLETA) -->
  <div id="tour-lightbox-modal" class="fixed inset-0 z-[120] bg-black/95 backdrop-blur-md hidden flex flex-col justify-between p-3 sm:p-5 select-none transition-all duration-300">
    <!-- Top Bar -->
    <div class="flex items-center justify-between text-white pb-3 border-b border-white/10 z-20">
      <div class="flex items-center gap-2.5">
        <div class="w-8 h-8 rounded-lg bg-primary/20 text-primary flex items-center justify-center">
          <span class="material-symbols-outlined text-[20px]">photo_camera</span>
        </div>
        <div>
          <h3 class="text-sm sm:text-base font-bold text-white truncate max-w-[200px] sm:max-w-md">@Model.Title</h3>
          <span class="text-[11px] text-white/60">Galería fotográfica oficial</span>
        </div>
      </div>
      <div class="flex items-center gap-3">
        <span id="lightbox-counter" class="text-xs sm:text-sm font-semibold text-white/80 bg-white/10 px-3 py-1 rounded-full border border-white/10">Foto 1 de @allImages.Count</span>
        <button type="button" onclick="closeLightbox()" class="w-9 h-9 rounded-full bg-white/10 hover:bg-white/20 text-white flex items-center justify-center transition-all cursor-pointer" title="Cerrar (Esc)">
          <span class="material-symbols-outlined text-2xl">close</span>
        </button>
      </div>
    </div>

    <!-- Center Image Viewing Area -->
    <div class="relative flex-1 flex items-center justify-center my-auto overflow-hidden py-3" 
         onclick="onLightboxBackdropClick(event)"
         onkeydown="if(event.key==='Escape'){event.preventDefault();closeLightbox();}"
         role="presentation">
      <!-- Prev Button -->
      <button type="button" onclick="prevLightboxImage(event)" class="absolute left-2 sm:left-6 z-20 w-11 h-11 sm:w-14 sm:h-14 rounded-full bg-black/60 hover:bg-black/90 text-white border border-white/20 flex items-center justify-center transition-all active:scale-90 cursor-pointer shadow-xl backdrop-blur-sm" title="Foto anterior (Flecha Izquierda)">
        <span class="material-symbols-outlined text-2xl sm:text-3xl">chevron_left</span>
      </button>

      <!-- Main Active Full Image -->
      <img id="lightbox-main-img" src="" alt="@Model.Title" class="max-h-[68vh] sm:max-h-[74vh] max-w-[90vw] object-contain rounded-xl shadow-2xl transition-all duration-200" />

      <!-- Next Button -->
      <button type="button" onclick="nextLightboxImage(event)" class="absolute right-2 sm:right-6 z-20 w-11 h-11 sm:w-14 sm:h-14 rounded-full bg-black/60 hover:bg-black/90 text-white border border-white/20 flex items-center justify-center transition-all active:scale-90 cursor-pointer shadow-xl backdrop-blur-sm" title="Siguiente foto (Flecha Derecha)">
        <span class="material-symbols-outlined text-2xl sm:text-3xl">chevron_right</span>
      </button>
    </div>

    <!-- Bottom Thumbnails Strip -->
    <div class="pt-3 border-t border-white/10 flex items-center justify-center gap-2 overflow-x-auto max-w-4xl mx-auto px-2 py-1 no-scrollbar z-20" id="lightbox-thumbnails">
      @for (int idx = 0; idx < allImages.Count; idx++)
      {
        var thumb = allImages[idx];
        <button type="button" onclick="setLightboxIndex(@idx)" class="lightbox-thumb-btn w-14 h-11 sm:w-16 sm:h-12 shrink-0 rounded-lg overflow-hidden border-2 transition-all opacity-60 hover:opacity-100 cursor-pointer" data-thumb-index="@idx">
          <img src="@thumb.ImageUrl" class="w-full h-full object-cover" alt="Miniatura @(idx+1)" />
        </button>
      }
    </div>
  </div>

  <script>
    const lightboxImages = [
      @foreach(var img in allImages)
      {
        <text>'@img.ImageUrl',</text>
      }
    ];

    let currentLightboxIdx = 0;

    function openLightbox(index = 0) {
      if (!lightboxImages || lightboxImages.length === 0) return;
      currentLightboxIdx = (index >= 0 && index < lightboxImages.length) ? index : 0;
      
      const modal = document.getElementById('tour-lightbox-modal');
      if (!modal) return;
      
      modal.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
      updateLightboxView();
    }

    function closeLightbox() {
      const modal = document.getElementById('tour-lightbox-modal');
      if (!modal) return;
      modal.classList.add('hidden');
      document.body.style.overflow = '';
    }

    function onLightboxBackdropClick(event) {
      if (event.target.id === 'lightbox-main-img' || event.target.closest('button')) {
        return;
      }
      closeLightbox();
    }

    function setLightboxIndex(index) {
      if (index >= 0 && index < lightboxImages.length) {
        currentLightboxIdx = index;
        updateLightboxView();
      }
    }

    function nextLightboxImage(event) {
      if (event) event.stopPropagation();
      currentLightboxIdx = (currentLightboxIdx + 1) % lightboxImages.length;
      updateLightboxView();
    }

    function prevLightboxImage(event) {
      if (event) event.stopPropagation();
      currentLightboxIdx = (currentLightboxIdx - 1 + lightboxImages.length) % lightboxImages.length;
      updateLightboxView();
    }

    function updateLightboxView() {
      const mainImg = document.getElementById('lightbox-main-img');
      const counter = document.getElementById('lightbox-counter');
      if (mainImg) {
        mainImg.src = lightboxImages[currentLightboxIdx];
      }
      if (counter) {
        counter.innerText = `Foto ${currentLightboxIdx + 1} de ${lightboxImages.length}`;
      }
      
      const thumbBtns = document.querySelectorAll('.lightbox-thumb-btn');
      thumbBtns.forEach((btn, idx) => {
        if (idx === currentLightboxIdx) {
          btn.classList.add('border-primary', 'opacity-100', 'scale-105');
          btn.classList.remove('border-transparent', 'opacity-60');
          btn.scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' });
        } else {
          btn.classList.remove('border-primary', 'opacity-100', 'scale-105');
          btn.classList.add('border-transparent', 'opacity-60');
        }
      });
    }

    document.addEventListener('keydown', (e) => {
      const modal = document.getElementById('tour-lightbox-modal');
      if (!modal || modal.classList.contains('hidden')) return;

      if (e.key === 'Escape') closeLightbox();
      else if (e.key === 'ArrowRight') nextLightboxImage();
      else if (e.key === 'ArrowLeft') prevLightboxImage();
    });

    let touchStartX = 0;
    let touchEndX = 0;
    const lightboxModal = document.getElementById('tour-lightbox-modal');
    if (lightboxModal) {
      lightboxModal.addEventListener('touchstart', e => {
        touchStartX = e.changedTouches[0].screenX;
      }, { passive: true });

      lightboxModal.addEventListener('touchend', e => {
        touchEndX = e.changedTouches[0].screenX;
        const swipeDistance = touchEndX - touchStartX;
        if (Math.abs(swipeDistance) > 50) {
          if (swipeDistance < 0) nextLightboxImage();
          else prevLightboxImage();
        }
      }, { passive: true });
    }
  </script>
</main>







