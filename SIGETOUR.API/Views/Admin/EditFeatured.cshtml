@using SIGETOUR.API.Models
@using SIGETOUR.API.Core.Entities
@model FeaturedPackageDto
@{
    ViewData["Title"] = Model.Id == Guid.Empty ? "Agregar Paquete a Portada" : "Editar Paquete de Portada";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var tours = ViewBag.Tours as IEnumerable<TourPackage>;
}

<form asp-action="EditFeatured" method="post" class="max-w-[1360px] mx-auto space-y-6">
    <input type="hidden" asp-for="Id" />
    
    <div class="bg-surface-container-lowest p-6 rounded-xl border border-outline-variant/80 shadow-sm flex flex-col gap-4">
        <h1 class="text-headline-md font-extrabold text-on-surface">@ViewData["Title"]</h1>
        
        <div class="flex items-center gap-3">
            <a asp-action="Featured" class="px-4 py-2 rounded-lg border border-outline-variant text-on-surface hover:bg-surface-container font-label-md">Cancelar</a>
            <button type="submit" class="px-6 py-2 rounded-lg bg-primary hover:bg-primary/90 text-on-primary font-bold shadow-md">Guardar Cambios</button>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <div class="space-y-6">
            <div class="bg-surface-container-lowest p-6 rounded-xl border border-outline-variant/80 shadow-sm space-y-4">
                <h2 class="font-bold text-title-md">1. Vinculación con Catálogo General</h2>
                <div>
                    <label class="block text-label-md font-bold mb-1">Tour Base del Catálogo Seleccionado *</label>
                    <select asp-for="TourPackageId" class="w-full bg-surface-container-low border border-outline-variant rounded-lg p-2.5">
                        @if (tours != null) {
                            foreach (var t in tours) {
                                <option value="@t.Id">@t.Title (S/ @t.BasePrice)</option>
                            }
                        }
                    </select>
                    <span asp-validation-for="TourPackageId" class="text-red-500 text-sm"></span>
                </div>
                <div class="flex items-center gap-2 pt-2">
                    <input asp-for="SyncInventory" class="w-5 h-5" />
                    <label class="font-bold text-label-md">Sincronizar automáticamente inventario</label>
                </div>
            </div>

            <div class="bg-surface-container-lowest p-6 rounded-xl border border-outline-variant/80 shadow-sm space-y-4">
                <h2 class="font-bold text-title-md">2. Personalización Comercial</h2>
                <div>
                    <label class="block text-label-md font-bold mb-1">Título Comercial en Portada (Opcional)</label>
                    <input asp-for="CommercialTitle" class="w-full bg-surface-container-low border border-outline-variant rounded-lg p-2.5" placeholder="Dejar en blanco para usar título original" />
                </div>
                <div>
                    <label class="block text-label-md font-bold mb-1">Subtítulo / Bajada</label>
                    <textarea asp-for="CommercialSubtitle" rows="2" class="w-full bg-surface-container-low border border-outline-variant rounded-lg p-2.5"></textarea>
                </div>
                <div>
                    <label class="block text-label-md font-bold mb-1">Etiqueta Promocional</label>
                    <select asp-for="PromoBadge" class="w-full bg-surface-container-low border border-outline-variant rounded-lg p-2.5">
                        <option value="none">Sin Etiqueta</option>
                        <option value="popular">Más Popular</option>
                        <option value="oferta">¡Oferta Finde!</option>
                        <option value="2x1">2x1 Limitados</option>
                        <option value="familias">Para Familias</option>
                        <option value="nuevo">Nuevo Tour</option>
                    </select>
                </div>
            </div>
        </div>

        <div class="space-y-6">
            <div class="bg-surface-container-lowest p-6 rounded-xl border border-outline-variant/80 shadow-sm space-y-4">
                <h2 class="font-bold text-title-md">3. Estrategia de Tarifas</h2>
                <div>
                    <label class="block text-label-md font-bold mb-1">Precio Especial en Portada (Opcional)</label>
                    <input asp-for="PromoPrice" type="number" step="0.5" class="w-full bg-surface-container-low border border-outline-variant rounded-lg p-2.5" placeholder="S/ 0.00" />
                </div>
            </div>

            <div class="bg-surface-container-lowest p-6 rounded-xl border border-outline-variant/80 shadow-sm space-y-4">
                <h2 class="font-bold text-title-md">4. Posición en Home</h2>
                <div>
                    <label class="block text-label-md font-bold mb-1">Orden de Visualización en Carrusel</label>
                    <select asp-for="DisplayOrder" class="w-full bg-surface-container-low border border-outline-variant rounded-lg p-2.5">
                        <option value="1">Posición 1 (Primero)</option>
                        <option value="2">Posición 2</option>
                        <option value="3">Posición 3</option>
                        <option value="4">Posición 4</option>
                        <option value="5">Posición 5</option>
                        <option value="6">Posición 6</option>
                    </select>
                </div>
            </div>
        </div>
    </div>
</form>
