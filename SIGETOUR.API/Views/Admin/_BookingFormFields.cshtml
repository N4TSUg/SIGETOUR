@model SIGETOUR.API.Models.EditBookingViewModel
@using SIGETOUR.API.Core.Entities
@{
    bool isEdit = Model.Id != Guid.Empty;
    var tours = ViewBag.Tours as IEnumerable<TourPackage> ?? Enumerable.Empty<TourPackage>();
    var activeFeatured = ViewBag.ActiveFeatured as Dictionary<Guid, FeaturedPackage> ?? new Dictionary<Guid, FeaturedPackage>();

    var toursJson = tours.Select(t => {
        var hasFp = activeFeatured.TryGetValue(t.Id, out var fp) && fp != null;
        var promo = hasFp && fp!.PromoPrice.HasValue ? fp.PromoPrice.Value : (decimal?)null;
        var commTitle = hasFp && !string.IsNullOrWhiteSpace(fp!.CommercialTitle) ? fp.CommercialTitle : null;
        var promoBadge = hasFp && !string.IsNullOrWhiteSpace(fp!.PromoBadge) ? fp.PromoBadge : null;
        return new {
            id = t.Id.ToString(),
            title = t.Title,
            commercialTitle = commTitle,
            promoBadge = promoBadge,
            basePrice = t.BasePrice,
            promoPrice = promo,
            price = promo ?? t.BasePrice,
            duration = t.Duration ?? "Día completo",
            shifts = t.Shifts != null ? t.Shifts.Where(s => s.IsActive).Select(s => s.ShiftName).ToList() : new List<string>()
        };
    });
}

<input type="hidden" asp-for="AdditionalPassengersJson" id="AdditionalPassengersJson" />

<!-- MAIN GRID -->
<div class="grid grid-cols-1 xl:grid-cols-3 gap-6">

  <!-- LEFT COLUMN: Operations & Contact -->
  <div class="xl:col-span-2 space-y-6">

    <!-- 1. Operational Details -->
    <div class="bg-surface-container-lowest rounded-2xl border border-outline-variant shadow-xs overflow-hidden">
      <div class="px-6 py-4 border-b border-outline-variant bg-surface-bright flex flex-wrap justify-between items-center gap-2">
        <h2 class="text-title-md font-title-md font-bold text-on-surface flex items-center gap-2">
          <span class="material-symbols-outlined text-primary">calendar_clock</span>
          Detalles Operativos de la Salida
        </h2>
        <div class="flex items-center gap-2">
          <label for="Status" class="text-label-sm font-bold text-on-surface-variant">@(isEdit ? "Estado:" : "Estado Inicial:")</label>
          <select id="Status" asp-for="Status" class="py-1 px-3 rounded-lg border border-outline-variant font-bold text-label-sm focus:outline-none focus:ring-2 focus:ring-primary @(Model.Status == BookingStatus.Confirmed ? "bg-green-50 text-green-800 border-green-300" : (Model.Status == BookingStatus.Pending ? "bg-yellow-50 text-yellow-800 border-yellow-300" : "bg-red-50 text-red-800 border-red-300"))">
            <option value="Confirmed">Confirmada</option>
            <option value="Pending">Pendiente</option>
            @if (isEdit)
            {
              <option value="Cancelled">Anulada / Cancelada</option>
            }
          </select>
        </div>
      </div>
      <div class="p-6">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">

          <!-- SELECTOR DE TOUR / CIRCUITO -->
          <div class="col-span-1 md:col-span-3 pb-4 border-b border-outline-variant/60">
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-1 mb-1.5">
              <label for="tourPackageSelect" class="block text-label-md font-label-md text-on-surface font-bold flex items-center gap-2">
                <span class="material-symbols-outlined text-primary text-[20px]">tour</span>
                @(isEdit ? "Circuito / Paquete Turístico Asignado" : "Seleccionar Tour / Circuito Turístico") <span class="text-tertiary">*</span>
              </label>
              @{
                var currentFp = activeFeatured.TryGetValue(Model.TourPackageId, out var cfp) ? cfp : null;
                var isCurrentPromo = currentFp?.PromoPrice.HasValue == true;
              }
              <div id="tourPriceBadgeContainer" class="flex items-center gap-2">
                @if (isCurrentPromo)
                {
                  <span id="tourPromoPill" class="px-2 py-0.5 rounded-full text-[11px] font-bold bg-primary text-white tracking-wide uppercase shadow-xs">
                    @(currentFp!.PromoBadge ?? "OFERTA")
                  </span>
                }
                <span class="text-xs text-outline" id="tourPriceBadge">
                  @if (isCurrentPromo)
                  {
                    <span>Tarifa promocional: <strong class="text-primary font-bold">S/ @currentFp!.PromoPrice!.Value.ToString("F2")</strong> <span class="line-through text-on-surface-variant/70 ml-1">S/ @Model.TourBasePrice.ToString("F2")</span></span>
                  }
                  else
                  {
                    <span>Tarifa individual base: S/ @Model.TourBasePrice.ToString("F2")</span>
                  }
                </span>
              </div>
            </div>
            <div>
              <select asp-for="TourPackageId" id="tourPackageSelect" onchange="onTourChanged(this)" class="w-full py-2.5 px-3 bg-surface-bright border border-outline-variant rounded-lg text-body-md font-bold text-on-surface focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent cursor-pointer">
                @foreach (var t in tours)
                {
                  var hasFp = activeFeatured.TryGetValue(t.Id, out var fp) && fp != null;
                  var promo = hasFp && fp!.PromoPrice.HasValue ? fp.PromoPrice.Value : (decimal?)null;
                  var effectivePrice = promo ?? t.BasePrice;
                  var commTitle = hasFp && !string.IsNullOrWhiteSpace(fp!.CommercialTitle) && !fp.CommercialTitle.Equals(t.Title, StringComparison.OrdinalIgnoreCase)
                      ? $" ({fp.CommercialTitle})"
                      : "";
                  var promoTag = promo.HasValue
                      ? $" [¡{fp!.PromoBadge?.ToUpper() ?? "OFERTA"}! S/ {promo.Value:F2} - Antes S/ {t.BasePrice:F2}]"
                      : $" — S/ {t.BasePrice:F2}";

                  <option value="@t.Id" data-price="@effectivePrice" data-base-price="@t.BasePrice" data-promo-price="@(promo?.ToString() ?? "")" data-promo-badge="@(fp?.PromoBadge ?? "")" data-title="@t.Title" selected="@(t.Id == Model.TourPackageId)">
                    @t.Title@commTitle@promoTag (@(t.Duration ?? "Día completo"))
                  </option>
                }
              </select>
            </div>
            <p class="text-xs text-outline mt-1.5">El tour seleccionado determina los turnos disponibles y calcula automáticamente la tarifa total según los pasajeros.</p>
          </div>

          <!-- FECHA DE RECORRIDO -->
          <div>
            <label for="TravelDate" class="block text-label-md font-label-md text-on-surface font-semibold mb-1.5">Fecha de Recorrido <span class="text-tertiary">*</span></label>
            <input id="TravelDate" asp-for="TravelDate" type="date" min="@DateTime.Today.ToString("yyyy-MM-dd")" class="w-full pl-3 pr-3 py-2 bg-surface-bright border border-outline-variant rounded-lg text-body-md font-body-md text-on-surface focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent" required />
          </div>
          
          <!-- TURNO OPERATIVO -->
          <div>
            <label for="ShiftName" class="block text-label-md font-label-md text-on-surface font-semibold mb-1.5">Turno Operativo</label>
            <div class="grid grid-cols-2 gap-3" id="shiftsContainer">
              @if (Model.AvailableShifts.Any())
              {
                  foreach (var shift in Model.AvailableShifts)
                  {
                      <label for="ShiftName" class="relative flex items-center justify-center p-3 border rounded-lg cursor-pointer transition-all hover:bg-surface-container-low @(Model.ShiftName == shift ? "border-primary bg-primary/5" : "border-outline-variant")">
                        <input id="ShiftName" type="radio" asp-for="ShiftName" value="@shift" class="sr-only" onchange="onShiftRadioChanged(this)" />
                        <span class="text-label-md font-label-md font-bold text-center">@shift</span>
                      </label>
                  }
              }
              else
              {
                  <label for="Turno__nico" class="relative flex items-center justify-center p-3 border rounded-lg cursor-pointer transition-all hover:bg-surface-container-low border-primary bg-primary/5">
                    <input id="Turno__nico" type="radio" asp-for="ShiftName" value="Turno Único" class="sr-only" checked onchange="onShiftRadioChanged(this)" />
                    <span class="text-label-md font-label-md font-bold text-center">Turno Único</span>
                  </label>
              }
            </div>
          </div>

          <!-- PUNTO DE EMBARQUE -->
          <div>
            <label for="BoardingPoint" class="block text-label-md font-label-md text-on-surface font-semibold mb-1.5">Punto de Embarque</label>
            <select id="BoardingPoint" asp-for="BoardingPoint" onchange="toggleHotelDetails(this.value)" class="w-full py-2 px-3 bg-surface-bright border border-outline-variant rounded-lg text-body-md font-body-md text-on-surface focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent">
              <option value="Agencia Central">Agencia Central (Jr. 2 de Mayo 569)</option>
              <option value="Hotel">Recojo en Hotel / Alojamiento</option>
              <option value="Plaza de Armas">Plaza de Armas</option>
              <option value="Aeropuerto">Aeropuerto</option>
              <option value="Otro">Otro punto coordinado</option>
            </select>
            <div id="hotelDetailsContainer" class="mt-2 @(string.IsNullOrWhiteSpace(Model.HotelDetails) && Model.BoardingPoint != "Hotel" && Model.BoardingPoint != "Otro" ? "hidden" : "")">
              <label for="HotelDetails" class="block text-xs font-semibold text-outline mb-1">Nombre del Hotel / Dirección de Recojo</label>
              <input id="HotelDetails" asp-for="HotelDetails" class="w-full py-1.5 px-3 rounded-lg border border-outline-variant bg-surface-container-lowest text-body-sm font-body-sm text-on-surface focus:ring-2 focus:ring-primary focus:outline-none" placeholder="Ej. Hotel Costa del Sol - Jr. Cruz de Piedra 250" />
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- 2. Passenger Manifest -->
    <div class="bg-surface-container-lowest rounded-2xl border border-outline-variant shadow-xs overflow-hidden">
      <div class="px-6 py-4 border-b border-outline-variant bg-surface-bright flex justify-between items-center">
        <h2 class="text-title-md font-title-md font-bold text-on-surface flex items-center gap-2">
          <span class="material-symbols-outlined text-primary">groups</span>
          Manifiesto de Pasajeros
        </h2>
        <div class="flex items-center gap-3">
          <span class="text-label-sm font-label-sm text-secondary bg-surface-container py-1 px-2 rounded-lg" id="passenger-count-badge">@Model.TotalPassengers Pasajeros</span>
          <button type="button" onclick="addPassengerRow()" class="text-primary hover:text-primary-container text-label-sm font-bold flex items-center gap-1 transition-colors cursor-pointer">
            <span class="material-symbols-outlined text-[18px]">person_add</span> Agregar
          </button>
        </div>
      </div>
      
      <div class="p-6 space-y-4" id="passengers-container">
        <!-- TITULAR -->
        <div class="passenger-card p-4 rounded-xl border-2 border-primary/20 bg-[#f8fafc] relative">
          <div class="flex items-center justify-between mb-3 border-b border-outline-variant/40 pb-2">
            <div class="flex items-center gap-2">
              <span class="material-symbols-outlined text-primary">how_to_reg</span>
              <span class="text-title-sm font-title-sm text-primary font-bold">Pasajero Titular (Contacto Principal)</span>
            </div>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <label for="CustomerName" class="block text-label-sm font-label-sm text-outline font-semibold mb-1">Nombres y Apellidos Completos <span class="text-tertiary">*</span></label>
              <input id="CustomerName" asp-for="CustomerName" class="w-full py-2 px-3 rounded-lg border border-outline-variant bg-surface-container-lowest text-body-md font-body-md text-on-surface focus:ring-2 focus:ring-primary focus:outline-none" placeholder="Ej. Juan Carlos Pérez Quispe" required />
            </div>
            <div>
              <label for="CustomerDni" class="block text-label-sm font-label-sm text-outline font-semibold mb-1">DNI / CE / Pasaporte <span class="text-tertiary">*</span></label>
              <input id="CustomerDni" asp-for="CustomerDni" class="w-full py-2 px-3 rounded-lg border border-outline-variant bg-surface-container-lowest text-body-md font-body-md text-on-surface focus:ring-2 focus:ring-primary focus:outline-none" placeholder="8 a 12 dígitos" required />
            </div>
            <div>
              <label for="CustomerPhone" class="block text-label-sm font-label-sm text-outline font-semibold mb-1">Celular / WhatsApp <span class="text-tertiary">*</span></label>
              <input id="CustomerPhone" asp-for="CustomerPhone" class="w-full py-2 px-3 rounded-lg border border-outline-variant bg-surface-container-lowest text-body-md font-body-md text-on-surface focus:ring-2 focus:ring-primary focus:outline-none" placeholder="Ej. +51 987654321" required />
            </div>
            <div>
              <label for="CustomerEmail" class="block text-label-sm font-label-sm text-outline font-semibold mb-1">Correo Electrónico <span class="text-tertiary">*</span></label>
              <input id="CustomerEmail" asp-for="CustomerEmail" type="email" class="w-full py-2 px-3 rounded-lg border border-outline-variant bg-surface-container-lowest text-body-md font-body-md text-on-surface focus:ring-2 focus:ring-primary focus:outline-none" placeholder="correo@ejemplo.com" required />
            </div>
          </div>
        </div>

        <!-- ADDITIONAL PASSENGERS RENDERED HERE BY JS -->
      </div>
    </div>
  </div>

  <!-- RIGHT COLUMN: Finance & Billing -->
  <div class="space-y-6">
    
    <!-- 3. Payment Status -->
    <div class="bg-surface-container-lowest rounded-2xl border border-outline-variant shadow-xs overflow-hidden">
      <div class="px-6 py-4 border-b border-outline-variant bg-surface-bright">
        <h2 class="text-title-md font-title-md font-bold text-on-surface flex items-center gap-2">
          <span class="material-symbols-outlined text-primary">payments</span>
          Liquidación de Pago
        </h2>
      </div>
      <div class="p-6">
        
        <div class="flex justify-between items-end mb-4 pb-4 border-b border-outline-variant">
          <div>
            <span class="block text-label-sm font-label-sm text-outline">Tarifa Total Calculada</span>
            <div class="flex items-center gap-2">
              <span class="text-headline-sm font-headline-sm font-extrabold text-on-surface">S/</span>
              <label for="TotalAmountHidden" class="sr-only">Total Amount</label>
              <input type="number" step="0.50" asp-for="TotalAmount" id="TotalAmountHidden" class="w-32 py-1 px-2 text-headline-sm font-headline-sm font-extrabold text-on-surface bg-transparent border-b-2 border-outline-variant focus:border-primary focus:outline-none" oninput="updateDisplayTotal(this.value)" />
            </div>
            <span class="hidden" id="display-total-tariff"></span>
            <input type="hidden" asp-for="TotalPassengers" id="TotalPassengersHidden" value="@Model.TotalPassengers" />
          </div>
        </div>

        <div class="space-y-4">
          <div class="flex justify-between items-center">
            <span class="text-body-md font-body-md text-on-surface-variant font-medium">Abono Registrado</span>
            <div class="flex items-center gap-2">
              <span class="text-body-md text-outline">S/</span>
              <label for="input-paid-amount" class="sr-only">Paid Amount</label>
              <input asp-for="PaidAmount" id="input-paid-amount" type="number" step="0.50" oninput="recalcBalance()" class="w-24 text-right py-1 px-2 rounded border border-outline-variant bg-surface-container-lowest font-bold text-title-sm text-primary focus:ring-1 focus:ring-primary" />
            </div>
          </div>

          <div class="flex justify-between items-center pt-2">
            <span class="text-body-md font-body-md text-on-surface-variant font-bold">Saldo Pendiente</span>
            <span id="display-pending-balance" class="text-title-md font-title-md font-extrabold text-tertiary">
              S/ @(Model.TotalAmount - Model.PaidAmount)
            </span>
          </div>
        </div>

        <div class="mt-6 pt-5 border-t border-outline-variant">
          <label for="PaymentMethod" class="block text-label-sm font-label-sm text-outline font-semibold mb-1.5">Método de Pago</label>
          <select id="PaymentMethod" asp-for="PaymentMethod" class="w-full py-2 px-3 bg-surface-container-lowest border border-outline-variant rounded-lg text-body-md font-body-md text-on-surface focus:outline-none focus:ring-2 focus:ring-primary mb-3">
            <option value="Efectivo">Efectivo (Caja Agencia)</option>
            <option value="Yape / Plin">Yape / Plin Interbancario</option>
            <option value="Transferencia BCP / BBVA">Transferencia BCP / BBVA</option>
            <option value="Culqi">Tarjeta Débito / Crédito (Culqi)</option>
            <option value="Culqi QR">Culqi QR (Billetera Digital)</option>
          </select>

          <label for="OperationNumber" class="block text-label-sm font-label-sm text-outline font-semibold mb-1.5">N° de Operación (Voucher)</label>
          <div class="relative">
            <input id="OperationNumber" asp-for="OperationNumber" placeholder="Opcional para efectivo" class="w-full py-2 px-3 bg-surface-container-lowest border border-outline-variant rounded-lg text-body-md font-body-md text-on-surface focus:outline-none focus:ring-2 focus:ring-primary font-mono" />
          </div>
        </div>
      </div>
    </div>

    <!-- 4. Electronic Billing -->
    <div class="bg-surface-container-lowest rounded-2xl border border-outline-variant shadow-xs overflow-hidden">
      <div class="px-6 py-4 border-b border-outline-variant bg-surface-bright">
        <h2 class="text-title-md font-title-md font-bold text-on-surface flex items-center gap-2">
          <span class="material-symbols-outlined text-primary">receipt_long</span>
          Comprobante de Pago
        </h2>
      </div>
      <div class="p-6 space-y-4">
        <div>
          <label for="InvoiceType" class="block text-label-sm font-label-sm text-outline font-semibold mb-1.5">Tipo de Comprobante</label>
          <select id="InvoiceType" asp-for="InvoiceType" class="w-full py-2 px-3 bg-surface-container-lowest border border-outline-variant rounded-lg text-body-md font-body-md text-on-surface focus:outline-none focus:ring-2 focus:ring-primary">
            <option value="boleta">Boleta de Venta Electrónica</option>
            <option value="factura">Factura Electrónica (RUC)</option>
            <option value="nota">Nota de Venta (Interno)</option>
          </select>
        </div>
        
        <div>
          <label for="InvoiceNumber" class="block text-label-sm font-label-sm text-outline font-semibold mb-1.5">Serie y Correlativo</label>
          <div class="flex gap-2">
            <input id="InvoiceNumber" asp-for="InvoiceNumber" placeholder="Ej. B001-000428" class="flex-1 py-2 px-3 bg-surface-container-lowest border border-outline-variant rounded-lg text-body-md font-body-md text-on-surface focus:outline-none focus:ring-2 focus:ring-primary font-mono font-bold" />
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
    const allTours = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(toursJson));

    function onTourChanged(select) {
        const tourId = select.value;
        const selectedTour = allTours.find(t => t.id === tourId);
        if (!selectedTour) return;

        // Actualizar título del header si existe
        const headerEl = document.getElementById('headerTourTitle');
        if (headerEl) headerEl.innerText = selectedTour.title;
        const modalEl = document.getElementById('modalTourName');
        if (modalEl) modalEl.innerText = selectedTour.title;

        // Actualizar etiqueta de precio individual y badge promocional
        const priceContainer = document.getElementById('tourPriceBadgeContainer');
        if (priceContainer) {
            if (selectedTour.promoPrice) {
                const badge = (selectedTour.promoBadge || 'OFERTA').toUpperCase();
                priceContainer.innerHTML = `
                    <span id="tourPromoPill" class="px-2 py-0.5 rounded-full text-[11px] font-bold bg-primary text-white tracking-wide uppercase shadow-xs">
                        ${badge}
                    </span>
                    <span class="text-xs text-outline" id="tourPriceBadge">
                        Tarifa promocional: <strong class="text-primary font-bold">S/ ${parseFloat(selectedTour.promoPrice).toFixed(2)}</strong> <span class="line-through text-on-surface-variant/70 ml-1">S/ ${parseFloat(selectedTour.basePrice).toFixed(2)}</span>
                    </span>
                `;
            } else {
                priceContainer.innerHTML = `
                    <span class="text-xs text-outline" id="tourPriceBadge">Tarifa individual base: S/ ${parseFloat(selectedTour.price).toFixed(2)}</span>
                `;
            }
        } else {
            const priceBadge = document.getElementById('tourPriceBadge');
            if (priceBadge) priceBadge.innerText = `Tarifa individual base: S/ ${parseFloat(selectedTour.price).toFixed(2)}`;
        }

        // Recalcular Total según cantidad de pasajeros
        const totalPax = parseInt(document.getElementById('TotalPassengersHidden')?.value || '1', 10);
        const newTotal = (selectedTour.price * totalPax);
        const totalInput = document.getElementById('TotalAmountHidden');
        if (totalInput) {
            totalInput.value = newTotal.toFixed(2);
            updateDisplayTotal(newTotal);
        }

        // Actualizar turnos dinámicamente
        const shiftsContainer = document.getElementById('shiftsContainer');
        if (shiftsContainer) {
            shiftsContainer.innerHTML = '';
            if (selectedTour.shifts && selectedTour.shifts.length > 0) {
                selectedTour.shifts.forEach((shift, idx) => {
                    const label = document.createElement('label');
                    label.className = `relative flex items-center justify-center p-3 border rounded-lg cursor-pointer transition-all hover:bg-surface-container-low ${idx === 0 ? 'border-primary bg-primary/5' : 'border-outline-variant'}`;
                    label.innerHTML = `
                        <label for="ShiftName_3" class="sr-only">Shift Name</label>
                        <input id="ShiftName_3" type="radio" name="ShiftName" value="${shift}" class="sr-only" ${idx === 0 ? 'checked' : ''} onchange="onShiftRadioChanged(this)" />
                        <span class="text-label-md font-label-md font-bold text-center">${shift}</span>
                    `;
                    shiftsContainer.appendChild(label);
                });
            } else {
                shiftsContainer.innerHTML = `
                    <label for="ShiftName_2" class="relative flex items-center justify-center p-3 border rounded-lg cursor-pointer transition-all hover:bg-surface-container-low border-primary bg-primary/5">
                        <input id="ShiftName_2" type="radio" name="ShiftName" value="Turno Único" class="sr-only" checked onchange="onShiftRadioChanged(this)" />
                        <span class="text-label-md font-label-md font-bold text-center">Turno Único</span>
                    </label>
                `;
            }
        }
    }

    function toggleHotelDetails(val) {
        const container = document.getElementById('hotelDetailsContainer');
        if (!container) return;
        if (val === 'Hotel' || val === 'Otro' || val === 'Hotel Centro Histórico') {
            container.classList.remove('hidden');
        } else {
            container.classList.add('hidden');
        }
    }

    function onShiftRadioChanged(radio) {
        document.querySelectorAll('#shiftsContainer label').forEach(lbl => {
            lbl.classList.remove('border-primary', 'bg-primary/5');
            lbl.classList.add('border-outline-variant');
        });
        radio.closest('label').classList.remove('border-outline-variant');
        radio.closest('label').classList.add('border-primary', 'bg-primary/5');
    }

    function initBookingSharedForm() {
        loadExtraPassengers();
        recalcBalance();

        // Hook into form submit to save extra passengers
        const form = document.querySelector('form[id$="BookingForm"]') || document.getElementById('createBookingForm') || document.getElementById('editBookingForm');
        form?.addEventListener('submit', function() {
            saveExtraPassengersToJson();
        });
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initBookingSharedForm);
    } else {
        initBookingSharedForm();
    }

    function loadExtraPassengers() {
        const jsonField = document.getElementById('AdditionalPassengersJson');
        let loadedCount = 0;
        if (jsonField && jsonField.value) {
            try {
                const passengers = JSON.parse(jsonField.value);
                if (Array.isArray(passengers)) {
                    passengers.forEach(p => {
                        addPassengerRow(p.Name || '', p.Dni || '', p.Phone || '', p.Email || '', false);
                        loadedCount++;
                    });
                }
            } catch (e) {
                console.error('Error parsing extra passengers:', e);
            }
        }

        const totalPaxHidden = document.getElementById('TotalPassengersHidden');
        const totalPax = parseInt(totalPaxHidden ? totalPaxHidden.value : '1', 10) || 1;
        const neededExtras = totalPax - 1;
        while (loadedCount < neededExtras) {
            addPassengerRow('', '', '', '', false);
            loadedCount++;
        }

        updatePassengerCount(false);
    }

    function renumberCompanions() {
        const container = document.getElementById('passengers-container');
        const rows = container.querySelectorAll('.extra-passenger-row');
        rows.forEach((row, idx) => {
            const num = idx + 2;
            const badge = row.querySelector('.companion-num');
            if (badge) badge.textContent = num;
            const title = row.querySelector('.companion-title');
            if (title) title.textContent = 'Acompañante ' + num;
        });
        updatePassengerCount(true);
    }

    function addPassengerRow(name = '', dni = '', phone = '', email = '', recalculatePrice = true) {
        const container = document.getElementById('passengers-container');
        const count = container.querySelectorAll('.extra-passenger-row').length + 2;
        
        const div = document.createElement('div');
        div.className = 'extra-passenger-row passenger-card p-4 rounded-xl border border-outline-variant bg-surface-bright relative mt-4';
        div.innerHTML = `
            <div class="flex items-center justify-between mb-3 border-b border-outline-variant/40 pb-2">
                <div class="flex items-center gap-2">
                  <span class="companion-num w-6 h-6 rounded-full bg-secondary text-on-secondary flex items-center justify-center text-label-sm font-bold">${count}</span>
                  <span class="companion-title text-title-sm font-title-sm text-on-surface font-bold">Acompañante ${count}</span>
                </div>
                <button type="button" class="btn-remove-companion p-1 text-tertiary hover:bg-error-container rounded-md transition-colors flex items-center gap-1 text-label-sm font-label-sm cursor-pointer">
                  <span class="material-symbols-outlined text-[16px]">delete</span>
                  <span>Retirar</span>
                </button>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                <div>
                  <label for="p_name_${count}" class="block text-label-sm font-label-sm text-outline font-semibold mb-1">Nombre Completo</label>
                  <input id="p_name_${count}" type="text" class="p-name w-full py-1.5 px-3 rounded-lg border border-outline-variant bg-surface-container-lowest text-body-md font-body-md text-on-surface focus:ring-2 focus:ring-primary focus:outline-none" placeholder="Nombre del acompañante" />
                </div>
                <div>
                  <label for="p_dni_${count}" class="block text-label-sm font-label-sm text-outline font-semibold mb-1">DNI / CE / Pasaporte</label>
                  <input id="p_dni_${count}" type="text" class="p-dni w-full py-1.5 px-3 rounded-lg border border-outline-variant bg-surface-container-lowest text-body-md font-body-md text-on-surface focus:ring-2 focus:ring-primary focus:outline-none" placeholder="8 a 12 dígitos" />
                </div>
                <div>
                  <label for="p_phone_${count}" class="block text-label-sm font-label-sm text-outline font-semibold mb-1">Teléfono (Opcional)</label>
                  <input id="p_phone_${count}" type="text" class="p-phone w-full py-1.5 px-3 rounded-lg border border-outline-variant bg-surface-container-lowest text-body-md font-body-md text-on-surface focus:ring-2 focus:ring-primary focus:outline-none" placeholder="Ej. 987654321" />
                </div>
                <div>
                  <label for="p_email_${count}" class="block text-label-sm font-label-sm text-outline font-semibold mb-1">Correo Electrónico (Opcional)</label>
                  <input id="p_email_${count}" type="email" class="p-email w-full py-1.5 px-3 rounded-lg border border-outline-variant bg-surface-container-lowest text-body-md font-body-md text-on-surface focus:ring-2 focus:ring-primary focus:outline-none" placeholder="correo@ejemplo.com" />
                </div>
            </div>
        `;

        div.querySelector('.p-name').value = name || '';
        div.querySelector('.p-dni').value = dni || '';
        div.querySelector('.p-phone').value = phone || '';
        div.querySelector('.p-email').value = email || '';

        div.querySelector('.btn-remove-companion').addEventListener('click', function() {
            div.remove();
            renumberCompanions();
        });

        container.appendChild(div);
        updatePassengerCount(recalculatePrice);
    }

    function updatePassengerCount(recalculatePrice = false) {
        const total = document.querySelectorAll('.extra-passenger-row').length + 1;
        const countBadge = document.getElementById('passenger-count-badge');
        if (countBadge) countBadge.innerText = total + ' Pasajeros';
        const totalHidden = document.getElementById('TotalPassengersHidden');
        if (totalHidden) totalHidden.value = total;

        if (recalculatePrice) {
            const tourSelect = document.getElementById('tourPackageSelect');
            if (tourSelect) {
                const selectedOpt = tourSelect.options[tourSelect.selectedIndex];
                const price = parseFloat(selectedOpt?.getAttribute('data-price') || '0');
                if (price > 0) {
                    const totalInput = document.getElementById('TotalAmountHidden');
                    if (totalInput) {
                        totalInput.value = (price * (total || 1)).toFixed(2);
                        updateDisplayTotal(totalInput.value);
                    }
                }
            }
        }
    }

    function saveExtraPassengersToJson() {
        const rows = document.querySelectorAll('.extra-passenger-row');
        const passengers = [];
        rows.forEach(row => {
            const name = row.querySelector('.p-name')?.value?.trim() || '';
            const dni = row.querySelector('.p-dni')?.value?.trim() || '';
            const phone = row.querySelector('.p-phone')?.value?.trim() || '';
            const email = row.querySelector('.p-email')?.value?.trim() || '';
            passengers.push({
                Name: name,
                Dni: dni,
                Phone: phone,
                Email: email
            });
        });
        const hiddenInput = document.getElementById('AdditionalPassengersJson');
        if (hiddenInput) {
            hiddenInput.value = JSON.stringify(passengers);
        }
    }

    function updateDisplayTotal(val) {
        document.getElementById('display-total-tariff').innerText = 'S/ ' + parseFloat(val).toFixed(2);
        recalcBalance();
    }

    function recalcBalance() {
        const total = parseFloat(document.getElementById('TotalAmountHidden').value) || 0;
        const paid = parseFloat(document.getElementById('input-paid-amount').value) || 0;
        const balance = Math.max(0, total - paid);
        
        const balanceEl = document.getElementById('display-pending-balance');
        if (!balanceEl) return;
        balanceEl.innerText = 'S/ ' + balance.toFixed(2);
        
        if (balance === 0) {
            balanceEl.classList.remove('text-tertiary');
            balanceEl.classList.add('text-primary');
        } else {
            balanceEl.classList.remove('text-primary');
            balanceEl.classList.add('text-tertiary');
        }
    }
</script>
