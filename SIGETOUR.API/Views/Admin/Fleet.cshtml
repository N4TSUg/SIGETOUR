@{ Layout = "_AdminLayout"; }
<main class="flex-1 overflow-y-auto p-space-md lg:p-space-lg flex flex-col gap-space-lg">
<!-- ==================== 1. PAGE HEADER ==================== -->
<section class="flex flex-col md:flex-row md:items-center justify-between gap-space-md">
<div>
<h1 class="text-headline-sm lg:text-headline-md font-headline-md text-primary font-bold tracking-tight">
            Gestión de Flota y Unidades de Transporte
          </h1>
<p class="text-body-md font-body-md text-on-surface-variant mt-0.5">
            Registro, mantenimiento técnico y asignación de vehículos turísticos autorizados
          </p>
</div>
<div class="flex items-center gap-space-sm shrink-0">
<button class="px-space-md py-2.5 rounded-lg bg-primary text-on-primary font-label-lg hover:bg-primary-container transition-all duration-150 active:scale-95 shadow-sm flex items-center gap-2 tracking-wide uppercase" onclick="document.getElementById('vehicle-drawer').classList.remove('translate-x-full')" type="button">
<span class="material-symbols-outlined text-[20px]">add</span>
<span>Registrar Nuevo Vehículo</span>
</button>
</div>
</section>
<!-- ==================== 2. KPI FLEET SUMMARY CARDS ==================== -->
<section class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-space-md">
<!-- KPI 1: Total Unidades -->
<div class="bg-surface-container-lowest rounded-xl p-space-md border border-outline-variant shadow-sm flex items-center justify-between relative overflow-hidden">
<div class="absolute left-0 top-0 bottom-0 w-1 bg-primary"></div>
<div>
<span class="text-label-md font-label-md text-on-surface-variant uppercase tracking-wider">Total Vehículos Registrados</span>
<div class="flex items-baseline gap-2 mt-1">
<span class="text-headline-md font-headline-md font-bold text-on-surface">7</span>
<span class="text-body-sm font-body-sm text-on-surface-variant font-medium">unidades autorizadas</span>
</div>
<span class="inline-flex items-center gap-1 text-label-sm font-label-sm text-primary mt-2">
<span class="material-symbols-outlined text-[15px]">verified</span> 100% habilitación MTC
            </span>
</div>
<div class="w-12 h-12 rounded-xl bg-surface-container-low flex items-center justify-center text-primary">
<span class="material-symbols-outlined text-[28px]">airport_shuttle</span>
</div>
</div>
<!-- KPI 2: Operativas en Ruta -->
<div class="bg-surface-container-lowest rounded-xl p-space-md border border-outline-variant shadow-sm flex items-center justify-between relative overflow-hidden">
<div class="absolute left-0 top-0 bottom-0 w-1 bg-primary-container"></div>
<div>
<span class="text-label-md font-label-md text-on-surface-variant uppercase tracking-wider">Operativas en Ruta</span>
<div class="flex items-baseline gap-2 mt-1">
<span class="text-headline-md font-headline-md font-bold text-primary">5</span>
<span class="text-body-sm font-body-sm text-on-surface-variant font-medium">activas en circuito</span>
</div>
<span class="inline-flex items-center gap-1 text-label-sm font-label-sm text-primary-container mt-2">
<span class="material-symbols-outlined text-[15px] material-symbols-fill">satellite_alt</span> GPS Transmitiendo
            </span>
</div>
<div class="w-12 h-12 rounded-xl bg-surface-container flex items-center justify-center text-primary-container">
<span class="material-symbols-outlined text-[28px] material-symbols-fill">route</span>
</div>
</div>
<!-- KPI 3: En Espera / Terminal -->
<div class="bg-surface-container-lowest rounded-xl p-space-md border border-outline-variant shadow-sm flex items-center justify-between relative overflow-hidden">
<div class="absolute left-0 top-0 bottom-0 w-1 bg-secondary"></div>
<div>
<span class="text-label-md font-label-md text-on-surface-variant uppercase tracking-wider">En Espera / Terminal</span>
<div class="flex items-baseline gap-2 mt-1">
