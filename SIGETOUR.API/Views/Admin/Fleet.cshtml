@using SIGETOUR.API.Core.Entities
@{
    ViewData["Title"] = "Flota de Vehículos";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var vehicles = Model as IEnumerable<Vehicle>;
    var currentSearch = ViewBag.CurrentSearch as string;
    var currentStatus = ViewBag.CurrentStatus as string;
    bool hasFilters = !string.IsNullOrWhiteSpace(currentSearch) || (!string.IsNullOrWhiteSpace(currentStatus) && currentStatus != "Todos");
}

<div class="mb-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
    <div>
        <h1 class="text-display-sm font-bold text-on-surface">Gestión de Flota</h1>
        <p class="text-body-lg text-on-surface-variant">Control operativo de unidades vehiculares, capacidades y estado técnico.</p>
    </div>
    <a href="@Url.Action("EditVehicle", "Admin")" class="bg-primary text-on-primary px-4 py-2 rounded-lg font-bold flex items-center gap-2 hover:bg-primary/90 transition-colors inline-flex shadow-sm shrink-0">
        <span class="material-symbols-outlined">add</span>
        Registrar Vehículo
    </a>
</div>

<!-- Barra de Búsqueda y Filtros de Flota -->
<div class="bg-surface-container-lowest p-4 rounded-2xl border border-outline-variant shadow-sm mb-6">
    <form method="get" asp-action="Fleet" id="fleetFilterForm" class="grid grid-cols-1 md:grid-cols-12 gap-3 items-center">
        <!-- Input de Búsqueda General -->
        <div class="md:col-span-6 relative">
            <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-outline text-[20px]">search</span>
            <input type="text" id="fleetSearchInput" name="search" value="@currentSearch" placeholder="Buscar por placa, modelo, categoría, color, SOAT o CITV..." class="w-full pl-10 pr-9 py-2 bg-surface-container-low border border-outline-variant rounded-lg text-body-sm text-on-surface focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-all" />
            @if (!string.IsNullOrWhiteSpace(currentSearch))
            {
                <a href="@Url.Action("Fleet", "Admin", new { status = currentStatus })" class="absolute right-2.5 top-1/2 -translate-y-1/2 text-outline hover:text-on-surface material-symbols-outlined text-[16px]">close</a>
            }
        </div>

        <!-- Filtro por Estado Operativo -->
        <div class="md:col-span-4">
            <select name="status" id="fleetStatusSelect" class="w-full py-2 px-3 bg-surface-container-low border border-outline-variant rounded-lg text-body-sm text-on-surface focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-all">
                <option value="Todos" selected="@(string.IsNullOrEmpty(currentStatus) || currentStatus == "Todos")">Todos los Estados</option>
                <option value="Operativo en Ruta (En Servicio)" selected="@(currentStatus == "Operativo en Ruta (En Servicio)")">Operativo en Ruta (En Servicio)</option>
                <option value="En Espera / Terminal" selected="@(currentStatus == "En Espera / Terminal")">En Espera / Terminal</option>
                <option value="En Mantenimiento Preventivo" selected="@(currentStatus == "En Mantenimiento Preventivo")">En Mantenimiento Preventivo</option>
                <option value="Baja Operativa" selected="@(currentStatus == "Baja Operativa")">Baja Operativa</option>
            </select>
        </div>

        <!-- Botones de Acción -->
        <div class="md:col-span-2 flex items-center gap-2">
            <button type="submit" class="flex-1 py-2 px-3 bg-primary hover:bg-[#0e5a52] text-on-primary font-bold text-body-sm rounded-lg flex items-center justify-center gap-1.5 shadow-sm transition-all cursor-pointer">
                <span class="material-symbols-outlined text-[18px]">filter_list</span>
                <span>Filtrar</span>
            </button>
            @if (hasFilters)
            {
                <a href="@Url.Action("Fleet", "Admin")" class="py-2 px-2.5 bg-surface-container hover:bg-surface-container-high text-on-surface-variant rounded-lg border border-outline-variant flex items-center justify-center transition-colors cursor-pointer" title="Limpiar todos los filtros">
                    <span class="material-symbols-outlined text-[18px]">filter_alt_off</span>
                </a>
            }
        </div>
    </form>
</div>

<div class="bg-surface-container-lowest rounded-2xl shadow-sm border border-outline-variant overflow-hidden">
    <div class="px-6 py-3 border-b border-outline-variant bg-surface-bright flex items-center justify-between">
        <span class="text-label-md font-bold text-on-surface" id="fleetResultsCount">
            @if (vehicles != null && vehicles.Any())
            {
                @:Mostrando @vehicles.Count() unidades vehiculares
            }
            else
            {
                @:0 unidades encontradas
            }
        </span>
        @if (hasFilters)
        {
            <span class="text-xs text-primary font-bold bg-primary/10 px-2 py-0.5 rounded-full">Filtro aplicado</span>
        }
    </div>

    <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse" id="fleetTable">
            <thead>
                <tr class="bg-surface-container-low text-on-surface-variant font-label-lg border-b border-outline-variant">
                    <th class="p-4 font-semibold w-16">Foto</th>
                    <th class="p-4 font-semibold">Placa</th>
                    <th class="p-4 font-semibold">Modelo</th>
                    <th class="p-4 font-semibold">Capacidad</th>
                    <th class="p-4 font-semibold text-center">Estado</th>
                    <th class="p-4 font-semibold text-right">Acciones</th>
                </tr>
            </thead>
            <tbody class="text-body-md text-on-surface divide-y divide-outline-variant/50" id="fleetTableBody">
                @if (vehicles != null && vehicles.Any())
                {
                    foreach (var vehicle in vehicles)
                    {
                        var coverImage = vehicle.Images?.FirstOrDefault(i => i.IsCover) ?? vehicle.Images?.FirstOrDefault();
                        var searchMeta = $"{vehicle.LicensePlate} {vehicle.Model} {vehicle.Category} {vehicle.Color} {vehicle.SoatNumber} {vehicle.CitvNumber}".ToLower();
                        <tr class="hover:bg-surface-container-low/50 transition-colors fleet-row" data-search="@searchMeta" data-status="@vehicle.Status">
                            <td class="p-3">
                                @if (coverImage != null) {
                                    <img src="@coverImage.ImageUrl" alt="@vehicle.LicensePlate" class="w-12 h-10 object-cover rounded-lg border border-outline-variant" />
                                } else {
                                    <div class="w-12 h-10 rounded-lg border border-outline-variant bg-surface-container-low flex items-center justify-center">
                                        <span class="material-symbols-outlined text-[18px] text-outline">directions_bus</span>
                                    </div>
                                }
                            </td>
                            <td class="p-4 font-bold text-primary font-mono tracking-wide">@vehicle.LicensePlate</td>
                            <td class="p-4">
                                <div class="font-bold text-on-surface">@vehicle.Model</div>
                                <div class="text-xs text-on-surface-variant">@(string.IsNullOrEmpty(vehicle.Category) ? "Transporte Turístico" : vehicle.Category)</div>
                            </td>
                            <td class="p-4">@vehicle.SeatCapacity pasajeros</td>
                            <td class="p-4 text-center">
                                @if (vehicle.Status == "Operativo en Ruta (En Servicio)") {
                                    <span class="inline-flex items-center gap-1 text-primary bg-primary-container/20 text-primary px-2.5 py-1 rounded-full font-label-sm font-bold">
                                        <span class="material-symbols-outlined text-[14px]">check_circle</span> Operativo
                                    </span>
                                } else if (vehicle.Status == "En Espera / Terminal") {
                                    <span class="inline-flex items-center gap-1 text-[#0284c7] bg-[#e0f2fe] px-2.5 py-1 rounded-full font-label-sm font-bold">
                                        <span class="material-symbols-outlined text-[14px]">store</span> En Espera / Terminal
                                    </span>
                                } else if (vehicle.Status == "En Mantenimiento Preventivo") {
                                    <span class="inline-flex items-center gap-1 text-amber-700 bg-amber-100 px-2.5 py-1 rounded-full font-label-sm font-bold">
                                        <span class="material-symbols-outlined text-[14px]">build</span> Mantenimiento
                                    </span>
                                } else {
                                    <span class="inline-flex items-center gap-1 text-error bg-error-container px-2.5 py-1 rounded-full font-label-sm font-bold">
                                        <span class="material-symbols-outlined text-[14px]">cancel</span> @vehicle.Status
                                    </span>
                                }
                            </td>
                            <td class="p-4 text-right space-x-1">
                                <a href="@Url.Action("EditVehicle", "Admin", new { id = vehicle.Id })" class="inline-block p-2 text-on-surface-variant hover:text-primary rounded-lg hover:bg-surface-container transition-colors" title="Editar">
                                    <span class="material-symbols-outlined text-[20px]">edit</span>
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr id="noVehiclesServerRow">
                        <td colspan="6" class="p-8 text-center text-on-surface-variant">
                            <span class="material-symbols-outlined text-outline text-4xl block mb-2">directions_bus</span>
                            No se encontraron vehículos con los criterios seleccionados.
                            @if (hasFilters)
                            {
                                <div class="mt-3">
                                    <a href="@Url.Action("Fleet", "Admin")" class="text-primary font-bold hover:underline">Limpiar filtros</a>
                                </div>
                            }
                        </td>
                    </tr>
                }
                <tr id="noVehiclesClientRow" class="hidden">
                    <td colspan="6" class="p-8 text-center text-on-surface-variant">
                        <span class="material-symbols-outlined text-outline text-4xl block mb-2">search_off</span>
                        No hay vehículos que coincidan con la búsqueda en tiempo real.
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const searchInput = document.getElementById('fleetSearchInput');
    const rows = document.querySelectorAll('.fleet-row');
    const noVehiclesClientRow = document.getElementById('noVehiclesClientRow');
    const countLabel = document.getElementById('fleetResultsCount');

    if (searchInput) {
        searchInput.addEventListener('input', function() {
            const query = this.value.trim().toLowerCase();
            let visibleCount = 0;

            rows.forEach(row => {
                const text = row.getAttribute('data-search') || '';
                const match = !query || text.includes(query);
                row.style.display = match ? '' : 'none';
                if (match) visibleCount++;
            });

            if (noVehiclesClientRow) {
                noVehiclesClientRow.classList.toggle('hidden', visibleCount > 0 || rows.length === 0);
            }

            if (countLabel && rows.length > 0) {
                countLabel.innerText = `Mostrando ${visibleCount} de ${rows.length} unidades`;
            }
        });
    }
});
</script>
