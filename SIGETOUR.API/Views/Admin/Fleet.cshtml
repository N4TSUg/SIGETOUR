<span class="material-symbols-outlined text-[28px]">local_parking</span>
</div>
</div>
<!-- KPI 4: En Mantenimiento -->
<div class="bg-surface-container-lowest rounded-xl p-space-md border border-outline-variant shadow-sm flex items-center justify-between relative overflow-hidden">
<div class="absolute left-0 top-0 bottom-0 w-1 bg-tertiary-container"></div>
