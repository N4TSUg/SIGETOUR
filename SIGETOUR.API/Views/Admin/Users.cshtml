<span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-surface-container text-on-secondary-container text-label-sm font-label-sm">
<span class="material-symbols-outlined text-[14px] text-primary" data-icon="badge">badge</span>
