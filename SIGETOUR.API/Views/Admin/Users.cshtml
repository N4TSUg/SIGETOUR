<span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-surface-container-high text-on-surface-variant text-label-sm font-label-sm">
<span class="w-2 h-2 rounded-full bg-primary-container"></span>
              Políticas Granulares de Claims
            </span>
</div>
<h1 class="text-headline-sm md:text-headline-md font-headline-md text-on-surface font-extrabold tracking-tight">
            Control de Acceso y Gestión de Usuarios Identity
          </h1>
<p class="text-body-md font-body-md text-on-surface-variant mt-1 max-w-3xl">
            Administración de cuentas corporativas, asignación de roles, permisos granulares y auditoría de seguridad para la flota administrativa de Turismo Chilón.
          </p>
</div>
<!-- Action CTAs -->
<div class="flex flex-wrap items-center gap-3 shrink-0">
<button class="inline-flex items-center gap-2 px-4 py-2.5 rounded-lg border border-outline text-on-surface hover:bg-surface-container text-label-lg font-label-lg transition-all duration-150 active:scale-95 shadow-xs" id="btnAuditoria">
<span class="material-symbols-outlined text-primary text-[19px]" data-icon="history">history</span>
            Auditoría de Inicios de Sesión
          </button>
<button class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg bg-primary hover:bg-primary-container text-on-primary text-label-lg font-label-lg shadow-sm transition-all duration-150 active:scale-95" id="btnNuevoUsuario">
<span class="material-symbols-outlined text-[20px]" data-icon="person_add">person_add</span>
