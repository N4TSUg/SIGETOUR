@model SIGETOUR.API.ViewModels.DashboardViewModel
@using SIGETOUR.API.Core.Entities
@{
    ViewData["Title"] = "Panel de Control y Despacho Operativo";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="space-y-6">
    <!-- Header Contextual -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <div class="flex items-center gap-2">
                <span class="w-2.5 h-2.5 rounded-full bg-primary animate-pulse"></span>
                <span class="text-label-sm font-label-sm text-primary font-bold uppercase tracking-wider">Centro de Operaciones y Despacho en Vivo</span>
                <span class="text-label-sm text-outline">• Jr. 2 de Mayo 569, Cajamarca</span>
            </div>
            <h1 class="text-headline-md font-bold text-on-surface mt-1">Dashboard General de Turismo Chilón</h1>
            <p class="text-body-sm text-on-surface-variant">Monitoreo en tiempo real de salidas turísticas, capacidad vehicular, caja y cumplimiento normativo.</p>
        </div>
        <div class="flex flex-wrap items-center gap-3">
            <!-- Contador de Visitas Web -->
            <div class="flex items-center gap-2 px-3.5 py-2 rounded-xl bg-surface-container-lowest border border-outline-variant/70 shadow-xs text-xs font-semibold text-on-surface" title="Personas que han visitado la página web">
                <span class="material-symbols-outlined text-primary text-[19px]">visibility</span>
                <span>Visitas Web: <strong class="text-primary font-bold">@Model.TotalSiteVisits.ToString("N0")</strong> <span class="text-outline font-normal">(@Model.TodaySiteVisits hoy)</span></span>
            </div>
            <a asp-controller="Admin" asp-action="CreateBooking" class="px-4 py-2.5 bg-primary text-on-primary font-label-md font-bold rounded-xl shadow-sm hover:bg-primary/90 transition-all flex items-center gap-2">
                <span class="material-symbols-outlined text-[20px]">add_circle</span>
                Nueva Reserva
            </a>
            <a asp-controller="Admin" asp-action="Cash" class="px-3.5 py-2.5 bg-surface-container-lowest border border-outline-variant text-on-surface font-label-md rounded-xl hover:bg-surface-container transition-colors flex items-center gap-2 shadow-sm">
                <span class="material-symbols-outlined text-primary text-[20px]">point_of_sale</span>
                Caja Chica
            </a>
        </div>
    </div>

    <!-- 1. Operational KPI Ribbon -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <!-- KPI 1: Pasajeros Hoy -->
        <div class="bg-surface-container-lowest rounded-2xl p-5 border border-outline-variant/60 shadow-sm flex flex-col justify-between">
            <div class="flex items-center justify-between">
                <div>
                    <span class="text-label-md text-on-surface-variant font-bold">Pasajeros Movilizados Hoy</span>
                    <p class="text-[11px] text-outline">Capacidad de flota: @Model.TotalDailyCapacity plazas</p>
                </div>
                <span class="w-9 h-9 rounded-xl bg-primary-container text-primary flex items-center justify-center">
                    <span class="material-symbols-outlined text-[20px]">groups</span>
                </span>
            </div>
            <div class="my-3">
                <div class="text-display-sm font-extrabold text-on-surface">
                    @Model.TodayPassengers <span class="text-label-md text-outline font-normal">/ @Model.TotalDailyCapacity plazas hoy</span>
                </div>
                <div class="mt-2">
                    <div class="flex justify-between text-body-sm text-outline mb-1 font-semibold">
                        <span>Ocupación de la flota</span>
                        <span class="font-bold text-primary">@Model.OccupancyPercentage%</span>
                    </div>
                    <div class="w-full bg-surface-container rounded-full h-2 overflow-hidden">
                        <div class="bg-primary h-2 rounded-full transition-all duration-500" style="width: @Model.OccupancyPercentage%"></div>
                    </div>
                </div>
            </div>
            <div class="text-body-sm text-outline border-t border-outline-variant/30 pt-2 flex justify-between items-center">
                @if (Model.UpcomingPassengersCount > 0)
                {
                    <span title="Próximos pasajeros con reservas confirmadas" class="flex items-center gap-1 text-primary font-bold text-xs truncate">
                        <span class="material-symbols-outlined text-[15px]">event</span> Próximos: @Model.UpcomingPassengersCount pax (@Model.NextDepartureDateText)
                    </span>
                }
                else
                {
                    <span>Total histórico</span>
                    <span class="font-bold text-on-surface">@Model.TotalBookings reservas</span>
                }
            </div>
        </div>

        <!-- KPI 2: Salidas y Circuitos -->
        <div class="bg-surface-container-lowest rounded-2xl p-5 border border-outline-variant/60 shadow-sm flex flex-col justify-between">
            <div class="flex items-center justify-between">
                <span class="text-label-md text-on-surface-variant font-bold">Salidas Programadas Hoy</span>
                <span class="w-9 h-9 rounded-xl bg-secondary-container text-secondary flex items-center justify-center">
                    <span class="material-symbols-outlined text-[20px]">tour</span>
                </span>
            </div>
            <div class="my-3">
                <div class="text-display-sm font-extrabold text-on-surface">
                    @Model.TodayDeparturesCount <span class="text-label-md text-outline font-normal">circuitos hoy</span>
                </div>
                @{
                    var todayDeps = Model.Departures.Where(d => d.DepartureDate.Date == DateTime.UtcNow.AddHours(-5).Date).ToList();
                    var enRutaCount = todayDeps.Count(d => d.Status.StartsWith("En Ruta"));
                    var abordandoCount = todayDeps.Count(d => d.Status.StartsWith("Abordando"));
                    var enEsperaCount = todayDeps.Count(d => d.Status.StartsWith("En Espera"));
                    var finalizadoCount = todayDeps.Count(d => d.Status.StartsWith("Finalizado"));
                }
                <div class="flex flex-wrap gap-1.5 mt-2">
                    @if (Model.TodayDeparturesCount > 0)
                    {
                        <span class="inline-flex items-center gap-1 text-[11px] font-bold px-2 py-0.5 rounded bg-emerald-100 text-emerald-800">
                            <span class="w-1.5 h-1.5 rounded-full bg-emerald-600"></span> @enRutaCount en ruta
                        </span>
                        <span class="inline-flex items-center gap-1 text-[11px] font-bold px-2 py-0.5 rounded bg-amber-100 text-amber-800">
                            <span class="w-1.5 h-1.5 rounded-full bg-amber-600"></span> @abordandoCount abordando
                        </span>
                        <span class="inline-flex items-center gap-1 text-[11px] font-bold px-2 py-0.5 rounded bg-slate-100 text-slate-700">
                            <span class="w-1.5 h-1.5 rounded-full bg-slate-400"></span> @enEsperaCount en espera
                        </span>
                        @if (finalizadoCount > 0)
                        {
                            <span class="inline-flex items-center gap-1 text-[11px] font-bold px-2 py-0.5 rounded bg-zinc-100 text-zinc-700">
                                <span class="w-1.5 h-1.5 rounded-full bg-zinc-500"></span> @finalizadoCount finalizados
                            </span>
                        }
                    }
                    else if (!string.IsNullOrEmpty(Model.NextDepartureDateText))
                    {
                        <span class="inline-flex items-center gap-1 text-[11px] font-bold px-2 py-0.5 rounded bg-sky-100 text-sky-800">
                            <span class="material-symbols-outlined text-[14px]">event</span> Próxima salida: @Model.NextDepartureDateText
                        </span>
                    }
                    else
                    {
                        <span class="inline-flex items-center gap-1 text-[11px] font-bold px-2 py-0.5 rounded bg-slate-100 text-slate-600">
                            Sin salidas programadas hoy
                        </span>
                    }
                </div>
            </div>
            <div class="text-body-sm text-outline border-t border-outline-variant/30 pt-2 flex justify-between items-center">
                <span>Catálogo de tours</span>
                <a asp-controller="Admin" asp-action="Tours" class="font-bold text-primary hover:underline">@Model.TotalTours activos</a>
            </div>
        </div>

        <!-- KPI 3: Recaudación Diaria -->
        <div class="bg-surface-container-lowest rounded-2xl p-5 border border-outline-variant/60 shadow-sm flex flex-col justify-between">
            <div class="flex items-center justify-between">
                <span class="text-label-md text-on-surface-variant font-bold">Recaudación Estimada Hoy</span>
                <span class="w-9 h-9 rounded-xl bg-emerald-50 text-emerald-700 flex items-center justify-center">
                    <span class="material-symbols-outlined text-[20px]">payments</span>
                </span>
            </div>
            <div class="my-3">
                <div class="text-display-sm font-extrabold text-primary">
                    S/ @Model.TodayIncome.ToString("N2")
                </div>
                <div class="flex justify-between items-center text-body-sm mt-2">
                    <span class="text-on-surface-variant">Cobrado: <strong class="text-emerald-700">S/ @Model.TodayIncome.ToString("N2")</strong></span>
                    <span class="text-outline">Saldo: <strong class="text-tertiary">S/ @Model.TodayPending.ToString("N2")</strong></span>
                </div>
            </div>
            <div class="text-body-sm text-outline border-t border-outline-variant/30 pt-2 flex justify-between items-center">
                <span>Ventanilla & Web</span>
                <span class="text-emerald-700 font-bold flex items-center gap-1">
                    <span class="material-symbols-outlined text-sm">check_circle</span> Conciliado
                </span>
            </div>
        </div>

        <!-- KPI 4: Flota en Operación -->
        <div class="bg-surface-container-lowest rounded-2xl p-5 border border-outline-variant/60 shadow-sm flex flex-col justify-between">
            <div class="flex items-center justify-between">
                <span class="text-label-md text-on-surface-variant font-bold">Flota Operativa</span>
                <span class="w-9 h-9 rounded-xl bg-surface-container text-primary flex items-center justify-center">
                    <span class="material-symbols-outlined text-[20px]">directions_bus</span>
                </span>
            </div>
            <div class="my-3">
                <div class="text-display-sm font-extrabold text-on-surface">
                    @Model.ActiveVehicles <span class="text-label-md text-outline font-normal">/ @Model.TotalVehicles unidades</span>
                </div>
                <p class="text-body-sm text-on-surface-variant mt-2">
                    Mercedes Sprinter & Toyota HiAce autorizadas MTC
                </p>
            </div>
            <div class="text-body-sm text-outline border-t border-outline-variant/30 pt-2 flex justify-between items-center">
                @if (Model.FleetAlerts.Any(a => a.IsExpired))
                {
                    <span class="text-tertiary font-bold flex items-center gap-1">
                        <span class="material-symbols-outlined text-sm">warning</span> Alertas pendientes
                    </span>
                }
                else
                {
                    <span class="text-emerald-700 font-semibold flex items-center gap-1">
                        <span class="w-2 h-2 rounded-full bg-emerald-600"></span> Flota operativa
                    </span>
                }
                <a asp-controller="Admin" asp-action="Fleet" class="text-label-sm font-bold text-primary hover:underline">Gestionar Flota</a>
            </div>
        </div>
    </div>

    <!-- 2. Tablero de Salidas y Despacho en Vivo / Historial -->
    <div id="tablero-despacho" class="bg-surface-container-lowest rounded-2xl border border-outline-variant/60 shadow-sm overflow-hidden flex flex-col">
        <div class="p-5 border-b border-outline-variant/40 flex flex-col lg:flex-row lg:items-center justify-between gap-4 bg-surface-bright">
            <div class="flex flex-wrap items-center gap-3">
                <span class="w-3 h-3 rounded-full bg-primary animate-ping"></span>
                <div>
                    <h2 class="text-title-md font-bold text-on-surface">Tablero de Salidas y Despacho</h2>
                    <p class="text-body-sm text-outline">Programación de circuitos en vivo, asignación de flota y regularización de manifiestos.</p>
                </div>
            </div>
            <div class="flex flex-wrap items-center gap-2.5">
                <!-- Pestañas Operativas: En Vivo vs Historial -->
                <div class="inline-flex p-1 bg-surface-container rounded-xl border border-outline-variant/50 text-label-sm">
                    <button type="button" id="tabBtnActive" onclick="switchDepartureTab('active')" class="px-3 py-1.5 rounded-lg font-bold transition-all flex items-center gap-1.5 bg-primary text-on-primary shadow-xs cursor-pointer">
                        <span class="material-symbols-outlined text-[16px]">departure_board</span>
                        <span>En Vivo y Próximas</span>
                        <span id="badgeActiveCount" class="px-1.5 py-0.2 rounded-full text-[10px] bg-white/20 text-white font-extrabold">
                            @Model.ActiveDeparturesCount
                        </span>
                    </button>
                    <button type="button" id="tabBtnHistory" onclick="switchDepartureTab('history')" class="px-3 py-1.5 rounded-lg font-medium transition-all flex items-center gap-1.5 text-on-surface-variant hover:text-on-surface hover:bg-surface-bright cursor-pointer">
                        <span class="material-symbols-outlined text-[16px]">history</span>
                        <span>Historial Concluido</span>
                        <span id="badgeHistoryCount" class="px-1.5 py-0.2 rounded-full text-[10px] bg-outline-variant/40 text-on-surface font-extrabold">
                            @Model.HistoricalDeparturesCount
                        </span>
                    </button>
                </div>

                <a asp-controller="Admin" asp-action="Bookings" class="text-label-sm px-3 py-1.5 rounded-lg border border-outline-variant text-on-surface-variant hover:bg-surface-container font-semibold transition-colors flex items-center gap-1">
                    <span class="material-symbols-outlined text-[16px]">table_view</span>
                    <span>Ver Reservas</span>
                </a>
            </div>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="border-b border-outline-variant/30 bg-surface/50 text-label-sm text-on-surface-variant uppercase tracking-wider font-bold">
                        <th class="py-3 px-4">Fecha de Salida</th>
                        <th class="py-3 px-4">Hora</th>
                        <th class="py-3 px-4">Circuito / Destino Turístico</th>
                        <th class="py-3 px-4">Unidad &amp; Placa</th>
                        <th class="py-3 px-4">Personal Asignado</th>
                        <th class="py-3 px-4">Ocupación Pax</th>
                        <th class="py-3 px-4">Estado / Manifiesto</th>
                        <th class="py-3 px-4 text-right">Acciones</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-outline-variant/20 text-body-sm">
                    @{
                        var activeDeps = Model.Departures.Where(d => !d.IsHistorical).OrderBy(d => d.DepartureDate).ThenBy(d => d.Time).ToList();
                        var historyDeps = Model.Departures.Where(d => d.IsHistorical).OrderByDescending(d => d.DepartureDate).ThenByDescending(d => d.Time).ToList();
                        var allRenderDeps = activeDeps.Concat(historyDeps).ToList();
                    }

                    @if (allRenderDeps.Any())
                    {
                        foreach (var dep in allRenderDeps)
                        {
                            var pct = dep.TotalCapacity > 0 ? (int)Math.Min(100, Math.Round((double)dep.BookedSeats / dep.TotalCapacity * 100)) : 0;
                            var isFull = dep.BookedSeats >= dep.TotalCapacity;
                            var rowId = $"row-{dep.TourId}-{dep.DepartureDate:yyyyMMdd}-{(dep.ShiftName ?? "").Replace(" ", "")}";

                            <tr class="departure-row hover:bg-surface-container-low/40 transition-colors @(dep.IsHistorical ? "hidden" : "")"
                                data-tab-type="@(dep.IsHistorical ? "history" : "active")"
                                data-dep-id="@rowId"
                                data-tour-id="@dep.TourId"
                                data-tour-title="@dep.TourTitle"
                                data-date="@dep.DepartureDate.ToString("yyyy-MM-dd")"
                                data-date-formatted="@dep.FormattedDate"
                                data-shift="@dep.ShiftName"
                                data-pax="@dep.BookedSeats"
                                data-vehicle-id="@(dep.VehicleId?.ToString() ?? "")"
                                data-driver-id="@(dep.DriverId?.ToString() ?? "")">
                                
                                <td class="py-3.5 px-4 whitespace-nowrap">
                                    <div class="flex items-center gap-2">
                                        <div class="w-8 h-8 rounded-lg @(dep.IsHistorical ? "bg-surface-container text-outline" : "bg-primary/10 text-primary") flex items-center justify-center shrink-0">
                                            <span class="material-symbols-outlined text-[18px]">calendar_month</span>
                                        </div>
                                        <div>
                                            <div class="font-bold text-on-surface text-body-sm">@dep.FormattedDate</div>
                                            <div class="text-[11px] text-outline capitalize">@dep.DepartureDate.ToString("dddd", new System.Globalization.CultureInfo("es-PE"))</div>
                                        </div>
                                    </div>
                                </td>
                                <td class="py-3.5 px-4 font-bold @(dep.IsHistorical ? "text-on-surface-variant font-mono" : "text-primary font-mono") text-title-sm whitespace-nowrap">
                                    @dep.Time
                                    @if (!string.IsNullOrWhiteSpace(dep.ShiftName) && !dep.ShiftName.Equals("General", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <div class="text-[10px] text-outline font-normal">@dep.ShiftName</div>
                                    }
                                </td>
                                <td class="py-3.5 px-4">
                                    <div class="font-bold text-on-surface">@dep.TourTitle</div>
                                    <div class="text-label-sm text-outline">@dep.Subtitle</div>
                                </td>
                                <td class="py-3.5 px-4">
                                    @if (!string.IsNullOrWhiteSpace(dep.VehicleModel))
                                    {
                                        <div class="flex items-center gap-1.5 font-semibold text-on-surface">
                                            <span class="material-symbols-outlined text-[18px] text-primary">directions_bus</span>
                                            <span class="vehicle-model-label">@dep.VehicleModel</span>
                                        </div>
                                        <div class="text-label-sm font-mono text-outline license-plate-label">Placa: @dep.LicensePlate</div>
                                    }
                                    else
                                    {
                                        <div class="flex items-center gap-1.5 @(dep.IsHistorical ? "text-amber-800" : "text-outline") text-label-sm">
                                            <span class="material-symbols-outlined text-[18px] @(dep.IsHistorical ? "text-amber-600" : "text-outline")">pending</span>
                                            <span class="italic font-medium vehicle-model-label">Sin unidad asignada</span>
                                        </div>
                                        <div class="text-[11px] @(dep.IsHistorical ? "text-amber-700 font-semibold" : "text-outline/80") license-plate-label">
                                            @(dep.IsHistorical ? "Manifiesto manual por regularizar" : "Por asignar en manifiesto")
                                        </div>
                                    }
                                </td>
                                <td class="py-3.5 px-4">
                                    @if (!string.IsNullOrWhiteSpace(dep.DriverName))
                                    {
                                        <div class="font-medium text-on-surface driver-name-label">@dep.DriverName</div>
                                    }
                                    else
                                    {
                                        <div class="flex items-center gap-1.5 text-outline text-label-sm">
                                            <span class="material-symbols-outlined text-[18px] text-outline">person_off</span>
                                            <span class="italic font-medium driver-name-label">Sin conductor asignado</span>
                                        </div>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(dep.GuideName))
                                    {
                                        <div class="text-label-sm text-primary font-semibold flex items-center gap-0.5">
                                            <span class="material-symbols-outlined text-[14px]">badge</span> @dep.GuideName
                                        </div>
                                    }
                                </td>
                                <td class="py-3.5 px-4">
                                    <div class="flex items-center gap-2">
                                        <span class="font-bold @(isFull ? "text-emerald-700" : "text-on-surface")">
                                            @dep.BookedSeats / @dep.TotalCapacity
                                        </span>
                                        @if (isFull)
                                        {
                                            <span class="px-1.5 py-0.5 bg-emerald-100 text-emerald-800 rounded text-[10px] font-bold">LLENO</span>
                                        }
                                        else
                                        {
                                            <span class="text-[10px] text-outline font-semibold">@(dep.TotalCapacity - dep.BookedSeats) disp.</span>
                                        }
                                    </div>
                                    <div class="w-24 bg-surface-container rounded-full h-1.5 mt-1 overflow-hidden">
                                        <div class="@(isFull ? "bg-emerald-600" : "bg-primary") h-1.5 rounded-full" style="width: @pct%"></div>
                                    </div>
                                </td>
                                <td class="py-3.5 px-4">
                                    <div class="flex flex-col gap-1 items-start">
                                        @if (dep.StatusColor == "emerald")
                                        {
                                            <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[11px] font-bold bg-emerald-100 text-emerald-800 border border-emerald-300">
                                                <span class="w-1.5 h-1.5 rounded-full bg-emerald-600 animate-pulse"></span>
                                                @dep.Status
                                            </span>
                                        }
                                        else if (dep.StatusColor == "amber")
                                        {
                                            <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[11px] font-bold bg-amber-100 text-amber-900 border border-amber-300">
                                                <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>
                                                @dep.Status
                                            </span>
                                        }
                                        else if (dep.StatusColor == "sky")
                                        {
                                            <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[11px] font-bold bg-sky-100 text-sky-900 border border-sky-300">
                                                <span class="w-1.5 h-1.5 rounded-full bg-sky-500"></span>
                                                @dep.Status
                                            </span>
                                        }
                                        else if (dep.StatusColor == "zinc")
                                        {
                                            <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[11px] font-bold bg-zinc-100 text-zinc-700 border border-zinc-300">
                                                <span class="material-symbols-outlined text-[13px] text-zinc-600">check_circle</span>
                                                @dep.Status
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[11px] font-bold bg-slate-100 text-slate-800 border border-slate-300">
                                                <span class="w-1.5 h-1.5 rounded-full bg-slate-400"></span>
                                                @dep.Status
                                            </span>
                                        }

                                        <!-- Badge de Estado del Manifiesto -->
                                        @if (dep.IsHistorical)
                                        {
                                            @if (dep.IsManifestRegularized)
                                            {
                                                <span class="manifest-status-badge inline-flex items-center gap-0.5 px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-50 text-emerald-800 border border-emerald-200">
                                                    <span class="material-symbols-outlined text-[12px]">verified</span> Manifiesto OK
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="manifest-status-badge inline-flex items-center gap-0.5 px-2 py-0.5 rounded text-[10px] font-bold bg-amber-50 text-amber-900 border border-amber-300">
                                                    <span class="material-symbols-outlined text-[12px]">edit_note</span> Pendiente Regularizar
                                                </span>
                                            }
                                        }
                                    </div>
                                </td>
                                <td class="py-3.5 px-4 text-right">
                                    <div class="flex items-center justify-end gap-1.5">
                                        <!-- Botón Descargar Manifiesto Excel MTC -->
                                        <a href="@Url.Action("ExportManifestExcel", "Admin", new { tourPackageId = dep.TourId, date = dep.DepartureDate.ToString("yyyy-MM-dd"), shiftName = dep.ShiftName, vehicleId = dep.VehicleId, driverId = dep.DriverId })"
                                           target="_blank"
                                           class="btn-export-manifest inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg @(dep.VehicleId.HasValue ? "bg-emerald-50 hover:bg-emerald-100 text-emerald-800 border border-emerald-300 font-bold" : "hover:bg-emerald-50 text-emerald-700 border border-emerald-200") text-[11px] transition-all shadow-2xs"
                                           title="Descargar Manifiesto Oficial de Pasajeros (Excel MTC)">
                                            <span class="material-symbols-outlined text-[16px] text-emerald-700">table_view</span>
                                            <span>Manifiesto MTC</span>
                                        </a>

                                        <!-- Botón Regularizar / Asignar / Modificar Despacho -->
                                        <button type="button"
                                                onclick="openRegularizeModalFromRow(this)"
                                                class="btn-assign-departure px-2 py-1 rounded-lg @(dep.IsHistorical && !dep.IsManifestRegularized ? "bg-amber-100 hover:bg-amber-200 text-amber-900 border border-amber-300 font-bold" : (dep.VehicleId.HasValue ? "hover:bg-primary/10 text-primary border border-primary/20 hover:border-primary" : "bg-primary text-on-primary hover:bg-primary/90 font-bold shadow-xs")) text-[11px] flex items-center gap-1 transition-all cursor-pointer shadow-2xs"
                                                title="@(dep.IsHistorical ? "Regularizar Manifiesto Manual / Normalizar Asignación" : (dep.VehicleId.HasValue ? "Modificar Unidad y Conductor Asignados" : "Asignar Flota y Conductor de Despacho"))">
                                            <span class="material-symbols-outlined text-[16px]">@(dep.IsHistorical ? (dep.IsManifestRegularized ? "edit" : "assignment_turned_in") : (dep.VehicleId.HasValue ? "edit" : "assignment_add"))</span>
                                            <span>@(dep.IsHistorical ? (dep.IsManifestRegularized ? "Modificar" : "Regularizar") : (dep.VehicleId.HasValue ? "Modificar" : "Asignar"))</span>
                                        </button>

                                        <!-- Botón Ver Pasajeros / Reservas -->
                                        <a asp-controller="Admin" asp-action="Bookings" asp-route-tourId="@dep.TourId"
                                           class="p-1.5 rounded-lg hover:bg-surface-container text-outline hover:text-on-surface transition-colors"
                                           title="Ver Reservas y Pasajeros">
                                            <span class="material-symbols-outlined text-[18px]">group</span>
                                        </a>

                                        @if (!dep.IsHistorical)
                                        {
                                            <!-- Botón Cancelar Salida Completa y Regularizar Devoluciones -->
                                            <button type="button"
                                                    onclick="openCancelDepartureModalFromRow(this)"
                                                    class="p-1.5 rounded-lg hover:bg-red-50 text-red-600 border border-transparent hover:border-red-200 transition-colors cursor-pointer"
                                                    title="Cancelar Salida Completa y Procesar Devoluciones (Caja General y SUNAT)">
                                                <span class="material-symbols-outlined text-[18px]">event_busy</span>
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }

                    <!-- Estado Vacío: Pestaña En Vivo y Próximas -->
                    <tr id="activeEmptyState" class="@(activeDeps.Any() ? "hidden" : "")">
                        <td colspan="8" class="py-12 px-4 text-center">
                            <div class="max-w-md mx-auto flex flex-col items-center">
                                <div class="w-12 h-12 rounded-full bg-primary/10 text-primary flex items-center justify-center mb-3">
                                    <span class="material-symbols-outlined text-2xl">event_available</span>
                                </div>
                                <h3 class="text-title-sm font-bold text-on-surface">No hay salidas programadas para hoy ni próximas fechas</h3>
                                <p class="text-body-sm text-outline mt-1 mb-4 leading-relaxed">
                                    Las salidas de días anteriores se encuentran archivadas en la pestaña <strong>Historial Concluido</strong> para su consulta y regularización de manifiestos.
                                </p>
                                <div class="flex flex-wrap items-center justify-center gap-3">
                                    @if (historyDeps.Any())
                                    {
                                        <button type="button" onclick="switchDepartureTab('history')" class="px-4 py-2 rounded-lg bg-surface-container hover:bg-surface-container-high text-on-surface font-semibold text-label-sm border border-outline-variant flex items-center gap-1.5 transition-colors cursor-pointer">
                                            <span class="material-symbols-outlined text-[18px]">history</span>
                                            <span>Ver Historial Concluido (@historyDeps.Count)</span>
                                        </button>
                                    }
                                    <a asp-controller="Admin" asp-action="CreateBooking" class="px-4 py-2 rounded-lg bg-primary hover:bg-primary/90 text-on-primary font-bold text-label-sm shadow-sm flex items-center gap-1.5 transition-colors">
                                        <span class="material-symbols-outlined text-[18px]">add</span>
                                        <span>Registrar Nueva Reserva</span>
                                    </a>
                                </div>
                            </div>
                        </td>
                    </tr>

                    <!-- Estado Vacío: Pestaña Historial Concluido -->
                    <tr id="historyEmptyState" class="hidden">
                        <td colspan="8" class="py-12 px-4 text-center text-outline">
                            <div class="flex flex-col items-center justify-center">
                                <span class="material-symbols-outlined text-3xl mb-1 text-outline">history</span>
                                <span>No hay salidas históricas concluidas registradas en el sistema.</span>
                            </div>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <!-- 3. Complementary Two-Column Bento Layout -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
        <!-- Columna Izquierda (7 Cols): Demanda por Circuito -->
        <div class="lg:col-span-7 bg-surface-container-lowest rounded-2xl p-6 border border-outline-variant/60 shadow-sm flex flex-col justify-between">
            <div>
                <div class="flex items-center justify-between pb-4 border-b border-outline-variant/30">
                    <div>
                        <h3 class="text-title-md font-bold text-on-surface">Demanda Turística por Circuito</h3>
                        <p class="text-body-sm text-outline">Distribución porcentual de pasajeros y reservas confirmadas.</p>
                    </div>
                    <span class="text-label-sm bg-surface-container px-2.5 py-1 rounded-lg text-primary font-bold border border-outline-variant/40">
                        Cajamarca Histórico
                    </span>
                </div>

                <!-- Custom Visual Bars for Tour Demands -->
                <div class="mt-6 space-y-4">
                    @if (Model.CircuitDemands.Any())
                    {
                        int rank = 1;
                        foreach (var demand in Model.CircuitDemands)
                        {
                            <div>
                                <div class="flex justify-between items-center text-body-sm mb-1.5">
                                    <span class="font-bold text-on-surface">@rank. @demand.TourTitle <span class="text-outline font-normal text-label-sm">(@demand.CategoryName)</span></span>
                                    <span class="font-bold text-primary">@demand.Percentage% <span class="text-outline font-normal">(@demand.PassengerCount pax)</span></span>
                                </div>
                                <div class="w-full bg-surface-container rounded-full h-3 overflow-hidden">
                                    <div class="@demand.ColorClass h-3 rounded-full transition-all duration-500" style="width: @demand.Percentage%"></div>
                                </div>
                            </div>
                            rank++;
                        }
                    }
                    else
                    {
                        <p class="text-on-surface-variant text-body-sm">No hay datos de demanda acumulados.</p>
                    }
                </div>
            </div>

            <!-- Bottom Summary Badge -->
            <div class="mt-6 p-4 bg-surface-container/40 rounded-xl border border-outline-variant/30 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                <div class="flex items-center gap-2">
                    <span class="material-symbols-outlined text-primary text-[20px]">verified</span>
                    <span class="text-body-sm text-on-surface">
                        Capacidad operativa diaria: <strong>@Model.TotalDailyCapacity plazas</strong> en @Model.ActiveVehicles vans autorizadas
                    </span>
                </div>
                <span class="text-label-sm text-primary font-bold">
                    @(Math.Max(0, Model.TotalDailyCapacity - Model.TodayPassengers)) Asientos Restantes Hoy
                </span>
            </div>
        </div>

        <!-- Columna Derecha (5 Cols): Alertas MTC y Últimas Reservas -->
        <div class="lg:col-span-5 flex flex-col gap-6">
            <!-- Box 1: Alerta Regulatoria MTC / SUTRAN -->
            <div class="bg-surface-container-lowest rounded-2xl p-5 border border-outline-variant/60 shadow-sm">
                <div class="flex items-center justify-between mb-3">
                    <span class="flex items-center gap-1.5 text-title-sm font-bold text-on-surface">
                        <span class="material-symbols-outlined text-emerald-600 text-[22px]">verified_user</span>
                        Cumplimiento SUTRAN / MTC
                    </span>
                    @if (Model.FleetAlerts.Any(a => a.IsExpired))
                    {
                        <span class="text-[11px] font-bold text-tertiary bg-error-container px-2 py-0.5 rounded">ATENCIÓN REQUERIDA</span>
                    }
                    else
                    {
                        <span class="text-[11px] font-bold text-emerald-800 bg-emerald-100 px-2 py-0.5 rounded">100% AL DÍA</span>
                    }
                </div>

                @if (Model.FleetAlerts.Any())
                {
                    <div class="space-y-2 mt-2">
                        @foreach (var alert in Model.FleetAlerts)
                        {
                            <div class="p-3 rounded-xl @(alert.IsExpired ? "bg-red-50 border border-red-200 text-red-900" : "bg-amber-50 border border-amber-200 text-amber-900") text-body-sm flex items-start gap-2.5">
                                <span class="material-symbols-outlined text-[20px] @(alert.IsExpired ? "text-tertiary" : "text-amber-600") shrink-0">
                                    @(alert.IsExpired ? "error" : "schedule")
                                </span>
                                <div class="flex-1">
                                    <div class="font-bold">@alert.LicensePlate - @alert.Model</div>
                                    <div class="text-[11px]">
                                        @alert.AlertType @(alert.IsExpired ? "VENCIDO" : $"vence en {alert.DaysRemaining} días") (@alert.ExpiryDate.ToString("dd/MM/yyyy"))
                                    </div>
                                </div>
                                <a asp-controller="Admin" asp-action="Fleet" class="text-label-sm font-bold underline shrink-0">Revisar</a>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="text-body-sm text-on-surface-variant leading-relaxed">
                        Toda la flota cuenta con SOAT turístico vigente, habilitación técnica y tarjeta única de circulación (TUC) verificadas para el transporte turístico interprovincial.
                    </p>
                }
            </div>

            <!-- Box 2: Últimas Reservas en Ventanilla -->
            <div class="bg-surface-container-lowest rounded-2xl p-5 border border-outline-variant/60 shadow-sm flex-1 flex flex-col justify-between">
                <div>
                    <div class="flex items-center justify-between pb-3 border-b border-outline-variant/30">
                        <h4 class="text-title-sm font-bold text-on-surface flex items-center gap-1.5">
                            <span class="material-symbols-outlined text-primary text-[20px]">receipt_long</span>
                            Últimas Reservas Registradas
                        </h4>
                        <a asp-controller="Admin" asp-action="Bookings" class="text-label-sm text-primary font-bold hover:underline">Ver todas</a>
                    </div>

                    <div class="divide-y divide-outline-variant/20 mt-2">
                        @if (Model.RecentBookings.Any())
                        {
                            foreach (var b in Model.RecentBookings.Take(4))
                            {
                                var tourName = b.Items.FirstOrDefault()?.TourPackage?.Title ?? "Circuito Cajamarca";
                                <div class="py-2.5 flex items-center justify-between text-body-sm">
                                    <div>
                                        <div class="font-bold text-on-surface">@b.CustomerName (@b.TotalPassengers boletos)</div>
                                        <div class="text-[11px] text-outline">@tourName • S/ @b.TotalAmount.ToString("N2") • @(string.IsNullOrEmpty(b.PaymentMethod) ? "Efectivo" : b.PaymentMethod)</div>
                                    </div>
                                    <span class="text-[11px] font-bold @(b.Status == BookingStatus.Confirmed ? "text-emerald-700 bg-emerald-50 border border-emerald-200" : "text-amber-800 bg-amber-50 border border-amber-200") px-2 py-0.5 rounded">
                                        @(b.Status == BookingStatus.Confirmed ? "Confirmado" : b.Status.ToString())
                                    </span>
                                </div>
                            }
                        }
                        else
                        {
                            <p class="text-outline text-body-sm py-4 text-center">No hay reservas registradas.</p>
                        }
                    </div>
                </div>

                <div class="pt-3 border-t border-outline-variant/30 mt-3 flex items-center justify-between text-body-sm">
                    <span class="text-outline font-medium">Sede Central: Jr. 2 de Mayo 569</span>
                    <a asp-controller="Admin" asp-action="CreateBooking" class="text-primary font-bold hover:underline flex items-center gap-1 text-label-sm">
                        <span>Registrar Venta</span>
                        <span class="material-symbols-outlined text-[16px]">arrow_forward</span>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal de Regularización y Normalización de Manifiesto (Operación y Archivo Histórico) -->
<div id="regularizeManifestModal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-inverse-surface/60 backdrop-blur-sm transition-all duration-200 hidden">
    <div class="bg-surface-container-lowest rounded-2xl max-w-xl w-full p-6 shadow-2xl border border-outline-variant relative max-h-[92vh] overflow-y-auto">
        <div class="flex items-start justify-between border-b border-outline-variant/60 pb-4 mb-4">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-primary/10 text-primary flex items-center justify-center">
                    <span class="material-symbols-outlined text-2xl">assignment_turned_in</span>
                </div>
                <div>
                    <h3 id="regModalTitle" class="text-title-md font-bold text-on-surface">Regularizar Manifiesto de Salida</h3>
                    <p class="text-label-sm text-outline">Asignación de unidad y conductor para normalización de manifiesto MTC/SUTRAN</p>
                </div>
            </div>
            <button type="button" onclick="closeRegularizeModal()" class="p-1 rounded-lg hover:bg-surface-container text-outline hover:text-on-surface transition-colors cursor-pointer">
                <span class="material-symbols-outlined text-2xl">close</span>
            </button>
        </div>

        <!-- Resumen de la Salida -->
        <div class="mb-5 p-3.5 rounded-xl bg-surface-container-low/70 border border-outline-variant/40 space-y-2">
            <div class="flex items-center justify-between text-body-sm">
                <span class="text-outline">Circuito Turístico:</span>
                <span id="regSummaryTour" class="font-bold text-on-surface"></span>
            </div>
            <div class="flex items-center justify-between text-body-sm">
                <span class="text-outline">Fecha de Recorrido:</span>
                <span id="regSummaryDate" class="font-bold text-primary"></span>
            </div>
            <div class="flex items-center justify-between text-body-sm">
                <span class="text-outline">Turno Operativo:</span>
                <span id="regSummaryShift" class="font-medium text-on-surface"></span>
            </div>
            <div class="flex items-center justify-between text-body-sm">
                <span class="text-outline">Pasajeros Confirmados:</span>
                <span id="regSummaryPax" class="font-bold text-emerald-700 bg-emerald-100 px-2 py-0.5 rounded text-label-sm"></span>
            </div>
        </div>

        <form id="regularizeManifestForm" onsubmit="submitRegularizeManifest(event)" class="space-y-4">
            @Html.AntiForgeryToken()
            <input type="hidden" id="regTourId" name="TourPackageId" />
            <input type="hidden" id="regDate" name="Date" />
            <input type="hidden" id="regShiftName" name="ShiftName" />

            <!-- Selector de Vehículo -->
            <div>
                <label for="regVehicleId" class="block text-label-sm font-bold text-on-surface-variant mb-1">
                    Unidad de Transporte (Flota) <span class="text-tertiary">*</span>
                </label>
                <select id="regVehicleId" name="VehicleId" required class="w-full py-2.5 px-3 rounded-lg border border-outline-variant bg-surface-bright text-body-sm text-on-surface focus:border-primary focus:ring-1 focus:ring-primary outline-none">
                    <option value="">-- Seleccionar Unidad / Vehículo --</option>
                    @foreach (var v in Model.AvailableVehicles)
                    {
                        <option value="@v.Id" data-plate="@v.LicensePlate" data-model="@v.Model" data-capacity="@v.SeatCapacity">
                            @v.Model • Placa: @v.LicensePlate (@v.SeatCapacity plazas)
                        </option>
                    }
                </select>
            </div>

            <!-- Selector de Conductor -->
            <div>
                <label for="regDriverId" class="block text-label-sm font-bold text-on-surface-variant mb-1">
                    Conductor Asignado
                </label>
                <select id="regDriverId" name="DriverId" class="w-full py-2.5 px-3 rounded-lg border border-outline-variant bg-surface-bright text-body-sm text-on-surface focus:border-primary focus:ring-1 focus:ring-primary outline-none">
                    <option value="">-- Sin conductor asignado / Seleccionar Conductor --</option>
                    @foreach (var d in Model.AvailableDrivers)
                    {
                        <option value="@d.Id" data-name="@d.FullName" data-license="@d.LicenseNumber">
                            @d.FullName @(!string.IsNullOrEmpty(d.LicenseNumber) ? $"(Lic. {d.LicenseNumber})" : "")
                        </option>
                    }
                </select>
                <p class="text-[11px] text-outline mt-1">Conductor con brevete profesional vigente para servicio turístico MTC.</p>
            </div>

            <!-- N° Folio de Manifiesto Físico / Observación -->
            <div>
                <label for="regNotes" class="block text-label-sm font-bold text-on-surface-variant mb-1">
                    N° de Folio / Manifiesto Físico en Cabina (Opcional)
                </label>
                <input type="text" id="regNotes" name="Notes" placeholder="Ej: Manifiesto manual físico de cabina #0452" class="w-full py-2 px-3 rounded-lg border border-outline-variant bg-surface-bright text-body-sm text-on-surface focus:border-primary focus:ring-1 focus:ring-primary outline-none" />
            </div>

            <!-- Botones de Acción -->
            <div class="pt-4 border-t border-outline-variant/60 flex flex-col sm:flex-row items-center justify-end gap-2.5">
                <button type="button" onclick="closeRegularizeModal()" class="w-full sm:w-auto px-4 py-2 rounded-lg border border-outline-variant text-on-surface-variant hover:bg-surface-container font-semibold text-body-sm transition-colors cursor-pointer">
                    Cancelar
                </button>
                <button type="submit" id="btnSaveRegularize" class="w-full sm:w-auto px-4 py-2 rounded-lg bg-primary hover:bg-primary/90 text-on-primary font-bold text-body-sm shadow-sm flex items-center justify-center gap-2 transition-colors cursor-pointer">
                    <span class="material-symbols-outlined text-[18px]">check_circle</span>
                    <span>Guardar y Normalizar</span>
                </button>
                <button type="button" onclick="submitRegularizeAndDownload()" id="btnSaveAndDownload" class="w-full sm:w-auto px-4 py-2 rounded-lg bg-emerald-700 hover:bg-emerald-800 text-white font-bold text-body-sm shadow-sm flex items-center justify-center gap-2 transition-colors cursor-pointer">
                    <span class="material-symbols-outlined text-[18px]">file_download</span>
                    <span>Guardar y Descargar Excel</span>
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Modal de Cancelación de Salida Operativa y Devolución Masiva (Caja y SUNAT) -->
<div id="cancelDepartureModal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-inverse-surface/60 backdrop-blur-sm transition-all duration-200 hidden">
    <div class="bg-surface-container-lowest rounded-2xl max-w-xl w-full p-6 shadow-2xl border border-outline-variant relative max-h-[92vh] overflow-y-auto">
        <div class="flex items-start justify-between border-b border-outline-variant/60 pb-4 mb-4">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-red-100 text-red-600 flex items-center justify-center shrink-0">
                    <span class="material-symbols-outlined text-2xl">event_busy</span>
                </div>
                <div>
                    <h3 class="text-title-md font-bold text-on-surface">Cancelar Salida Operativa y Regularizar</h3>
                    <p class="text-label-sm text-outline">Anulación masiva de reservas, devolución en Caja General y baja en SUNAT</p>
                </div>
            </div>
            <button type="button" onclick="closeCancelDepartureModal()" class="p-1 rounded-lg hover:bg-surface-container text-outline hover:text-on-surface transition-colors cursor-pointer">
                <span class="material-symbols-outlined text-2xl">close</span>
            </button>
        </div>

        <div class="mb-4 p-3.5 rounded-xl bg-red-50/70 border border-red-200 space-y-1.5 text-body-sm">
            <div class="flex items-center justify-between">
                <span class="text-red-900/80">Circuito a Cancelar:</span>
                <span id="cancelDepSummaryTour" class="font-bold text-red-950"></span>
            </div>
            <div class="flex items-center justify-between">
                <span class="text-red-900/80">Fecha y Turno:</span>
                <span id="cancelDepSummaryDateShift" class="font-bold text-red-800"></span>
            </div>
            <div class="flex items-center justify-between">
                <span class="text-red-900/80">Pasajeros Afectados:</span>
                <span id="cancelDepSummaryPax" class="font-bold text-red-900 bg-red-100 px-2 py-0.5 rounded text-label-sm"></span>
            </div>
        </div>

        <form asp-controller="Admin" asp-action="CancelDeparture" method="post" class="space-y-4">
            @Html.AntiForgeryToken()
            <input type="hidden" id="cancelDepTourId" name="tourPackageId" />
            <input type="hidden" id="cancelDepDate" name="date" />
            <input type="hidden" id="cancelDepShiftName" name="shiftName" />

            <div class="p-3.5 rounded-xl bg-amber-50/80 border border-amber-200 space-y-2">
                <label class="flex items-start gap-2.5 cursor-pointer">
                    <input type="checkbox" name="registerCashRefund" value="true" checked class="mt-0.5 rounded border-amber-400 text-primary focus:ring-primary" />
                    <span class="text-xs text-amber-950">
                        <strong class="block font-bold">1. Registrar Egresos por Devolución (100%) en Caja General</strong>
                        Genera automáticamente el movimiento de salida de dinero en el turno abierto de caja por cada reserva pagada de esta salida.
                    </span>
                </label>
            </div>

            <div class="p-3.5 rounded-xl bg-sky-50/80 border border-sky-200 space-y-2.5">
                <label class="flex items-start gap-2.5 cursor-pointer">
                    <input type="checkbox" name="voidSunatReceipts" value="true" checked class="mt-0.5 rounded border-sky-400 text-primary focus:ring-primary" />
                    <span class="text-xs text-sky-950">
                        <strong class="block font-bold">2. Regularizar Comprobantes Electrónicos en SUNAT (NubeFact)</strong>
                        Anula las Boletas y Facturas emitidas para los pasajeros de esta salida mediante Nota de Crédito o Comunicación de Baja.
                    </span>
                </label>
                <div>
                    <label for="cancelDepSunatAction" class="block text-[11px] font-bold text-sky-900 mb-1">Operación Tributaria en SUNAT:</label>
                    <select id="cancelDepSunatAction" name="sunatAction" class="w-full py-1.5 px-2.5 rounded-lg border border-sky-300 bg-white text-xs font-semibold text-on-surface">
                        <option value="credit_note">Emitir Nota de Crédito Electrónica (Catálogo 09 SUNAT - Anulación de la operación)</option>
                        <option value="void">Comunicación de Baja / Anulación Directa en NubeFact</option>
                    </select>
                </div>
            </div>

            <div>
                <label for="cancelDepReason" class="block text-label-sm font-bold text-on-surface-variant mb-1">Motivo de Cancelación de la Salida *</label>
                <input type="text" id="cancelDepReason" name="cancelReason" value="Cancelación de salida operativa por fuerza mayor / reprogramación" required class="w-full py-2 px-3 rounded-lg border border-outline-variant bg-surface-bright text-body-sm text-on-surface focus:border-primary outline-none" />
            </div>

            <div class="pt-4 border-t border-outline-variant/60 flex flex-col sm:flex-row items-center justify-end gap-2.5">
                <button type="button" onclick="closeCancelDepartureModal()" class="w-full sm:w-auto px-4 py-2 rounded-lg border border-outline-variant text-on-surface-variant hover:bg-surface-container font-semibold text-body-sm transition-colors cursor-pointer">
                    Volver
                </button>
                <button type="submit" class="w-full sm:w-auto px-5 py-2 rounded-lg bg-red-600 hover:bg-red-700 text-white font-bold text-body-sm shadow-sm flex items-center justify-center gap-2 transition-colors cursor-pointer">
                    <span class="material-symbols-outlined text-[18px]">event_busy</span>
                    <span>Confirmar Cancelación y Devoluciones</span>
                </button>
            </div>
        </form>
    </div>
</div>

<script>
    let currentRegRowKey = null;

    function openCancelDepartureModalFromRow(btn) {
        const row = btn.closest('.departure-row');
        if (!row) return;
        document.getElementById('cancelDepTourId').value = row.dataset.tourId;
        document.getElementById('cancelDepDate').value = row.dataset.date;
        document.getElementById('cancelDepShiftName').value = row.dataset.shift || '';

        document.getElementById('cancelDepSummaryTour').textContent = row.dataset.tourTitle;
        document.getElementById('cancelDepSummaryDateShift').textContent = `${row.dataset.dateFormatted} • ${row.dataset.shift || 'General'}`;
        document.getElementById('cancelDepSummaryPax').textContent = `${row.dataset.pax} pasajero(s)`;

        document.getElementById('cancelDepartureModal').classList.remove('hidden');
    }

    function closeCancelDepartureModal() {
        document.getElementById('cancelDepartureModal').classList.add('hidden');
    }

    function switchDepartureTab(tab) {
        const activeBtn = document.getElementById('tabBtnActive');
        const historyBtn = document.getElementById('tabBtnHistory');
        const rows = document.querySelectorAll('.departure-row');
        const activeEmpty = document.getElementById('activeEmptyState');
        const historyEmpty = document.getElementById('historyEmptyState');

        let visibleCount = 0;
        rows.forEach(r => {
            if (r.getAttribute('data-tab-type') === tab) {
                r.classList.remove('hidden');
                visibleCount++;
            } else {
                r.classList.add('hidden');
            }
        });

        if (tab === 'active') {
            activeBtn.className = "px-3 py-1.5 rounded-lg font-bold transition-all flex items-center gap-1.5 bg-primary text-on-primary shadow-xs cursor-pointer";
            historyBtn.className = "px-3 py-1.5 rounded-lg font-medium transition-all flex items-center gap-1.5 text-on-surface-variant hover:text-on-surface hover:bg-surface-bright cursor-pointer";
            if (visibleCount === 0 && activeEmpty) activeEmpty.classList.remove('hidden');
            else if (activeEmpty) activeEmpty.classList.add('hidden');
            if (historyEmpty) historyEmpty.classList.add('hidden');
        } else {
            historyBtn.className = "px-3 py-1.5 rounded-lg font-bold transition-all flex items-center gap-1.5 bg-primary text-on-primary shadow-xs cursor-pointer";
            activeBtn.className = "px-3 py-1.5 rounded-lg font-medium transition-all flex items-center gap-1.5 text-on-surface-variant hover:text-on-surface hover:bg-surface-bright cursor-pointer";
            if (visibleCount === 0 && historyEmpty) historyEmpty.classList.remove('hidden');
            else if (historyEmpty) historyEmpty.classList.add('hidden');
            if (activeEmpty) activeEmpty.classList.add('hidden');
        }
    }

    function openRegularizeModalFromRow(btn) {
        const row = btn.closest('.departure-row');
        if (!row) return;
        const tourId = row.dataset.tourId;
        const tourTitle = row.dataset.tourTitle;
        const dateStr = row.dataset.date;
        const dateFormatted = row.dataset.dateFormatted;
        const shiftName = row.dataset.shift || '';
        const pax = row.dataset.pax;
        const vehicleId = row.dataset.vehicleId;
        const driverId = row.dataset.driverId;
        const isHistorical = row.dataset.tabType === 'history';
        openRegularizeModal(tourId, tourTitle, dateStr, dateFormatted, shiftName, pax, vehicleId, driverId, isHistorical);
    }

    function openRegularizeModal(tourId, tourTitle, dateStr, dateFormatted, shiftName, pax, vehicleId, driverId, isHistorical) {
        document.getElementById('regTourId').value = tourId;
        document.getElementById('regDate').value = dateStr;
        document.getElementById('regShiftName').value = shiftName || '';

        document.getElementById('regSummaryTour').textContent = tourTitle;
        document.getElementById('regSummaryDate').textContent = dateFormatted;
        document.getElementById('regSummaryShift').textContent = shiftName || 'General / Salida Única';
        document.getElementById('regSummaryPax').textContent = pax + ' pasajero(s)';

        const isHist = (isHistorical === 'True' || isHistorical === true);
        if (isHist) {
            document.getElementById('regModalTitle').textContent = vehicleId ? 'Modificar Manifiesto Regularizado (Historial)' : 'Regularizar Manifiesto Manual (Historial)';
        } else {
            document.getElementById('regModalTitle').textContent = vehicleId ? 'Modificar Asignación de Despacho' : 'Asignar Flota y Conductor de Despacho';
        }

        document.getElementById('regVehicleId').value = vehicleId || '';
        document.getElementById('regDriverId').value = driverId || '';

        document.getElementById('regNotes').value = '';
        currentRegRowKey = `row-${tourId}-${dateStr.replace(/-/g, '')}-${(shiftName || '').replace(/\s+/g, '')}`;

        document.getElementById('regularizeManifestModal').classList.remove('hidden');
    }

    function closeRegularizeModal() {
        document.getElementById('regularizeManifestModal').classList.add('hidden');
    }

    async function submitRegularizeManifest(e) {
        if (e) e.preventDefault();
        const form = document.getElementById('regularizeManifestForm');
        if (!form.checkValidity()) {
            form.reportValidity();
            return;
        }

        const formData = new FormData(form);
        const saveBtn = document.getElementById('btnSaveRegularize');

        try {
            saveBtn.disabled = true;
            saveBtn.innerHTML = '<span class="material-symbols-outlined text-[18px] animate-spin">refresh</span> Guardando...';

            const res = await fetch('/Admin/RegularizeManifest', {
                method: 'POST',
                body: formData
            });

            const data = await res.json();
            if (res.ok && data.success) {
                updateRowInTable(data);
                closeRegularizeModal();
                showDashboardToast(data.message, 'success');
            } else {
                alert(data.message || 'Error al regularizar el manifiesto.');
            }
        } catch (err) {
            alert('Error de conexión al regularizar el manifiesto.');
        } finally {
            saveBtn.disabled = false;
            saveBtn.innerHTML = '<span class="material-symbols-outlined text-[18px]">check_circle</span> <span>Guardar y Normalizar</span>';
        }
    }

    async function submitRegularizeAndDownload() {
        const form = document.getElementById('regularizeManifestForm');
        if (!form.checkValidity()) {
            form.reportValidity();
            return;
        }
        const formData = new FormData(form);
        const downloadBtn = document.getElementById('btnSaveAndDownload');

        try {
            downloadBtn.disabled = true;
            downloadBtn.innerHTML = '<span class="material-symbols-outlined text-[18px] animate-spin">refresh</span> Procesando...';

            const res = await fetch('/Admin/RegularizeManifest', {
                method: 'POST',
                body: formData
            });

            const data = await res.json();
            if (res.ok && data.success) {
                updateRowInTable(data);
                closeRegularizeModal();
                showDashboardToast(data.message, 'success');

                const tourId = document.getElementById('regTourId').value;
                const date = document.getElementById('regDate').value;
                const shift = document.getElementById('regShiftName').value;
                const vId = data.vehicleId || document.getElementById('regVehicleId').value;
                const dId = data.driverId || document.getElementById('regDriverId').value;
                window.location.href = `/Admin/ExportManifestExcel?tourPackageId=${encodeURIComponent(tourId)}&date=${encodeURIComponent(date)}&shiftName=${encodeURIComponent(shift)}&vehicleId=${encodeURIComponent(vId)}&driverId=${encodeURIComponent(dId)}`;
            } else {
                alert(data.message || 'Error al regularizar el manifiesto.');
            }
        } catch (err) {
            alert('Error de conexión al procesar el manifiesto.');
        } finally {
            downloadBtn.disabled = false;
            downloadBtn.innerHTML = '<span class="material-symbols-outlined text-[18px]">file_download</span> <span>Guardar y Descargar Excel</span>';
        }
    }

    function updateRowInTable(data) {
        if (!currentRegRowKey) return;
        const row = document.querySelector(`[data-dep-id="${currentRegRowKey}"]`);
        if (row) {
            if (data.vehicleId) row.dataset.vehicleId = data.vehicleId;
            if (data.driverId) row.dataset.driverId = data.driverId;

            const vLabel = row.querySelector('.vehicle-model-label');
            if (vLabel) {
                vLabel.textContent = data.vehicleModel;
                vLabel.classList.remove('italic');
            }
            const plateLabel = row.querySelector('.license-plate-label');
            if (plateLabel) {
                plateLabel.textContent = 'Placa: ' + data.licensePlate;
                plateLabel.classList.remove('text-amber-700', 'font-semibold');
                plateLabel.classList.add('text-outline', 'font-mono');
            }
            const dLabel = row.querySelector('.driver-name-label');
            if (dLabel) {
                dLabel.textContent = data.driverName;
                dLabel.classList.remove('italic');
            }
            const mBadge = row.querySelector('.manifest-status-badge');
            if (mBadge) {
                mBadge.className = 'manifest-status-badge inline-flex items-center gap-0.5 px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-50 text-emerald-800 border border-emerald-200';
                mBadge.innerHTML = '<span class="material-symbols-outlined text-[12px]">verified</span> Manifiesto OK';
            }

            // Actualizar enlace de descarga de manifiesto con los nuevos IDs
            const exportLink = row.querySelector('.btn-export-manifest');
            if (exportLink) {
                const tourId = row.dataset.tourId;
                const date = row.dataset.date;
                const shift = row.dataset.shift || '';
                const vId = data.vehicleId || row.dataset.vehicleId || '';
                const dId = data.driverId || row.dataset.driverId || '';
                exportLink.href = `/Admin/ExportManifestExcel?tourPackageId=${encodeURIComponent(tourId)}&date=${encodeURIComponent(date)}&shiftName=${encodeURIComponent(shift)}&vehicleId=${encodeURIComponent(vId)}&driverId=${encodeURIComponent(dId)}`;
                exportLink.className = "btn-export-manifest inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-emerald-50 hover:bg-emerald-100 text-emerald-800 border border-emerald-300 font-bold text-[11px] transition-all shadow-2xs";
            }

            // Actualizar botón de asignación a 'Modificar'
            const assignBtn = row.querySelector('.btn-assign-departure');
            if (assignBtn) {
                const labelSpan = assignBtn.querySelector('span:not(.material-symbols-outlined)');
                if (labelSpan) labelSpan.textContent = 'Modificar';
                const iconSpan = assignBtn.querySelector('.material-symbols-outlined');
                if (iconSpan) iconSpan.textContent = 'edit';
                assignBtn.className = "btn-assign-departure px-2 py-1 rounded-lg hover:bg-primary/10 text-primary border border-primary/20 hover:border-primary text-[11px] flex items-center gap-1 transition-all cursor-pointer shadow-2xs";
                assignBtn.title = "Modificar Unidad y Conductor Asignados";
            }
        }
    }

    function showDashboardToast(msg, type) {
        const toast = document.createElement('div');
        toast.className = `fixed bottom-5 right-5 z-50 px-4 py-3 rounded-xl shadow-lg border flex items-center gap-2 text-body-sm font-semibold transition-all duration-300 transform translate-y-4 opacity-0 ${
            type === 'success' ? 'bg-emerald-900 text-white border-emerald-700' : 'bg-surface-container-high text-on-surface border-outline-variant'
        }`;
        toast.innerHTML = `<span class="material-symbols-outlined text-[20px]">${type === 'success' ? 'check_circle' : 'info'}</span> <span>${msg}</span>`;
        document.body.appendChild(toast);
        setTimeout(() => {
            toast.classList.remove('translate-y-4', 'opacity-0');
        }, 50);
        setTimeout(() => {
            toast.classList.add('opacity-0');
            setTimeout(() => toast.remove(), 300);
        }, 4000);
    }

    document.addEventListener('DOMContentLoaded', () => {
        const hash = (window.location.hash || '').toLowerCase();
        if (hash === '#historial' || hash === '#history') {
            switchDepartureTab('history');
        } else {
            switchDepartureTab('active');
        }
    });
</script>
