@using SIGETOUR.API.Core.Entities
@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var toursCount = ViewBag.ToursCount ?? 0;
    var usersCount = ViewBag.UsersCount ?? 0;
    var vehiclesCount = ViewBag.VehiclesCount ?? 0;
    var bookingsCount = ViewBag.BookingsCount ?? 0;
    var recentBookings = ViewBag.RecentBookings as IEnumerable<Booking>;
    var activeTours = ViewBag.ActiveTours as IEnumerable<TourPackage>;
}

<div class="mb-6">
    <h1 class="text-display-sm font-bold text-on-surface">Dashboard Operativo</h1>
    <p class="text-body-lg text-on-surface-variant">Resumen de operaciones y estado actual de reservas.</p>
</div>

<!-- 2. Operational KPI Cards -->
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
    <div class="bg-surface-container-lowest p-6 rounded-2xl shadow-sm border border-outline-variant flex items-center justify-between">
        <div>
            <p class="text-label-md text-on-surface-variant mb-1 font-bold">Total Reservas</p>
            <p class="text-display-md font-bold text-on-surface">@bookingsCount</p>
        </div>
        <div class="w-12 h-12 rounded-full bg-primary-container text-primary flex items-center justify-center">
            <span class="material-symbols-outlined text-[24px]">confirmation_number</span>
        </div>
    </div>

    <div class="bg-surface-container-lowest p-6 rounded-2xl shadow-sm border border-outline-variant flex items-center justify-between">
        <div>
            <p class="text-label-md text-on-surface-variant mb-1 font-bold">Circuitos Activos</p>
            <p class="text-display-md font-bold text-on-surface">@toursCount</p>
        </div>
        <div class="w-12 h-12 rounded-full bg-tertiary-container text-tertiary flex items-center justify-center">
            <span class="material-symbols-outlined text-[24px]">explore</span>
        </div>
    </div>

    <div class="bg-surface-container-lowest p-6 rounded-2xl shadow-sm border border-outline-variant flex items-center justify-between">
        <div>
            <p class="text-label-md text-on-surface-variant mb-1 font-bold">Flota en Operación</p>
            <p class="text-display-md font-bold text-on-surface">@vehiclesCount</p>
        </div>
        <div class="w-12 h-12 rounded-full bg-secondary-container text-secondary flex items-center justify-center">
            <span class="material-symbols-outlined text-[24px]">directions_bus</span>
        </div>
    </div>

    <div class="bg-surface-container-lowest p-6 rounded-2xl shadow-sm border border-outline-variant flex items-center justify-between">
        <div>
            <p class="text-label-md text-on-surface-variant mb-1 font-bold">Usuarios Sistema</p>
            <p class="text-display-md font-bold text-on-surface">@usersCount</p>
        </div>
        <div class="w-12 h-12 rounded-full bg-surface-variant text-on-surface-variant flex items-center justify-center">
            <span class="material-symbols-outlined text-[24px]">group</span>
        </div>
    </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
    <!-- Tours -->
    <div class="lg:col-span-7 bg-surface-container-lowest rounded-2xl shadow-sm border border-outline-variant overflow-hidden flex flex-col">
        <div class="p-5 border-b border-outline-variant flex justify-between items-center bg-surface-container-low/30">
            <h2 class="text-title-md font-bold text-on-surface flex items-center gap-2">
                <span class="material-symbols-outlined text-tertiary">tour</span> Tours Destacados
            </h2>
        </div>
        <div class="p-5 flex-1 space-y-4">
            @if (activeTours != null && activeTours.Any())
            {
                foreach (var tour in activeTours)
                {
                    <div class="flex items-center gap-4">
                        <div class="w-12 h-12 rounded-lg overflow-hidden bg-surface-container">
                             @if (tour.Images != null && tour.Images.Any())
                             {
                                 <img src="@tour.Images.First().ImageUrl" alt="@tour.Title" class="w-full h-full object-cover" />
                             }
                        </div>
                        <div class="flex-1">
                            <h3 class="font-bold text-on-surface text-body-lg">@tour.Title</h3>
                            <p class="text-body-sm text-on-surface-variant">S/ @tour.BasePrice - @tour.Duration</p>
                        </div>
                    </div>
                }
            }
            else
            {
                <p class="text-on-surface-variant">No hay tours activos.</p>
            }
        </div>
    </div>

    <!-- Recent Bookings -->
    <div class="lg:col-span-5 bg-surface-container-lowest rounded-2xl shadow-sm border border-outline-variant overflow-hidden flex flex-col">
        <div class="p-5 border-b border-outline-variant flex justify-between items-center bg-surface-container-low/30">
            <h2 class="text-title-md font-bold text-on-surface flex items-center gap-2">
                <span class="material-symbols-outlined text-primary">history</span> Últimas Reservas Registradas
            </h2>
        </div>
        <div class="p-5 flex-1">
            <div class="space-y-4">
                @if (recentBookings != null && recentBookings.Any())
                {
                    foreach (var booking in recentBookings)
                    {
                        <div class="flex items-start gap-4 p-4 rounded-xl border border-outline-variant/60 bg-surface/50 hover:bg-surface-container-lowest transition-colors">
                            <div class="w-10 h-10 rounded-full bg-primary/10 text-primary flex items-center justify-center flex-shrink-0">
                                <span class="material-symbols-outlined text-[20px]">person</span>
                            </div>
                            <div class="flex-1 min-w-0">
                                <div class="flex justify-between items-start mb-1">
                                    <h4 class="font-bold text-on-surface text-label-lg truncate pr-2">@booking.CustomerName</h4>
                                    <span class="font-mono text-label-sm font-bold text-primary">@booking.ReferenceCode</span>
                                </div>
                                <p class="text-body-sm text-on-surface-variant truncate mb-2">@booking.TravelDate.ToString("dd MMM yyyy") - @booking.TotalPassengers pax</p>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <p class="text-on-surface-variant">No hay reservas registradas.</p>
                }
            </div>
        </div>
    </div>
</div>

