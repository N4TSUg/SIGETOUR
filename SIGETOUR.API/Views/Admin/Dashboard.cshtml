@model SIGETOUR.API.ViewModels.DashboardViewModel
@using SIGETOUR.API.Core.Entities
@{
    ViewData["Title"] = "Panel de Control y Despacho Operativo";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="space-y-6">
    <!-- Header Contextual -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <div class="flex items-center gap-2">
                <span class="w-2.5 h-2.5 rounded-full bg-primary animate-pulse"></span>
                <span class="text-label-sm font-label-sm text-primary font-bold uppercase tracking-wider">Centro de Operaciones y Despacho en Vivo</span>
                <span class="text-label-sm text-outline">• Jr. 2 de Mayo 569, Cajamarca</span>
            </div>
            <h1 class="text-headline-md font-bold text-on-surface mt-1">Dashboard General de Turismo Chilón</h1>
            <p class="text-body-sm text-on-surface-variant">Monitoreo en tiempo real de salidas turísticas, capacidad vehicular, caja y cumplimiento normativo.</p>
        </div>
        <div class="flex items-center gap-3">
            <a asp-controller="Admin" asp-action="CreateBooking" class="px-4 py-2.5 bg-primary text-on-primary font-label-md font-bold rounded-xl shadow-sm hover:bg-primary/90 transition-all flex items-center gap-2">
                <span class="material-symbols-outlined text-[20px]">add_circle</span>
                Nueva Reserva
            </a>
            <a asp-controller="Admin" asp-action="Cash" class="px-3.5 py-2.5 bg-surface-container-lowest border border-outline-variant text-on-surface font-label-md rounded-xl hover:bg-surface-container transition-colors flex items-center gap-2 shadow-sm">
                <span class="material-symbols-outlined text-primary text-[20px]">point_of_sale</span>
                Caja Chica
            </a>
        </div>
    </div>

    <!-- 1. Operational KPI Ribbon -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <!-- KPI 1: Pasajeros Hoy -->
        <div class="bg-surface-container-lowest rounded-2xl p-5 border border-outline-variant/60 shadow-sm flex flex-col justify-between">
            <div class="flex items-center justify-between">
                <span class="text-label-md text-on-surface-variant font-bold">Pasajeros Movilizados Hoy</span>
                <span class="w-9 h-9 rounded-xl bg-primary-container text-primary flex items-center justify-center">
                    <span class="material-symbols-outlined text-[20px]">groups</span>
                </span>
            </div>
            <div class="my-3">
                <div class="text-display-sm font-extrabold text-on-surface">
                    @Model.TodayPassengers <span class="text-label-md text-outline font-normal">/ @Model.TotalDailyCapacity plazas</span>
                </div>
                <div class="mt-2">
                    <div class="flex justify-between text-body-sm text-outline mb-1 font-semibold">
                        <span>Ocupación de asientos</span>
                        <span class="font-bold text-primary">@Model.OccupancyPercentage%</span>
                    </div>
                    <div class="w-full bg-surface-container rounded-full h-2 overflow-hidden">
                        <div class="bg-primary h-2 rounded-full transition-all duration-500" style="width: @Model.OccupancyPercentage%"></div>
                    </div>
                </div>
            </div>
            <div class="text-body-sm text-outline border-t border-outline-variant/30 pt-2 flex justify-between items-center">
                <span>Total histórico</span>
                <span class="font-bold text-on-surface">@Model.TotalBookings reservas</span>
            </div>
        </div>

        <!-- KPI 2: Salidas y Circuitos -->
        <div class="bg-surface-container-lowest rounded-2xl p-5 border border-outline-variant/60 shadow-sm flex flex-col justify-between">
            <div class="flex items-center justify-between">
                <span class="text-label-md text-on-surface-variant font-bold">Salidas Programadas Hoy</span>
                <span class="w-9 h-9 rounded-xl bg-secondary-container text-secondary flex items-center justify-center">
                    <span class="material-symbols-outlined text-[20px]">tour</span>
                </span>
            </div>
            <div class="my-3">
                <div class="text-display-sm font-extrabold text-on-surface">
                    @Model.Departures.Count <span class="text-label-md text-outline font-normal">circuitos</span>
                </div>
                @{
                    var enRutaCount = Model.Departures.Count(d => d.StatusColor == "emerald");
                    var abordandoCount = Model.Departures.Count(d => d.StatusColor == "amber" || d.StatusColor == "sky");
                    var enEsperaCount = Math.Max(0, Model.Departures.Count - enRutaCount - abordandoCount);
                }
                <div class="flex flex-wrap gap-1.5 mt-2">
                    <span class="inline-flex items-center gap-1 text-[11px] font-bold px-2 py-0.5 rounded bg-emerald-100 text-emerald-800">
                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-600"></span> @enRutaCount en ruta
                    </span>
                    <span class="inline-flex items-center gap-1 text-[11px] font-bold px-2 py-0.5 rounded bg-amber-100 text-amber-800">
                        <span class="w-1.5 h-1.5 rounded-full bg-amber-600"></span> @abordandoCount abordando
                    </span>
                    <span class="inline-flex items-center gap-1 text-[11px] font-bold px-2 py-0.5 rounded bg-slate-100 text-slate-700">
                        @enEsperaCount en espera
                    </span>
                </div>
            </div>
            <div class="text-body-sm text-outline border-t border-outline-variant/30 pt-2 flex justify-between items-center">
                <span>Catálogo de tours</span>
                <a asp-controller="Admin" asp-action="Tours" class="font-bold text-primary hover:underline">@Model.TotalTours activos</a>
            </div>
        </div>

        <!-- KPI 3: Recaudación Diaria -->
        <div class="bg-surface-container-lowest rounded-2xl p-5 border border-outline-variant/60 shadow-sm flex flex-col justify-between">
            <div class="flex items-center justify-between">
                <span class="text-label-md text-on-surface-variant font-bold">Recaudación Estimada Hoy</span>
                <span class="w-9 h-9 rounded-xl bg-emerald-50 text-emerald-700 flex items-center justify-center">
                    <span class="material-symbols-outlined text-[20px]">payments</span>
                </span>
            </div>
            <div class="my-3">
                <div class="text-display-sm font-extrabold text-primary">
                    S/ @Model.TodayIncome.ToString("N2")
                </div>
                <div class="flex justify-between items-center text-body-sm mt-2">
                    <span class="text-on-surface-variant">Cobrado: <strong class="text-emerald-700">S/ @Model.TodayIncome.ToString("N2")</strong></span>
                    <span class="text-outline">Saldo: <strong class="text-tertiary">S/ @Model.TodayPending.ToString("N2")</strong></span>
                </div>
            </div>
            <div class="text-body-sm text-outline border-t border-outline-variant/30 pt-2 flex justify-between items-center">
                <span>Ventanilla & Web</span>
                <span class="text-emerald-700 font-bold flex items-center gap-1">
                    <span class="material-symbols-outlined text-sm">check_circle</span> Conciliado
                </span>
            </div>
        </div>

        <!-- KPI 4: Flota en Operación -->
        <div class="bg-surface-container-lowest rounded-2xl p-5 border border-outline-variant/60 shadow-sm flex flex-col justify-between">
            <div class="flex items-center justify-between">
                <span class="text-label-md text-on-surface-variant font-bold">Flota Operativa</span>
                <span class="w-9 h-9 rounded-xl bg-surface-container text-primary flex items-center justify-center">
                    <span class="material-symbols-outlined text-[20px]">directions_bus</span>
                </span>
            </div>
            <div class="my-3">
                <div class="text-display-sm font-extrabold text-on-surface">
                    @Model.ActiveVehicles <span class="text-label-md text-outline font-normal">/ @Model.TotalVehicles unidades</span>
                </div>
                <p class="text-body-sm text-on-surface-variant mt-2">
                    Mercedes Sprinter & Toyota HiAce autorizadas MTC
                </p>
            </div>
            <div class="text-body-sm text-outline border-t border-outline-variant/30 pt-2 flex justify-between items-center">
                @if (Model.FleetAlerts.Any(a => a.IsExpired))
                {
                    <span class="text-tertiary font-bold flex items-center gap-1">
                        <span class="material-symbols-outlined text-sm">warning</span> Alertas pendientes
                    </span>
                }
                else
                {
                    <span class="text-emerald-700 font-semibold flex items-center gap-1">
                        <span class="w-2 h-2 rounded-full bg-emerald-600"></span> Flota operativa
                    </span>
                }
                <a asp-controller="Admin" asp-action="Fleet" class="text-label-sm font-bold text-primary hover:underline">Gestionar Flota</a>
            </div>
        </div>
    </div>

    <!-- 2. Tablero de Salidas y Despacho en Vivo de Hoy -->
    <div class="bg-surface-container-lowest rounded-2xl border border-outline-variant/60 shadow-sm overflow-hidden flex flex-col">
        <div class="p-5 border-b border-outline-variant/40 flex flex-col sm:flex-row sm:items-center justify-between gap-4 bg-surface-bright">
            <div class="flex items-center gap-3">
                <span class="w-3 h-3 rounded-full bg-primary animate-ping"></span>
                <div>
                    <h2 class="text-title-md font-bold text-on-surface">Tablero de Salidas y Despacho en Vivo</h2>
                    <p class="text-body-sm text-outline">Programación de circuitos del día con asignación de flota y personal de campo.</p>
                </div>
            </div>
            <div class="flex items-center gap-2">
                <span class="text-label-sm bg-surface-container px-3 py-1 rounded-lg text-primary font-bold border border-primary/20">
                    Turno Mañana / Tarde
                </span>
                <a asp-controller="Admin" asp-action="Bookings" class="text-label-sm px-3 py-1 rounded-lg border border-outline-variant text-on-surface-variant hover:bg-surface-container font-semibold transition-colors">
                    Ver Reservas
                </a>
            </div>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="border-b border-outline-variant/30 bg-surface/50 text-label-sm text-on-surface-variant uppercase tracking-wider font-bold">
                        <th class="py-3 px-4">Hora</th>
                        <th class="py-3 px-4">Circuito / Destino Turístico</th>
                        <th class="py-3 px-4">Unidad &amp; Placa</th>
                        <th class="py-3 px-4">Personal Asignado</th>
                        <th class="py-3 px-4">Ocupación Pax</th>
                        <th class="py-3 px-4">Estado de Salida</th>
                        <th class="py-3 px-4 text-right">Acciones</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-outline-variant/20 text-body-sm">
                    @if (Model.Departures.Any())
                    {
                        foreach (var dep in Model.Departures)
                        {
                            var pct = dep.TotalCapacity > 0 ? (int)Math.Min(100, Math.Round((double)dep.BookedSeats / dep.TotalCapacity * 100)) : 0;
                            var isFull = dep.BookedSeats >= dep.TotalCapacity;
                            <tr class="hover:bg-surface-container-low/40 transition-colors">
                                <td class="py-3.5 px-4 font-bold text-primary font-mono text-title-sm">
                                    @dep.Time
                                </td>
                                <td class="py-3.5 px-4">
                                    <div class="font-bold text-on-surface">@dep.TourTitle</div>
                                    <div class="text-label-sm text-outline">@dep.Subtitle</div>
                                </td>
                                <td class="py-3.5 px-4">
                                    @if (!string.IsNullOrWhiteSpace(dep.VehicleModel))
                                    {
                                        <div class="flex items-center gap-1.5 font-semibold text-on-surface">
                                            <span class="material-symbols-outlined text-[18px] text-primary">directions_bus</span>
                                            @dep.VehicleModel
                                        </div>
                                        <div class="text-label-sm font-mono text-outline">Placa: @dep.LicensePlate</div>
                                    }
                                    else
                                    {
                                        <div class="flex items-center gap-1.5 text-outline text-label-sm">
                                            <span class="material-symbols-outlined text-[18px] text-outline">pending</span>
                                            <span class="italic font-medium">Sin unidad asignada</span>
                                        </div>
                                        <div class="text-[11px] text-outline/80">Por asignar en manifiesto</div>
                                    }
                                </td>
                                <td class="py-3.5 px-4">
                                    @if (!string.IsNullOrWhiteSpace(dep.DriverName))
                                    {
                                        <div class="font-medium text-on-surface">@dep.DriverName</div>
                                    }
                                    else
                                    {
                                        <div class="flex items-center gap-1.5 text-outline text-label-sm">
                                            <span class="material-symbols-outlined text-[18px] text-outline">person_off</span>
                                            <span class="italic font-medium">Sin conductor asignado</span>
                                        </div>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(dep.GuideName))
                                    {
                                        <div class="text-label-sm text-primary font-semibold flex items-center gap-0.5">
                                            <span class="material-symbols-outlined text-[14px]">badge</span> @dep.GuideName
                                        </div>
                                    }
                                </td>
                                <td class="py-3.5 px-4">
                                    <div class="flex items-center gap-2">
                                        <span class="font-bold @(isFull ? "text-emerald-700" : "text-on-surface")">
                                            @dep.BookedSeats / @dep.TotalCapacity
                                        </span>
                                        @if (isFull)
                                        {
                                            <span class="px-1.5 py-0.5 bg-emerald-100 text-emerald-800 rounded text-[10px] font-bold">LLENO</span>
                                        }
                                        else
                                        {
                                            <span class="text-[10px] text-outline font-semibold">@(dep.TotalCapacity - dep.BookedSeats) disp.</span>
                                        }
                                    </div>
                                    <div class="w-24 bg-surface-container rounded-full h-1.5 mt-1 overflow-hidden">
                                        <div class="@(isFull ? "bg-emerald-600" : "bg-primary") h-1.5 rounded-full" style="width: @pct%"></div>
                                    </div>
                                </td>
                                <td class="py-3.5 px-4">
                                    @if (dep.StatusColor == "emerald")
                                    {
                                        <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[11px] font-bold bg-emerald-100 text-emerald-800 border border-emerald-300">
                                            <span class="w-1.5 h-1.5 rounded-full bg-emerald-600 animate-pulse"></span>
                                            @dep.Status
                                        </span>
                                    }
                                    else if (dep.StatusColor == "amber")
                                    {
                                        <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[11px] font-bold bg-amber-100 text-amber-900 border border-amber-300">
                                            <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>
                                            @dep.Status
                                        </span>
                                    }
                                    else if (dep.StatusColor == "sky")
                                    {
                                        <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[11px] font-bold bg-sky-100 text-sky-900 border border-sky-300">
                                            <span class="w-1.5 h-1.5 rounded-full bg-sky-500"></span>
                                            @dep.Status
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[11px] font-bold bg-slate-100 text-slate-800 border border-slate-300">
                                            <span class="w-1.5 h-1.5 rounded-full bg-slate-400"></span>
                                            @dep.Status
                                        </span>
                                    }
                                </td>
                                <td class="py-3.5 px-4 text-right">
                                    <div class="flex items-center justify-end gap-1">
                                        <a asp-controller="Admin" asp-action="Bookings" asp-route-tourId="@dep.TourId" class="p-1.5 rounded-lg hover:bg-surface-container text-primary" title="Ver Manifiesto y Pasajeros">
                                            <span class="material-symbols-outlined text-[18px]">assignment</span>
                                        </a>
                                        <a href="https://wa.me/51901195392" target="_blank" class="p-1.5 rounded-lg hover:bg-surface-container text-secondary" title="Contacto con la Unidad / Chofer">
                                            <span class="material-symbols-outlined text-[18px]">chat</span>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="py-8 text-center text-outline">
                                No hay salidas registradas para hoy. <a asp-controller="Admin" asp-action="Tours" class="text-primary font-bold hover:underline">Revisar catálogo de tours</a>.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- 3. Complementary Two-Column Bento Layout -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
        <!-- Columna Izquierda (7 Cols): Demanda por Circuito -->
        <div class="lg:col-span-7 bg-surface-container-lowest rounded-2xl p-6 border border-outline-variant/60 shadow-sm flex flex-col justify-between">
            <div>
                <div class="flex items-center justify-between pb-4 border-b border-outline-variant/30">
                    <div>
                        <h3 class="text-title-md font-bold text-on-surface">Demanda Turística por Circuito</h3>
                        <p class="text-body-sm text-outline">Distribución porcentual de pasajeros y reservas confirmadas.</p>
                    </div>
                    <span class="text-label-sm bg-surface-container px-2.5 py-1 rounded-lg text-primary font-bold border border-outline-variant/40">
                        Cajamarca Histórico
                    </span>
                </div>

                <!-- Custom Visual Bars for Tour Demands -->
                <div class="mt-6 space-y-4">
                    @if (Model.CircuitDemands.Any())
                    {
                        int rank = 1;
                        foreach (var demand in Model.CircuitDemands)
                        {
                            <div>
                                <div class="flex justify-between items-center text-body-sm mb-1.5">
                                    <span class="font-bold text-on-surface">@rank. @demand.TourTitle <span class="text-outline font-normal text-label-sm">(@demand.CategoryName)</span></span>
                                    <span class="font-bold text-primary">@demand.Percentage% <span class="text-outline font-normal">(@demand.PassengerCount pax)</span></span>
                                </div>
                                <div class="w-full bg-surface-container rounded-full h-3 overflow-hidden">
                                    <div class="@demand.ColorClass h-3 rounded-full transition-all duration-500" style="width: @demand.Percentage%"></div>
                                </div>
                            </div>
                            rank++;
                        }
                    }
                    else
                    {
                        <p class="text-on-surface-variant text-body-sm">No hay datos de demanda acumulados.</p>
                    }
                </div>
            </div>

            <!-- Bottom Summary Badge -->
            <div class="mt-6 p-4 bg-surface-container/40 rounded-xl border border-outline-variant/30 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                <div class="flex items-center gap-2">
                    <span class="material-symbols-outlined text-primary text-[20px]">verified</span>
                    <span class="text-body-sm text-on-surface">
                        Capacidad operativa diaria: <strong>@Model.TotalDailyCapacity plazas</strong> en @Model.ActiveVehicles vans autorizadas
                    </span>
                </div>
                <span class="text-label-sm text-primary font-bold">
                    @(Math.Max(0, Model.TotalDailyCapacity - Model.TodayPassengers)) Asientos Restantes Hoy
                </span>
            </div>
        </div>

        <!-- Columna Derecha (5 Cols): Alertas MTC y Últimas Reservas -->
        <div class="lg:col-span-5 flex flex-col gap-6">
            <!-- Box 1: Alerta Regulatoria MTC / SUTRAN -->
            <div class="bg-surface-container-lowest rounded-2xl p-5 border border-outline-variant/60 shadow-sm">
                <div class="flex items-center justify-between mb-3">
                    <span class="flex items-center gap-1.5 text-title-sm font-bold text-on-surface">
                        <span class="material-symbols-outlined text-emerald-600 text-[22px]">verified_user</span>
                        Cumplimiento SUTRAN / MTC
                    </span>
                    @if (Model.FleetAlerts.Any(a => a.IsExpired))
                    {
                        <span class="text-[11px] font-bold text-tertiary bg-error-container px-2 py-0.5 rounded">ATENCIÓN REQUERIDA</span>
                    }
                    else
                    {
                        <span class="text-[11px] font-bold text-emerald-800 bg-emerald-100 px-2 py-0.5 rounded">100% AL DÍA</span>
                    }
                </div>

                @if (Model.FleetAlerts.Any())
                {
                    <div class="space-y-2 mt-2">
                        @foreach (var alert in Model.FleetAlerts)
                        {
                            <div class="p-3 rounded-xl @(alert.IsExpired ? "bg-red-50 border border-red-200 text-red-900" : "bg-amber-50 border border-amber-200 text-amber-900") text-body-sm flex items-start gap-2.5">
                                <span class="material-symbols-outlined text-[20px] @(alert.IsExpired ? "text-tertiary" : "text-amber-600") shrink-0">
                                    @(alert.IsExpired ? "error" : "schedule")
                                </span>
                                <div class="flex-1">
                                    <div class="font-bold">@alert.LicensePlate - @alert.Model</div>
                                    <div class="text-[11px]">
                                        @alert.AlertType @(alert.IsExpired ? "VENCIDO" : $"vence en {alert.DaysRemaining} días") (@alert.ExpiryDate.ToString("dd/MM/yyyy"))
                                    </div>
                                </div>
                                <a asp-controller="Admin" asp-action="Fleet" class="text-label-sm font-bold underline shrink-0">Revisar</a>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="text-body-sm text-on-surface-variant leading-relaxed">
                        Toda la flota cuenta con SOAT turístico vigente, habilitación técnica y tarjeta única de circulación (TUC) verificadas para el transporte turístico interprovincial.
                    </p>
                }
            </div>

            <!-- Box 2: Últimas Reservas en Ventanilla -->
            <div class="bg-surface-container-lowest rounded-2xl p-5 border border-outline-variant/60 shadow-sm flex-1 flex flex-col justify-between">
                <div>
                    <div class="flex items-center justify-between pb-3 border-b border-outline-variant/30">
                        <h4 class="text-title-sm font-bold text-on-surface flex items-center gap-1.5">
                            <span class="material-symbols-outlined text-primary text-[20px]">receipt_long</span>
                            Últimas Reservas Registradas
                        </h4>
                        <a asp-controller="Admin" asp-action="Bookings" class="text-label-sm text-primary font-bold hover:underline">Ver todas</a>
                    </div>

                    <div class="divide-y divide-outline-variant/20 mt-2">
                        @if (Model.RecentBookings.Any())
                        {
                            foreach (var b in Model.RecentBookings.Take(4))
                            {
                                var tourName = b.Items.FirstOrDefault()?.TourPackage?.Title ?? "Circuito Cajamarca";
                                <div class="py-2.5 flex items-center justify-between text-body-sm">
                                    <div>
                                        <div class="font-bold text-on-surface">@b.CustomerName (@b.TotalPassengers boletos)</div>
                                        <div class="text-[11px] text-outline">@tourName • S/ @b.TotalAmount.ToString("N2") • @(string.IsNullOrEmpty(b.PaymentMethod) ? "Efectivo" : b.PaymentMethod)</div>
                                    </div>
                                    <span class="text-[11px] font-bold @(b.Status == BookingStatus.Confirmed ? "text-emerald-700 bg-emerald-50 border border-emerald-200" : "text-amber-800 bg-amber-50 border border-amber-200") px-2 py-0.5 rounded">
                                        @(b.Status == BookingStatus.Confirmed ? "Confirmado" : b.Status.ToString())
                                    </span>
                                </div>
                            }
                        }
                        else
                        {
                            <p class="text-outline text-body-sm py-4 text-center">No hay reservas registradas.</p>
                        }
                    </div>
                </div>

                <div class="pt-3 border-t border-outline-variant/30 mt-3 flex items-center justify-between text-body-sm">
                    <span class="text-outline font-medium">Sede Central: Jr. 2 de Mayo 569</span>
                    <a asp-controller="Admin" asp-action="CreateBooking" class="text-primary font-bold hover:underline flex items-center gap-1 text-label-sm">
                        <span>Registrar Venta</span>
