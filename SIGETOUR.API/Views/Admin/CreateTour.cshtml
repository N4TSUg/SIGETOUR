@model SIGETOUR.API.Core.Entities.TourPackage
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Crear Tour";
}
<main class="flex-1 overflow-y-auto bg-surface p-4 lg:p-6"><form method="post" enctype="multipart/form-data" action="@(Model.Id == Guid.Empty ? "/Admin/CreateTour" : "/Admin/EditTour")"><input type="hidden" asp-for="Id" />
<!-- Top Action Title Bar with Quick Breadcrumbs -->
<div class="max-w-7xl mx-auto space-y-6">
<div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 pb-3 border-b border-outline-variant/60">
<div>
<div class="flex items-center gap-2 text-label-sm font-label-sm text-secondary mb-1">
<span class="">Catálogo de Rutas</span>
<span class="material-symbols-outlined text-xs">chevron_right</span>
<span class="text-primary font-bold">Circuito Nuevo</span>
</div>
<h1 class="text-headline-md font-headline-md text-on-surface flex items-center gap-2.5">
<span class="material-symbols-outlined text-primary text-28px">add_location_alt</span>
              @(Model.Id == Guid.Empty ? "Registrar Nuevo Circuito" : "Editar Circuito")
            </h1>
</div>
<div class="flex items-center gap-2">
<button class="px-4 py-2 rounded-lg bg-surface-container-lowest border border-outline-variant hover:bg-surface-container text-on-surface-variant font-label-md transition-colors" type="button">
              Guardar como Borrador
            </button>
<button class="px-4 py-2 rounded-lg bg-primary hover:bg-primary-container text-on-primary font-label-lg shadow-sm transition-all duration-150 active:scale-98 flex items-center gap-1.5" type="button">
<span class="material-symbols-outlined text-base">cloud_upload</span>
              Publicar en la Web
            </button>
</div>
</div>
<!-- WORKSPACE GRID: Bento Formulation (8 Cols Left) + Live Preview Sticky (4 Cols Right) -->
<div class="grid grid-cols-1 xl:grid-cols-12 gap-6 items-start">
<!-- LEFT FORM COLUMN (xl:col-span-8) -->
<div class="xl:col-span-12 space-y-6 max-w-5xl mx-auto">
<!-- SECTION 1: Información General del Tour -->
<section class="bg-surface-container-lowest rounded-xl p-5 border border-outline-variant/70 shadow-sm relative overflow-hidden">
<div class="absolute top-0 left-0 w-1.5 h-full bg-primary"></div>
<div class="flex items-center gap-2 mb-4">
<span class="material-symbols-outlined text-primary text-xl">info</span>
<h2 class="text-title-md font-title-md text-on-surface">1. Información General del Circuito</h2>
</div>
<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
<!-- Nombre del Tour -->
<div class="md:col-span-2">
<label class="block text-label-md font-label-md text-on-surface mb-1.5">
                    Nombre Comercial del Tour / Circuito *
                  </label>
<input class="w-full px-3.5 py-2 text-body-md font-body-md bg-surface-bright/40 border border-outline-variant rounded-lg text-on-surface focus:ring-2 focus:ring-primary focus:border-transparent focus:bg-surface-container-lowest" type="text" asp-for="Title" placeholder="Ej: @(string.IsNullOrEmpty(Model.Title) ? "Nuevo Circuito/Tour" : Model.Title)" required>
<span class="text-label-sm font-label-sm text-on-surface-variant/80 mt-1 block">Visible en boleterías, página de reservas y comprobantes electrónicos.</span>
</div>
<!-- Categoría Temática -->
<div>
<label class="block text-label-md font-label-md text-on-surface mb-1.5">Categoría Temática *</label>
<select asp-for="Category" class="w-full px-3.5 py-2 text-body-md font-body-md bg-surface-bright/40 border border-outline-variant rounded-lg text-on-surface focus:ring-2 focus:ring-primary focus:border-transparent"><option value="0">Arqueología y Petroglifos</option><option value="1">City Tour</option><option value="2">Naturaleza</option></select>
<option selected="">Arqueología &amp; Petroglifos</option>
<option>Termalismo &amp; Spa Baños del Inca</option>
<option>Naturaleza, Bosques &amp; Aventura</option>
<option>Tradición, Agroturismo &amp; Quesos</option>
<option>City Tour Colonial &amp; Iglesias</option>
</select>
</div>
<!-- Tipo de Salida -->
<div>
<label class="block text-label-md font-label-md text-on-surface mb-1.5">Modalidad de Salida *</label>
<div class="grid grid-cols-2 gap-2">
<label class="flex items-center gap-2 p-2 rounded-lg border border-primary bg-surface-container-low/40 cursor-pointer">
<input checked="" class="text-primary focus:ring-primary" name="modalidad" type="radio">
<span class="text-label-md font-label-md text-on-surface">Salida Diaria Regular</span>
</label>
<label class="flex items-center gap-2 p-2 rounded-lg border border-outline-variant bg-surface-bright/30 cursor-pointer">
<input class="text-primary focus:ring-primary" name="modalidad" type="radio">
<span class="text-label-md font-label-md text-on-surface">Privado / Delegación</span>
</label>
</div>
</div>
<!-- Nivel de Exigencia Física -->
<div class="md:col-span-2">
<label class="block text-label-md font-label-md text-on-surface mb-1.5">Nivel de Dificultad Física</label>
<div class="flex flex-wrap gap-3">
<label class="flex items-center gap-2 px-3 py-1.5 rounded-lg border border-outline-variant bg-surface-bright/30 hover:bg-surface-container cursor-pointer">
<input class="text-primary focus:ring-primary" name="dificultad" type="radio">
<span class="text-label-md font-label-md text-on-surface">Fácil (Apto para toda la familia)</span>
</label>
<label class="flex items-center gap-2 px-3 py-1.5 rounded-lg border border-primary bg-primary/10 cursor-pointer">
<input checked="" class="text-primary focus:ring-primary" name="dificultad" type="radio">
<span class="text-label-md font-label-md text-primary font-bold">Moderado (Caminata a 3,500 msnm)</span>
</label>
<label class="flex items-center gap-2 px-3 py-1.5 rounded-lg border border-outline-variant bg-surface-bright/30 hover:bg-surface-container cursor-pointer">
<input class="text-primary focus:ring-primary" name="dificultad" type="radio">
<span class="text-label-md font-label-md text-on-surface">Exigente (Trekking andino)</span>
</label>
</div>
</div>
</div>
</section>
<!-- SECTION 2: Tarifas y Capacidad de Cupos -->
<section class="bg-surface-container-lowest rounded-xl p-5 border border-outline-variant/70 shadow-sm relative overflow-hidden">
<div class="absolute top-0 left-0 w-1.5 h-full bg-secondary"></div>
<div class="flex items-center justify-between mb-4">
<div class="flex items-center gap-2">
<span class="material-symbols-outlined text-secondary text-xl">monetization_on</span>
<h2 class="text-title-md font-title-md text-on-surface">2. Tarifas, Cupos y Política de Reserva</h2>
</div>
<span class="text-label-sm font-label-sm px-2.5 py-1 bg-surface-container rounded-full text-secondary font-bold">Moneda: Soles (PEN)</span>
</div>
<div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
<!-- Tarifa Adulto -->
<div class="p-3.5 rounded-lg bg-surface-bright/30 border border-outline-variant/60">
<label class="block text-label-md font-label-md text-on-surface mb-1 font-semibold">Tarifa Adulto General</label>
<div class="relative mt-1">
<span class="absolute inset-y-0 left-0 pl-3 flex items-center text-on-surface-variant font-bold text-sm">S/</span>
<input class="w-full pl-8 pr-3 py-1.5 text-headline-sm font-headline-sm font-bold text-primary bg-surface-container-lowest border border-outline-variant rounded-lg focus:ring-2 focus:ring-primary" type="number" step="0.01" asp-for="BasePrice" required>
</div>
<span class="text-label-sm font-label-sm text-on-surface-variant mt-1 block">Nacionales y extranjeros</span>
</div>
<!-- Tarifa Niño / Estudiante -->
<div class="p-3.5 rounded-lg bg-surface-bright/30 border border-outline-variant/60">
<label class="block text-label-md font-label-md text-on-surface mb-1 font-semibold">Tarifa Niño / Estudiante</label>
<div class="relative mt-1">
<span class="absolute inset-y-0 left-0 pl-3 flex items-center text-on-surface-variant font-bold text-sm">S/</span>
<input class="w-full pl-8 pr-3 py-1.5 text-headline-sm font-headline-sm font-bold text-secondary bg-surface-container-lowest border border-outline-variant rounded-lg focus:ring-2 focus:ring-secondary" type="number" step="0.01" asp-for="ChildPrice" required>
</div>
<span class="text-label-sm font-label-sm text-on-surface-variant mt-1 block">Hasta 12 años con DNI/Carnet</span>
</div>
<!-- Capacidad Asientos Sprinter -->
<div class="p-3.5 rounded-lg bg-surface-bright/30 border border-outline-variant/60">
<label class="block text-label-md font-label-md text-on-surface mb-1 font-semibold">Cupo Máximo por Salida</label>
<div class="relative mt-1">
<input class="w-full px-3 py-1.5 text-headline-sm font-headline-sm font-bold text-on-surface bg-surface-container-lowest border border-outline-variant rounded-lg focus:ring-2 focus:ring-primary" type="number" asp-for="MaxCapacity" required>
<span class="absolute inset-y-0 right-0 pr-3 flex items-center text-label-sm font-label-sm text-on-surface-variant">asientos</span>
</div>
<span class="text-label-sm font-label-sm text-on-surface-variant mt-1 block">Configuración Sprinter Estándar</span>
</div>
</div>
<!-- Reserva mínima -->
<div class="mt-4 pt-3 border-t border-outline-variant/40 flex flex-wrap items-center justify-between gap-3">
<div class="flex items-center gap-2">
<span class="material-symbols-outlined text-primary text-base">verified_user</span>
<span class="text-body-sm font-body-sm text-on-surface">Anticipo mínimo requerido para confirmación inmediata:</span>
</div>
<div class="flex items-center gap-4">
<label class="flex items-center gap-1.5 text-label-md font-label-md text-on-surface">
<input checked="" class="text-primary focus:ring-primary" name="anticipo" type="radio">
<span class="">50% Adelanto (Yape / Plin / Transferencia)</span>
</label>
<label class="flex items-center gap-1.5 text-label-md font-label-md text-on-surface">
<input class="text-primary focus:ring-primary" name="anticipo" type="radio">
<span class="">100% Pago Total Requerido</span>
</label>
</div>
</div>
</section>
<!-- SECTION 3: Horarios, Turnos y Duración -->
<section class="bg-surface-container-lowest rounded-xl p-5 border border-outline-variant/70 shadow-sm relative overflow-hidden">
<div class="absolute top-0 left-0 w-1.5 h-full bg-primary-container"></div>
<div class="flex items-center gap-2 mb-4">
<span class="material-symbols-outlined text-primary text-xl">schedule</span>
<h2 class="text-title-md font-title-md text-on-surface">3. Turnos de Operación y Duración Estimada</h2>
</div>
<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
<!-- Turnos Disponibles -->
<div class="space-y-2">
<span class="block text-label-md font-label-md text-on-surface">Turnos de Salida Activos</span>
<div class="flex items-center justify-between p-3 rounded-lg border border-primary/40 bg-surface-bright/40">
<div class="flex items-center gap-2.5">
<input checked="" class="rounded text-primary focus:ring-primary h-4 w-4" type="checkbox">
<div>
<div class="text-label-md font-label-md text-on-surface font-semibold">Turno Mañana</div>
<div class="text-label-sm font-label-sm text-secondary">Salida: 09:30 AM • Retorno: 01:30 PM</div>
</div>
</div>
<span class="px-2 py-0.5 rounded text-label-sm font-label-sm bg-primary/10 text-primary font-bold">Activo Diario</span>
</div>
<div class="flex items-center justify-between p-3 rounded-lg border border-primary/40 bg-surface-bright/40">
<div class="flex items-center gap-2.5">
<input checked="" class="rounded text-primary focus:ring-primary h-4 w-4" type="checkbox">
<div>
<div class="text-label-md font-label-md text-on-surface font-semibold">Turno Tarde</div>
<div class="text-label-sm font-label-sm text-secondary">Salida: 03:00 PM • Retorno: 07:00 PM</div>
</div>
</div>
<span class="px-2 py-0.5 rounded text-label-sm font-label-sm bg-primary/10 text-primary font-bold">Activo Diario</span>
</div>
</div>
<!-- Duración & Puntos de Encuentro -->
<div class="space-y-3">
<div>
<label class="block text-label-md font-label-md text-on-surface mb-1">Duración Estimada Total</label>
<div class="flex items-center gap-2">
<select class="w-full px-3 py-2 text-body-md font-body-md bg-surface-bright/40 border border-outline-variant rounded-lg text-on-surface">
<option>4 Horas (Medio Día)</option>
<option>6 Horas (Media Jornada Extendida)</option>
<option>Día Completo (8 a 9 Horas)</option>
</select>
</div>
</div>
<div>
<label class="block text-label-md font-label-md text-on-surface mb-1">Puntos de Embarque Permitidos</label>
<div class="space-y-1.5">
<label class="flex items-center gap-2 text-body-sm font-body-sm text-on-surface">
<input checked="" class="rounded text-primary focus:ring-primary" type="checkbox">
<span class="">Agencia Central Turismo Chilón (Jr. 2 de Mayo 569)</span>
</label>
<label class="flex items-center gap-2 text-body-sm font-body-sm text-on-surface">
<input checked="" class="rounded text-primary focus:ring-primary" type="checkbox">
<span class="">Recojo en Hoteles del Centro Histórico (Radio 8 cuadras)</span>
</label>
<label class="flex items-center gap-2 text-body-sm font-body-sm text-on-surface">
<input class="rounded text-primary focus:ring-primary" type="checkbox">
<span class="">Plaza Mayor Cajamarca (Frente a la Catedral)</span>
</label>
</div>
</div>
</div>
</div>
</section>
<!-- SECTION 4: Descripción y Detalles -->
<section class="bg-surface-container-lowest rounded-xl p-5 border border-outline-variant/70 shadow-sm relative overflow-hidden mb-6">
    <div class="absolute top-0 left-0 w-1.5 h-full bg-tertiary-container"></div>
    <div class="flex items-center gap-2 mb-4">
        <span class="material-symbols-outlined text-tertiary-container text-xl">description</span>
        <h2 class="text-title-md font-title-md text-on-surface">4. Descripción e Itinerario</h2>
    </div>
    <textarea asp-for="Description" rows="5" class="w-full px-3.5 py-2 text-body-md font-body-md bg-surface-bright/40 border border-outline-variant rounded-lg text-on-surface focus:ring-2 focus:ring-primary focus:border-transparent" placeholder="Escribe aquí el detalle del itinerario y lo que incluye..."></textarea>
</section>

<!-- SECTION IMAGE UPLOAD -->
<section class="bg-surface-container-lowest rounded-xl p-5 border border-outline-variant/70 shadow-sm relative overflow-hidden">
    <div class="absolute top-0 left-0 w-1.5 h-full bg-primary"></div>
    <div class="flex items-center gap-2 mb-4">
        <span class="material-symbols-outlined text-primary text-xl">image</span>
        <h2 class="text-title-md font-title-md text-on-surface">Imágenes del Tour</h2>
    </div>
    <input type="file" name="ImageFiles" multiple accept="image/*" class="w-full px-3.5 py-2 bg-surface-bright/40 border border-outline-variant rounded-lg text-on-surface" />
</section>

<!-- ACTION BUTTON BAR -->
<div class="pt-6 border-t border-outline-variant/60 flex flex-col-reverse sm:flex-row justify-end gap-3 items-center mt-6">
    <a href="/Admin/Tours" class="px-5 py-2.5 rounded-lg text-on-surface-variant hover:bg-surface-container font-label-md transition-colors w-full sm:w-auto text-center">
        Descartar Cambios
    </a>
    <button class="px-6 py-2.5 rounded-lg bg-primary hover:bg-primary-container text-on-primary font-label-lg shadow-md transition-all duration-150 active:scale-95 flex items-center gap-2 w-full sm:w-auto justify-center" type="submit">
        <span class="material-symbols-outlined text-base">cloud_upload</span>
        @(Model.Id == Guid.Empty ? "Publicar Nuevo Tour" : "Guardar Cambios")
    </button>
</div>
</div> <!-- End of left column space-y-6 -->
</form></main>


