@model SIGETOUR.API.Models.CategoryDto
@{
    bool isCreate = Model.Id == Guid.Empty;
    ViewData["Title"] = isCreate ? "Nueva Categoría de Tour" : "Editar Categoría: " + Model.Name;
    Layout = "_AdminLayout";
}

<div class="px-4 sm:px-6 lg:px-8 py-8 w-full max-w-5xl mx-auto space-y-6">

    <form asp-action="EditCategory" method="post" id="categoryForm">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="AssociatedToursCount" />

        <!-- Header Bar -->
        <div class="sm:flex sm:justify-between sm:items-center mb-6">
            <div class="flex items-center gap-3">
                <a href="@Url.Action("Categories", "Admin")" class="p-2 rounded-full hover:bg-surface-container transition-colors text-on-surface-variant shrink-0" title="Regresar al listado">
                    <span class="material-symbols-outlined text-[24px]">arrow_back</span>
                </a>
                <div>
                    <div class="flex items-center gap-2 text-label-sm font-label-sm text-secondary mb-0.5">
                        <a href="@Url.Action("Categories", "Admin")" class="hover:underline">Categorías de Tours</a>
                        <span class="material-symbols-outlined text-xs">chevron_right</span>
                        <span class="text-primary font-bold">@(isCreate ? "Nueva" : "Edición")</span>
                    </div>
                    <h1 class="text-headline-md font-headline-md font-extrabold text-on-surface flex items-center gap-2.5">
                        <span class="material-symbols-outlined text-primary text-[30px]">@(isCreate ? "add_circle" : "edit_document")</span>
                        @(isCreate ? "Registrar Nueva Categoría" : "Editar Categoría: " + Model.Name)
                    </h1>
                </div>
            </div>
            <div class="flex items-center gap-3 mt-4 sm:mt-0">
                <a href="@Url.Action("Categories", "Admin")" class="px-4 py-2.5 rounded-lg border border-outline-variant text-on-surface-variant hover:bg-surface-container transition-colors font-label-md">
                    Cancelar
                </a>
                <button type="submit" class="px-6 py-2.5 rounded-lg bg-primary hover:bg-[#0e5a52] text-on-primary font-label-lg font-bold shadow-md transition-all flex items-center gap-2 active:scale-95">
                    <span class="material-symbols-outlined text-xl">save</span>
                    <span>Guardar Categoría</span>
                </button>
            </div>
        </div>

        <!-- Form Card -->
        <div class="bg-surface-container-lowest rounded-2xl border border-outline-variant shadow-sm overflow-hidden space-y-6">
            <div class="px-6 py-4 border-b border-outline-variant bg-surface-bright flex items-center justify-between">
                <h2 class="text-title-md font-bold text-on-surface flex items-center gap-2">
                    <span class="material-symbols-outlined text-primary">category</span>
                    Información de la Categoría
                </h2>
                @if (!isCreate)
                {
                    <span class="text-label-sm px-2.5 py-1 rounded-full font-bold bg-primary-container text-on-primary-container">
                        @Model.AssociatedToursCount tours vinculados
                    </span>
                }
            </div>

            <div class="p-6 space-y-6">
                <!-- Row 1: Nombre y Orden -->
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
                    <div class="sm:col-span-2">
                        <label class="block text-label-md font-bold text-on-surface mb-1.5" asp-for="Name">
                            Nombre de la Categoría <span class="text-tertiary">*</span>
                        </label>
                        <div class="relative">
                            <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-outline text-[20px]">label</span>
                            <input asp-for="Name" class="w-full bg-surface-container-low text-on-surface pl-10 pr-4 py-2.5 rounded-lg border border-outline-variant focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none text-body-md" placeholder="Ej: Arqueología y Petroglifos" required maxlength="100" />
                        </div>
                        <span asp-validation-for="Name" class="text-error text-label-sm mt-1 block"></span>
                    </div>

                    <div>
                        <label class="block text-label-md font-bold text-on-surface mb-1.5" asp-for="DisplayOrder">
                            Orden de Visualización <span class="text-tertiary">*</span>
                        </label>
                        <div class="relative">
                            <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-outline text-[20px]">sort</span>
                            <input asp-for="DisplayOrder" type="number" min="1" max="999" class="w-full bg-surface-container-low text-on-surface pl-10 pr-4 py-2.5 rounded-lg border border-outline-variant focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none text-body-md font-bold" required />
                        </div>
                        <span class="text-label-sm text-outline mt-1 block">Posición en listados y filtros</span>
                        <span asp-validation-for="DisplayOrder" class="text-error text-label-sm mt-1 block"></span>
                    </div>
                </div>

                <!-- Row 2: Icono Material con selector rápido y vista previa -->
                <div>
                    <label class="block text-label-md font-bold text-on-surface mb-1.5" asp-for="Icon">
                        Icono Material Symbols
                    </label>
                    <div class="flex items-center gap-4">
                        <div class="w-14 h-14 rounded-xl bg-primary/10 border border-primary/20 text-primary flex items-center justify-center shrink-0 shadow-xs">
                            <span class="material-symbols-outlined text-[32px]" id="iconPreview">@(string.IsNullOrWhiteSpace(Model.Icon) ? "landscape" : Model.Icon)</span>
                        </div>
                        <div class="flex-1">
                            <input asp-for="Icon" id="iconInput" class="w-full bg-surface-container-low text-on-surface px-4 py-2.5 rounded-lg border border-outline-variant focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none text-body-md font-mono" placeholder="Ej: landscape, history_edu, hot_tub..." oninput="updateIconPreview(this.value)" />
                            <span class="text-label-sm text-outline mt-1 block">Escribe el nombre de un icono de Google Material Symbols o selecciona uno rápido:</span>
                        </div>
                    </div>
                    <!-- Quick Icon Badges -->
                    <div class="flex flex-wrap gap-2 mt-3 pt-3 border-t border-outline-variant/50">
                        <span class="text-label-sm text-on-surface-variant self-center mr-1">Sugeridos:</span>
                        @foreach (var (ic, label) in new[] {
                            ("landscape", "Naturaleza"),
                            ("history_edu", "Arqueología"),
                            ("hot_tub", "Termalismo"),
                            ("agriculture", "Agroturismo"),
                            ("location_city", "City Tour"),
                            ("hiking", "Trekking"),
                            ("kayaking", "Aventura"),
                            ("photo_camera", "Miradores"),
                            ("church", "Religioso"),
                            ("restaurant", "Gastronómico")
                        })
                        {
                            <button type="button" onclick="selectQuickIcon('@ic')" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-outline-variant hover:border-primary bg-surface-container-low hover:bg-primary-container text-body-sm font-medium text-on-surface transition-colors cursor-pointer">
                                <span class="material-symbols-outlined text-[16px] text-primary">@ic</span>
                                <span>@label</span>
                            </button>
                        }
                    </div>
                </div>

                <!-- Row 3: Descripción -->
                <div>
                    <label class="block text-label-md font-bold text-on-surface mb-1.5" asp-for="Description">
                        Descripción Resumida
                    </label>
                    <textarea asp-for="Description" rows="3" class="w-full bg-surface-container-low text-on-surface px-4 py-2.5 rounded-lg border border-outline-variant focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none text-body-md" placeholder="Describe brevemente las actividades o destinos comprendidos en esta categoría temática..." maxlength="300"></textarea>
                    <div class="flex justify-between items-center text-label-sm text-outline mt-1">
                        <span>Visible como ayuda explicativa en catálogos y paneles de gestión.</span>
                        <span id="descCharCount">0 / 300 caracteres</span>
                    </div>
                    <span asp-validation-for="Description" class="text-error text-label-sm mt-1 block"></span>
                </div>

                <!-- Row 4: Estado Activo / Inactivo -->
                <div class="p-4 rounded-xl bg-surface-container-low border border-outline-variant flex items-center justify-between">
                    <div>
                        <label class="font-bold text-on-surface text-body-md block">Estado Operativo de la Categoría</label>
                        <p class="text-body-sm text-on-surface-variant mt-0.5">
                            Si está activa, se mostrará en los filtros públicos y estará disponible para asociar nuevos tours.
                        </p>
                    </div>
                    <label class="relative inline-flex items-center cursor-pointer">
                        <input type="checkbox" asp-for="IsActive" class="sr-only peer">
                        <div class="w-11 h-6 bg-surface-container-highest peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-outline-variant after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-primary"></div>
                        <span class="ml-3 text-label-md font-bold text-on-surface peer-checked:text-primary">
                            @(Model.IsActive ? "Activa" : "Inactiva")
                        </span>
                    </label>
                </div>

                <!-- Validation Summary at the bottom in Spanish -->
                <div asp-validation-summary="All" class="p-4 rounded-xl bg-error-container/30 border border-error/20 text-error font-medium text-body-sm empty:hidden"></div>
            </div>

            <!-- Card Footer -->
            <div class="px-6 py-4 bg-surface-container-low/50 border-t border-outline-variant flex items-center justify-between">
                <a href="@Url.Action("Categories", "Admin")" class="px-4 py-2 rounded-lg border border-outline-variant text-on-surface-variant hover:bg-surface-container transition-colors font-label-md">
                    Volver al Listado
                </a>
                <button type="submit" class="px-6 py-2.5 rounded-lg bg-primary hover:bg-[#0e5a52] text-on-primary font-label-lg font-bold shadow-md transition-all flex items-center gap-2 active:scale-95">
                    <span class="material-symbols-outlined text-xl">save</span>
                    <span>Guardar Categoría</span>
                </button>
            </div>
        </div>
    </form>

    <!-- Danger Zone if Edit -->
    @if (!isCreate)
    {
        <div class="bg-surface-container-lowest rounded-2xl border-2 border-tertiary/30 p-6 shadow-sm">
            <div class="flex items-start justify-between flex-col md:flex-row gap-4">
                <div class="flex items-start gap-3.5">
                    <div class="w-11 h-11 rounded-xl bg-error-container text-tertiary flex items-center justify-center shrink-0">
                        <span class="material-symbols-outlined text-2xl">warning</span>
                    </div>
                    <div>
                        <h3 class="text-title-sm font-bold text-on-surface">Zona de Peligro: Eliminar Categoría @Model.Name</h3>
                        <p class="text-body-sm text-tertiary mt-1 flex items-center gap-1">
                            <span class="material-symbols-outlined text-base">info</span>
                            Los tours asociados a esta categoría (@Model.AssociatedToursCount tours) no se borrarán; únicamente quedarán sin categoría.
                        </p>
                    </div>
                </div>
                <button type="button" class="shrink-0 px-4 py-2.5 rounded-lg bg-tertiary text-on-tertiary font-label-md font-bold hover:bg-tertiary/90 transition-all flex items-center gap-1.5 shadow-sm" onclick="document.getElementById('editDeleteCategoryModal').classList.remove('hidden')">
                    <span class="material-symbols-outlined text-base">delete_forever</span>
                    Eliminar Categoría
                </button>
            </div>
        </div>

        <!-- Delete Modal for Edit View -->
        <div class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-inverse-surface/70 backdrop-blur-sm transition-opacity duration-200 hidden" id="editDeleteCategoryModal">
            <div class="bg-surface-container-lowest rounded-2xl w-full max-w-xl border border-outline-variant shadow-2xl overflow-hidden">
                <div class="h-2 w-full bg-red-600"></div>
                <div class="p-6 pb-4 flex items-start justify-between gap-4">
                    <div class="flex items-center gap-3">
                        <div class="w-12 h-12 rounded-xl bg-red-100 border border-red-200 flex items-center justify-center text-red-600 shrink-0">
                            <span class="material-symbols-outlined text-[28px]">warning</span>
                        </div>
                        <div>
                            <h3 class="text-headline-sm font-headline-sm text-on-surface font-bold leading-snug">¿Eliminar esta categoría?</h3>
                            <span class="text-label-sm font-label-sm text-red-600 font-bold tracking-wider uppercase">Confirmación Requerida</span>
                        </div>
                    </div>
                    <button class="p-1.5 rounded-lg text-on-surface-variant hover:bg-surface-container transition-colors" onclick="document.getElementById('editDeleteCategoryModal').classList.add('hidden')" type="button">
                        <span class="material-symbols-outlined">close</span>
                    </button>
                </div>
                <div class="px-6 py-4 space-y-4">
                    <p class="text-body-md font-body-md text-on-surface leading-relaxed">
                        Estás a punto de eliminar definitivamente la categoría <strong>@Model.Name</strong>.
                    </p>
                    <div class="p-4 rounded-xl bg-red-50 border border-red-200">
                        <label class="block text-label-md font-label-md text-on-surface mb-2 font-bold">
                            Para confirmar, escribe la palabra <span class="text-red-600 font-mono font-bold">ELIMINAR</span>:
                        </label>
                        <input class="w-full uppercase font-mono tracking-wider text-body-md rounded-lg border-outline-variant focus:border-red-600 focus:ring-red-600 bg-surface-container-lowest text-on-surface px-3 py-2" id="confirmEditDeleteInput" placeholder="Escribe 'ELIMINAR'" type="text" autocomplete="off"/>
                    </div>
                </div>
                <div class="p-6 pt-4 bg-surface-container-high/20 border-t border-outline-variant/40 flex flex-col-reverse sm:flex-row justify-end gap-3">
                    <button class="px-5 py-2.5 rounded-lg border border-outline-variant bg-surface-container-lowest text-on-surface font-label-md font-bold hover:bg-surface-container transition-all" onclick="document.getElementById('editDeleteCategoryModal').classList.add('hidden')" type="button">Cancelar</button>
                    <form asp-action="DeleteCategory" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <button type="submit" class="flex items-center gap-2 px-5 py-2.5 rounded-lg bg-red-600 disabled:bg-gray-300 disabled:cursor-not-allowed text-white font-label-md font-bold shadow-sm transition-all hover:bg-red-700" disabled id="confirmEditDeleteBtn">
                            <span class="material-symbols-outlined text-[18px]">delete_forever</span>
                            <span>Sí, Eliminar Definitivamente</span>
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <script>
            document.getElementById('confirmEditDeleteInput')?.addEventListener('input', function() {
                document.getElementById('confirmEditDeleteBtn').disabled = (this.value.trim().toUpperCase() !== 'ELIMINAR');
            });
        </script>
    }
</div>

<script>
    function updateIconPreview(val) {
        val = val ? val.trim() : 'landscape';
        document.getElementById('iconPreview').innerText = val;
    }

    function selectQuickIcon(iconName) {
        document.getElementById('iconInput').value = iconName;
        updateIconPreview(iconName);
    }

    // Char counter for description
    const descInput = document.getElementById('Description');
    const descCount = document.getElementById('descCharCount');
    if (descInput && descCount) {
        function updateCount() {
            descCount.innerText = `${descInput.value.length} / 300 caracteres`;
        }
        descInput.addEventListener('input', updateCount);
        updateCount();
    }
</script>
