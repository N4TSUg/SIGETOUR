@using SIGETOUR.API.Core.Entities
@{
    ViewData["Title"] = "Despacho y Reservas";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var bookings = Model as IEnumerable<Booking>;
    var currentSearch = ViewBag.CurrentSearch as string;
    var currentStatus = ViewBag.CurrentStatus as string;
    var currentDate = ViewBag.CurrentDate as string;
    var currentTourId = ViewBag.CurrentTourId as Guid?;
    var availableTours = ViewBag.AvailableTours as IEnumerable<TourPackage> ?? Enumerable.Empty<TourPackage>();
    var availableVehicles = ViewBag.AvailableVehicles as IEnumerable<Vehicle> ?? Enumerable.Empty<Vehicle>();
    var driversList = ViewBag.Drivers as IEnumerable<Driver> ?? Enumerable.Empty<Driver>();
    bool hasFilters = !string.IsNullOrWhiteSpace(currentSearch) || (!string.IsNullOrWhiteSpace(currentStatus) && currentStatus != "Todos") || !string.IsNullOrWhiteSpace(currentDate) || (currentTourId.HasValue && currentTourId.Value != Guid.Empty);
}

<div class="mb-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
    <div>
        <div class="flex items-center gap-2 mb-1">
            <span class="px-2.5 py-0.5 rounded-full bg-secondary-container text-on-secondary-container text-label-sm font-bold tracking-wide uppercase">
                Operaciones de Campo
            </span>
            <span class="text-label-sm text-secondary font-medium">• @DateTime.Now.ToString("dd MMMM yyyy")</span>
        </div>
        <h1 class="text-display-sm font-bold text-on-surface">Despacho de Salidas y Reservas</h1>
        <p class="text-body-lg text-on-surface-variant">Historial, control de salidas programadas y emisión de manifiestos oficiales de viaje MTC.</p>
    </div>
    <div class="flex flex-wrap items-center gap-2.5">
        <button type="button" onclick="openManifestModal()" class="px-4 py-2 rounded-lg bg-surface-container-lowest hover:bg-surface-container border border-outline text-primary font-bold flex items-center gap-2 transition-all shadow-sm cursor-pointer" title="Generar y Exportar Manifiesto Oficial de Pasajeros en Excel">
            <span class="material-symbols-outlined text-[20px]">table_view</span>
            Exportar Manifiesto (Excel)
        </button>
        <a href="@Url.Action("CreateBooking", "Admin")" class="bg-primary text-on-primary px-4 py-2 rounded-lg font-bold flex items-center gap-2 hover:bg-primary/90 transition-colors inline-flex shadow-sm shrink-0" title="Ir al formulario para registrar reserva manual">
            <span class="material-symbols-outlined">add</span>
            Nueva Reserva Manual
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="p-4 rounded-xl bg-primary/10 border border-primary/20 text-primary flex items-center gap-3 mb-6">
        <span class="material-symbols-outlined text-[22px]">check_circle</span>
        <span class="font-semibold text-body-md">@TempData["SuccessMessage"]</span>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="p-4 rounded-xl bg-red-100 border border-red-200 text-red-700 flex items-center gap-3 mb-6">
        <span class="material-symbols-outlined text-[22px]">error</span>
        <span class="font-semibold text-body-md">@TempData["ErrorMessage"]</span>
    </div>
}

<!-- Barra de Búsqueda y Filtros -->
<div class="bg-surface-container-lowest p-4 rounded-2xl border border-outline-variant shadow-sm mb-6">
    <form method="get" asp-action="Bookings" id="bookingFilterForm" class="grid grid-cols-1 md:grid-cols-12 gap-3 items-center">
        <!-- Input de Búsqueda General -->
        <div class="md:col-span-4 relative">
            <label for="bookingSearchInput" class="sr-only">Buscar por código, cliente, DNI, tour o punto</label>
            <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-outline text-[20px]">search</span>
            <input type="text" id="bookingSearchInput" name="search" value="@currentSearch" placeholder="Buscar por código, cliente, DNI, tour o punto..." class="w-full pl-10 pr-9 py-2 bg-surface-container-low border border-outline-variant rounded-lg text-body-sm text-on-surface focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-all" />
            @if (!string.IsNullOrWhiteSpace(currentSearch))
            {
                <a href="@Url.Action("Bookings", "Admin", new { status = currentStatus, date = currentDate, tourId = currentTourId })" class="absolute right-2.5 top-1/2 -translate-y-1/2 text-outline hover:text-on-surface material-symbols-outlined text-[16px]">close</a>
            }
        </div>

        <!-- Filtro por Circuito / Salida -->
        <div class="md:col-span-3">
            <label for="bookingTourSelect" class="sr-only">Filtrar por Circuito o Tour</label>
            <select name="tourId" id="bookingTourSelect" class="w-full py-2 px-3 bg-surface-container-low border border-outline-variant rounded-lg text-body-sm text-on-surface focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-all">
                <option value="" selected="@(!currentTourId.HasValue || currentTourId.Value == Guid.Empty)">Todos los Circuitos / Tours</option>
                @foreach (var tour in availableTours)
                {
                    <option value="@tour.Id" selected="@(currentTourId.HasValue && currentTourId.Value == tour.Id)">@tour.Title</option>
                }
            </select>
        </div>

        <!-- Filtro por Estado -->
        <div class="md:col-span-2">
            <label for="bookingStatusSelect" class="sr-only">Filtrar por Estado de Reserva</label>
            <select name="status" id="bookingStatusSelect" class="w-full py-2 px-3 bg-surface-container-low border border-outline-variant rounded-lg text-body-sm text-on-surface focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-all">
                <option value="Todos" selected="@(string.IsNullOrEmpty(currentStatus) || currentStatus == "Todos")">Todos los Estados</option>
                <option value="Confirmed" selected="@(currentStatus == "Confirmed")">Confirmados</option>
                <option value="Pending" selected="@(currentStatus == "Pending")">Pendientes</option>
                <option value="Cancelled" selected="@(currentStatus == "Cancelled")">Cancelados</option>
            </select>
        </div>

        <!-- Filtro por Fecha de Salida -->
        <div class="md:col-span-2">
            <label for="bookingDateInput" class="sr-only">Filtrar por Fecha de Salida</label>
            <input type="date" name="date" id="bookingDateInput" value="@currentDate" class="w-full py-2 px-3 bg-surface-container-low border border-outline-variant rounded-lg text-body-sm text-on-surface focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-all" title="Filtrar por fecha de salida" />
        </div>

        <!-- Botones de Acción -->
        <div class="md:col-span-1 flex items-center gap-1.5">
            <button type="submit" class="flex-1 py-2 px-2.5 bg-primary hover:bg-[#0e5a52] text-on-primary font-bold text-body-sm rounded-lg flex items-center justify-center gap-1 shadow-sm transition-all cursor-pointer" title="Aplicar Filtros">
                <span class="material-symbols-outlined text-[18px]">filter_list</span>
            </button>
            @if (hasFilters)
            {
                <a href="@Url.Action("Bookings", "Admin")" class="py-2 px-2.5 bg-surface-container hover:bg-surface-container-high text-on-surface-variant rounded-lg border border-outline-variant flex items-center justify-center transition-colors cursor-pointer" title="Limpiar todos los filtros">
                    <span class="material-symbols-outlined text-[18px]">filter_alt_off</span>
                </a>
            }
        </div>
    </form>
</div>

<!-- Tabla de Despacho y Reservas -->
<div class="bg-surface-container-lowest rounded-2xl shadow-sm border border-outline-variant overflow-hidden">
    <div class="px-6 py-3.5 border-b border-outline-variant bg-surface-bright flex items-center justify-between">
        <div class="flex items-center gap-2">
            <span class="material-symbols-outlined text-primary text-[20px]">departure_board</span>
            <span class="text-label-md font-bold text-on-surface" id="bookingResultsCount">
                @{
                    var pvm = ViewBag.Pagination as SIGETOUR.API.Models.PaginationViewModel;
                    int totalCount = pvm?.TotalItems ?? (bookings?.Count() ?? 0);
                }
                @if (totalCount > 0)
                {
                    @:Total: @totalCount reservas registradas
                }
                else
                {
                    @:0 reservas encontradas
                }
            </span>
        </div>
        @if (hasFilters)
        {
            <span class="text-xs text-primary font-bold bg-primary/10 px-2 py-0.5 rounded-full">Filtro aplicado</span>
        }
    </div>

    <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse" id="bookingsTable">
            <thead>
                <tr class="bg-surface-container-low text-on-surface-variant font-label-lg border-b border-outline-variant text-xs uppercase tracking-wider">
                    <th class="p-3.5 font-semibold">Código</th>
                    <th class="p-3.5 font-semibold">Salida / Circuito</th>
                    <th class="p-3.5 font-semibold">Fecha y Turno</th>
                    <th class="p-3.5 font-semibold">Titular / Contacto</th>
                    <th class="p-3.5 font-semibold text-center">Pax</th>
                    <th class="p-3.5 font-semibold">Total / Abonado</th>
                    <th class="p-3.5 font-semibold text-center">Saldo Pendiente</th>
                    <th class="p-3.5 font-semibold text-center">Estado</th>
                    <th class="p-3.5 font-semibold text-right">Acciones</th>
                </tr>
            </thead>
            <tbody class="text-body-md text-on-surface divide-y divide-outline-variant/50" id="bookingsTableBody">
                @if (bookings != null && bookings.Any())
                {
                    foreach (var booking in bookings)
                    {
                        var statusStr = booking.Status.ToString();
                        var item = booking.Items.FirstOrDefault();
                        var tour = item?.TourPackage;
                        var tourTitle = tour?.Title ?? "Sin tour asignado";
                        var tourCategory = tour?.Category?.Name ?? "";
                        var tourDuration = tour?.Duration ?? "";
                        var searchMeta = $"{booking.ReferenceCode} {booking.CustomerName} {booking.CustomerEmail} {booking.CustomerPhone} {booking.CustomerDni} {booking.OperationNumber} {tourTitle} {tourCategory} {booking.PickupLocation} {booking.ShiftName}".ToLower();
                        
                        <tr class="hover:bg-surface-container-low/50 transition-colors booking-row" 
                            data-search="@searchMeta" 
                            data-status="@statusStr" 
                            data-tour="@(tour?.Id.ToString() ?? "")"
                            data-date="@booking.TravelDate.ToString("yyyy-MM-dd")">
                            
                            <!-- CÓDIGO -->
                            <td class="p-3.5 font-mono whitespace-nowrap">
                                <div class="font-bold text-primary flex items-center gap-1 text-sm">
                                    <span class="material-symbols-outlined text-[17px]">confirmation_number</span>
                                    <span>@booking.ReferenceCode</span>
                                </div>
                                <span class="text-[11px] text-outline block mt-0.5">Boleto Elect.</span>
                            </td>

                            <!-- SALIDA / CIRCUITO -->
                            <td class="p-3.5">
                                @if (tour != null)
                                {
                                    <div class="font-bold text-on-surface flex items-center gap-1.5 text-body-md">
                                        <span class="material-symbols-outlined text-primary text-[18px] shrink-0">tour</span>
                                        <span class="truncate max-w-[220px]" title="@tour.Title">@tour.Title</span>
                                    </div>
                                    <div class="flex items-center gap-1.5 mt-1 text-xs">
                                        @if (tour.Category != null)
                                        {
                                            <span class="px-2 py-0.5 rounded-md bg-secondary-container/50 text-on-secondary-container font-semibold text-[11px]">@tour.Category.Name</span>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(tour.Duration))
                                        {
                                            <span class="text-outline flex items-center gap-0.5 text-[11px]">
                                                <span class="material-symbols-outlined text-[13px]">timelapse</span> @tour.Duration
                                            </span>
                                        }
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(booking.PickupLocation))
                                    {
                                        <div class="text-xs text-secondary mt-1 flex items-center gap-1 font-medium" title="Punto de recojo / salida">
                                            <span class="material-symbols-outlined text-[14px] text-primary shrink-0">pin_drop</span>
                                            <span class="truncate max-w-[200px]">@booking.PickupLocation</span>
                                        </div>
                                    }
                                    @if (booking.AssignedVehicle != null)
                                    {
                                        <div class="text-[11px] font-bold text-emerald-800 bg-emerald-50 border border-emerald-200 px-1.5 py-0.5 rounded mt-1 inline-flex items-center gap-1" title="Vehículo y Conductor asignados en Manifiesto">
                                            <span class="material-symbols-outlined text-[13px] shrink-0 text-emerald-600">directions_bus</span>
                                            <span class="truncate max-w-[200px]">Despacho: @booking.AssignedVehicle.LicensePlate • @(booking.AssignedDriver?.FullName ?? "Chofer asignado")</span>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="text-[11px] text-amber-700 bg-amber-50 border border-amber-200 px-1.5 py-0.5 rounded mt-1 inline-flex items-center gap-1" title="El vehículo se asigna al exportar el Manifiesto de la salida">
                                            <span class="material-symbols-outlined text-[13px] shrink-0 text-amber-600">schedule</span>
                                            <span>Por asignar en Manifiesto</span>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <span class="inline-flex items-center gap-1 text-xs text-outline italic">
                                        <span class="material-symbols-outlined text-[14px]">warning</span> Sin tour asignado
                                    </span>
                                }
                            </td>

                            <!-- FECHA Y TURNO -->
                            <td class="p-3.5 whitespace-nowrap">
                                <div class="font-bold text-on-surface flex items-center gap-1 text-body-sm">
                                    <span class="material-symbols-outlined text-[16px] text-primary">calendar_today</span>
                                    <span>@booking.TravelDate.ToString("dd MMM yyyy")</span>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(booking.ShiftName))
                                {
                                    <div class="text-xs text-secondary font-semibold flex items-center gap-1 mt-1">
                                        <span class="material-symbols-outlined text-[14px]">schedule</span>
                                        <span>Turno: @booking.ShiftName</span>
                                    </div>
                                }
                                else
                                {
                                    <span class="text-[11px] text-outline block mt-0.5">Turno Regular</span>
                                }
                            </td>

                            <!-- TITULAR / CONTACTO -->
                            <td class="p-3.5">
                                <div class="font-bold text-on-surface text-body-sm truncate max-w-[170px]" title="@booking.CustomerName">@booking.CustomerName</div>
                                <div class="text-xs text-on-surface-variant flex items-center gap-1 mt-0.5">
                                    @if (!string.IsNullOrWhiteSpace(booking.CustomerDni))
                                    {
                                        <span class="font-mono bg-surface-container px-1 py-0.2 rounded text-[11px]">DNI: @booking.CustomerDni</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(booking.CustomerPhone))
                                    {
                                        <span class="text-outline text-[11px]">Tel: @booking.CustomerPhone</span>
                                    }
                                </div>
                                @if (!string.IsNullOrWhiteSpace(booking.CustomerEmail))
                                {
                                    <div class="text-[11px] text-outline truncate max-w-[170px] mt-0.5">@booking.CustomerEmail</div>
                                }
                            </td>

                            <!-- PASAJEROS (PAX) -->
                            <td class="p-3.5 text-center whitespace-nowrap">
                                <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg bg-surface-container border border-outline-variant font-bold text-body-sm text-on-surface">
                                    <span class="material-symbols-outlined text-[15px] text-primary">group</span>
                                    <span>@booking.TotalPassengers pax</span>
                                </span>
                            </td>

                            <!-- TOTAL / ABONADO -->
                            <td class="p-3.5 whitespace-nowrap">
                                <div class="font-bold text-on-surface text-body-md">Total: S/ @booking.TotalAmount.ToString("F2")</div>
                                <div class="text-xs font-semibold @(booking.PaidAmount > 0 ? "text-emerald-700 font-bold" : "text-outline") mt-0.5 flex items-center gap-1">
                                    <span class="material-symbols-outlined text-[14px]">payments</span>
                                    <span>Abonado: S/ @booking.PaidAmount.ToString("F2")</span>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(booking.PaymentMethod))
                                {
                                    <div class="text-[11px] text-outline font-medium mt-0.5">
                                        @booking.PaymentMethod
                                    </div>
                                }
                            </td>

                            <!-- SALDO PENDIENTE -->
                            <td class="p-3.5 whitespace-nowrap text-center">
                                @{
                                    var pendingBalance = booking.TotalAmount - booking.PaidAmount;
                                    var isFullyPaid = booking.PaidAmount >= booking.TotalAmount && booking.TotalAmount > 0;
                                    var isPartial = booking.PaidAmount > 0 && pendingBalance > 0;
                                }
                                @if (isFullyPaid)
                                {
                                    <span class="inline-flex items-center gap-1 text-emerald-800 bg-emerald-100 border border-emerald-300 px-2.5 py-1 rounded-full font-label-sm font-bold text-xs">
                                        <span class="material-symbols-outlined text-[14px]">verified</span> Pagado 100%
                                    </span>
                                }
                                else if (isPartial)
                                {
                                    <div class="inline-flex flex-col items-center">
                                        <span class="inline-flex items-center gap-1 text-amber-900 bg-amber-100 border border-amber-400 px-2.5 py-1 rounded-full font-label-sm font-bold text-xs">
                                            <span class="material-symbols-outlined text-[14px]">toll</span> Saldo: S/ @pendingBalance.ToString("F2")
                                        </span>
                                        <span class="text-[10px] text-amber-800 font-bold mt-0.5 uppercase tracking-tight">Cobrar en Counter</span>
                                    </div>
                                }
                                else
                                {
                                    <span class="inline-flex items-center gap-1 text-gray-700 bg-gray-100 border border-gray-300 px-2.5 py-1 rounded-full font-label-sm text-xs">
                                        S/ @booking.TotalAmount.ToString("F2") (Sin abono)
                                    </span>
                                }
                            </td>

                            <!-- ESTADO -->
                            <td class="p-3.5 text-center whitespace-nowrap">
                                @if (booking.Status == BookingStatus.Confirmed)
                                {
                                    <span class="inline-flex items-center gap-1 text-green-800 bg-green-100 px-2.5 py-1 rounded-full font-label-sm font-semibold text-xs">
                                        <span class="material-symbols-outlined text-[14px]">check_circle</span> Confirmado
                                    </span>
                                }
                                else if (booking.Status == BookingStatus.Pending)
                                {
                                    <span class="inline-flex items-center gap-1 text-yellow-800 bg-yellow-100 px-2.5 py-1 rounded-full font-label-sm font-semibold text-xs">
                                        <span class="material-symbols-outlined text-[14px]">pending</span> Pendiente
                                    </span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center gap-1 text-red-800 bg-red-100 px-2.5 py-1 rounded-full font-label-sm font-semibold text-xs">
                                        <span class="material-symbols-outlined text-[14px]">cancel</span> Cancelado
                                    </span>
                                }
                            </td>

                            <!-- ACCIONES -->
                            <td class="p-3.5 text-right space-x-1 whitespace-nowrap">
                                <a href="@Url.Action("Voucher", "Booking", new { id = booking.Id })" target="_blank" class="inline-flex items-center justify-center p-2 text-on-surface-variant hover:text-primary rounded-lg hover:bg-surface-container transition-colors cursor-pointer" title="Ver Boleto Oficial">
                                    <span class="material-symbols-outlined text-[20px]">confirmation_number</span>
                                </a>
                                @if (booking.Status == BookingStatus.Confirmed)
                                {
                                    <a href="@Url.Action("Ticket", "Booking", new { id = booking.Id })" target="_blank" class="inline-flex items-center justify-center p-2 text-on-surface-variant hover:text-amber-600 rounded-lg hover:bg-amber-50 transition-colors cursor-pointer" title="Imprimir Ticket POS (80mm / 58mm)">
                                        <span class="material-symbols-outlined text-[20px]">receipt_long</span>
                                    </a>
                                }
                                @{
                                    var bRawPhone = booking.CustomerPhone ?? "";
                                    var bVoucherUrl = Url.Action("Voucher", "Booking", new { id = booking.Id }, Context.Request.Scheme);
                                    var bTourTitle = tour?.Title ?? "Circuito Cajamarca";
                                    var bTravelDateStr = booking.TravelDate.ToString("dd/MM/yyyy");
                                }
                                <button type="button" 
                                        onclick="openSendEmailModal('@booking.Id', '@(booking.CustomerEmail?.Replace("'", "\\'") ?? "")', '@booking.ReferenceCode', '@(booking.CustomerName?.Replace("'", "\\'") ?? "")')" 
                                        class="inline-flex items-center justify-center p-2 text-on-surface-variant hover:text-emerald-700 hover:bg-emerald-50 rounded-lg transition-colors cursor-pointer" 
                                        title="Enviar Boleto y Boleta (PDF) por Correo">
                                    <span class="material-symbols-outlined text-[20px]">forward_to_inbox</span>
                                </button>
                                <button type="button" 
                                        onclick="openSendWhatsAppModal('@booking.Id', '@bRawPhone', '@(booking.CustomerName?.Replace("'", "\\'") ?? "")', '@booking.ReferenceCode', '@(bTourTitle.Replace("'", "\\'"))', '@bTravelDateStr')" 
                                        class="inline-flex items-center justify-center p-2 text-on-surface-variant hover:text-[#25D366] hover:bg-emerald-50 rounded-lg transition-colors cursor-pointer" 
                                        title="Enviar Boleto y Boleta (PDF) por WhatsApp">
                                    <span class="material-symbols-outlined text-[20px] text-[#25D366]">chat</span>
                                </button>
                                <button type="button" onclick="openManifestForBooking('@booking.TravelDate.ToString("yyyy-MM-dd")', '@tour?.Id', '@booking.ShiftName', '@tour?.DefaultVehicleId')" class="inline-flex items-center justify-center p-2 text-on-surface-variant hover:text-primary rounded-lg hover:bg-surface-container transition-colors cursor-pointer" title="Exportar Manifiesto de esta Salida en Excel">
                                    <span class="material-symbols-outlined text-[20px]">table_view</span>
                                </button>
                                <a href="@Url.Action("EditBooking", "Admin", new { id = booking.Id })" class="inline-flex items-center justify-center p-2 text-on-surface-variant hover:text-primary rounded-lg hover:bg-surface-container transition-colors" title="Ver / Editar Reserva">
                                    <span class="material-symbols-outlined text-[20px]">edit_note</span>
                                </a>
                                <button type="button" onclick="openDeleteBookingModal('@booking.Id', '@booking.ReferenceCode', '@(booking.CustomerName?.Replace("'", "\\'") ?? "")')" class="inline-flex items-center justify-center p-2 text-on-surface-variant hover:text-red-600 hover:bg-red-50 rounded-lg transition-colors cursor-pointer" title="Eliminar Reserva Definitivamente">
                                    <span class="material-symbols-outlined text-[20px]">delete</span>
                                </button>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr id="noResultsServerRow">
                        <td colspan="9" class="p-8 text-center text-on-surface-variant">
                            <span class="material-symbols-outlined text-outline text-4xl block mb-2">departure_board</span>
                            No se encontraron reservas con los criterios seleccionados.
                            @if (hasFilters)
                            {
                                <div class="mt-3">
                                    <a href="@Url.Action("Bookings", "Admin")" class="text-primary font-bold hover:underline">Limpiar filtros</a>
                                </div>
                            }
                        </td>
                    </tr>
                }
                <tr id="noResultsClientRow" class="hidden">
                    <td colspan="9" class="p-8 text-center text-on-surface-variant">
                        <span class="material-symbols-outlined text-outline text-4xl block mb-2">search_off</span>
                        No hay reservas que coincidan con la búsqueda en tiempo real.
                    </td>
                </tr>
            </tbody>
        </table>
    </div>

    <partial name="_AdminPagination" model="ViewBag.Pagination as SIGETOUR.API.Models.PaginationViewModel" />
</div>

<!-- ======================================================== -->
<!-- MODAL DE EXPORTACIÓN DE MANIFIESTO DE SALIDA             -->
<!-- ======================================================== -->
<div id="manifestModal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-inverse-surface/60 backdrop-blur-sm transition-all duration-200 hidden">
    <div class="bg-surface-container-lowest rounded-2xl max-w-3xl w-full p-6 shadow-2xl border border-outline-variant relative max-h-[92vh] overflow-y-auto">
        <!-- Encabezado Modal -->
        <div class="flex items-start justify-between border-b border-outline-variant/60 pb-4 mb-5">
            <div class="flex items-center gap-3">
                <div class="w-12 h-12 rounded-xl bg-primary/10 text-primary flex items-center justify-center shrink-0">
                    <span class="material-symbols-outlined text-2xl">table_view</span>
                </div>
                <div>
                    <h3 class="text-headline-sm font-bold text-on-surface leading-tight">Exportar Manifiesto de Pasajeros MTC</h3>
                    <p class="text-body-sm text-on-surface-variant mt-0.5">Genera el archivo Excel oficial con la capacidad exacta de asientos del vehículo asignado a la salida.</p>
                </div>
            </div>
            <button type="button" onclick="closeManifestModal()" class="p-1 rounded-lg hover:bg-surface-container text-outline hover:text-on-surface transition-colors cursor-pointer">
                <span class="material-symbols-outlined text-2xl">close</span>
            </button>
        </div>

        <form id="manifestExportForm" method="post" asp-action="ExportManifestExcel" target="_blank" class="space-y-5">
            <!-- SELECCIÓN PRINCIPAL DE LA SALIDA -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <!-- Fecha de Recorrido -->
                <div>
                    <label for="manifestDate" class="block text-label-sm font-bold text-on-surface-variant mb-1">Fecha de la Salida <span class="text-tertiary">*</span></label>
                    <input type="date" name="Date" id="manifestDate" value="@(currentDate ?? DateTime.Today.ToString("yyyy-MM-dd"))" onchange="fetchManifestPreview()" class="w-full py-2.5 px-3 rounded-lg border border-outline-variant bg-surface-bright text-body-sm text-on-surface focus:border-primary focus:ring-1 focus:ring-primary outline-none" required />
                </div>

                <!-- Circuito / Tour -->
                <div>
                    <label for="manifestTour" class="block text-label-sm font-bold text-on-surface-variant mb-1">Circuito Turístico <span class="text-tertiary">*</span></label>
                    <select name="TourPackageId" id="manifestTour" onchange="onTourChangedManifest()" class="w-full py-2.5 px-3 rounded-lg border border-outline-variant bg-surface-bright text-body-sm text-on-surface focus:border-primary focus:ring-1 focus:ring-primary outline-none" required>
                        @foreach (var tour in availableTours)
                        {
                            <option value="@tour.Id" data-vehicle="@tour.DefaultVehicleId" selected="@(currentTourId == tour.Id)">
                                @tour.Title
                            </option>
                        }
                    </select>
                </div>

                <!-- Turno de Salida -->
                <div>
                    <label for="manifestShift" class="block text-label-sm font-bold text-on-surface-variant mb-1">Turno Operativo</label>
                    <select name="ShiftName" id="manifestShift" onchange="fetchManifestPreview()" class="w-full py-2.5 px-3 rounded-lg border border-outline-variant bg-surface-bright text-body-sm text-on-surface focus:border-primary focus:ring-1 focus:ring-primary outline-none">
                        <option value="">Todos los turnos de la jornada</option>
                        <option value="Mañana (09:00 AM)">Mañana (09:00 AM)</option>
                        <option value="Tarde (02:30 PM)">Tarde (02:30 PM)</option>
                        <option value="Día Completo">Día Completo</option>
                    </select>
                </div>

                <!-- Vehículo Elegido (Determina la cantidad de asientos de la tabla Excel) -->
                <div>
                    <label for="manifestVehicle" class="block text-label-sm font-bold text-on-surface-variant mb-1 flex items-center justify-between">
                        <span>Vehículo Asignado a la Salida <span class="text-tertiary">*</span></span>
                        <span class="text-[11px] text-primary font-bold" id="previewTotalSeatsBadge">-- Asientos</span>
                    </label>
                    <select name="VehicleId" id="manifestVehicle" onchange="fetchManifestPreview()" class="w-full py-2.5 px-3 rounded-lg border-2 border-primary/40 bg-surface-bright text-body-sm font-bold text-on-surface focus:border-primary focus:ring-1 focus:ring-primary outline-none cursor-pointer" required>
                        @if (availableVehicles.Any())
                        {
                            foreach (var v in availableVehicles)
                            {
                                <option value="@v.Id" data-capacity="@v.SeatCapacity" data-plate="@v.LicensePlate" data-model="@v.Model">
                                    @v.Model (@v.LicensePlate) &bull; @v.SeatCapacity Asientos
                                </option>
                            }
                        }
                        else
                        {
                            <option value="" data-capacity="18" data-plate="T7C-000" data-model="Unidad Estándar">Unidad Estándar (18 Asientos)</option>
                        }
                    </select>
                </div>
            </div>

            <!-- DATOS OPERATIVOS DEL SERVICIO (TRIPULACIÓN Y DESPACHO) -->
            <div class="bg-surface-container-low/50 p-4 rounded-xl border border-outline-variant/60 space-y-3">
                <span class="text-label-sm font-bold text-secondary uppercase tracking-wider block">Ficha Operativa de Tripulación (Formatos MTC)</span>
                
                <div class="grid grid-cols-1 md:grid-cols-2 gap-3 text-body-sm">
                    <div>
                        <label for="manifestDriverSelect" class="block text-[11px] font-semibold text-outline mb-1">Conductor Habilitado MTC <span class="text-tertiary">*</span></label>
                        <select name="DriverId" id="manifestDriverSelect" onchange="onDriverSelected(this)" class="w-full py-1.5 px-3 rounded-lg border border-outline-variant bg-surface-container-lowest text-on-surface text-body-sm font-semibold focus:border-primary outline-none">
                            <option value="" data-name="Conductor Oficial Chilón" data-license="Q-42910834" data-vehicle="">-- Seleccionar Conductor Oficial --</option>
                            @foreach (var d in driversList)
                            {
                                <option value="@d.Id" data-name="@d.FullName" data-license="@d.LicenseNumber" data-vehicle="@(d.AssignedVehicleId?.ToString() ?? "")">
                                    @d.FullName &bull; Lic: @d.LicenseNumber (@d.LicenseCategory.Split(' ')[0])
                                </option>
                            }
                        </select>
                        <input type="hidden" name="DriverName" id="manifestDriver" value="Conductor Oficial Chilón" />
                    </div>
                    <div>
                        <label for="manifestDriverLicense" class="block text-[11px] font-semibold text-outline mb-1">N° Licencia de Conducir / DNI</label>
                        <input type="text" name="DriverLicense" id="manifestDriverLicense" value="Q-42910834" class="w-full py-1.5 px-3 rounded-lg border border-outline-variant bg-surface-container-lowest text-on-surface text-body-sm focus:border-primary outline-none" />
                    </div>
                    <div>
                        <label for="manifestGuide" class="block text-[11px] font-semibold text-outline mb-1">Guía Oficial de Turismo (Opcional)</label>
                        <input type="text" name="GuideName" id="manifestGuide" value="" placeholder="Sin guía contratado" class="w-full py-1.5 px-3 rounded-lg border border-outline-variant bg-surface-container-lowest text-on-surface text-body-sm focus:border-primary outline-none" />
                    </div>
                    <div>
                        <label for="manifestGuideCarnet" class="block text-[11px] font-semibold text-outline mb-1">Carnet DIRCETUR / DNI Guía</label>
                        <input type="text" name="GuideCarnet" id="manifestGuideCarnet" value="" placeholder="Opcional" class="w-full py-1.5 px-3 rounded-lg border border-outline-variant bg-surface-container-lowest text-on-surface text-body-sm focus:border-primary outline-none" />
                    </div>
                    <div class="md:col-span-2">
                        <label for="manifestDeparturePoint" class="block text-[11px] font-semibold text-outline mb-1">Punto de Concentración / Salida General</label>
                        <input type="text" name="DeparturePoint" id="manifestDeparturePoint" value="Oficina Principal - Jr. 2 de Mayo 569, Cajamarca" class="w-full py-1.5 px-3 rounded-lg border border-outline-variant bg-surface-container-lowest text-on-surface text-body-sm focus:border-primary outline-none" />
                    </div>
                </div>
            </div>

            <!-- TARJETA DE VISTA PREVIA Y VALIDACIÓN DE ASIENTOS -->
            <div class="p-4 rounded-xl bg-primary/5 border border-primary/20 space-y-3">
                <div class="flex items-center justify-between">
                    <span class="text-label-md font-bold text-primary flex items-center gap-1.5">
                        <span class="material-symbols-outlined text-[18px]">airline_seat_recline_extra</span>
                        Balance de Asientos de la Salida
                    </span>
                    <div class="flex items-center gap-2 text-xs">
                        <span id="previewOccupiedBadge" class="px-2 py-0.5 rounded-full bg-primary/10 text-primary font-bold">0 Pasajeros</span>
                        <span id="previewAvailableBadge" class="px-2 py-0.5 rounded-full bg-surface-container text-secondary font-medium">-- Libres</span>
                        <span id="previewOccupancyBadge" class="px-2 py-0.5 rounded-full bg-secondary-container text-on-secondary-container font-bold">0% Ocupación</span>
                    </div>
                </div>

                <!-- Barra de Progreso de Ocupación -->
                <div class="w-full bg-surface-container-high rounded-full h-2 overflow-hidden">
                    <div id="previewProgressBar" class="bg-primary h-2 rounded-full transition-all duration-300" style="width: 0%"></div>
                </div>

                <!-- BANNER DE RECOMENDACIÓN DE OPTIMIZACIÓN DE FLOTA (EVITAR PÉRDIDAS) -->
                <div id="optimizationAdviceContainer" class="hidden p-3.5 rounded-xl border text-xs leading-relaxed flex items-start gap-2.5">
                    <span class="material-symbols-outlined text-[20px] shrink-0" id="optimizationIcon">tips_and_updates</span>
                    <div class="flex-1">
                        <strong class="block font-bold mb-0.5" id="optimizationTitle">Recomendación de Flota</strong>
                        <p id="optimizationText" class="text-body-sm"></p>
                        <button type="button" id="applySuggestedVehicleBtn" class="mt-2 text-xs font-bold underline cursor-pointer hidden">
                            Cambiar a unidad sugerida
                        </button>
                    </div>
                </div>

                <!-- Mensaje Explicativo de la Tabla del Excel -->
                <p class="text-xs text-on-surface-variant leading-relaxed">
                    <span class="material-symbols-outlined text-[14px] text-primary align-middle">check_circle</span>
                    La tabla del archivo Excel generado contendrá <b>exactamente <span id="summaryCapacity">--</span> filas</b> numeradas del <b>Asiento 01</b> al <b>Asiento <span id="summaryCapacityEnd">--</span></b> según la capacidad de la unidad <b id="summaryVehicleName">elegida</b>. Los asientos no reservados quedarán etiquetados como <i>Asiento Disponible / Libre</i> con espacio en blanco para control físico y firma durante el abordaje.
                </p>
            </div>

            <!-- Botones de Acción del Modal -->
            <div class="flex items-center justify-end gap-3 pt-3 border-t border-outline-variant">
                <button type="button" onclick="closeManifestModal()" class="px-5 py-2.5 rounded-lg border border-outline-variant text-on-surface-variant font-label-md hover:bg-surface-container transition-colors cursor-pointer">
                    Cancelar
                </button>
                <button type="submit" class="px-6 py-2.5 rounded-lg bg-primary hover:bg-[#0e5a52] text-on-primary font-bold flex items-center gap-2 shadow-md transition-all cursor-pointer">
                    <span class="material-symbols-outlined text-[20px]">download</span>
                    Descargar Manifiesto Excel (.xlsx)
                </button>
            </div>
        </form>
    </div>
</div>

<!-- ======================================================== -->
<!-- MODAL DE CONFIRMACIÓN DE ELIMINACIÓN DE RESERVA          -->
<!-- ======================================================== -->
<div id="deleteBookingModal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-inverse-surface/60 backdrop-blur-sm transition-all duration-200 hidden">
    <div class="bg-surface-container-lowest rounded-2xl max-w-lg w-full p-6 shadow-2xl border border-outline-variant relative">
        <div class="flex items-start gap-4">
            <div class="w-12 h-12 rounded-2xl bg-red-100 border border-red-200 text-red-600 flex items-center justify-center shrink-0">
                <span class="material-symbols-outlined text-[28px]">delete_forever</span>
            </div>
            <div>
                <h3 class="text-headline-sm font-bold text-on-surface leading-snug">¿Eliminar reserva definitivamente?</h3>
                <p class="text-body-sm text-outline mt-1">
                    Código: <span id="modalDeleteRefCode" class="font-mono font-bold text-red-600 bg-red-50 px-1.5 py-0.5 rounded"></span>
                </p>
            </div>
        </div>

        <div class="mt-4 p-4 rounded-xl bg-red-50 border border-red-200 text-body-sm text-red-900 space-y-1.5">
            <div class="flex items-center gap-2 font-bold text-red-700">
                <span class="material-symbols-outlined text-lg">crisis_alert</span>
                <span>Acción irreversible para depuración de pruebas</span>
            </div>
            <p class="text-body-sm text-on-surface-variant leading-relaxed">
                Vas a eliminar la reserva a nombre de <strong id="modalDeleteCustomer" class="text-on-surface font-bold"></strong>. Se borrarán permanentemente sus items de reserva, acompañantes y datos de despacho.
            </p>
        </div>

        <form asp-action="DeleteBooking" method="post" class="mt-6 flex items-center justify-end gap-3 pt-3 border-t border-outline-variant">
            @Html.AntiForgeryToken()
            <input type="hidden" id="modalDeleteBookingId" name="id" value="" />
            <button type="button" onclick="closeDeleteBookingModal()" class="px-5 py-2.5 rounded-lg border border-outline-variant text-on-surface-variant font-label-md font-bold hover:bg-surface-container transition-colors cursor-pointer">
                Cancelar
            </button>
            <button type="submit" class="px-5 py-2.5 rounded-lg bg-red-600 text-white font-label-md font-bold hover:bg-red-700 transition-all flex items-center gap-2 shadow-md cursor-pointer">
                <span class="material-symbols-outlined text-[18px]">delete</span>
                Sí, Eliminar Reserva
            </button>
        </form>
    </div>
</div>

<!-- ======================================================== -->
<!-- MODAL DE ENVÍO DE CORREO CON LOS 2 PDFs (BOLETO Y BOLETA) -->
<!-- ======================================================== -->
<div id="sendEmailModal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-inverse-surface/70 backdrop-blur-sm transition-all duration-200 hidden">
    <div class="bg-surface-container-lowest rounded-2xl w-full max-w-lg border border-outline-variant shadow-2xl overflow-hidden transform transition-all duration-200">
        <div class="h-2 w-full bg-gradient-to-r from-primary to-primary-dark"></div>
        <div class="p-6">
            <div class="flex items-center justify-between pb-3 border-b border-outline-variant/60">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl bg-primary/10 text-primary flex items-center justify-center font-bold">
                        <span class="material-symbols-outlined text-[24px]">forward_to_inbox</span>
                    </div>
                    <div>
                        <h3 class="text-title-md font-bold text-on-surface">Enviar Boleto y Boleta por Correo</h3>
                        <p class="text-xs text-on-surface-variant">Confirmación oficial con los 2 PDFs adjuntos</p>
                    </div>
                </div>
                <button type="button" onclick="closeSendEmailModal()" class="text-outline hover:text-on-surface p-1 rounded-lg cursor-pointer">
                    <span class="material-symbols-outlined text-[20px]">close</span>
                </button>
            </div>

            <!-- Booking Summary Pill -->
            <div class="my-4 p-3 bg-surface-container-low rounded-xl border border-outline-variant/50 text-xs flex items-center justify-between">
                <div>
                    <span class="text-outline font-semibold block">Reserva:</span>
                    <strong class="text-primary font-mono text-sm" id="modalBookingRefCode">RES-XXXX</strong>
                </div>
                <div class="text-right">
                    <span class="text-outline font-semibold block">Pasajero:</span>
                    <strong class="text-on-surface" id="modalBookingCustomer">Cliente</strong>
                </div>
            </div>

            <!-- Email Input Field -->
            <div class="space-y-1.5 mb-4">
                <label for="modalBookingEmailInput" class="block text-xs font-bold text-on-surface uppercase tracking-wider">
                    Correo Electrónico de Destino *
                </label>
                <div class="relative">
                    <span class="material-symbols-outlined absolute left-3 top-3 text-outline text-[20px]" aria-hidden="true">mail</span>
                    <input type="email" id="modalBookingEmailInput" name="modalBookingEmailInput" class="w-full pl-10 pr-4 py-2.5 rounded-xl border border-outline-variant focus:border-primary focus:ring-1 focus:ring-primary text-sm text-on-surface bg-white font-medium" placeholder="correo@ejemplo.com" required />
                </div>
                <p class="text-[11px] text-on-surface-variant">Se enviará desde el correo oficial <strong class="text-primary">enriquearana1402@gmail.com</strong>.</p>
            </div>

            <!-- PDFs Included Checklist -->
            <div class="p-3 bg-emerald-50/70 border border-emerald-200 rounded-xl space-y-1.5 mb-5 text-xs">
                <div class="font-bold text-emerald-900 flex items-center gap-1.5">
                    <span class="material-symbols-outlined text-emerald-700 text-[18px]">attach_file</span>
                    Documentos Oficiales Adjuntos en PDF:
                </div>
                <div class="flex items-center gap-2 text-emerald-800">
                    <span class="material-symbols-outlined text-[16px] text-emerald-600">check_circle</span>
                    <span><strong>1. Boleto Oficial de Viaje (Voucher PDF):</strong> Itinerario, embarque y manifiesto.</span>
                </div>
                <div class="flex items-center gap-2 text-emerald-800">
                    <span class="material-symbols-outlined text-[16px] text-emerald-600">check_circle</span>
                    <span><strong>2. Boleta de Venta Electrónica SUNAT (PDF):</strong> Comprobante tributario oficial.</span>
                </div>
            </div>

            <!-- Status Message Area -->
            <div id="modalSendEmailStatus" class="hidden mb-4 p-3 rounded-xl text-xs font-semibold"></div>

            <!-- Actions Buttons -->
            <div class="flex items-center justify-end gap-3 pt-2 border-t border-outline-variant/40">
                <button type="button" onclick="closeSendEmailModal()" class="px-4 py-2.5 rounded-xl border border-outline-variant hover:bg-surface-container text-xs font-bold text-secondary transition-all cursor-pointer">
                    Cancelar
                </button>
                <button type="button" id="btnConfirmSendEmail" onclick="executeSendEmailFromModal()" class="px-5 py-2.5 rounded-xl bg-primary hover:bg-primary-dark text-white text-xs font-bold transition-all shadow-md flex items-center gap-1.5 cursor-pointer">
                    <span class="material-symbols-outlined text-[18px]">send</span>
                    <span id="btnConfirmSendEmailText">Enviar Correo con los 2 PDFs</span>
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ======================================================== -->
<!-- MODAL: COMPARTIR BOLETO Y BOLETA (PDF) POR WHATSAPP      -->
<!-- ======================================================== -->
<div id="sendWhatsAppModal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-inverse-surface/70 backdrop-blur-sm transition-all duration-200 hidden">
    <div class="bg-surface-container-lowest rounded-2xl w-full max-w-lg border border-outline-variant shadow-2xl overflow-hidden transform transition-all duration-200">
        <div class="h-2 w-full bg-gradient-to-r from-[#128C7E] to-[#25D366]"></div>
        <div class="p-6">
            <div class="flex items-center justify-between pb-3 border-b border-outline-variant/60">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl bg-emerald-100 text-[#128C7E] flex items-center justify-center font-bold">
                        <span class="material-symbols-outlined text-[24px]">chat</span>
                    </div>
                    <div>
                        <h3 class="text-title-md font-bold text-on-surface">Compartir por WhatsApp</h3>
                        <p class="text-xs text-on-surface-variant">Boleto Oficial de Viaje y Boleta Electrónica en PDF</p>
                    </div>
                </div>
                <button type="button" onclick="closeSendWhatsAppModal()" class="text-outline hover:text-on-surface p-1 rounded-lg cursor-pointer">
                    <span class="material-symbols-outlined text-[20px]">close</span>
                </button>
            </div>

            <!-- Booking Summary Pill -->
            <div class="my-4 p-3 bg-emerald-50/70 border border-emerald-200 rounded-xl text-xs flex items-center justify-between">
                <div>
                    <span class="text-emerald-800 font-semibold block text-[11px] uppercase">Pasajero Titular:</span>
                    <strong class="text-emerald-950 text-sm font-bold block" id="waModalPassengerName">-</strong>
                    <div class="text-xs text-emerald-800 flex items-center gap-2 mt-0.5">
                        <span id="waModalRefCode" class="font-mono font-bold bg-white px-1.5 py-0.5 rounded border border-emerald-200">RES-XXXX</span>
                        <span>•</span>
                        <span id="waModalTourTitle">-</span>
                    </div>
                </div>
                <div class="text-right">
                    <span class="inline-flex items-center gap-1 text-[11px] font-bold text-emerald-800 bg-emerald-100 px-2.5 py-1 rounded-full border border-emerald-300">
                        <span class="material-symbols-outlined text-[14px]">picture_as_pdf</span> 2 PDFs Listos
                    </span>
                </div>
            </div>

            <!-- Phone Input -->
            <div class="space-y-1.5 mb-4">
                <label for="waModalPhoneInput" class="block text-xs font-bold text-on-surface uppercase tracking-wider flex items-center justify-between">
                    <span>Número de WhatsApp del Cliente *</span>
                    <span class="text-[11px] text-outline font-normal">Perú (+51)</span>
                </label>
                <div class="relative">
                    <span class="absolute left-3.5 top-2.5 text-xs font-bold text-emerald-700 bg-emerald-100 px-1.5 py-0.5 rounded" aria-hidden="true">🇵🇪 +51</span>
                    <input type="tel" id="waModalPhoneInput" name="waModalPhoneInput" oninput="updateWaMessagePreview()" class="w-full pl-20 pr-4 py-2.5 rounded-xl border border-outline-variant focus:border-[#25D366] focus:ring-1 focus:ring-[#25D366] text-sm text-on-surface bg-white font-mono font-bold" placeholder="987654321" required />
                </div>
            </div>

            <!-- PDFs Included Checklist & Download Links -->
            <div class="p-3 bg-surface-container-low rounded-xl border border-outline-variant/60 space-y-2 mb-4 text-xs">
                <div class="font-bold text-on-surface flex items-center gap-1.5">
                    <span class="material-symbols-outlined text-primary text-[18px]">attach_file</span>
                    Archivos PDF incluidos para la reserva:
                </div>
                <div class="space-y-1.5">
                    <div class="flex items-center justify-between bg-white p-2 rounded-lg border border-outline-variant/50">
                        <div class="flex items-center gap-2">
                            <span class="material-symbols-outlined text-red-600 text-[18px]">picture_as_pdf</span>
                            <span class="font-medium text-on-surface" id="waModalVoucherPdfLabel">Boleto_Oficial_RES-XXXX.pdf</span>
                        </div>
                        <a id="waModalDownloadVoucherBtn" href="#" target="_blank" class="text-primary hover:underline font-bold text-[11px] flex items-center gap-0.5 cursor-pointer">
                            <span class="material-symbols-outlined text-[14px]">download</span> Descargar
                        </a>
                    </div>
                    <div class="flex items-center justify-between bg-white p-2 rounded-lg border border-outline-variant/50">
                        <div class="flex items-center gap-2">
                            <span class="material-symbols-outlined text-blue-600 text-[18px]">receipt_long</span>
                            <span class="font-medium text-on-surface" id="waModalReceiptPdfLabel">Boleta_Electronica_SUNAT.pdf</span>
                        </div>
                        <a id="waModalDownloadReceiptBtn" href="#" target="_blank" class="text-blue-700 hover:underline font-bold text-[11px] flex items-center gap-0.5 cursor-pointer">
                            <span class="material-symbols-outlined text-[14px]">download</span> Descargar
                        </a>
                    </div>
                </div>
            </div>

            <!-- Preview of WhatsApp Message -->
            <div class="space-y-1.5 mb-4">
                <div class="flex items-center justify-between">
                    <label for="waModalMessagePreview" class="block text-xs font-bold text-on-surface uppercase tracking-wider">
                        Mensaje a Enviar por WhatsApp
                    </label>
                    <button type="button" onclick="copyWaMessageToClipboard()" class="text-xs text-primary hover:underline font-semibold flex items-center gap-1 cursor-pointer">
                        <span class="material-symbols-outlined text-[14px]">content_copy</span> Copiar texto
                    </button>
                </div>
                <textarea id="waModalMessagePreview" name="waModalMessagePreview" rows="4" class="w-full text-xs font-mono p-2.5 rounded-xl border border-outline-variant bg-surface-container-lowest text-on-surface resize-none focus:outline-none" readonly></textarea>
            </div>

            <!-- Notice / Status Area -->
            <div id="waModalStatusNotice" class="hidden mb-4 p-3 rounded-xl text-xs font-semibold"></div>

            <!-- Actions Buttons -->
            <div class="flex flex-col gap-2 pt-1 border-t border-outline-variant/40">
                <button type="button" id="btnWaOpenDirect" onclick="executeWaOpenOnly()" class="w-full py-3 px-4 bg-[#25D366] hover:bg-[#1EBE5D] text-white rounded-xl font-bold text-xs sm:text-sm flex items-center justify-center gap-2 shadow-md transition-all active:scale-98 cursor-pointer">
                    <span class="material-symbols-outlined text-[20px]">chat</span>
                    <span>Abrir WhatsApp con Enlaces Directos</span>
                </button>
                
                <div class="flex items-center gap-2">
                    <button type="button" id="btnWaDownloadAndOpen" onclick="executeWaDownloadAndOpen()" class="flex-1 py-2.5 px-3 bg-surface-container-high hover:bg-surface-container text-on-surface border border-outline-variant rounded-xl font-semibold text-xs flex items-center justify-center gap-1.5 transition-all cursor-pointer" title="Descargar ambos archivos PDF a la computadora y abrir WhatsApp">
                        <span class="material-symbols-outlined text-[17px] text-primary">cloud_download</span>
                        <span>Descargar PDFs y Abrir</span>
                    </button>
                    <button type="button" onclick="closeSendWhatsAppModal()" class="px-4 py-2.5 rounded-xl border border-outline-variant hover:bg-surface-container text-xs font-bold text-secondary transition-all cursor-pointer">
                        Cerrar
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const searchInput = document.getElementById('bookingSearchInput');
    const rows = document.querySelectorAll('.booking-row');
    const noResultsClientRow = document.getElementById('noResultsClientRow');
    const countLabel = document.getElementById('bookingResultsCount');

    if (searchInput) {
        searchInput.addEventListener('input', function() {
            const query = this.value.trim().toLowerCase();
            let visibleCount = 0;

            rows.forEach(row => {
                const text = row.getAttribute('data-search') || '';
                const match = !query || text.includes(query);
                row.style.display = match ? '' : 'none';
                if (match) visibleCount++;
            });

            if (noResultsClientRow) {
                noResultsClientRow.classList.toggle('hidden', visibleCount > 0 || rows.length === 0);
            }

            if (countLabel && rows.length > 0) {
                countLabel.innerText = `Mostrando ${visibleCount} de ${rows.length} reservas`;
            }
        });
    }

    // Cerrar modal con ESC
    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') closeManifestModal();
    });

    // Inicializar preview si hay tour seleccionado
    if (document.getElementById('manifestTour')?.value) {
        fetchManifestPreview();
    }
});

function openManifestModal() {
    const modal = document.getElementById('manifestModal');
    if (modal) {
        modal.classList.remove('hidden');
        fetchManifestPreview();
    }
}

function closeManifestModal() {
    const modal = document.getElementById('manifestModal');
    if (modal) modal.classList.add('hidden');
}

function openManifestForBooking(date, tourId, shift, vehicleId) {
    if (date) {
        const dInput = document.getElementById('manifestDate');
        if (dInput) dInput.value = date;
    }
    if (tourId) {
        const tSelect = document.getElementById('manifestTour');
        if (tSelect) tSelect.value = tourId;
    }
    if (shift) {
        const sSelect = document.getElementById('manifestShift');
        if (sSelect) sSelect.value = shift;
    }
    if (vehicleId && vehicleId !== 'null' && vehicleId !== '') {
        const vSelect = document.getElementById('manifestVehicle');
        if (vSelect) vSelect.value = vehicleId;
    }
    openManifestModal();
}

function onTourChangedManifest() {
    const tourSelect = document.getElementById('manifestTour');
    if (tourSelect) {
        const selectedOpt = tourSelect.options[tourSelect.selectedIndex];
        const defaultVehicle = selectedOpt?.getAttribute('data-vehicle');
        if (defaultVehicle && defaultVehicle !== '') {
            const vehicleSelect = document.getElementById('manifestVehicle');
            if (vehicleSelect) {
                for (let i = 0; i < vehicleSelect.options.length; i++) {
                    if (vehicleSelect.options[i].value === defaultVehicle) {
                        vehicleSelect.selectedIndex = i;
                        break;
                    }
                }
            }
        }
    }
    fetchManifestPreview();
}

async function fetchManifestPreview() {
    const dateInput = document.getElementById('manifestDate');
    const tourSelect = document.getElementById('manifestTour');
    const shiftSelect = document.getElementById('manifestShift');
    const vehicleSelect = document.getElementById('manifestVehicle');

    const date = dateInput?.value;
    const tourId = tourSelect?.value;
    const shift = shiftSelect?.value;
    const vehicleId = vehicleSelect?.value;

    const selectedVehicleOpt = vehicleSelect?.options[vehicleSelect.selectedIndex];
    const capacity = selectedVehicleOpt?.getAttribute('data-capacity') || '18';
    const plate = selectedVehicleOpt?.getAttribute('data-plate') || '';
    const model = selectedVehicleOpt?.getAttribute('data-model') || '';

    const formattedCap = capacity.toString().padStart(2, '0');
    const summaryCap = document.getElementById('summaryCapacity');
    if (summaryCap) summaryCap.innerText = formattedCap;
    const summaryCapEnd = document.getElementById('summaryCapacityEnd');
    if (summaryCapEnd) summaryCapEnd.innerText = formattedCap;

    const summaryVeh = document.getElementById('summaryVehicleName');
    if (summaryVeh) summaryVeh.innerText = model ? `${model} (${plate})` : 'unidad seleccionada';

    const countBadge = document.getElementById('previewTotalSeatsBadge');
    if (countBadge) countBadge.innerText = `${capacity} Asientos Oficiales`;

    if (!tourId || !date) return;

    try {
        const url = `/Admin/GetManifestPreview?date=${encodeURIComponent(date)}&tourId=${encodeURIComponent(tourId)}&vehicleId=${encodeURIComponent(vehicleId || '')}&shift=${encodeURIComponent(shift || '')}`;
        const res = await fetch(url);
        if (res.ok) {
            const data = await res.json();
            const occBadge = document.getElementById('previewOccupiedBadge');
            if (occBadge) occBadge.innerText = `${data.occupiedSeats} Pasajeros`;

            const availBadge = document.getElementById('previewAvailableBadge');
            if (availBadge) availBadge.innerText = `${data.availableSeats} Asientos Libres`;

            const pctBadge = document.getElementById('previewOccupancyBadge');
            if (pctBadge) pctBadge.innerText = `${data.occupancyPercentage}% Ocupación`;

            const bar = document.getElementById('previewProgressBar');
            if (bar) bar.style.width = `${Math.min(100, data.occupancyPercentage)}%`;

            // Gestión de Alertas y Recomendación de Flota (Evitar pérdidas operativas)
            const adviceContainer = document.getElementById('optimizationAdviceContainer');
            const adviceTitle = document.getElementById('optimizationTitle');
            const adviceText = document.getElementById('optimizationText');
            const adviceIcon = document.getElementById('optimizationIcon');
            const applyBtn = document.getElementById('applySuggestedVehicleBtn');

            if (adviceContainer && data.isOverCapacity) {
                adviceContainer.className = 'p-3.5 rounded-xl border border-red-300 bg-red-50 text-red-900 flex items-start gap-2.5';
                if (adviceIcon) {
                    adviceIcon.className = 'material-symbols-outlined text-[20px] shrink-0 text-red-600';
                    adviceIcon.innerText = 'warning';
                }
                if (adviceTitle) adviceTitle.innerText = '⚠️ Alerta de Capacidad Insuficiente';
                if (adviceText) adviceText.innerText = data.optimizationAdvice;
                adviceContainer.classList.remove('hidden');
                if (applyBtn && data.suggestedVehicleId) {
                    applyBtn.classList.remove('hidden');
                    applyBtn.innerText = `Asignar unidad mayor: ${data.suggestedVehicleName}`;
                    applyBtn.onclick = () => selectVehicleById(data.suggestedVehicleId);
                } else if (applyBtn) {
                    applyBtn.classList.add('hidden');
                }
            } else if (adviceContainer && data.isUnderUtilized) {
                adviceContainer.className = 'p-3.5 rounded-xl border border-amber-300 bg-amber-50 text-amber-900 flex items-start gap-2.5';
                if (adviceIcon) {
                    adviceIcon.className = 'material-symbols-outlined text-[20px] shrink-0 text-amber-600';
                    adviceIcon.innerText = 'tips_and_updates';
                }
                if (adviceTitle) adviceTitle.innerText = '💡 Sugerencia de Eficiencia (Evitar pérdidas operativas)';
                if (adviceText) adviceText.innerText = data.optimizationAdvice;
                adviceContainer.classList.remove('hidden');
                if (applyBtn && data.suggestedVehicleId) {
                    applyBtn.classList.remove('hidden');
                    applyBtn.innerText = `Asignar unidad sugerida: ${data.suggestedVehicleName}`;
                    applyBtn.onclick = () => selectVehicleById(data.suggestedVehicleId);
                } else if (applyBtn) {
                    applyBtn.classList.add('hidden');
                }
            } else if (adviceContainer) {
                adviceContainer.classList.add('hidden');
            }
        }
    } catch (err) {
        console.error('Error fetching manifest preview:', err);
    }
}

function onDriverSelected(select) {
    if (!select) return;
    const opt = select.options[select.selectedIndex];
    const name = opt?.getAttribute('data-name') || '';
    const license = opt?.getAttribute('data-license') || '';
    const assignedVehicle = opt?.getAttribute('data-vehicle') || '';

    const driverNameInput = document.getElementById('manifestDriver');
    const driverLicenseInput = document.getElementById('manifestDriverLicense');

    if (driverNameInput) driverNameInput.value = name;
    if (driverLicenseInput) driverLicenseInput.value = license;

    if (assignedVehicle && assignedVehicle !== '') {
        const vSelect = document.getElementById('manifestVehicle');
        if (vSelect && (!vSelect.value || vSelect.value === '')) {
            vSelect.value = assignedVehicle;
            fetchManifestPreview();
        }
    }
}

function selectVehicleById(vehId) {
    const vSelect = document.getElementById('manifestVehicle');
    if (vSelect && vehId) {
        vSelect.value = vehId;
        fetchManifestPreview();
    }
}

function openDeleteBookingModal(id, code, customer) {
    const idInput = document.getElementById('modalDeleteBookingId');
    const codeSpan = document.getElementById('modalDeleteRefCode');
    const customerSpan = document.getElementById('modalDeleteCustomer');
    const modal = document.getElementById('deleteBookingModal');

    if (idInput) idInput.value = id;
    if (codeSpan) codeSpan.innerText = code;
    if (customerSpan) customerSpan.innerText = customer || 'Sin nombre registrado';
    if (modal) modal.classList.remove('hidden');
}

function closeDeleteBookingModal() {
    const modal = document.getElementById('deleteBookingModal');
    if (modal) modal.classList.add('hidden');
}

let currentEmailModalBookingId = null;

function openSendEmailModal(bookingId, currentEmail, refCode, customerName) {
    currentEmailModalBookingId = bookingId;
    const refSpan = document.getElementById('modalBookingRefCode');
    const custSpan = document.getElementById('modalBookingCustomer');
    const emailInput = document.getElementById('modalBookingEmailInput');
    const statusDiv = document.getElementById('modalSendEmailStatus');
    const btn = document.getElementById('btnConfirmSendEmail');
    const btnText = document.getElementById('btnConfirmSendEmailText');

    if (refSpan) refSpan.innerText = refCode || 'RES-XXXX';
    if (custSpan) custSpan.innerText = customerName || 'Cliente';
    if (emailInput) emailInput.value = (currentEmail && currentEmail !== 'manual@agencia.com') ? currentEmail : '';
    if (statusDiv) {
        statusDiv.className = 'hidden mb-4 p-3 rounded-xl text-xs font-semibold';
        statusDiv.innerHTML = '';
    }
    if (btn) {
        btn.disabled = false;
        btn.classList.remove('opacity-50', 'cursor-not-allowed');
    }
    if (btnText) btnText.innerText = 'Enviar Correo con los 2 PDFs';

    const modal = document.getElementById('sendEmailModal');
    if (modal) modal.classList.remove('hidden');
    if (emailInput) setTimeout(() => emailInput.focus(), 50);
}

function closeSendEmailModal() {
    const modal = document.getElementById('sendEmailModal');
    if (modal) modal.classList.add('hidden');
    currentEmailModalBookingId = null;
}

function executeSendEmailFromModal() {
    const emailInput = document.getElementById('modalBookingEmailInput');
    const email = emailInput ? emailInput.value.trim() : '';

    if (!email || !email.includes('@@')) {
        alert('Por favor ingrese un correo electrónico válido.');
        if (emailInput) emailInput.focus();
        return;
    }

    const btn = document.getElementById('btnConfirmSendEmail');
    const btnText = document.getElementById('btnConfirmSendEmailText');
    const statusDiv = document.getElementById('modalSendEmailStatus');

    if (btn) {
        btn.disabled = true;
        btn.classList.add('opacity-50', 'cursor-not-allowed');
    }
    if (btnText) btnText.innerText = 'Generando PDFs y enviando...';

    if (statusDiv) {
        statusDiv.className = 'mb-4 p-3 rounded-xl text-xs font-semibold bg-blue-50 text-blue-900 border border-blue-200 flex items-center gap-2';
        statusDiv.innerHTML = '<span class="material-symbols-outlined text-[18px] animate-spin">progress_activity</span> Generando Boleto de Viaje PDF y adjuntando Boleta de Venta oficial...';
    }

    const formData = new FormData();
    formData.append('id', currentEmailModalBookingId);
    formData.append('email', email);

    fetch('/Admin/ResendBookingEmail', {
        method: 'POST',
        body: formData
    })
    .then(res => res.json())
    .then(data => {
        if (data.success) {
            if (statusDiv) {
                statusDiv.className = 'mb-4 p-3 rounded-xl text-xs font-semibold bg-emerald-50 text-emerald-900 border border-emerald-300 flex items-center gap-2';
                statusDiv.innerHTML = `<span class="material-symbols-outlined text-[18px] text-emerald-600">check_circle</span> <span>${data.message}</span>`;
            }
            if (btnText) btnText.innerText = '✓ Enviado';
            showToastNotification(data.message, 'success');
            setTimeout(() => {
                closeSendEmailModal();
            }, 1800);
        } else {
            if (statusDiv) {
                statusDiv.className = 'mb-4 p-3 rounded-xl text-xs font-semibold bg-red-50 text-red-900 border border-red-300 flex items-center gap-2';
                statusDiv.innerHTML = `<span class="material-symbols-outlined text-[18px] text-red-600">error</span> <span>${data.message}</span>`;
            }
            if (btn) {
                btn.disabled = false;
                btn.classList.remove('opacity-50', 'cursor-not-allowed');
            }
            if (btnText) btnText.innerText = 'Reintentar Envío';
            showToastNotification(data.message, 'error');
        }
    })
    .catch(err => {
        if (statusDiv) {
            statusDiv.className = 'mb-4 p-3 rounded-xl text-xs font-semibold bg-red-50 text-red-900 border border-red-300 flex items-center gap-2';
            statusDiv.innerHTML = '<span class="material-symbols-outlined text-[18px] text-red-600">error</span> Error de conexión al servidor al enviar correo.';
        }
        if (btn) {
            btn.disabled = false;
            btn.classList.remove('opacity-50', 'cursor-not-allowed');
        }
        if (btnText) btnText.innerText = 'Reintentar Envío';
        showToastNotification('Error de conexión al enviar correo.', 'error');
    });
}

let currentWaData = null;

function openSendWhatsAppModal(bookingId, rawPhone, customerName, refCode, tourTitle, travelDate) {
    currentWaData = {
        bookingId: bookingId,
        rawPhone: rawPhone || '',
        customerName: customerName || 'Estimado(a) Cliente',
        refCode: refCode || 'RES-XXXX',
        tourTitle: tourTitle || 'Circuito Cajamarca',
        travelDate: travelDate || ''
    };

    const modal = document.getElementById('sendWhatsAppModal');
    if (!modal) return;

    document.getElementById('waModalPassengerName').innerText = currentWaData.customerName;
    document.getElementById('waModalRefCode').innerText = currentWaData.refCode;
    document.getElementById('waModalTourTitle').innerText = currentWaData.tourTitle;

    let digits = (currentWaData.rawPhone || '').replace(/\D/g, '');
    if (digits.startsWith('51') && digits.length === 11) {
        digits = digits.substring(2);
    }
    const phoneInput = document.getElementById('waModalPhoneInput');
    if (phoneInput) phoneInput.value = digits;

    document.getElementById('waModalVoucherPdfLabel').innerText = `Boleto_Oficial_${currentWaData.refCode}.pdf`;
    document.getElementById('waModalReceiptPdfLabel').innerText = 'Boleta_Venta_SUNAT.pdf';

    const statusDiv = document.getElementById('waModalStatusNotice');
    if (statusDiv) {
        statusDiv.className = 'hidden';
        statusDiv.innerHTML = '';
    }

    const downloadVoucherBtn = document.getElementById('waModalDownloadVoucherBtn');
    if (downloadVoucherBtn) downloadVoucherBtn.href = `/Admin/DownloadVoucherPdf/${bookingId}`;
    const downloadReceiptBtn = document.getElementById('waModalDownloadReceiptBtn');
    if (downloadReceiptBtn) downloadReceiptBtn.href = `/Admin/DownloadReceiptPdf/${bookingId}`;

    updateWaMessagePreview();
    modal.classList.remove('hidden');

    fetch(`/Admin/GetBookingWhatsAppShareData/${bookingId}`)
        .then(res => res.json())
        .then(data => {
            if (data && data.success) {
                currentWaData.voucherPdfUrl = data.voucherPdfUrl;
                currentWaData.receiptPdfUrl = data.receiptPdfUrl;
                currentWaData.hasReceipt = data.hasReceipt;
                currentWaData.receiptSeriesNumber = data.receiptSeriesNumber;

                if (data.receiptSeriesNumber) {
                    document.getElementById('waModalReceiptPdfLabel').innerText = `Boleta_${data.receiptSeriesNumber}.pdf`;
                }
                updateWaMessagePreview();
            }
        })
        .catch(() => {});
}

function updateWaMessagePreview() {
    if (!currentWaData) return;
    const voucherUrl = currentWaData.voucherPdfUrl || `${window.location.origin}/b/${currentWaData.refCode}`;
    const receiptLine = currentWaData.hasReceipt && currentWaData.receiptPdfUrl
        ? `\n• *Boleta Electrónica:* ${currentWaData.receiptPdfUrl}`
        : '';

    const msg = `¡Hola *${currentWaData.customerName}*! Le saluda Turismo Chilón.\n\n` +
                `Le confirmamos que su reserva para el tour *${currentWaData.tourTitle}* programada para el *${currentWaData.travelDate}* se encuentra CONFIRMADA.\n\n` +
                `• *Código de Reserva:* ${currentWaData.refCode}\n\n` +
                `*Comprobantes Oficiales en PDF:*\n` +
                `• *Boleto de Viaje:* ${voucherUrl}` +
                receiptLine + `\n\n` +
                `Punto de salida: Jr. 2 de Mayo 569, Cajamarca (presentarse 15 min antes con DNI físico).\n` +
                `¡Gracias por confiar en Turismo Chilón!`;

    const previewArea = document.getElementById('waModalMessagePreview');
    if (previewArea) previewArea.value = msg;
}

function closeSendWhatsAppModal() {
    const modal = document.getElementById('sendWhatsAppModal');
    if (modal) modal.classList.add('hidden');
    currentWaData = null;
}

function executeWaDownloadAndOpen() {
    if (!currentWaData) return;
    const phoneInput = document.getElementById('waModalPhoneInput');
    let digits = (phoneInput ? phoneInput.value.trim() : '').replace(/\D/g, '');
    if (!digits) {
        alert('Por favor ingrese el número de teléfono o WhatsApp del cliente.');
        if (phoneInput) phoneInput.focus();
        return;
    }
    if (digits.length === 9 && digits.startsWith('9')) {
        digits = '51' + digits;
    }

    const previewArea = document.getElementById('waModalMessagePreview');
    const msg = previewArea ? previewArea.value : '';

    downloadFileUrl(`/Admin/DownloadVoucherPdf/${currentWaData.bookingId}`, `Boleto_Oficial_${currentWaData.refCode}.pdf`);

    if (currentWaData.hasReceipt) {
        const receiptName = currentWaData.receiptSeriesNumber ? `Boleta_${currentWaData.receiptSeriesNumber}.pdf` : 'Boleta_Venta_SUNAT.pdf';
        setTimeout(() => {
            downloadFileUrl(`/Admin/DownloadReceiptPdf/${currentWaData.bookingId}`, receiptName);
        }, 400);
    }

    const statusDiv = document.getElementById('waModalStatusNotice');
    if (statusDiv) {
        statusDiv.className = 'mb-4 p-3 rounded-xl text-xs font-semibold bg-emerald-50 text-emerald-900 border border-emerald-300 block';
        statusDiv.innerHTML = '<span class="material-symbols-outlined text-[18px] text-emerald-600 align-middle">check_circle</span> ¡2 PDFs descargados! Abriendo WhatsApp... Envíe el mensaje y adjunte (📎) los PDFs.';
    }

    setTimeout(() => {
        window.open(`https://wa.me/${digits}?text=${encodeURIComponent(msg)}`, '_blank');
    }, 700);
}

function downloadFileUrl(url, filename) {
    const a = document.createElement('a');
    a.href = url;
    a.download = filename;
    document.body.appendChild(a);
    a.click();
    setTimeout(() => a.remove(), 300);
}

async function executeWaShareDirect() {
    if (!currentWaData) return;
    const previewArea = document.getElementById('waModalMessagePreview');
    const msg = previewArea ? previewArea.value : '';

    try {
        const filesToShare = [];
        const voucherRes = await fetch(`/Admin/DownloadVoucherPdf/${currentWaData.bookingId}`);
        const voucherBlob = await voucherRes.blob();
        filesToShare.push(new File([voucherBlob], `Boleto_Oficial_${currentWaData.refCode}.pdf`, { type: 'application/pdf' }));

        if (currentWaData.hasReceipt) {
            try {
                const receiptRes = await fetch(`/Admin/DownloadReceiptPdf/${currentWaData.bookingId}`);
                const receiptBlob = await receiptRes.blob();
                const rName = currentWaData.receiptSeriesNumber ? `Boleta_${currentWaData.receiptSeriesNumber}.pdf` : 'Boleta_Venta_SUNAT.pdf';
                filesToShare.push(new File([receiptBlob], rName, { type: 'application/pdf' }));
            } catch {}
        }

        if (navigator.canShare && navigator.canShare({ files: filesToShare })) {
            await navigator.share({
                title: `Boleto y Boleta ${currentWaData.refCode} - Turismo Chilón`,
                text: msg,
                files: filesToShare
            });
            closeSendWhatsAppModal();
            return;
        }
    } catch (e) {
        console.log('WebShare not supported or cancelled', e);
    }

    executeWaDownloadAndOpen();
}

function executeWaOpenOnly() {
    if (!currentWaData) return;
    const phoneInput = document.getElementById('waModalPhoneInput');
    let digits = (phoneInput ? phoneInput.value.trim() : '').replace(/\D/g, '');
    if (!digits) {
        alert('Por favor ingrese el número de teléfono o WhatsApp del cliente.');
        if (phoneInput) phoneInput.focus();
        return;
    }
    if (digits.length === 9 && digits.startsWith('9')) {
        digits = '51' + digits;
    }

    const previewArea = document.getElementById('waModalMessagePreview');
    const msg = previewArea ? previewArea.value : '';
    window.open(`https://wa.me/${digits}?text=${encodeURIComponent(msg)}`, '_blank');
}

function copyWaMessageToClipboard() {
    const previewArea = document.getElementById('waModalMessagePreview');
    if (!previewArea) return;
    navigator.clipboard.writeText(previewArea.value).then(() => {
        showToastNotification('Mensaje copiado al portapapeles.', 'success');
    });
}

function showToastNotification(message, type) {
    let container = document.getElementById('sigetourToastContainer');
    if (!container) {
        container = document.createElement('div');
        container.id = 'sigetourToastContainer';
        container.className = 'fixed bottom-5 right-5 z-[100] flex flex-col gap-2 max-w-md';
        document.body.appendChild(container);
    }
    const toast = document.createElement('div');
    const bgClass = type === 'success' ? 'bg-emerald-700 text-white border-emerald-800' :
                    type === 'error' ? 'bg-red-700 text-white border-red-800' : 'bg-secondary text-white border-secondary-dark';
    toast.className = `${bgClass} p-4 rounded-xl shadow-2xl border text-sm font-semibold flex items-center gap-2 transition-all duration-300 transform translate-y-2 opacity-0`;
    toast.innerHTML = `<span class="material-symbols-outlined text-[20px]">${type === 'success' ? 'check_circle' : type === 'error' ? 'error' : 'mail'}</span> <span>${message}</span>`;
    container.appendChild(toast);
    setTimeout(() => {
        toast.classList.remove('translate-y-2', 'opacity-0');
    }, 10);
    setTimeout(() => {
        toast.classList.add('opacity-0', 'translate-y-2');
        setTimeout(() => toast.remove(), 400);
    }, 4500);
}
</script>
