@using SIGETOUR.API.Core.Entities
@{
    ViewData["Title"] = "Reservas";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var bookings = Model as IEnumerable<Booking>;
}

<div class="mb-6 flex justify-between items-center">
    <div>
        <h1 class="text-display-sm font-bold text-on-surface">Gestión de Reservas</h1>
        <p class="text-body-lg text-on-surface-variant">Historial y estado de las reservas de clientes.</p>
    </div>
    <button class="bg-primary text-on-primary px-4 py-2 rounded-lg font-bold flex items-center gap-2 hover:bg-primary/90 transition-colors">
        <span class="material-symbols-outlined">add</span>
        Nueva Reserva Manual
    </button>
</div>

<div class="bg-surface-container-lowest rounded-2xl shadow-sm border border-outline-variant overflow-hidden">
    <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
            <thead>
                <tr class="bg-surface-container-low text-on-surface-variant font-label-lg border-b border-outline-variant">
                    <th class="p-4 font-semibold">Código</th>
                    <th class="p-4 font-semibold">Cliente</th>
                    <th class="p-4 font-semibold">Fecha de Viaje</th>
                    <th class="p-4 font-semibold">Pasajeros</th>
                    <th class="p-4 font-semibold">Monto Total</th>
                    <th class="p-4 font-semibold text-center">Estado</th>
                    <th class="p-4 font-semibold text-right">Acciones</th>
                </tr>
            </thead>
            <tbody class="text-body-md text-on-surface divide-y divide-outline-variant/50">
                @if (bookings != null && bookings.Any())
                {
                    foreach (var booking in bookings)
                    {
                        <tr class="hover:bg-surface-container-low/50 transition-colors">
                            <td class="p-4 font-mono font-bold text-primary">@booking.ReferenceCode</td>
                            <td class="p-4">
                                <div class="font-bold text-on-surface">@booking.CustomerName</div>
                                <div class="text-label-sm text-on-surface-variant">@booking.CustomerEmail</div>
                            </td>
                            <td class="p-4">@booking.TravelDate.ToString("dd MMM yyyy")</td>
                            <td class="p-4">@booking.TotalPassengers pax</td>
                            <td class="p-4 font-bold">S/ @booking.TotalAmount</td>
                            <td class="p-4 text-center">
                                @if (booking.Status == BookingStatus.Confirmed)
                                {
                                    <span class="inline-flex items-center gap-1 text-green-800 bg-green-100 px-2 py-1 rounded-full font-label-sm">
                                        <span class="material-symbols-outlined text-[14px]">check_circle</span> Confirmado
                                    </span>
                                }
                                else if (booking.Status == BookingStatus.Pending)
                                {
                                    <span class="inline-flex items-center gap-1 text-yellow-800 bg-yellow-100 px-2 py-1 rounded-full font-label-sm">
                                        <span class="material-symbols-outlined text-[14px]">pending</span> Pendiente
                                    </span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center gap-1 text-red-800 bg-red-100 px-2 py-1 rounded-full font-label-sm">
                                        <span class="material-symbols-outlined text-[14px]">cancel</span> Cancelado
                                    </span>
                                }
                            </td>
                            <td class="p-4 text-right space-x-1">
                                <button class="p-2 text-on-surface-variant hover:text-primary rounded-lg hover:bg-surface-container transition-colors" title="Ver Detalles">
                                    <span class="material-symbols-outlined text-[20px]">visibility</span>
                                </button>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="p-8 text-center text-on-surface-variant">
                            No hay reservas registradas en la base de datos.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

