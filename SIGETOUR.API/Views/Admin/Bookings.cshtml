</button>
<button class="flex items-center gap-2 px-4 py-2 rounded-lg bg-primary hover:bg-primary-container text-on-primary font-label-lg shadow-sm transition-all duration-150">
<span class="material-symbols-outlined text-lg">person_add</span>
<span>Nueva Reserva Manual</span>
</button>
</div>
</div>
