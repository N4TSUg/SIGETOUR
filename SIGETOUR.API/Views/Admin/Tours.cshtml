@using SIGETOUR.API.Core.Entities
@{
    ViewData["Title"] = "Tours y Circuitos";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var tours = Model as IEnumerable<TourPackage>;
}

<div class="mb-6 flex justify-between items-center">
    <div>
        <h1 class="text-display-sm font-bold text-on-surface">Tours y Circuitos</h1>
        <p class="text-body-lg text-on-surface-variant">Administración de paquetes turísticos.</p>
    </div>
    <a asp-action="CreateTour" class="bg-primary text-on-primary px-4 py-2 rounded-lg font-bold flex items-center gap-2 hover:bg-primary/90 transition-colors">
        <span class="material-symbols-outlined">add</span>
        Nuevo Tour</a>
</div>

<div class="bg-surface-container-lowest rounded-2xl shadow-sm border border-outline-variant overflow-hidden">
    <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
            <thead>
                <tr class="bg-surface-container-low text-on-surface-variant font-label-lg border-b border-outline-variant">
                    <th class="p-4 font-semibold">Tour / Circuito</th>
                    <th class="p-4 font-semibold">Categoría</th>
                    <th class="p-4 font-semibold">Duración</th>
                    <th class="p-4 font-semibold">Precio Base</th>
                    <th class="p-4 font-semibold text-center">Estado</th>
                    <th class="p-4 font-semibold text-right">Acciones</th>
                </tr>
            </thead>
            <tbody class="text-body-md text-on-surface divide-y divide-outline-variant/50">
                @if (tours != null && tours.Any())
                {
                    foreach (var tour in tours)
                    {
                        <tr class="hover:bg-surface-container-low/50 transition-colors">
                            <td class="p-4">
                                <div class="flex items-center gap-3">
                                    <div class="w-10 h-10 rounded-lg overflow-hidden bg-surface-container flex-shrink-0">
                                        @if (tour.Images != null && tour.Images.Any())
                                        {
                                            <img src="@tour.Images.First().ImageUrl" alt="@tour.Title" class="w-full h-full object-cover" />
                                        }
                                        else
                                        {
                                            <div class="w-full h-full flex items-center justify-center text-on-surface-variant/50">
                                                <span class="material-symbols-outlined">image</span>
                                            </div>
                                        }
                                    </div>
                                    <div class="font-bold text-on-surface">@tour.Title</div>
                                </div>
                            </td>
                            <td class="p-4">
                                <span class="px-2 py-1 rounded-md bg-secondary-container text-on-secondary-container font-label-sm">
                                    @tour.Category
                                </span>
                            </td>
                            <td class="p-4">@tour.Duration</td>
                            <td class="p-4 font-bold text-primary">S/ @tour.BasePrice</td>
                            <td class="p-4 text-center">
                                @if (tour.IsActive)
                                {
                                    <span class="inline-flex items-center gap-1 text-green-800 bg-green-100 px-2 py-1 rounded-full font-label-sm">
                                        <span class="material-symbols-outlined text-[14px]">check_circle</span> Activo
                                    </span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center gap-1 text-red-800 bg-red-100 px-2 py-1 rounded-full font-label-sm">
                                        <span class="material-symbols-outlined text-[14px]">cancel</span> Inactivo
                                    </span>
                                }
                            </td>
                            <td class="p-4 text-right space-x-1">
                                <a asp-action="EditTour" asp-route-id="@tour.Id" class="p-2 text-on-surface-variant hover:text-primary rounded-lg hover:bg-surface-container transition-colors inline-block" title="Editar"><span class="material-symbols-outlined text-[20px]">edit</span></a>
                                <button type="button" class="p-2 text-on-surface-variant hover:text-red-600 rounded-lg hover:bg-surface-container transition-colors" title="Eliminar" onclick="openDeleteModal('@tour.Id', '@tour.Title')"><span class="material-symbols-outlined text-[20px]">delete</span></button>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="p-8 text-center text-on-surface-variant">
                            No hay tours registrados en la base de datos.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>



<!-- MODAL DE CONFIRMACIÓN: ELIMINAR TOUR -->
<div class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-inverse-surface/70 backdrop-blur-sm transition-opacity duration-200 hidden" id="deleteTourModal">
<div class="bg-surface-container-lowest rounded-2xl w-full max-w-xl border border-tertiary/30 overflow-hidden transform transition-all duration-200">
  <div class="h-2 w-full bg-red-600"></div>
  <div class="p-6 pb-4 flex items-start justify-between gap-4">
      <div class="flex items-center gap-3">
          <div class="w-12 h-12 rounded-xl bg-red-100 border border-red-200 flex items-center justify-center text-red-600 shrink-0">
              <span class="material-symbols-outlined text-[28px]">warning</span>
          </div>
          <div>
              <h3 class="text-headline-sm font-headline-sm text-on-surface font-bold leading-snug">¿Estás seguro de eliminar este tour?</h3>
              <span class="text-label-sm font-label-sm text-red-600 font-bold tracking-wider uppercase">Acción Destructiva Irreversible</span>
          </div>
      </div>
      <button class="p-1.5 rounded-lg text-on-surface-variant hover:bg-surface-container transition-colors" onclick="closeDeleteModal()" type="button">
          <span class="material-symbols-outlined">close</span>
      </button>
  </div>
  <div class="px-6 py-4 space-y-4">
      <p class="text-body-md font-body-md text-on-surface leading-relaxed">
          Esta acción dará de baja de forma permanente el circuito 
          <strong class="text-on-surface font-bold" id="deleteTourNameText"></strong>.
      </p>
      <div class="p-4 rounded-xl bg-red-50 border border-red-200">
          <label class="block text-label-md font-label-md text-on-surface mb-2 font-bold">
              Para confirmar, escribe la palabra <span class="text-red-600 font-mono font-bold">ELIMINAR</span>:
          </label>
          <input class="w-full uppercase font-mono tracking-wider text-body-md rounded-lg border-outline-variant focus:border-red-600 focus:ring-red-600 bg-surface-container-lowest text-on-surface" id="confirmDeleteInput" placeholder="Escribe 'ELIMINAR'" type="text"/>
      </div>
  </div>
  <div class="p-6 pt-4 bg-surface-container-high/20 border-t border-outline-variant/40 flex flex-col-reverse sm:flex-row justify-end gap-3">
      <button class="px-5 py-2.5 rounded-lg border border-outline-variant bg-surface-container-lowest text-on-surface font-label-md font-bold hover:bg-surface-container transition-all" onclick="closeDeleteModal()" type="button">Cancelar</button>
      <form asp-action="DeleteTour" method="post" id="deleteTourForm">
          <input type="hidden" name="id" id="deleteTourIdInput" />
          <button type="submit" class="flex items-center gap-2 px-5 py-2.5 rounded-lg bg-red-600 disabled:bg-gray-300 disabled:cursor-not-allowed text-white font-label-md font-bold shadow-sm transition-all hover:bg-red-700" disabled id="confirmDeleteActionBtn">
              <span class="material-symbols-outlined text-[18px]">delete_forever</span>
              <span>Sí, Eliminar Definitivamente</span>
          </button>
      </form>
  </div>
</div>
</div>
<script>
  function openDeleteModal(id, name) {
      document.getElementById('deleteTourIdInput').value = id;
      document.getElementById('deleteTourNameText').innerText = '"' + name + '"';
      document.getElementById('confirmDeleteInput').value = '';
      document.getElementById('confirmDeleteActionBtn').disabled = true;
      document.getElementById('deleteTourModal').classList.remove('hidden');
  }
  function closeDeleteModal() {
      document.getElementById('deleteTourModal').classList.add('hidden');
  }
  document.getElementById('confirmDeleteInput').addEventListener('input', (e) => {
      document.getElementById('confirmDeleteActionBtn').disabled = (e.target.value.trim().toUpperCase() !== 'ELIMINAR');
  });
</script>
