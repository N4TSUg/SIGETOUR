@model SIGETOUR.API.Models.EditBookingViewModel
@using SIGETOUR.API.Core.Entities
@{
    ViewData["Title"] = "Editar Reserva " + Model.ReferenceCode;
    Layout = "_AdminLayout";
    bool isCancelled = Model.Status == BookingStatus.Cancelled;
}

<div class="px-4 sm:px-6 lg:px-8 py-8 w-full max-w-9xl mx-auto">

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="mb-6 p-4 rounded-xl bg-primary/10 border border-primary/20 text-primary flex items-center gap-3">
            <span class="material-symbols-outlined text-[22px]">check_circle</span>
            <span class="font-semibold text-body-md">@TempData["SuccessMessage"]</span>
        </div>
    }

    @if (isCancelled)
    {
        <div class="mb-6 p-4 rounded-xl bg-red-50 border border-red-200 text-red-700 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
            <div class="flex items-center gap-3">
                <span class="material-symbols-outlined text-3xl shrink-0">cancel</span>
                <div>
                    <h3 class="font-bold text-body-lg">Esta reserva se encuentra ANULADA / CANCELADA</h3>
                    <p class="text-xs text-red-600 mt-0.5">Los cupos se encuentran liberados del despacho operativo y vehículos.</p>
                </div>
            </div>
            <button type="button" onclick="openReactivateModal()" class="px-4 py-2 bg-red-600 hover:bg-red-700 text-white rounded-lg text-label-md font-bold transition-all shadow-sm flex items-center gap-1.5 self-start sm:self-auto cursor-pointer">
                <span class="material-symbols-outlined text-[18px]">restore</span>
                Reactivar Reserva
            </button>
        </div>
    }

<form asp-action="EditBooking" method="post" id="editBookingForm">
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="ReferenceCode" />

    <!-- Page Header -->
    <div class="sm:flex sm:justify-between sm:items-center mb-8">
      <div class="mb-4 sm:mb-0 flex items-center gap-3">
        <a href="@Url.Action("Bookings", "Admin")" class="p-2 rounded-full hover:bg-surface-container-low transition-colors text-on-surface-variant cursor-pointer" title="Volver al listado de reservas">
          <span class="material-symbols-outlined text-[24px]">arrow_back</span>
        </a>
        <div>
          <h1 class="text-headline-md font-headline-md font-bold text-on-surface flex items-center gap-3">
            Editar Reserva <span class="text-primary font-mono bg-surface-container-low px-2 rounded">@Model.ReferenceCode</span>
          </h1>
          <p class="text-body-md text-on-surface-variant flex items-center gap-2">
            <span class="material-symbols-outlined text-[18px] text-primary">tour</span>
            Tour actual: <span class="font-bold text-on-surface" id="headerTourTitle">@Model.TourName</span>
          </p>
        </div>
      </div>
      <div class="flex flex-wrap gap-2 items-center">
        <a href="@Url.Action("Voucher", "Booking", new { id = Model.Id })" target="_blank" class="bg-surface-container border border-outline-variant hover:bg-surface-container-low text-on-surface transition-colors font-label-md px-3.5 py-2.5 rounded-lg flex items-center gap-1.5 shadow-sm font-semibold cursor-pointer" title="Ver Boleto Oficial">
          <span class="material-symbols-outlined text-[18px] text-primary">confirmation_number</span>
          Boleto
        </a>
        <a href="@Url.Action("Ticket", "Booking", new { id = Model.Id })" target="_blank" class="bg-amber-50 border border-amber-300 hover:bg-amber-100 text-amber-900 transition-colors font-label-md px-3.5 py-2.5 rounded-lg flex items-center gap-1.5 shadow-sm font-semibold cursor-pointer" title="Ver / Imprimir Ticket POS (80mm / 58mm)">
          <span class="material-symbols-outlined text-[18px] text-amber-700">receipt_long</span>
          Ticket POS
        </a>
        <button type="button" 
                onclick="sendBookingEmailFromEdit()" 
                class="bg-emerald-50 border border-emerald-300 hover:bg-emerald-100 text-emerald-900 transition-colors font-label-md px-3.5 py-2.5 rounded-lg flex items-center gap-1.5 shadow-sm font-semibold cursor-pointer" 
                title="Enviar o Reenviar Boleto por Correo Electrónico">
          <span class="material-symbols-outlined text-[18px] text-emerald-700">forward_to_inbox</span>
          Enviar Correo
        </button>
        <button type="button" 
                onclick="openSendWhatsAppModalEdit()" 
                class="bg-emerald-50 border border-[#25D366]/40 hover:bg-emerald-100 text-emerald-950 transition-colors font-label-md px-3.5 py-2.5 rounded-lg flex items-center gap-1.5 shadow-sm font-semibold cursor-pointer" 
                title="Enviar Boleto y Boleta (PDF) por WhatsApp">
          <span class="material-symbols-outlined text-[18px] text-[#25D366]">chat</span>
          WhatsApp
        </button>
        @if (!isCancelled)
        {
          @if (Model.PaidAmount > 0)
          {
            <button type="button" onclick="openRefundModal()" class="bg-amber-50 border border-amber-300 text-amber-900 hover:bg-amber-100 transition-colors font-label-md px-3.5 py-2.5 rounded-lg flex items-center gap-1.5 shadow-sm font-bold cursor-pointer" title="Registrar devolución parcial de dinero en Caja General manteniendo la reserva">
              <span class="material-symbols-outlined text-[18px] text-amber-700">currency_exchange</span>
              Devolución Parcial
            </button>
          }
          <button type="button" onclick="openCancelModal()" class="bg-surface-container border border-red-300 text-red-600 hover:bg-red-50 transition-colors font-label-md px-4 py-2.5 rounded-lg flex items-center gap-2 shadow-sm font-bold cursor-pointer" title="Anular esta reserva y regularizar devolución en Caja y SUNAT">
            <span class="material-symbols-outlined text-[18px]">cancel</span>
            Anular / Devolver
          </button>
        }
        else
        {
          <button type="button" onclick="openReactivateModal()" class="bg-surface-container border border-green-300 text-green-700 hover:bg-green-50 transition-colors font-label-md px-4 py-2.5 rounded-lg flex items-center gap-2 shadow-sm font-bold cursor-pointer" title="Reactivar reserva">
            <span class="material-symbols-outlined text-[18px]">restore</span>
            Reactivar Reserva
          </button>
        }
        <button type="button" onclick="openDeleteBookingModal()" class="bg-surface-container border border-red-400 text-red-700 hover:bg-red-50 transition-colors font-label-md px-3.5 py-2.5 rounded-lg flex items-center gap-1.5 shadow-sm font-bold cursor-pointer" title="Eliminar reserva permanentemente">
          <span class="material-symbols-outlined text-[18px]">delete</span>
          Eliminar
        </button>
        <button type="submit" class="bg-primary text-on-primary hover:bg-[#0e5a52] transition-colors font-label-md px-6 py-2.5 rounded-lg flex items-center gap-2 shadow-sm font-bold cursor-pointer">
          <span class="material-symbols-outlined text-[18px]">save</span>
          Guardar Cambios
        </button>
      </div>
    </div>

    <partial name="_BookingFormFields" model="Model" />

    <div asp-validation-summary="All" class="text-error text-label-sm font-bold bg-error-container/50 p-3 rounded-lg mt-6 empty:hidden"></div>
</form>
</div>

<!-- MODAL INTEGRADO DE ANULACIÓN Y REGULARIZACIÓN (CAJA Y SUNAT) -->
<div class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-inverse-surface/70 backdrop-blur-sm transition-opacity duration-200 hidden" id="cancelBookingModal">
    <div class="bg-surface-container-lowest rounded-2xl w-full max-w-xl border border-outline-variant shadow-2xl overflow-hidden transform transition-all duration-200 max-h-[92vh] overflow-y-auto">
        <div class="h-2 w-full bg-red-600"></div>
        <div class="p-6 pb-4 flex items-start justify-between gap-4 border-b border-outline-variant/50">
            <div class="flex items-center gap-3">
                <div class="w-12 h-12 rounded-xl bg-red-100 border border-red-200 flex items-center justify-center text-red-600 shrink-0">
                    <span class="material-symbols-outlined text-[28px]">cancel</span>
                </div>
                <div>
                    <h3 class="text-title-md font-bold text-on-surface leading-snug">Anular Reserva y Regularizar Devolución</h3>
                    <span class="text-label-sm text-red-600 font-bold tracking-wider uppercase">Localizador @Model.ReferenceCode • @Model.TotalPassengers pax</span>
                </div>
            </div>
            <button class="p-1.5 rounded-lg text-on-surface-variant hover:bg-surface-container transition-colors cursor-pointer" onclick="closeCancelModal()" type="button">
                <span class="material-symbols-outlined">close</span>
            </button>
        </div>

        <form asp-action="CancelBooking" method="post" id="cancelBookingForm">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.Id" />

            <div class="px-6 py-4 space-y-4">
                <!-- Resumen Financiero y Tributario Actual -->
                <div class="p-3.5 rounded-xl bg-surface-container-low border border-outline-variant/60 space-y-1.5 text-body-sm">
                    <div class="flex items-center justify-between">
                        <span class="text-outline">Titular / Circuito:</span>
                        <span class="font-bold text-on-surface">@Model.CustomerName • @Model.TourName</span>
                    </div>
                    <div class="flex items-center justify-between">
                        <span class="text-outline">Monto Abonado Actual:</span>
                        <span class="font-bold text-emerald-700">S/ @Model.PaidAmount.ToString("N2") (@(string.IsNullOrWhiteSpace(Model.PaymentMethod) ? "Efectivo" : Model.PaymentMethod))</span>
                    </div>
                    <div class="flex items-center justify-between">
                        <span class="text-outline">Comprobante SUNAT Asociado:</span>
                        <span class="font-bold text-primary">@(string.IsNullOrWhiteSpace(Model.InvoiceNumber) ? "Detección automática (Boleta / Factura)" : $"{Model.InvoiceType} {Model.InvoiceNumber}")</span>
                    </div>
                </div>

                @if (Model.PaidAmount > 0)
                {
                    <!-- 1. Devolución y Regularización en Caja General -->
                    <div class="p-4 rounded-xl bg-amber-50/70 border border-amber-200 space-y-3">
                        <div class="flex items-center justify-between">
                            <div class="flex items-center gap-2 font-bold text-amber-950 text-body-sm">
                                <span class="material-symbols-outlined text-[19px] text-amber-700">point_of_sale</span>
                                <span>1. Devolución de Dinero y Caja General</span>
                            </div>
                            <label class="inline-flex items-center gap-1.5 text-xs font-bold text-amber-900 cursor-pointer">
                                <input type="checkbox" name="registerCashRefund" id="chkRegisterCashRefund" value="true" checked class="rounded border-amber-400 text-primary focus:ring-primary" />
                                <span>Registrar Egreso en Caja</span>
                            </label>
                        </div>

                        <div class="grid grid-cols-1 sm:grid-cols-3 gap-2 text-xs">
                            <label class="flex items-center gap-2 p-2.5 rounded-lg border border-amber-300 bg-white cursor-pointer font-semibold text-on-surface">
                                <input type="radio" name="refundType" value="full" checked onchange="toggleCancelRefundAmount()" class="text-primary focus:ring-primary" />
                                <span>Total 100% (S/ @Model.PaidAmount.ToString("N2"))</span>
                            </label>
                            <label class="flex items-center gap-2 p-2.5 rounded-lg border border-amber-300 bg-white cursor-pointer font-semibold text-on-surface">
                                <input type="radio" name="refundType" value="partial" onchange="toggleCancelRefundAmount()" class="text-primary focus:ring-primary" />
                                <span>Parcial (Con penalidad)</span>
                            </label>
                            <label class="flex items-center gap-2 p-2.5 rounded-lg border border-amber-300 bg-white cursor-pointer font-semibold text-on-surface">
                                <input type="radio" name="refundType" value="none" onchange="toggleCancelRefundAmount()" class="text-primary focus:ring-primary" />
                                <span>Sin devolución (No-Show)</span>
                            </label>
                        </div>

                        <div id="partialRefundInputBox" class="hidden pt-1 space-y-2">
                            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
                                <label for="cancelRefundAmountInput" class="text-xs font-bold text-amber-950">Monto exacto a devolver (S/):</label>
                                <div class="flex items-center gap-1.5">
                                    <button type="button" onclick="setCancelPenaltyPreset(0.8)" class="px-2 py-1 rounded bg-amber-100 hover:bg-amber-200 text-amber-900 text-[11px] font-bold cursor-pointer">80% (-20% penalidad)</button>
                                    <button type="button" onclick="setCancelPenaltyPreset(0.5)" class="px-2 py-1 rounded bg-amber-100 hover:bg-amber-200 text-amber-900 text-[11px] font-bold cursor-pointer">50% (-50% penalidad)</button>
                                </div>
                            </div>
                            <input type="number" step="0.50" min="0" max="@Model.PaidAmount.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)" name="refundAmount" id="cancelRefundAmountInput" value="@Model.PaidAmount.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)" class="w-full py-2 px-3 rounded-lg border border-amber-300 bg-white text-body-sm font-bold text-on-surface" />
                        </div>

                        <div id="refundMethodBox" class="grid grid-cols-1 sm:grid-cols-2 gap-2 pt-1">
                            <div>
                                <label for="cancelRefundMethod" class="block text-[11px] font-bold text-amber-900 mb-1">Medio de salida del dinero:</label>
                                <select name="refundMethod" id="cancelRefundMethod" class="w-full py-1.5 px-2.5 rounded-lg border border-amber-300 bg-white text-xs font-semibold text-on-surface">
                                    <option value="Efectivo">Efectivo (Caja General)</option>
                                    <option value="Yape / Plin">Yape / Plin</option>
                                    <option value="Transferencia BCP / BBVA">Transferencia Bancaria</option>
                                    <option value="Extorno Culqi">Extorno Pasarela Culqi</option>
                                </select>
                            </div>
                            <div class="flex items-end">
                                <p class="text-[11px] text-amber-800 leading-tight">Se descontará automáticamente del arqueo en el turno abierto de Caja General.</p>
                            </div>
                        </div>
                    </div>
                }

                <!-- 2. Regularización Tributaria SUNAT (NubeFact) -->
                <div class="p-4 rounded-xl bg-sky-50/70 border border-sky-200 space-y-2.5">
                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-2 font-bold text-sky-950 text-body-sm">
                            <span class="material-symbols-outlined text-[19px] text-sky-700">receipt_long</span>
                            <span>2. Regularización en SUNAT (NubeFact)</span>
                        </div>
                        <label class="inline-flex items-center gap-1.5 text-xs font-bold text-sky-900 cursor-pointer">
                            <input type="checkbox" name="voidSunatReceipt" value="true" checked class="rounded border-sky-400 text-primary focus:ring-primary" />
                            <span>Anular en SUNAT</span>
                        </label>
                    </div>
                    <div>
                        <label for="cancelSunatAction" class="block text-[11px] font-bold text-sky-900 mb-1">Operación Tributaria Electrónica:</label>
                        <select name="sunatAction" id="cancelSunatAction" class="w-full py-2 px-3 rounded-lg border border-sky-300 bg-white text-xs font-semibold text-on-surface">
                            <option value="credit_note">Emitir Nota de Crédito Electrónica (Catálogo 09 SUNAT - Anulación / Devolución)</option>
                            <option value="void">Comunicación de Baja / Anulación Directa del Comprobante en NubeFact</option>
                        </select>
                    </div>
                </div>

                <!-- 3. Motivo de Anulación -->
                <div>
                    <label for="cancelReasonInput" class="block text-label-sm font-bold text-on-surface-variant mb-1">Motivo de Anulación / Sustento Tributario y de Caja</label>
                    <input type="text" name="cancelReason" id="cancelReasonInput" value="Anulación de reserva y devolución a solicitud del pasajero" required class="w-full py-2 px-3 rounded-lg border border-outline-variant bg-surface-bright text-body-sm text-on-surface focus:border-primary outline-none" />
                </div>
            </div>

            <div class="p-6 pt-4 bg-surface-container-high/20 border-t border-outline-variant/40 flex flex-col-reverse sm:flex-row justify-end gap-3">
                <button class="px-5 py-2.5 rounded-lg border border-outline-variant bg-surface-container-lowest text-on-surface font-label-md font-bold hover:bg-surface-container transition-all cursor-pointer" onclick="closeCancelModal()" type="button">Volver</button>
                <button type="submit" class="flex items-center justify-center gap-2 px-5 py-2.5 rounded-lg bg-red-600 text-white font-label-md font-bold shadow-sm transition-all hover:bg-red-700 cursor-pointer">
                    <span class="material-symbols-outlined text-[18px]">cancel</span>
                    <span>Confirmar Anulación y Regularizar</span>
                </button>
            </div>
        </form>
    </div>
</div>

<!-- MODAL DE DEVOLUCIÓN PARCIAL (MANTENIENDO LA RESERVA ACTIVA) -->
<div class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-inverse-surface/70 backdrop-blur-sm transition-opacity duration-200 hidden" id="refundBookingModal">
    <div class="bg-surface-container-lowest rounded-2xl w-full max-w-lg border border-outline-variant shadow-2xl overflow-hidden transform transition-all duration-200">
        <div class="h-2 w-full bg-amber-500"></div>
        <div class="p-6 pb-4 flex items-start justify-between gap-4 border-b border-outline-variant/50">
            <div class="flex items-center gap-3">
                <div class="w-11 h-11 rounded-xl bg-amber-100 border border-amber-200 flex items-center justify-center text-amber-800 shrink-0">
                    <span class="material-symbols-outlined text-[24px]">currency_exchange</span>
                </div>
                <div>
                    <h3 class="text-title-md font-bold text-on-surface">Registrar Devolución / Reembolso en Caja</h3>
                    <span class="text-label-sm text-amber-800 font-bold uppercase">Reserva @Model.ReferenceCode • Pagado: S/ @Model.PaidAmount.ToString("N2")</span>
                </div>
            </div>
            <button class="p-1.5 rounded-lg text-on-surface-variant hover:bg-surface-container transition-colors cursor-pointer" onclick="closeRefundModal()" type="button">
                <span class="material-symbols-outlined">close</span>
            </button>
        </div>
        <form asp-action="RefundBookingPayment" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.Id" />
            <div class="px-6 py-4 space-y-4">
                <p class="text-xs text-on-surface-variant leading-relaxed">
                    Usa esta opción cuando la reserva continúa activa (por ejemplo, si desiste 1 acompañante o se aplica un descuento) y deseas devolver parte del dinero registrando el <strong>Egreso en Caja General</strong>.
                </p>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    <div>
                        <label class="block text-label-sm font-bold text-on-surface-variant mb-1">Monto a Devolver (S/) *</label>
                        <input type="number" step="0.50" min="0.50" max="@Model.PaidAmount.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)" name="refundAmount" value="@Model.PaidAmount.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)" required class="w-full py-2 px-3 rounded-lg border border-outline-variant bg-surface-bright text-body-sm font-bold text-on-surface" />
                    </div>
                    <div>
                        <label class="block text-label-sm font-bold text-on-surface-variant mb-1">Medio de Devolución</label>
                        <select name="paymentMethod" class="w-full py-2 px-3 rounded-lg border border-outline-variant bg-surface-bright text-body-sm text-on-surface">
                            <option value="Efectivo">Efectivo</option>
                            <option value="Yape / Plin">Yape / Plin</option>
                            <option value="Transferencia BCP / BBVA">Transferencia Bancaria</option>
                        </select>
                    </div>
                </div>
                <div>
                    <label class="block text-label-sm font-bold text-on-surface-variant mb-1">Motivo / Justificación de la Devolución *</label>
                    <input type="text" name="reason" minlength="5" required placeholder="Ej: Devolución de 1 pasaje por inasistencia justificada de acompañante" class="w-full py-2 px-3 rounded-lg border border-outline-variant bg-surface-bright text-body-sm text-on-surface" />
                </div>
            </div>
            <div class="p-6 pt-4 bg-surface-container-high/20 border-t border-outline-variant/40 flex justify-end gap-3">
                <button type="button" onclick="closeRefundModal()" class="px-4 py-2 rounded-lg border border-outline-variant text-on-surface font-bold text-body-sm cursor-pointer">Cancelar</button>
                <button type="submit" class="px-5 py-2 rounded-lg bg-amber-600 hover:bg-amber-700 text-white font-bold text-body-sm flex items-center gap-1.5 shadow-sm cursor-pointer">
                    <span class="material-symbols-outlined text-[18px]">check_circle</span>
                    <span>Registrar Devolución en Caja</span>
                </button>
            </div>
        </form>
    </div>
</div>

<!-- MODAL DE ELIMINACIÓN DEFINITIVA DE RESERVA -->
<div class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-inverse-surface/70 backdrop-blur-sm transition-opacity duration-200 hidden" id="deleteBookingModal">
    <div class="bg-surface-container-lowest rounded-2xl w-full max-w-lg border border-outline-variant shadow-2xl overflow-hidden transform transition-all duration-200">
        <div class="h-2 w-full bg-red-600"></div>
        <div class="p-6 pb-4 flex items-start justify-between gap-4">
            <div class="flex items-center gap-3">
                <div class="w-12 h-12 rounded-xl bg-red-100 border border-red-200 flex items-center justify-center text-red-600 shrink-0">
                    <span class="material-symbols-outlined text-[28px]">delete_forever</span>
                </div>
                <div>
                    <h3 class="text-headline-sm font-bold text-on-surface leading-snug">¿Eliminar reserva definitivamente?</h3>
                    <span class="text-label-sm text-red-600 font-bold tracking-wider uppercase">Código @Model.ReferenceCode</span>
                </div>
            </div>
            <button class="p-1.5 rounded-lg text-on-surface-variant hover:bg-surface-container transition-colors cursor-pointer" onclick="closeDeleteBookingModal()" type="button">
                <span class="material-symbols-outlined">close</span>
            </button>
        </div>
        <div class="px-6 py-4 space-y-4">
            <p class="text-body-md text-on-surface leading-relaxed">
                Estás a punto de borrar definitivamente la reserva de <strong class="font-bold text-primary">@Model.CustomerName</strong>.
            </p>
            <div class="p-4 rounded-xl bg-red-50 border border-red-200 text-body-sm text-red-800 space-y-1">
                <div class="flex items-center gap-1.5 font-bold">
                    <span class="material-symbols-outlined text-[18px]">warning</span>
                    <span>Advertencia de depuración:</span>
                </div>
                <ul class="list-disc list-inside text-xs space-y-0.5 pl-1">
                    <li>Esta acción no se puede deshacer.</li>
                    <li>Se eliminarán todos los acompañantes y detalles asociados a esta reserva.</li>
                    <li>Ideal para limpiar reservas de prueba en el sistema.</li>
                </ul>
            </div>
        </div>
        <div class="p-6 pt-4 bg-surface-container-high/20 border-t border-outline-variant/40 flex flex-col-reverse sm:flex-row justify-end gap-3">
            <button class="px-5 py-2.5 rounded-lg border border-outline-variant bg-surface-container-lowest text-on-surface font-label-md font-bold hover:bg-surface-container transition-all cursor-pointer" onclick="closeDeleteBookingModal()" type="button">Cancelar</button>
            <form asp-action="DeleteBooking" method="post" id="deleteBookingForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <button type="submit" class="flex items-center gap-2 px-5 py-2.5 rounded-lg bg-red-600 text-white font-label-md font-bold shadow-sm transition-all hover:bg-red-700 cursor-pointer">
                    <span class="material-symbols-outlined text-[18px]">delete</span>
                    <span>Sí, Eliminar Permanentemente</span>
                </button>
            </form>
        </div>
    </div>
</div>

<!-- MODAL DE ENVÍO DE CORREO CON LOS 2 PDFs (BOLETO Y BOLETA) -->
<div id="sendEmailModalEdit" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-inverse-surface/70 backdrop-blur-sm transition-all duration-200 hidden">
    <div class="bg-surface-container-lowest rounded-2xl w-full max-w-lg border border-outline-variant shadow-2xl overflow-hidden transform transition-all duration-200">
        <div class="h-2 w-full bg-gradient-to-r from-primary to-primary-dark"></div>
        <div class="p-6">
            <div class="flex items-center justify-between pb-3 border-b border-outline-variant/60">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl bg-primary/10 text-primary flex items-center justify-center font-bold">
                        <span class="material-symbols-outlined text-[24px]">forward_to_inbox</span>
                    </div>
                    <div>
                        <h3 class="text-title-md font-bold text-on-surface">Enviar Boleto y Boleta por Correo</h3>
                        <p class="text-xs text-on-surface-variant">Confirmación oficial con los 2 PDFs adjuntos</p>
                    </div>
                </div>
                <button type="button" onclick="closeSendEmailModalEdit()" class="text-outline hover:text-on-surface p-1 rounded-lg cursor-pointer">
                    <span class="material-symbols-outlined text-[20px]">close</span>
                </button>
            </div>

            <!-- Booking Summary Pill -->
            <div class="my-4 p-3 bg-surface-container-low rounded-xl border border-outline-variant/50 text-xs flex items-center justify-between">
                <div>
                    <span class="text-outline font-semibold block">Reserva:</span>
                    <strong class="text-primary font-mono text-sm">@Model.ReferenceCode</strong>
                </div>
                <div class="text-right">
                    <span class="text-outline font-semibold block">Pasajero:</span>
                    <strong class="text-on-surface">@Model.CustomerName</strong>
                </div>
            </div>

            <!-- Email Input Field -->
            <div class="space-y-1.5 mb-4">
                <label for="modalBookingEmailInputEdit" class="block text-xs font-bold text-on-surface uppercase tracking-wider">
                    Correo Electrónico de Destino *
                </label>
                <div class="relative">
                    <span class="material-symbols-outlined absolute left-3 top-3 text-outline text-[20px]" aria-hidden="true">mail</span>
                    <input type="email" id="modalBookingEmailInputEdit" name="modalBookingEmailInputEdit" class="w-full pl-10 pr-4 py-2.5 rounded-xl border border-outline-variant focus:border-primary focus:ring-1 focus:ring-primary text-sm text-on-surface bg-white font-medium" placeholder="correo@ejemplo.com" required />
                </div>
                <p class="text-[11px] text-on-surface-variant">Se enviará desde el correo oficial <strong class="text-primary">enriquearana1402@gmail.com</strong>.</p>
            </div>

            <!-- PDFs Included Checklist -->
            <div class="p-3 bg-emerald-50/70 border border-emerald-200 rounded-xl space-y-1.5 mb-5 text-xs">
                <div class="font-bold text-emerald-900 flex items-center gap-1.5">
                    <span class="material-symbols-outlined text-emerald-700 text-[18px]">attach_file</span>
                    Documentos Oficiales Adjuntos en PDF:
                </div>
                <div class="flex items-center gap-2 text-emerald-800">
                    <span class="material-symbols-outlined text-[16px] text-emerald-600">check_circle</span>
                    <span><strong>1. Boleto Oficial de Viaje (Voucher PDF):</strong> Itinerario, datos de embarque y pasajeros.</span>
                </div>
                <div class="flex items-center gap-2 text-emerald-800">
                    <span class="material-symbols-outlined text-[16px] text-emerald-600">check_circle</span>
                    <span><strong>2. Boleta de Venta Electrónica SUNAT (PDF):</strong> Comprobante tributario oficial.</span>
                </div>
            </div>

            <!-- Status Message Area -->
            <div id="modalSendEmailStatusEdit" class="hidden mb-4 p-3 rounded-xl text-xs font-semibold"></div>

            <!-- Actions Buttons -->
            <div class="flex items-center justify-end gap-3 pt-2 border-t border-outline-variant/40">
                <button type="button" onclick="closeSendEmailModalEdit()" class="px-4 py-2.5 rounded-xl border border-outline-variant hover:bg-surface-container text-xs font-bold text-secondary transition-all cursor-pointer">
                    Cancelar
                </button>
                <button type="button" id="btnConfirmSendEmailEdit" onclick="executeSendEmailFromModalEdit()" class="px-5 py-2.5 rounded-xl bg-primary hover:bg-primary-dark text-white text-xs font-bold transition-all shadow-md flex items-center gap-1.5 cursor-pointer">
                    <span class="material-symbols-outlined text-[18px]">send</span>
                    <span id="btnConfirmSendEmailTextEdit">Enviar Correo con los 2 PDFs</span>
                </button>
            </div>
        </div>
    </div>
</div>

