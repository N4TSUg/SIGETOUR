@model SIGETOUR.API.Models.EditBookingViewModel
@using SIGETOUR.API.Core.Entities
@{
    ViewData["Title"] = "Editar Reserva " + Model.ReferenceCode;
    Layout = "_AdminLayout";
    bool isCancelled = Model.Status == BookingStatus.Cancelled;
}

<div class="px-4 sm:px-6 lg:px-8 py-8 w-full max-w-9xl mx-auto">

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="mb-6 p-4 rounded-xl bg-primary/10 border border-primary/20 text-primary flex items-center gap-3">
            <span class="material-symbols-outlined text-[22px]">check_circle</span>
            <span class="font-semibold text-body-md">@TempData["SuccessMessage"]</span>
        </div>
    }

    @if (isCancelled)
    {
        <div class="mb-6 p-4 rounded-xl bg-red-50 border border-red-200 text-red-700 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
            <div class="flex items-center gap-3">
                <span class="material-symbols-outlined text-3xl shrink-0">cancel</span>
                <div>
                    <h3 class="font-bold text-body-lg">Esta reserva se encuentra ANULADA / CANCELADA</h3>
                    <p class="text-xs text-red-600 mt-0.5">Los cupos se encuentran liberados del despacho operativo y vehículos.</p>
                </div>
            </div>
            <button type="button" onclick="document.getElementById('reactivateForm').submit()" class="px-4 py-2 bg-red-600 hover:bg-red-700 text-white rounded-lg text-label-md font-bold transition-all shadow-sm flex items-center gap-1.5 self-start sm:self-auto cursor-pointer">
                <span class="material-symbols-outlined text-[18px]">restore</span>
                Reactivar Reserva
            </button>
        </div>
    }

<form asp-action="EditBooking" method="post" id="editBookingForm">
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="ReferenceCode" />

    <!-- Page Header -->
    <div class="sm:flex sm:justify-between sm:items-center mb-8">
      <div class="mb-4 sm:mb-0 flex items-center gap-3">
        <a href="@Url.Action("Bookings", "Admin")" class="p-2 rounded-full hover:bg-surface-container-low transition-colors text-on-surface-variant cursor-pointer" title="Volver al listado de reservas">
          <span class="material-symbols-outlined text-[24px]">arrow_back</span>
        </a>
        <div>
          <h1 class="text-headline-md font-headline-md font-bold text-on-surface flex items-center gap-3">
            Editar Reserva <span class="text-primary font-mono bg-surface-container-low px-2 rounded">@Model.ReferenceCode</span>
          </h1>
          <p class="text-body-md text-on-surface-variant flex items-center gap-2">
            <span class="material-symbols-outlined text-[18px] text-primary">tour</span>
            Tour actual: <span class="font-bold text-on-surface" id="headerTourTitle">@Model.TourName</span>
          </p>
        </div>
      </div>
      <div class="flex flex-wrap gap-2 items-center">
        <a href="@Url.Action("Voucher", "Booking", new { id = Model.Id })" target="_blank" class="bg-surface-container border border-outline-variant hover:bg-surface-container-low text-on-surface transition-colors font-label-md px-3.5 py-2.5 rounded-lg flex items-center gap-1.5 shadow-sm font-semibold cursor-pointer" title="Ver Boleto Oficial">
          <span class="material-symbols-outlined text-[18px] text-primary">confirmation_number</span>
          Boleto
        </a>
        <a href="@Url.Action("Ticket", "Booking", new { id = Model.Id })" target="_blank" class="bg-amber-50 border border-amber-300 hover:bg-amber-100 text-amber-900 transition-colors font-label-md px-3.5 py-2.5 rounded-lg flex items-center gap-1.5 shadow-sm font-semibold cursor-pointer" title="Ver / Imprimir Ticket POS (80mm / 58mm)">
          <span class="material-symbols-outlined text-[18px] text-amber-700">receipt_long</span>
          Ticket POS
        </a>
        <button type="button" 
                onclick="sendBookingEmailFromEdit()" 
                class="bg-emerald-50 border border-emerald-300 hover:bg-emerald-100 text-emerald-900 transition-colors font-label-md px-3.5 py-2.5 rounded-lg flex items-center gap-1.5 shadow-sm font-semibold cursor-pointer" 
                title="Enviar o Reenviar Boleto por Correo Electrónico">
          <span class="material-symbols-outlined text-[18px] text-emerald-700">forward_to_inbox</span>
          Enviar Correo
        </button>
        <button type="button" 
                onclick="sendWhatsappFromEdit()" 
                class="bg-emerald-50 border border-[#25D366]/40 hover:bg-emerald-100 text-emerald-950 transition-colors font-label-md px-3.5 py-2.5 rounded-lg flex items-center gap-1.5 shadow-sm font-semibold cursor-pointer" 
                title="Enviar Confirmación y Boleto por WhatsApp">
          <span class="material-symbols-outlined text-[18px] text-[#25D366]">chat</span>
          WhatsApp
        </button>
        @if (!isCancelled)
        {
          <button type="button" onclick="openCancelModal()" class="bg-surface-container border border-red-300 text-red-600 hover:bg-red-50 transition-colors font-label-md px-4 py-2.5 rounded-lg flex items-center gap-2 shadow-sm font-bold cursor-pointer" title="Anular esta reserva">
            <span class="material-symbols-outlined text-[18px]">cancel</span>
            Anular Reserva
          </button>
        }
        else
        {
          <button type="button" onclick="document.getElementById('reactivateForm').submit()" class="bg-surface-container border border-green-300 text-green-700 hover:bg-green-50 transition-colors font-label-md px-4 py-2.5 rounded-lg flex items-center gap-2 shadow-sm font-bold cursor-pointer" title="Reactivar reserva">
            <span class="material-symbols-outlined text-[18px]">restore</span>
            Reactivar Reserva
          </button>
        }
        <button type="button" onclick="openDeleteBookingModal()" class="bg-surface-container border border-red-400 text-red-700 hover:bg-red-50 transition-colors font-label-md px-3.5 py-2.5 rounded-lg flex items-center gap-1.5 shadow-sm font-bold cursor-pointer" title="Eliminar reserva permanentemente">
          <span class="material-symbols-outlined text-[18px]">delete</span>
          Eliminar
        </button>
        <button type="submit" class="bg-primary text-on-primary hover:bg-[#0e5a52] transition-colors font-label-md px-6 py-2.5 rounded-lg flex items-center gap-2 shadow-sm font-bold cursor-pointer">
          <span class="material-symbols-outlined text-[18px]">save</span>
          Guardar Cambios
        </button>
      </div>
    </div>

    <partial name="_BookingFormFields" model="Model" />

    <div asp-validation-summary="All" class="text-error text-label-sm font-bold bg-error-container/50 p-3 rounded-lg mt-6 empty:hidden"></div>
</form>
</div>

<!-- MODAL DE ANULACIÓN DE RESERVA -->
<div class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-inverse-surface/70 backdrop-blur-sm transition-opacity duration-200 hidden" id="cancelBookingModal">
    <div class="bg-surface-container-lowest rounded-2xl w-full max-w-lg border border-outline-variant shadow-2xl overflow-hidden transform transition-all duration-200">
        <div class="h-2 w-full bg-red-600"></div>
        <div class="p-6 pb-4 flex items-start justify-between gap-4">
            <div class="flex items-center gap-3">
                <div class="w-12 h-12 rounded-xl bg-red-100 border border-red-200 flex items-center justify-center text-red-600 shrink-0">
                    <span class="material-symbols-outlined text-[28px]">warning</span>
                </div>
                <div>
                    <h3 class="text-headline-sm font-bold text-on-surface leading-snug">¿Confirmas anular esta reserva?</h3>
                    <span class="text-label-sm text-red-600 font-bold tracking-wider uppercase">Código @Model.ReferenceCode</span>
                </div>
            </div>
            <button class="p-1.5 rounded-lg text-on-surface-variant hover:bg-surface-container transition-colors cursor-pointer" onclick="closeCancelModal()" type="button">
                <span class="material-symbols-outlined">close</span>
            </button>
        </div>
        <div class="px-6 py-4 space-y-4">
            <p class="text-body-md text-on-surface leading-relaxed">
                Estás a punto de anular la reserva a nombre de <strong class="font-bold text-primary">@Model.CustomerName</strong> para el tour <strong class="font-bold" id="modalTourName">@Model.TourName</strong>.
            </p>
            <div class="p-4 rounded-xl bg-red-50 border border-red-200 text-body-sm text-red-800 space-y-1">
                <div class="flex items-center gap-1.5 font-bold">
                    <span class="material-symbols-outlined text-[18px]">info</span>
                    <span>Consecuencias operativas:</span>
                </div>
                <ul class="list-disc list-inside text-xs space-y-0.5 pl-1">
                    <li>La reserva pasará al estado <strong>Cancelado</strong>.</li>
                    <li>Los @Model.TotalPassengers cupos quedarán liberados inmediatamente del despacho.</li>
                    <li>Podrás reactivar la reserva en cualquier momento si fue un error.</li>
                </ul>
            </div>
        </div>
        <div class="p-6 pt-4 bg-surface-container-high/20 border-t border-outline-variant/40 flex flex-col-reverse sm:flex-row justify-end gap-3">
            <button class="px-5 py-2.5 rounded-lg border border-outline-variant bg-surface-container-lowest text-on-surface font-label-md font-bold hover:bg-surface-container transition-all cursor-pointer" onclick="closeCancelModal()" type="button">Volver</button>
            <form asp-action="CancelBooking" method="post" id="cancelBookingForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <button type="submit" class="flex items-center gap-2 px-5 py-2.5 rounded-lg bg-red-600 text-white font-label-md font-bold shadow-sm transition-all hover:bg-red-700 cursor-pointer">
                    <span class="material-symbols-outlined text-[18px]">cancel</span>
                    <span>Sí, Anular Reserva</span>
                </button>
            </form>
        </div>
    </div>
</div>

<!-- MODAL DE ELIMINACIÓN DEFINITIVA DE RESERVA -->
<div class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-inverse-surface/70 backdrop-blur-sm transition-opacity duration-200 hidden" id="deleteBookingModal">
    <div class="bg-surface-container-lowest rounded-2xl w-full max-w-lg border border-outline-variant shadow-2xl overflow-hidden transform transition-all duration-200">
        <div class="h-2 w-full bg-red-600"></div>
        <div class="p-6 pb-4 flex items-start justify-between gap-4">
            <div class="flex items-center gap-3">
                <div class="w-12 h-12 rounded-xl bg-red-100 border border-red-200 flex items-center justify-center text-red-600 shrink-0">
                    <span class="material-symbols-outlined text-[28px]">delete_forever</span>
                </div>
                <div>
                    <h3 class="text-headline-sm font-bold text-on-surface leading-snug">¿Eliminar reserva definitivamente?</h3>
                    <span class="text-label-sm text-red-600 font-bold tracking-wider uppercase">Código @Model.ReferenceCode</span>
                </div>
            </div>
            <button class="p-1.5 rounded-lg text-on-surface-variant hover:bg-surface-container transition-colors cursor-pointer" onclick="closeDeleteBookingModal()" type="button">
                <span class="material-symbols-outlined">close</span>
            </button>
        </div>
        <div class="px-6 py-4 space-y-4">
            <p class="text-body-md text-on-surface leading-relaxed">
                Estás a punto de borrar definitivamente la reserva de <strong class="font-bold text-primary">@Model.CustomerName</strong>.
            </p>
            <div class="p-4 rounded-xl bg-red-50 border border-red-200 text-body-sm text-red-800 space-y-1">
                <div class="flex items-center gap-1.5 font-bold">
                    <span class="material-symbols-outlined text-[18px]">warning</span>
                    <span>Advertencia de depuración:</span>
                </div>
                <ul class="list-disc list-inside text-xs space-y-0.5 pl-1">
                    <li>Esta acción no se puede deshacer.</li>
                    <li>Se eliminarán todos los acompañantes y detalles asociados a esta reserva.</li>
                    <li>Ideal para limpiar reservas de prueba en el sistema.</li>
                </ul>
            </div>
        </div>
        <div class="p-6 pt-4 bg-surface-container-high/20 border-t border-outline-variant/40 flex flex-col-reverse sm:flex-row justify-end gap-3">
            <button class="px-5 py-2.5 rounded-lg border border-outline-variant bg-surface-container-lowest text-on-surface font-label-md font-bold hover:bg-surface-container transition-all cursor-pointer" onclick="closeDeleteBookingModal()" type="button">Cancelar</button>
            <form asp-action="DeleteBooking" method="post" id="deleteBookingForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <button type="submit" class="flex items-center gap-2 px-5 py-2.5 rounded-lg bg-red-600 text-white font-label-md font-bold shadow-sm transition-all hover:bg-red-700 cursor-pointer">
                    <span class="material-symbols-outlined text-[18px]">delete</span>
                    <span>Sí, Eliminar Permanentemente</span>
                </button>
            </form>
        </div>
    </div>
</div>

<!-- FORMULARIO OCULTO PARA REACTIVAR -->
<form asp-action="ReactivateBooking" method="post" id="reactivateForm" class="hidden">
    @Html.AntiForgeryToken()
    <input type="hidden" name="id" value="@Model.Id" />
</form>

<script>
    function openCancelModal() {
        document.getElementById('cancelBookingModal')?.classList.remove('hidden');
    }
    function closeCancelModal() {
        document.getElementById('cancelBookingModal')?.classList.add('hidden');
    }
    function openDeleteBookingModal() {
        document.getElementById('deleteBookingModal')?.classList.remove('hidden');
    }
    function closeDeleteBookingModal() {
        document.getElementById('deleteBookingModal')?.classList.add('hidden');
    }

    function sendBookingEmailFromEdit() {
        const emailInput = document.getElementById('CustomerEmail') || document.querySelector('input[name="CustomerEmail"]');
        let email = emailInput ? emailInput.value.trim() : '@Model.CustomerEmail';
        if (!email || email === 'manual@agencia.com') {
            email = prompt('Ingrese el correo del cliente para enviarle el boleto de viaje:', '');
            if (!email) return;
            if (emailInput) emailInput.value = email;
        } else {
            if (!confirm(`¿Enviar el boleto oficial de la reserva @Model.ReferenceCode a:\n${email}?`)) return;
        }

        showEditToast('Enviando correo...', 'info');

        const formData = new FormData();
        formData.append('id', '@Model.Id');
        formData.append('email', email);

        fetch('/Admin/ResendBookingEmail', {
            method: 'POST',
            body: formData
        })
        .then(res => res.json())
        .then(data => {
            if (data.success) {
                showEditToast(`✓ ${data.message}`, 'success');
            } else {
                showEditToast(`✗ ${data.message}`, 'error');
            }
        })
        .catch(err => {
            showEditToast('Error de conexión al enviar correo.', 'error');
        });
    }

    function sendWhatsappFromEdit() {
        const phoneInput = document.getElementById('CustomerPhone') || document.querySelector('input[name="CustomerPhone"]');
        let rawPhone = phoneInput ? phoneInput.value.trim() : '@Model.CustomerPhone';
        if (!rawPhone) {
            rawPhone = prompt('Ingrese el teléfono / WhatsApp del cliente:', '');
            if (!rawPhone) return;
        }

        let digits = rawPhone.replace(/\D/g, '');
        if (digits.length === 9 && digits.startsWith('9')) {
            digits = '51' + digits;
        }

        const name = '@Model.CustomerName' || 'Estimado(a) Cliente';
        const refCode = '@Model.ReferenceCode';
        const tour = '@Model.TourName';
        const travelDate = '@Model.TravelDate.ToString("dd/MM/yyyy")';
        const voucherUrl = '@Url.Action("Voucher", "Booking", new { id = Model.Id }, Context.Request.Scheme)';

        const message = `¡Hola *${name}*! Le saluda Turismo Chilón.\n\n` +
                        `Le confirmamos que su reserva para el tour *${tour}* programada para el *${travelDate}* se encuentra CONFIRMADA.\n\n` +
                        `📌 *Código de Reserva:* ${refCode}\n` +
                        `🎟️ *Ver y Descargar Boleto Oficial:* ${voucherUrl}\n\n` +
                        `Punto de salida: Jr. 2 de Mayo 569, Cajamarca (presentarse 15 min antes con DNI).\n` +
                        `¡Gracias por confiar en Turismo Chilón!`;

        window.open(`https://wa.me/${digits}?text=${encodeURIComponent(message)}`, '_blank');
    }

    function showEditToast(message, type) {
        let container = document.getElementById('editToastContainer');
        if (!container) {
            container = document.createElement('div');
            container.id = 'editToastContainer';
            container.className = 'fixed bottom-5 right-5 z-[100] flex flex-col gap-2 max-w-md';
            document.body.appendChild(container);
        }
        const toast = document.createElement('div');
        const bgClass = type === 'success' ? 'bg-emerald-700 text-white' :
                        type === 'error' ? 'bg-red-700 text-white' : 'bg-secondary text-white';
        toast.className = `${bgClass} p-4 rounded-xl shadow-2xl border border-white/20 text-sm font-semibold flex items-center gap-2 transition-all duration-300 transform translate-y-2 opacity-0`;
        toast.innerHTML = `<span class="material-symbols-outlined text-[20px]">${type === 'success' ? 'check_circle' : type === 'error' ? 'error' : 'mail'}</span> <span>${message}</span>`;
        container.appendChild(toast);
        setTimeout(() => toast.classList.remove('translate-y-2', 'opacity-0'), 10);
        setTimeout(() => {
            toast.classList.add('opacity-0', 'translate-y-2');
            setTimeout(() => toast.remove(), 400);
        }, 4500);
    }
</script>
