@model SIGETOUR.API.Models.EditBookingViewModel
@using SIGETOUR.API.Core.Entities
@{
    ViewData["Title"] = "Editar Reserva " + Model.ReferenceCode;
    Layout = "_AdminLayout";
    bool isCancelled = Model.Status == BookingStatus.Cancelled;
}

<div class="px-4 sm:px-6 lg:px-8 py-8 w-full max-w-9xl mx-auto">

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="mb-6 p-4 rounded-xl bg-primary/10 border border-primary/20 text-primary flex items-center gap-3">
            <span class="material-symbols-outlined text-[22px]">check_circle</span>
            <span class="font-semibold text-body-md">@TempData["SuccessMessage"]</span>
        </div>
    }

    @if (isCancelled)
    {
        <div class="mb-6 p-4 rounded-xl bg-red-50 border border-red-200 text-red-700 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
            <div class="flex items-center gap-3">
                <span class="material-symbols-outlined text-3xl shrink-0">cancel</span>
                <div>
                    <h3 class="font-bold text-body-lg">Esta reserva se encuentra ANULADA / CANCELADA</h3>
                    <p class="text-xs text-red-600 mt-0.5">Los cupos se encuentran liberados del despacho operativo y vehículos.</p>
                </div>
            </div>
            <button type="button" onclick="document.getElementById('reactivateForm').submit()" class="px-4 py-2 bg-red-600 hover:bg-red-700 text-white rounded-lg text-label-md font-bold transition-all shadow-sm flex items-center gap-1.5 self-start sm:self-auto cursor-pointer">
                <span class="material-symbols-outlined text-[18px]">restore</span>
                Reactivar Reserva
            </button>
        </div>
    }

<form asp-action="EditBooking" method="post" id="editBookingForm">
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="ReferenceCode" />

    <!-- Page Header -->
    <div class="sm:flex sm:justify-between sm:items-center mb-8">
      <div class="mb-4 sm:mb-0 flex items-center gap-3">
        <a href="@Url.Action("Bookings", "Admin")" class="p-2 rounded-full hover:bg-surface-container-low transition-colors text-on-surface-variant cursor-pointer" title="Volver al listado de reservas">
          <span class="material-symbols-outlined text-[24px]">arrow_back</span>
        </a>
        <div>
          <h1 class="text-headline-md font-headline-md font-bold text-on-surface flex items-center gap-3">
            Editar Reserva <span class="text-primary font-mono bg-surface-container-low px-2 rounded">@Model.ReferenceCode</span>
          </h1>
          <p class="text-body-md text-on-surface-variant flex items-center gap-2">
            <span class="material-symbols-outlined text-[18px] text-primary">tour</span>
            Tour actual: <span class="font-bold text-on-surface" id="headerTourTitle">@Model.TourName</span>
          </p>
        </div>
      </div>
      <div class="flex flex-wrap gap-2 items-center">
        <a href="@Url.Action("Voucher", "Booking", new { id = Model.Id })" target="_blank" class="bg-surface-container border border-outline-variant hover:bg-surface-container-low text-on-surface transition-colors font-label-md px-3.5 py-2.5 rounded-lg flex items-center gap-1.5 shadow-sm font-semibold cursor-pointer" title="Ver Boleto Oficial">
          <span class="material-symbols-outlined text-[18px] text-primary">confirmation_number</span>
          Boleto
        </a>
        <a href="@Url.Action("Ticket", "Booking", new { id = Model.Id })" target="_blank" class="bg-amber-50 border border-amber-300 hover:bg-amber-100 text-amber-900 transition-colors font-label-md px-3.5 py-2.5 rounded-lg flex items-center gap-1.5 shadow-sm font-semibold cursor-pointer" title="Ver / Imprimir Ticket POS (80mm / 58mm)">
          <span class="material-symbols-outlined text-[18px] text-amber-700">receipt_long</span>
          Ticket POS
        </a>
        <button type="button" 
                onclick="sendBookingEmailFromEdit()" 
                class="bg-emerald-50 border border-emerald-300 hover:bg-emerald-100 text-emerald-900 transition-colors font-label-md px-3.5 py-2.5 rounded-lg flex items-center gap-1.5 shadow-sm font-semibold cursor-pointer" 
                title="Enviar o Reenviar Boleto por Correo Electrónico">
          <span class="material-symbols-outlined text-[18px] text-emerald-700">forward_to_inbox</span>
          Enviar Correo
        </button>
        <button type="button" 
                onclick="openSendWhatsAppModalEdit()" 
                class="bg-emerald-50 border border-[#25D366]/40 hover:bg-emerald-100 text-emerald-950 transition-colors font-label-md px-3.5 py-2.5 rounded-lg flex items-center gap-1.5 shadow-sm font-semibold cursor-pointer" 
                title="Enviar Boleto y Boleta (PDF) por WhatsApp">
          <span class="material-symbols-outlined text-[18px] text-[#25D366]">chat</span>
          WhatsApp
        </button>
        @if (!isCancelled)
        {
          <button type="button" onclick="openCancelModal()" class="bg-surface-container border border-red-300 text-red-600 hover:bg-red-50 transition-colors font-label-md px-4 py-2.5 rounded-lg flex items-center gap-2 shadow-sm font-bold cursor-pointer" title="Anular esta reserva">
            <span class="material-symbols-outlined text-[18px]">cancel</span>
            Anular Reserva
          </button>
        }
        else
        {
          <button type="button" onclick="document.getElementById('reactivateForm').submit()" class="bg-surface-container border border-green-300 text-green-700 hover:bg-green-50 transition-colors font-label-md px-4 py-2.5 rounded-lg flex items-center gap-2 shadow-sm font-bold cursor-pointer" title="Reactivar reserva">
            <span class="material-symbols-outlined text-[18px]">restore</span>
            Reactivar Reserva
          </button>
        }
        <button type="button" onclick="openDeleteBookingModal()" class="bg-surface-container border border-red-400 text-red-700 hover:bg-red-50 transition-colors font-label-md px-3.5 py-2.5 rounded-lg flex items-center gap-1.5 shadow-sm font-bold cursor-pointer" title="Eliminar reserva permanentemente">
          <span class="material-symbols-outlined text-[18px]">delete</span>
          Eliminar
        </button>
        <button type="submit" class="bg-primary text-on-primary hover:bg-[#0e5a52] transition-colors font-label-md px-6 py-2.5 rounded-lg flex items-center gap-2 shadow-sm font-bold cursor-pointer">
          <span class="material-symbols-outlined text-[18px]">save</span>
          Guardar Cambios
        </button>
      </div>
    </div>

    <partial name="_BookingFormFields" model="Model" />

    <div asp-validation-summary="All" class="text-error text-label-sm font-bold bg-error-container/50 p-3 rounded-lg mt-6 empty:hidden"></div>
</form>
</div>

<!-- MODAL DE ANULACIÓN DE RESERVA -->
<div class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-inverse-surface/70 backdrop-blur-sm transition-opacity duration-200 hidden" id="cancelBookingModal">
    <div class="bg-surface-container-lowest rounded-2xl w-full max-w-lg border border-outline-variant shadow-2xl overflow-hidden transform transition-all duration-200">
        <div class="h-2 w-full bg-red-600"></div>
        <div class="p-6 pb-4 flex items-start justify-between gap-4">
            <div class="flex items-center gap-3">
                <div class="w-12 h-12 rounded-xl bg-red-100 border border-red-200 flex items-center justify-center text-red-600 shrink-0">
                    <span class="material-symbols-outlined text-[28px]">warning</span>
                </div>
                <div>
                    <h3 class="text-headline-sm font-bold text-on-surface leading-snug">¿Confirmas anular esta reserva?</h3>
                    <span class="text-label-sm text-red-600 font-bold tracking-wider uppercase">Código @Model.ReferenceCode</span>
                </div>
            </div>
            <button class="p-1.5 rounded-lg text-on-surface-variant hover:bg-surface-container transition-colors cursor-pointer" onclick="closeCancelModal()" type="button">
                <span class="material-symbols-outlined">close</span>
            </button>
        </div>
        <div class="px-6 py-4 space-y-4">
            <p class="text-body-md text-on-surface leading-relaxed">
                Estás a punto de anular la reserva a nombre de <strong class="font-bold text-primary">@Model.CustomerName</strong> para el tour <strong class="font-bold" id="modalTourName">@Model.TourName</strong>.
            </p>
            <div class="p-4 rounded-xl bg-red-50 border border-red-200 text-body-sm text-red-800 space-y-1">
                <div class="flex items-center gap-1.5 font-bold">
                    <span class="material-symbols-outlined text-[18px]">info</span>
                    <span>Consecuencias operativas:</span>
                </div>
                <ul class="list-disc list-inside text-xs space-y-0.5 pl-1">
                    <li>La reserva pasará al estado <strong>Cancelado</strong>.</li>
                    <li>Los @Model.TotalPassengers cupos quedarán liberados inmediatamente del despacho.</li>
                    <li>Podrás reactivar la reserva en cualquier momento si fue un error.</li>
                </ul>
            </div>
        </div>
        <div class="p-6 pt-4 bg-surface-container-high/20 border-t border-outline-variant/40 flex flex-col-reverse sm:flex-row justify-end gap-3">
            <button class="px-5 py-2.5 rounded-lg border border-outline-variant bg-surface-container-lowest text-on-surface font-label-md font-bold hover:bg-surface-container transition-all cursor-pointer" onclick="closeCancelModal()" type="button">Volver</button>
            <form asp-action="CancelBooking" method="post" id="cancelBookingForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <button type="submit" class="flex items-center gap-2 px-5 py-2.5 rounded-lg bg-red-600 text-white font-label-md font-bold shadow-sm transition-all hover:bg-red-700 cursor-pointer">
                    <span class="material-symbols-outlined text-[18px]">cancel</span>
                    <span>Sí, Anular Reserva</span>
                </button>
            </form>
        </div>
    </div>
</div>

<!-- MODAL DE ELIMINACIÓN DEFINITIVA DE RESERVA -->
<div class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-inverse-surface/70 backdrop-blur-sm transition-opacity duration-200 hidden" id="deleteBookingModal">
    <div class="bg-surface-container-lowest rounded-2xl w-full max-w-lg border border-outline-variant shadow-2xl overflow-hidden transform transition-all duration-200">
        <div class="h-2 w-full bg-red-600"></div>
        <div class="p-6 pb-4 flex items-start justify-between gap-4">
            <div class="flex items-center gap-3">
                <div class="w-12 h-12 rounded-xl bg-red-100 border border-red-200 flex items-center justify-center text-red-600 shrink-0">
                    <span class="material-symbols-outlined text-[28px]">delete_forever</span>
                </div>
                <div>
                    <h3 class="text-headline-sm font-bold text-on-surface leading-snug">¿Eliminar reserva definitivamente?</h3>
                    <span class="text-label-sm text-red-600 font-bold tracking-wider uppercase">Código @Model.ReferenceCode</span>
                </div>
            </div>
            <button class="p-1.5 rounded-lg text-on-surface-variant hover:bg-surface-container transition-colors cursor-pointer" onclick="closeDeleteBookingModal()" type="button">
                <span class="material-symbols-outlined">close</span>
            </button>
        </div>
        <div class="px-6 py-4 space-y-4">
            <p class="text-body-md text-on-surface leading-relaxed">
                Estás a punto de borrar definitivamente la reserva de <strong class="font-bold text-primary">@Model.CustomerName</strong>.
            </p>
            <div class="p-4 rounded-xl bg-red-50 border border-red-200 text-body-sm text-red-800 space-y-1">
                <div class="flex items-center gap-1.5 font-bold">
                    <span class="material-symbols-outlined text-[18px]">warning</span>
                    <span>Advertencia de depuración:</span>
                </div>
                <ul class="list-disc list-inside text-xs space-y-0.5 pl-1">
                    <li>Esta acción no se puede deshacer.</li>
                    <li>Se eliminarán todos los acompañantes y detalles asociados a esta reserva.</li>
                    <li>Ideal para limpiar reservas de prueba en el sistema.</li>
                </ul>
            </div>
        </div>
        <div class="p-6 pt-4 bg-surface-container-high/20 border-t border-outline-variant/40 flex flex-col-reverse sm:flex-row justify-end gap-3">
            <button class="px-5 py-2.5 rounded-lg border border-outline-variant bg-surface-container-lowest text-on-surface font-label-md font-bold hover:bg-surface-container transition-all cursor-pointer" onclick="closeDeleteBookingModal()" type="button">Cancelar</button>
            <form asp-action="DeleteBooking" method="post" id="deleteBookingForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <button type="submit" class="flex items-center gap-2 px-5 py-2.5 rounded-lg bg-red-600 text-white font-label-md font-bold shadow-sm transition-all hover:bg-red-700 cursor-pointer">
                    <span class="material-symbols-outlined text-[18px]">delete</span>
                    <span>Sí, Eliminar Permanentemente</span>
                </button>
            </form>
        </div>
    </div>
</div>

<!-- MODAL DE ENVÍO DE CORREO CON LOS 2 PDFs (BOLETO Y BOLETA) -->
<div id="sendEmailModalEdit" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-inverse-surface/70 backdrop-blur-sm transition-all duration-200 hidden">
    <div class="bg-surface-container-lowest rounded-2xl w-full max-w-lg border border-outline-variant shadow-2xl overflow-hidden transform transition-all duration-200">
        <div class="h-2 w-full bg-gradient-to-r from-primary to-primary-dark"></div>
        <div class="p-6">
            <div class="flex items-center justify-between pb-3 border-b border-outline-variant/60">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl bg-primary/10 text-primary flex items-center justify-center font-bold">
                        <span class="material-symbols-outlined text-[24px]">forward_to_inbox</span>
                    </div>
                    <div>
                        <h3 class="text-title-md font-bold text-on-surface">Enviar Boleto y Boleta por Correo</h3>
                        <p class="text-xs text-on-surface-variant">Confirmación oficial con los 2 PDFs adjuntos</p>
                    </div>
                </div>
                <button type="button" onclick="closeSendEmailModalEdit()" class="text-outline hover:text-on-surface p-1 rounded-lg cursor-pointer">
                    <span class="material-symbols-outlined text-[20px]">close</span>
                </button>
            </div>

            <!-- Booking Summary Pill -->
            <div class="my-4 p-3 bg-surface-container-low rounded-xl border border-outline-variant/50 text-xs flex items-center justify-between">
                <div>
                    <span class="text-outline font-semibold block">Reserva:</span>
                    <strong class="text-primary font-mono text-sm">@Model.ReferenceCode</strong>
                </div>
                <div class="text-right">
                    <span class="text-outline font-semibold block">Pasajero:</span>
                    <strong class="text-on-surface">@Model.CustomerName</strong>
                </div>
            </div>

            <!-- Email Input Field -->
            <div class="space-y-1.5 mb-4">
                <label class="block text-xs font-bold text-on-surface uppercase tracking-wider">
                    Correo Electrónico de Destino *
                </label>
                <div class="relative">
                    <span class="material-symbols-outlined absolute left-3 top-3 text-outline text-[20px]">mail</span>
                    <input type="email" id="modalBookingEmailInputEdit" class="w-full pl-10 pr-4 py-2.5 rounded-xl border border-outline-variant focus:border-primary focus:ring-1 focus:ring-primary text-sm text-on-surface bg-white font-medium" placeholder="correo@ejemplo.com" required />
                </div>
                <p class="text-[11px] text-on-surface-variant">Se enviará desde el correo oficial <strong class="text-primary">enriquearana1402@gmail.com</strong>.</p>
            </div>

            <!-- PDFs Included Checklist -->
            <div class="p-3 bg-emerald-50/70 border border-emerald-200 rounded-xl space-y-1.5 mb-5 text-xs">
                <div class="font-bold text-emerald-900 flex items-center gap-1.5">
                    <span class="material-symbols-outlined text-emerald-700 text-[18px]">attach_file</span>
                    Documentos Oficiales Adjuntos en PDF:
                </div>
                <div class="flex items-center gap-2 text-emerald-800">
                    <span class="material-symbols-outlined text-[16px] text-emerald-600">check_circle</span>
                    <span><strong>1. Boleto Oficial de Viaje (Voucher PDF):</strong> Itinerario, datos de embarque y pasajeros.</span>
                </div>
                <div class="flex items-center gap-2 text-emerald-800">
                    <span class="material-symbols-outlined text-[16px] text-emerald-600">check_circle</span>
                    <span><strong>2. Boleta de Venta Electrónica SUNAT (PDF):</strong> Comprobante tributario oficial.</span>
                </div>
            </div>

            <!-- Status Message Area -->
            <div id="modalSendEmailStatusEdit" class="hidden mb-4 p-3 rounded-xl text-xs font-semibold"></div>

            <!-- Actions Buttons -->
            <div class="flex items-center justify-end gap-3 pt-2 border-t border-outline-variant/40">
                <button type="button" onclick="closeSendEmailModalEdit()" class="px-4 py-2.5 rounded-xl border border-outline-variant hover:bg-surface-container text-xs font-bold text-secondary transition-all cursor-pointer">
                    Cancelar
                </button>
                <button type="button" id="btnConfirmSendEmailEdit" onclick="executeSendEmailFromModalEdit()" class="px-5 py-2.5 rounded-xl bg-primary hover:bg-primary-dark text-white text-xs font-bold transition-all shadow-md flex items-center gap-1.5 cursor-pointer">
                    <span class="material-symbols-outlined text-[18px]">send</span>
                    <span id="btnConfirmSendEmailTextEdit">Enviar Correo con los 2 PDFs</span>
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ======================================================== -->
<!-- MODAL: COMPARTIR BOLETO Y BOLETA (PDF) POR WHATSAPP      -->
<!-- ======================================================== -->
<div id="sendWhatsAppModalEdit" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-inverse-surface/70 backdrop-blur-sm transition-all duration-200 hidden">
    <div class="bg-surface-container-lowest rounded-2xl w-full max-w-lg border border-outline-variant shadow-2xl overflow-hidden transform transition-all duration-200">
        <div class="h-2 w-full bg-gradient-to-r from-[#128C7E] to-[#25D366]"></div>
        <div class="p-6">
            <div class="flex items-center justify-between pb-3 border-b border-outline-variant/60">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl bg-emerald-100 text-[#128C7E] flex items-center justify-center font-bold">
                        <span class="material-symbols-outlined text-[24px]">chat</span>
                    </div>
                    <div>
                        <h3 class="text-title-md font-bold text-on-surface">Compartir por WhatsApp</h3>
                        <p class="text-xs text-on-surface-variant">Boleto Oficial de Viaje y Boleta Electrónica en PDF</p>
                    </div>
                </div>
                <button type="button" onclick="closeSendWhatsAppModalEdit()" class="text-outline hover:text-on-surface p-1 rounded-lg cursor-pointer">
                    <span class="material-symbols-outlined text-[20px]">close</span>
                </button>
            </div>

            <!-- Booking Summary Pill -->
            <div class="my-4 p-3 bg-emerald-50/70 border border-emerald-200 rounded-xl text-xs flex items-center justify-between">
                <div>
                    <span class="text-emerald-800 font-semibold block text-[11px] uppercase">Pasajero Titular:</span>
                    <strong class="text-emerald-950 text-sm font-bold block" id="waModalPassengerNameEdit">@Model.CustomerName</strong>
                    <div class="text-xs text-emerald-800 flex items-center gap-2 mt-0.5">
                        <span class="font-mono font-bold bg-white px-1.5 py-0.5 rounded border border-emerald-200">@Model.ReferenceCode</span>
                        <span>•</span>
                        <span>@Model.TourName</span>
                    </div>
                </div>
                <div class="text-right">
                    <span class="inline-flex items-center gap-1 text-[11px] font-bold text-emerald-800 bg-emerald-100 px-2.5 py-1 rounded-full border border-emerald-300">
                        <span class="material-symbols-outlined text-[14px]">picture_as_pdf</span> 2 PDFs Listos
                    </span>
                </div>
            </div>

            <!-- Phone Input -->
            <div class="space-y-1.5 mb-4">
                <label class="block text-xs font-bold text-on-surface uppercase tracking-wider flex items-center justify-between">
                    <span>Número de WhatsApp del Cliente *</span>
                    <span class="text-[11px] text-outline font-normal">Perú (+51)</span>
                </label>
                <div class="relative">
                    <span class="absolute left-3.5 top-2.5 text-xs font-bold text-emerald-700 bg-emerald-100 px-1.5 py-0.5 rounded">🇵🇪 +51</span>
                    <input type="tel" id="waModalPhoneInputEdit" oninput="updateWaMessagePreviewEdit()" class="w-full pl-20 pr-4 py-2.5 rounded-xl border border-outline-variant focus:border-[#25D366] focus:ring-1 focus:ring-[#25D366] text-sm text-on-surface bg-white font-mono font-bold" placeholder="987654321" required />
                </div>
            </div>

            <!-- PDFs Included Checklist & Download Links -->
            <div class="p-3 bg-surface-container-low rounded-xl border border-outline-variant/60 space-y-2 mb-4 text-xs">
                <div class="font-bold text-on-surface flex items-center gap-1.5">
                    <span class="material-symbols-outlined text-primary text-[18px]">attach_file</span>
                    Archivos PDF incluidos para la reserva:
                </div>
                <div class="space-y-1.5">
                    <div class="flex items-center justify-between bg-white p-2 rounded-lg border border-outline-variant/50">
                        <div class="flex items-center gap-2">
                            <span class="material-symbols-outlined text-red-600 text-[18px]">picture_as_pdf</span>
                            <span class="font-medium text-on-surface">Boleto_Oficial_@(Model.ReferenceCode).pdf</span>
                        </div>
                        <a href="/Admin/DownloadVoucherPdf/@Model.Id" target="_blank" class="text-primary hover:underline font-bold text-[11px] flex items-center gap-0.5 cursor-pointer">
                            <span class="material-symbols-outlined text-[14px]">download</span> Descargar
                        </a>
                    </div>
                    <div class="flex items-center justify-between bg-white p-2 rounded-lg border border-outline-variant/50">
                        <div class="flex items-center gap-2">
                            <span class="material-symbols-outlined text-blue-600 text-[18px]">receipt_long</span>
                            <span class="font-medium text-on-surface" id="waModalReceiptPdfLabelEdit">Boleta_Electronica_SUNAT.pdf</span>
                        </div>
                        <a id="waModalDownloadReceiptBtnEdit" href="/Admin/DownloadReceiptPdf/@Model.Id" target="_blank" class="text-blue-700 hover:underline font-bold text-[11px] flex items-center gap-0.5 cursor-pointer">
                            <span class="material-symbols-outlined text-[14px]">download</span> Descargar
                        </a>
                    </div>
                </div>
            </div>

            <!-- Preview of WhatsApp Message -->
            <div class="space-y-1.5 mb-4">
                <div class="flex items-center justify-between">
                    <label class="block text-xs font-bold text-on-surface uppercase tracking-wider">
                        Mensaje a Enviar por WhatsApp
                    </label>
                    <button type="button" onclick="copyWaMessageToClipboardEdit()" class="text-xs text-primary hover:underline font-semibold flex items-center gap-1 cursor-pointer">
                        <span class="material-symbols-outlined text-[14px]">content_copy</span> Copiar texto
                    </button>
                </div>
                <textarea id="waModalMessagePreviewEdit" rows="4" class="w-full text-xs font-mono p-2.5 rounded-xl border border-outline-variant bg-surface-container-lowest text-on-surface resize-none focus:outline-none" readonly></textarea>
            </div>

            <!-- Notice / Status Area -->
            <div id="waModalStatusNoticeEdit" class="hidden mb-4 p-3 rounded-xl text-xs font-semibold"></div>

            <!-- Actions Buttons -->
            <div class="flex flex-col gap-2 pt-1 border-t border-outline-variant/40">
                <button type="button" id="btnWaDownloadAndOpenEdit" onclick="executeWaDownloadAndOpenEdit()" class="w-full py-3 px-4 bg-[#25D366] hover:bg-[#1EBE5D] text-white rounded-xl font-bold text-xs sm:text-sm flex items-center justify-center gap-2 shadow-md transition-all active:scale-98 cursor-pointer">
                    <span class="material-symbols-outlined text-[20px]">cloud_download</span>
                    <span>Descargar 2 PDFs y Abrir WhatsApp</span>
                </button>
                
                <div class="flex items-center gap-2">
                    <button type="button" id="btnWaShareDirectEdit" onclick="executeWaShareDirectEdit()" class="flex-1 py-2.5 px-3 bg-surface-container-high hover:bg-surface-container text-on-surface border border-outline-variant rounded-xl font-semibold text-xs flex items-center justify-center gap-1.5 transition-all cursor-pointer" title="Compartir archivos PDF directamente">
                        <span class="material-symbols-outlined text-[17px] text-primary">share</span>
                        <span>Compartir Archivos</span>
                    </button>
                    <button type="button" onclick="executeWaOpenOnlyEdit()" class="flex-1 py-2.5 px-3 bg-surface-container-high hover:bg-surface-container text-on-surface border border-outline-variant rounded-xl font-semibold text-xs flex items-center justify-center gap-1.5 transition-all cursor-pointer" title="Abrir WhatsApp con mensaje de enlaces directos">
                        <span class="material-symbols-outlined text-[17px] text-[#25D366]">chat</span>
                        <span>Solo Chat con Enlaces</span>
                    </button>
                    <button type="button" onclick="closeSendWhatsAppModalEdit()" class="px-4 py-2.5 rounded-xl border border-outline-variant hover:bg-surface-container text-xs font-bold text-secondary transition-all cursor-pointer">
                        Cerrar
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- FORMULARIO OCULTO PARA REACTIVAR -->
<form asp-action="ReactivateBooking" method="post" id="reactivateForm" class="hidden">
    @Html.AntiForgeryToken()
    <input type="hidden" name="id" value="@Model.Id" />
</form>

<script>
    function openCancelModal() {
        document.getElementById('cancelBookingModal')?.classList.remove('hidden');
    }
    function closeCancelModal() {
        document.getElementById('cancelBookingModal')?.classList.add('hidden');
    }
    function openDeleteBookingModal() {
        document.getElementById('deleteBookingModal')?.classList.remove('hidden');
    }
    function closeDeleteBookingModal() {
        document.getElementById('deleteBookingModal')?.classList.add('hidden');
    }

    function sendBookingEmailFromEdit() {
        const emailInput = document.getElementById('CustomerEmail') || document.querySelector('input[name="CustomerEmail"]');
        let email = emailInput ? emailInput.value.trim() : '@Model.CustomerEmail';
        const modalInput = document.getElementById('modalBookingEmailInputEdit');
        if (modalInput) {
            modalInput.value = (email && email !== 'manual@agencia.com') ? email : '';
        }
        const statusDiv = document.getElementById('modalSendEmailStatusEdit');
        if (statusDiv) {
            statusDiv.className = 'hidden mb-4 p-3 rounded-xl text-xs font-semibold';
            statusDiv.innerHTML = '';
        }
        const btn = document.getElementById('btnConfirmSendEmailEdit');
        const btnText = document.getElementById('btnConfirmSendEmailTextEdit');
        if (btn) {
            btn.disabled = false;
            btn.classList.remove('opacity-50', 'cursor-not-allowed');
        }
        if (btnText) btnText.innerText = 'Enviar Correo con los 2 PDFs';

        document.getElementById('sendEmailModalEdit')?.classList.remove('hidden');
        if (modalInput) setTimeout(() => modalInput.focus(), 50);
    }

    function closeSendEmailModalEdit() {
        document.getElementById('sendEmailModalEdit')?.classList.add('hidden');
    }

    function executeSendEmailFromModalEdit() {
        const modalInput = document.getElementById('modalBookingEmailInputEdit');
        const email = modalInput ? modalInput.value.trim() : '';

        if (!email || !email.includes('@@')) {
            alert('Por favor ingrese un correo electrónico válido.');
            if (modalInput) modalInput.focus();
            return;
        }

        const btn = document.getElementById('btnConfirmSendEmailEdit');
        const btnText = document.getElementById('btnConfirmSendEmailTextEdit');
        const statusDiv = document.getElementById('modalSendEmailStatusEdit');

        if (btn) {
            btn.disabled = true;
            btn.classList.add('opacity-50', 'cursor-not-allowed');
        }
        if (btnText) btnText.innerText = 'Generando PDFs y enviando...';

        if (statusDiv) {
            statusDiv.className = 'mb-4 p-3 rounded-xl text-xs font-semibold bg-blue-50 text-blue-900 border border-blue-200 flex items-center gap-2';
            statusDiv.innerHTML = '<span class="material-symbols-outlined text-[18px] animate-spin">progress_activity</span> Generando Boleto de Viaje PDF y adjuntando comprobante oficial...';
        }

        const formData = new FormData();
        formData.append('id', '@Model.Id');
        formData.append('email', email);

        fetch('/Admin/ResendBookingEmail', {
            method: 'POST',
            body: formData
        })
        .then(res => res.json())
        .then(data => {
            if (data.success) {
                if (statusDiv) {
                    statusDiv.className = 'mb-4 p-3 rounded-xl text-xs font-semibold bg-emerald-50 text-emerald-900 border border-emerald-300 flex items-center gap-2';
                    statusDiv.innerHTML = `<span class="material-symbols-outlined text-[18px] text-emerald-600">check_circle</span> <span>${data.message}</span>`;
                }
                if (btnText) btnText.innerText = '✓ Enviado';
                showEditToast(data.message, 'success');
                const pageEmailInput = document.getElementById('CustomerEmail') || document.querySelector('input[name="CustomerEmail"]');
                if (pageEmailInput) pageEmailInput.value = email;
                setTimeout(() => {
                    closeSendEmailModalEdit();
                }, 1800);
            } else {
                if (statusDiv) {
                    statusDiv.className = 'mb-4 p-3 rounded-xl text-xs font-semibold bg-red-50 text-red-900 border border-red-300 flex items-center gap-2';
                    statusDiv.innerHTML = `<span class="material-symbols-outlined text-[18px] text-red-600">error</span> <span>${data.message}</span>`;
                }
                if (btn) {
                    btn.disabled = false;
                    btn.classList.remove('opacity-50', 'cursor-not-allowed');
                }
                if (btnText) btnText.innerText = 'Reintentar Envío';
                showEditToast(data.message, 'error');
            }
        })
        .catch(err => {
            if (statusDiv) {
                statusDiv.className = 'mb-4 p-3 rounded-xl text-xs font-semibold bg-red-50 text-red-900 border border-red-300 flex items-center gap-2';
                statusDiv.innerHTML = '<span class="material-symbols-outlined text-[18px] text-red-600">error</span> Error de conexión al servidor al enviar correo.';
            }
            if (btn) {
                btn.disabled = false;
                btn.classList.remove('opacity-50', 'cursor-not-allowed');
            }
            if (btnText) btnText.innerText = 'Reintentar Envío';
            showEditToast('Error de conexión al enviar correo.', 'error');
        });
    }

    let currentWaDataEdit = {
        bookingId: '@Model.Id',
        rawPhone: '@(Model.CustomerPhone ?? "")',
        customerName: '@(Model.CustomerName?.Replace("'", "\\'") ?? "Estimado(a) Cliente")',
        refCode: '@Model.ReferenceCode',
        tourTitle: '@(Model.TourName?.Replace("'", "\\'") ?? "Tour")',
        travelDate: '@Model.TravelDate.ToString("dd/MM/yyyy")',
        voucherPdfUrl: '',
        receiptPdfUrl: '',
        hasReceipt: false,
        receiptSeriesNumber: ''
    };

    function openSendWhatsAppModalEdit() {
        const phoneInputForm = document.getElementById('CustomerPhone') || document.querySelector('input[name="CustomerPhone"]');
        let currentPhone = phoneInputForm ? phoneInputForm.value.trim() : currentWaDataEdit.rawPhone;

        let digits = currentPhone.replace(/\D/g, '');
        if (digits.startsWith('51') && digits.length === 11) {
            digits = digits.substring(2);
        }
        const modalPhoneInput = document.getElementById('waModalPhoneInputEdit');
        if (modalPhoneInput) modalPhoneInput.value = digits;

        const statusDiv = document.getElementById('waModalStatusNoticeEdit');
        if (statusDiv) {
            statusDiv.className = 'hidden';
            statusDiv.innerHTML = '';
        }

        updateWaMessagePreviewEdit();
        document.getElementById('sendWhatsAppModalEdit')?.classList.remove('hidden');

        fetch('/Admin/GetBookingWhatsAppShareData/@Model.Id')
            .then(res => res.json())
            .then(data => {
                if (data && data.success) {
                    currentWaDataEdit.voucherPdfUrl = data.voucherPdfUrl;
                    currentWaDataEdit.receiptPdfUrl = data.receiptPdfUrl;
                    currentWaDataEdit.hasReceipt = data.hasReceipt;
                    currentWaDataEdit.receiptSeriesNumber = data.receiptSeriesNumber;

                    if (data.receiptSeriesNumber) {
                        const lbl = document.getElementById('waModalReceiptPdfLabelEdit');
                        if (lbl) lbl.innerText = `Boleta_${data.receiptSeriesNumber}.pdf`;
                    }
                    updateWaMessagePreviewEdit();
                }
            })
            .catch(() => {});
    }

    function updateWaMessagePreviewEdit() {
        const voucherUrl = currentWaDataEdit.voucherPdfUrl || `${window.location.origin}/Booking/DownloadVoucherPdf/@Model.Id`;
        const receiptLine = currentWaDataEdit.hasReceipt && currentWaDataEdit.receiptPdfUrl
            ? `\n• *Boleta de Venta Electrónica (PDF):* ${currentWaDataEdit.receiptPdfUrl}`
            : '';

        const msg = `¡Hola *${currentWaDataEdit.customerName}*! Le saluda Turismo Chilón.\n\n` +
                    `Le confirmamos que su reserva para el tour *${currentWaDataEdit.tourTitle}* programada para el *${currentWaDataEdit.travelDate}* se encuentra CONFIRMADA.\n\n` +
                    `• *Código de Reserva:* ${currentWaDataEdit.refCode}\n\n` +
                    `*Descarga de Comprobantes Oficiales en PDF:*\n` +
                    `• *Boleto Oficial de Viaje (PDF):* ${voucherUrl}` +
                    receiptLine + `\n\n` +
                    `Punto de salida: Jr. 2 de Mayo 569, Cajamarca (presentarse 15 min antes con DNI físico).\n` +
                    `¡Gracias por confiar en Turismo Chilón!`;

        const previewArea = document.getElementById('waModalMessagePreviewEdit');
        if (previewArea) previewArea.value = msg;
    }

    function closeSendWhatsAppModalEdit() {
        document.getElementById('sendWhatsAppModalEdit')?.classList.add('hidden');
    }

    function executeWaDownloadAndOpenEdit() {
        const phoneInput = document.getElementById('waModalPhoneInputEdit');
        let digits = (phoneInput ? phoneInput.value.trim() : '').replace(/\D/g, '');
        if (!digits) {
            alert('Por favor ingrese el número de teléfono o WhatsApp del cliente.');
            if (phoneInput) phoneInput.focus();
            return;
        }
        if (digits.length === 9 && digits.startsWith('9')) {
            digits = '51' + digits;
        }

        const previewArea = document.getElementById('waModalMessagePreviewEdit');
        const msg = previewArea ? previewArea.value : '';

        downloadFileUrlEdit('/Admin/DownloadVoucherPdf/@Model.Id', 'Boleto_Oficial_@(Model.ReferenceCode).pdf');

        if (currentWaDataEdit.hasReceipt) {
            const receiptName = currentWaDataEdit.receiptSeriesNumber ? `Boleta_${currentWaDataEdit.receiptSeriesNumber}.pdf` : 'Boleta_Venta_SUNAT.pdf';
            setTimeout(() => {
                downloadFileUrlEdit('/Admin/DownloadReceiptPdf/@Model.Id', receiptName);
            }, 400);
        }

        const statusDiv = document.getElementById('waModalStatusNoticeEdit');
        if (statusDiv) {
            statusDiv.className = 'mb-4 p-3 rounded-xl text-xs font-semibold bg-emerald-50 text-emerald-900 border border-emerald-300 block';
            statusDiv.innerHTML = '<span class="material-symbols-outlined text-[18px] text-emerald-600 align-middle">check_circle</span> ¡2 PDFs descargados! Abriendo WhatsApp... Envíe el mensaje y adjunte (📎) los PDFs.';
        }

        setTimeout(() => {
            window.open(`https://wa.me/${digits}?text=${encodeURIComponent(msg)}`, '_blank');
        }, 700);
    }

    function downloadFileUrlEdit(url, filename) {
        const a = document.createElement('a');
        a.href = url;
        a.download = filename;
        document.body.appendChild(a);
        a.click();
        setTimeout(() => a.remove(), 300);
    }

    async function executeWaShareDirectEdit() {
        const previewArea = document.getElementById('waModalMessagePreviewEdit');
        const msg = previewArea ? previewArea.value : '';

        try {
            const filesToShare = [];
            const voucherRes = await fetch('/Admin/DownloadVoucherPdf/@Model.Id');
            const voucherBlob = await voucherRes.blob();
            filesToShare.push(new File([voucherBlob], 'Boleto_Oficial_@(Model.ReferenceCode).pdf', { type: 'application/pdf' }));

            if (currentWaDataEdit.hasReceipt) {
                try {
                    const receiptRes = await fetch('/Admin/DownloadReceiptPdf/@Model.Id');
                    const receiptBlob = await receiptRes.blob();
                    const rName = currentWaDataEdit.receiptSeriesNumber ? `Boleta_${currentWaDataEdit.receiptSeriesNumber}.pdf` : 'Boleta_Venta_SUNAT.pdf';
                    filesToShare.push(new File([receiptBlob], rName, { type: 'application/pdf' }));
                } catch {}
            }

            if (navigator.canShare && navigator.canShare({ files: filesToShare })) {
                await navigator.share({
                    title: 'Boleto y Boleta @(Model.ReferenceCode) - Turismo Chilón',
                    text: msg,
                    files: filesToShare
                });
                closeSendWhatsAppModalEdit();
                return;
            }
        } catch (e) {
            console.log('WebShare not supported or cancelled', e);
        }

        executeWaDownloadAndOpenEdit();
    }

    function executeWaOpenOnlyEdit() {
        const phoneInput = document.getElementById('waModalPhoneInputEdit');
        let digits = (phoneInput ? phoneInput.value.trim() : '').replace(/\D/g, '');
        if (!digits) {
            alert('Por favor ingrese el número de teléfono o WhatsApp del cliente.');
            if (phoneInput) phoneInput.focus();
            return;
        }
        if (digits.length === 9 && digits.startsWith('9')) {
            digits = '51' + digits;
        }

        const previewArea = document.getElementById('waModalMessagePreviewEdit');
        const msg = previewArea ? previewArea.value : '';
        window.open(`https://wa.me/${digits}?text=${encodeURIComponent(msg)}`, '_blank');
    }

    function copyWaMessageToClipboardEdit() {
        const previewArea = document.getElementById('waModalMessagePreviewEdit');
        if (!previewArea) return;
        navigator.clipboard.writeText(previewArea.value).then(() => {
            showEditToast('Mensaje copiado al portapapeles.', 'success');
        });
    }

    function showEditToast(message, type) {
        let container = document.getElementById('editToastContainer');
        if (!container) {
            container = document.createElement('div');
            container.id = 'editToastContainer';
            container.className = 'fixed bottom-5 right-5 z-[100] flex flex-col gap-2 max-w-md';
            document.body.appendChild(container);
        }
        const toast = document.createElement('div');
        const bgClass = type === 'success' ? 'bg-emerald-700 text-white' :
                        type === 'error' ? 'bg-red-700 text-white' : 'bg-secondary text-white';
        toast.className = `${bgClass} p-4 rounded-xl shadow-2xl border border-white/20 text-sm font-semibold flex items-center gap-2 transition-all duration-300 transform translate-y-2 opacity-0`;
        toast.innerHTML = `<span class="material-symbols-outlined text-[20px]">${type === 'success' ? 'check_circle' : type === 'error' ? 'error' : 'mail'}</span> <span>${message}</span>`;
        container.appendChild(toast);
        setTimeout(() => toast.classList.remove('translate-y-2', 'opacity-0'), 10);
        setTimeout(() => {
            toast.classList.add('opacity-0', 'translate-y-2');
            setTimeout(() => toast.remove(), 400);
        }, 4500);
    }
</script>
