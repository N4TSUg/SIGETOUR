@model SIGETOUR.API.Models.EditBookingViewModel
@using SIGETOUR.API.Core.Entities
@{
    ViewData["Title"] = "Editar Reserva " + Model.ReferenceCode;
    Layout = "_AdminLayout";
    bool isCancelled = Model.Status == BookingStatus.Cancelled;
    var tours = ViewBag.Tours as IEnumerable<TourPackage> ?? Enumerable.Empty<TourPackage>();
    var toursJson = tours.Select(t => new {
        id = t.Id.ToString(),
        title = t.Title,
        price = t.BasePrice,
        duration = t.Duration ?? "Día completo",
        shifts = t.Shifts != null ? t.Shifts.Where(s => s.IsActive).Select(s => s.ShiftName).ToList() : new List<string>()
    });
}

<div class="px-4 sm:px-6 lg:px-8 py-8 w-full max-w-9xl mx-auto">

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="mb-6 p-4 rounded-xl bg-primary/10 border border-primary/20 text-primary flex items-center gap-3">
            <span class="material-symbols-outlined text-[22px]">check_circle</span>
            <span class="font-semibold text-body-md">@TempData["SuccessMessage"]</span>
        </div>
    }

    @if (isCancelled)
    {
        <div class="mb-6 p-4 rounded-xl bg-red-50 border border-red-200 text-red-700 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
            <div class="flex items-center gap-3">
                <span class="material-symbols-outlined text-3xl shrink-0">cancel</span>
                <div>
                    <h3 class="font-bold text-body-lg">Esta reserva se encuentra ANULADA / CANCELADA</h3>
                    <p class="text-xs text-red-600 mt-0.5">Los cupos se encuentran liberados del despacho operativo y vehículos.</p>
                </div>
            </div>
            <button type="button" onclick="document.getElementById('reactivateForm').submit()" class="px-4 py-2 bg-red-600 hover:bg-red-700 text-white rounded-lg text-label-md font-bold transition-all shadow-sm flex items-center gap-1.5 self-start sm:self-auto cursor-pointer">
                <span class="material-symbols-outlined text-[18px]">restore</span>
                Reactivar Reserva
            </button>
        </div>
    }

<form asp-action="EditBooking" method="post" id="editBookingForm">
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="ReferenceCode" />
    <input type="hidden" asp-for="AdditionalPassengersJson" id="AdditionalPassengersJson" />

    <!-- Page Header -->
    <div class="sm:flex sm:justify-between sm:items-center mb-8">
      <div class="mb-4 sm:mb-0 flex items-center gap-3">
        <a href="@Url.Action("Bookings", "Admin")" class="p-2 rounded-full hover:bg-surface-container-low transition-colors text-on-surface-variant cursor-pointer" title="Volver al listado de reservas">
          <span class="material-symbols-outlined text-[24px]">arrow_back</span>
        </a>
        <div>
          <h1 class="text-headline-md font-headline-md font-bold text-on-surface flex items-center gap-3">
            Editar Reserva <span class="text-primary font-mono bg-surface-container-low px-2 rounded">@Model.ReferenceCode</span>
          </h1>
          <p class="text-body-md text-on-surface-variant flex items-center gap-2">
            <span class="material-symbols-outlined text-[18px] text-primary">tour</span>
            Tour actual: <span class="font-bold text-on-surface" id="headerTourTitle">@Model.TourName</span>
          </p>
        </div>
      </div>
      <div class="flex gap-2 items-center">
        @if (!isCancelled)
        {
          <button type="button" onclick="openCancelModal()" class="bg-surface-container border border-red-300 text-red-600 hover:bg-red-50 transition-colors font-label-md px-4 py-2.5 rounded-lg flex items-center gap-2 shadow-sm font-bold cursor-pointer" title="Anular esta reserva">
            <span class="material-symbols-outlined text-[18px]">cancel</span>
            Anular Reserva
          </button>
        }
        else
        {
          <button type="button" onclick="document.getElementById('reactivateForm').submit()" class="bg-surface-container border border-green-300 text-green-700 hover:bg-green-50 transition-colors font-label-md px-4 py-2.5 rounded-lg flex items-center gap-2 shadow-sm font-bold cursor-pointer" title="Reactivar reserva">
            <span class="material-symbols-outlined text-[18px]">restore</span>
            Reactivar Reserva
          </button>
        }
        <button type="submit" class="bg-primary text-on-primary hover:bg-[#0e5a52] transition-colors font-label-md px-6 py-2.5 rounded-lg flex items-center gap-2 shadow-sm font-bold cursor-pointer">
          <span class="material-symbols-outlined text-[18px]">save</span>
          Guardar Cambios
        </button>
      </div>
    </div>

    <!-- MAIN GRID -->
    <div class="grid grid-cols-1 xl:grid-cols-3 gap-6">

      <!-- LEFT COLUMN: Operations & Contact -->
      <div class="xl:col-span-2 space-y-6">

        <!-- 1. Operational Details -->
        <div class="bg-surface-container-lowest rounded-2xl border border-outline-variant shadow-xs overflow-hidden">
          <div class="px-6 py-4 border-b border-outline-variant bg-surface-bright flex flex-wrap justify-between items-center gap-2">
            <h2 class="text-title-md font-title-md font-bold text-on-surface flex items-center gap-2">
              <span class="material-symbols-outlined text-primary">calendar_clock</span>
              Detalles Operativos de la Salida
            </h2>
            <div class="flex items-center gap-2">
              <label class="text-label-sm font-bold text-on-surface-variant">Estado:</label>
              <select asp-for="Status" class="py-1 px-3 rounded-lg border border-outline-variant font-bold text-label-sm focus:outline-none focus:ring-2 focus:ring-primary @(Model.Status == BookingStatus.Confirmed ? "bg-green-50 text-green-800 border-green-300" : (Model.Status == BookingStatus.Pending ? "bg-yellow-50 text-yellow-800 border-yellow-300" : "bg-red-50 text-red-800 border-red-300"))">
                <option value="Confirmed">Confirmada</option>
                <option value="Pending">Pendiente</option>
                <option value="Cancelled">Anulada / Cancelada</option>
              </select>
            </div>
          </div>
          <div class="p-6">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">

              <!-- SELECTOR DE TOUR / CIRCUITO -->
              <div class="col-span-1 md:col-span-3 pb-4 border-b border-outline-variant/60">
                <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-1 mb-1.5">
                  <label class="block text-label-md font-label-md text-on-surface font-bold flex items-center gap-2">
                    <span class="material-symbols-outlined text-primary text-[20px]">tour</span>
                    Circuito / Paquete Turístico Asignado <span class="text-tertiary">*</span>
                  </label>
                  <span class="text-xs text-outline" id="tourPriceBadge">Tarifa individual base: S/ @Model.TourBasePrice.ToString("F2")</span>
                </div>
                <div>
                  <select asp-for="TourPackageId" id="tourPackageSelect" onchange="onTourChanged(this)" class="w-full py-2.5 px-3 bg-surface-bright border border-outline-variant rounded-lg text-body-md font-bold text-on-surface focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent cursor-pointer">
                    @foreach (var t in tours)
                    {
                      <option value="@t.Id" data-price="@t.BasePrice" data-title="@t.Title" selected="@(t.Id == Model.TourPackageId)">
                        @t.Title — S/ @t.BasePrice.ToString("F2") (@(t.Duration ?? "Día completo"))
                      </option>
                    }
                  </select>
                </div>
                <p class="text-xs text-outline mt-1.5">Si el cliente desea cambiar de tour, selecciona la nueva ruta aquí. Se actualizarán los turnos y la tarifa correspondiente.</p>
              </div>

              <!-- FECHA DE RECORRIDO -->
              <div>
                <label class="block text-label-md font-label-md text-on-surface font-semibold mb-1.5">Fecha de Recorrido</label>
                <input asp-for="TravelDate" type="date" class="w-full pl-3 pr-3 py-2 bg-surface-bright border border-outline-variant rounded-lg text-body-md font-body-md text-on-surface focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent" />
              </div>
              
              <!-- TURNO OPERATIVO -->
              <div>
                <label class="block text-label-md font-label-md text-on-surface font-semibold mb-1.5">Turno Operativo</label>
                <div class="grid grid-cols-2 gap-3" id="shiftsContainer">
                  @if (Model.AvailableShifts.Any())
                  {
                      foreach (var shift in Model.AvailableShifts)
                      {
                          <label class="relative flex items-center justify-center p-3 border rounded-lg cursor-pointer transition-all hover:bg-surface-container-low @(Model.ShiftName == shift ? "border-primary bg-primary/5" : "border-outline-variant")">
                            <input type="radio" asp-for="ShiftName" value="@shift" class="sr-only" onchange="onShiftRadioChanged(this)" />
                            <span class="text-label-md font-label-md font-bold text-center">@shift</span>
                          </label>
                      }
                  }
                  else
                  {
                      <label class="relative flex items-center justify-center p-3 border rounded-lg cursor-pointer transition-all hover:bg-surface-container-low border-primary bg-primary/5">
                        <input type="radio" asp-for="ShiftName" value="Turno Único" class="sr-only" checked onchange="onShiftRadioChanged(this)" />
                        <span class="text-label-md font-label-md font-bold text-center">Turno Único</span>
                      </label>
                  }
                </div>
              </div>

              <!-- PUNTO DE EMBARQUE -->
              <div>
                <label class="block text-label-md font-label-md text-on-surface font-semibold mb-1.5">Punto de Embarque</label>
                <select asp-for="BoardingPoint" class="w-full py-2 px-3 bg-surface-bright border border-outline-variant rounded-lg text-body-md font-body-md text-on-surface focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent">
                  <option value="Agencia Central">Agencia Central</option>
                  <option value="Hotel Centro Histórico">Hotel (Recojo coordinado)</option>
                  <option value="Plaza de Armas">Plaza de Armas</option>
                  <option value="Aeropuerto Mayor General FAP Armando Revoredo">Aeropuerto</option>
                </select>
              </div>
            </div>
          </div>
        </div>

        <!-- 2. Passenger Manifest -->
        <div class="bg-surface-container-lowest rounded-2xl border border-outline-variant shadow-xs overflow-hidden">
          <div class="px-6 py-4 border-b border-outline-variant bg-surface-bright flex justify-between items-center">
            <h2 class="text-title-md font-title-md font-bold text-on-surface flex items-center gap-2">
              <span class="material-symbols-outlined text-primary">groups</span>
              Manifiesto de Pasajeros
            </h2>
            <div class="flex items-center gap-3">
              <span class="text-label-sm font-label-sm text-secondary bg-surface-container py-1 px-2 rounded-lg" id="passenger-count-badge">@Model.TotalPassengers Pasajeros</span>
              <button type="button" onclick="addPassengerRow()" class="text-primary hover:text-primary-container text-label-sm font-bold flex items-center gap-1 transition-colors cursor-pointer">
                <span class="material-symbols-outlined text-[18px]">person_add</span> Agregar
              </button>
            </div>
          </div>
          
          <div class="p-6 space-y-4" id="passengers-container">
            <!-- TITULAR -->
            <div class="passenger-card p-4 rounded-xl border-2 border-primary/20 bg-[#f8fafc] relative">
              <div class="flex items-center justify-between mb-3 border-b border-outline-variant/40 pb-2">
                <div class="flex items-center gap-2">
                  <span class="material-symbols-outlined text-primary">how_to_reg</span>
                  <span class="text-title-sm font-title-sm text-primary font-bold">Pasajero Titular (Contacto)</span>
                </div>
              </div>

              <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                <div class="md:col-span-2">
                  <label class="block text-label-sm font-label-sm text-outline font-semibold mb-1">Nombre Completo <span class="text-tertiary">*</span></label>
                  <input asp-for="CustomerName" class="w-full py-1.5 px-3 rounded-lg border border-outline-variant bg-surface-container-lowest text-body-md font-body-md text-on-surface focus:ring-2 focus:ring-primary focus:outline-none" required />
                </div>
                <div>
                  <label class="block text-label-sm font-label-sm text-outline font-semibold mb-1">DNI / Pasaporte <span class="text-tertiary">*</span></label>
                  <input asp-for="CustomerDni" class="w-full py-1.5 px-3 rounded-lg border border-outline-variant bg-surface-container-lowest text-body-md font-body-md text-on-surface focus:ring-2 focus:ring-primary focus:outline-none" required />
                </div>
                <div class="md:col-span-1">
                  <label class="block text-label-sm font-label-sm text-outline font-semibold mb-1">Teléfono <span class="text-tertiary">*</span></label>
                  <input asp-for="CustomerPhone" class="w-full py-1.5 px-3 rounded-lg border border-outline-variant bg-surface-container-lowest text-body-md font-body-md text-on-surface focus:ring-2 focus:ring-primary focus:outline-none" required />
                </div>
              </div>
            </div>

            <!-- ADDITIONAL PASSENGERS RENDERED HERE BY JS LATER -->
          </div>
        </div>
      </div>

      <!-- RIGHT COLUMN: Finance & Billing -->
      <div class="space-y-6">
        
        <!-- 3. Payment Status -->
        <div class="bg-surface-container-lowest rounded-2xl border border-outline-variant shadow-xs overflow-hidden">
          <div class="px-6 py-4 border-b border-outline-variant bg-surface-bright">
            <h2 class="text-title-md font-title-md font-bold text-on-surface flex items-center gap-2">
              <span class="material-symbols-outlined text-primary">payments</span>
              Liquidación de Pago
            </h2>
          </div>
          <div class="p-6">
            
            <div class="flex justify-between items-end mb-4 pb-4 border-b border-outline-variant">
              <div>
                <span class="block text-label-sm font-label-sm text-outline">Tarifa Total Calculada</span>
                <div class="flex items-center gap-2">
                  <span class="text-headline-sm font-headline-sm font-extrabold text-on-surface">S/</span>
                  <input type="number" step="0.50" asp-for="TotalAmount" id="TotalAmountHidden" class="w-32 py-1 px-2 text-headline-sm font-headline-sm font-extrabold text-on-surface bg-transparent border-b-2 border-outline-variant focus:border-primary focus:outline-none" oninput="updateDisplayTotal(this.value)" />
                </div>
                <span class="hidden" id="display-total-tariff"></span>
                <input type="hidden" asp-for="TotalPassengers" id="TotalPassengersHidden" />
              </div>
            </div>

            <div class="space-y-4">
              <div class="flex justify-between items-center">
                <span class="text-body-md font-body-md text-on-surface-variant font-medium">Abono Registrado</span>
                <div class="flex items-center gap-2">
                  <span class="text-body-md text-outline">S/</span>
                  <input asp-for="PaidAmount" id="input-paid-amount" type="number" step="0.50" oninput="recalcBalance()" class="w-24 text-right py-1 px-2 rounded border border-outline-variant bg-surface-container-lowest font-bold text-title-sm text-primary focus:ring-1 focus:ring-primary" />
                </div>
              </div>

              <div class="flex justify-between items-center pt-2">
                <span class="text-body-md font-body-md text-on-surface-variant font-bold">Saldo Pendiente</span>
                <span id="display-pending-balance" class="text-title-md font-title-md font-extrabold text-tertiary">
                  S/ @(Model.TotalAmount - Model.PaidAmount)
                </span>
              </div>
            </div>

            <div class="mt-6 pt-5 border-t border-outline-variant">
              <label class="block text-label-sm font-label-sm text-outline font-semibold mb-1.5">Método de Pago (Abono)</label>
              <select asp-for="PaymentMethod" class="w-full py-2 px-3 bg-surface-container-lowest border border-outline-variant rounded-lg text-body-md font-body-md text-on-surface focus:outline-none focus:ring-2 focus:ring-primary mb-3">
                <option value="yape">Yape / Plin Interbancario</option>
                <option value="transferencia">Transferencia BCP / BBVA</option>
                <option value="efectivo">Efectivo (Caja Agencia)</option>
                <option value="tarjeta">POS Tarjeta (Niubiz/IziPay)</option>
              </select>

              <label class="block text-label-sm font-label-sm text-outline font-semibold mb-1.5">N° de Operación (Voucher)</label>
              <div class="relative">
                <input asp-for="OperationNumber" class="w-full py-2 px-3 bg-surface-container-lowest border border-outline-variant rounded-lg text-body-md font-body-md text-on-surface focus:outline-none focus:ring-2 focus:ring-primary font-mono" />
              </div>
            </div>
          </div>
        </div>

        <!-- 4. Electronic Billing -->
        <div class="bg-surface-container-lowest rounded-2xl border border-outline-variant shadow-xs overflow-hidden">
          <div class="px-6 py-4 border-b border-outline-variant bg-surface-bright">
            <h2 class="text-title-md font-title-md font-bold text-on-surface flex items-center gap-2">
              <span class="material-symbols-outlined text-primary">receipt_long</span>
              Comprobante de Pago
            </h2>
          </div>
          <div class="p-6 space-y-4">
            <div>
              <label class="block text-label-sm font-label-sm text-outline font-semibold mb-1.5">Tipo de Comprobante</label>
              <select asp-for="InvoiceType" class="w-full py-2 px-3 bg-surface-container-lowest border border-outline-variant rounded-lg text-body-md font-body-md text-on-surface focus:outline-none focus:ring-2 focus:ring-primary">
                <option value="boleta">Boleta de Venta Electrónica</option>
                <option value="factura">Factura Electrónica (RUC)</option>
                <option value="nota">Nota de Venta (Interno)</option>
              </select>
            </div>
            
            <div>
              <label class="block text-label-sm font-label-sm text-outline font-semibold mb-1.5">Serie y Correlativo</label>
              <div class="flex gap-2">
                <input asp-for="InvoiceNumber" class="flex-1 py-2 px-3 bg-surface-container-lowest border border-outline-variant rounded-lg text-body-md font-body-md text-on-surface focus:outline-none focus:ring-2 focus:ring-primary font-mono font-bold" />
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div asp-validation-summary="All" class="text-error text-label-sm font-bold bg-error-container/50 p-3 rounded-lg mt-6 empty:hidden"></div>
</form>
</div>

<!-- MODAL DE ANULACIÓN DE RESERVA -->
<div class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-inverse-surface/70 backdrop-blur-sm transition-opacity duration-200 hidden" id="cancelBookingModal">
    <div class="bg-surface-container-lowest rounded-2xl w-full max-w-lg border border-outline-variant shadow-2xl overflow-hidden transform transition-all duration-200">
        <div class="h-2 w-full bg-red-600"></div>
        <div class="p-6 pb-4 flex items-start justify-between gap-4">
            <div class="flex items-center gap-3">
                <div class="w-12 h-12 rounded-xl bg-red-100 border border-red-200 flex items-center justify-center text-red-600 shrink-0">
                    <span class="material-symbols-outlined text-[28px]">warning</span>
                </div>
                <div>
                    <h3 class="text-headline-sm font-bold text-on-surface leading-snug">¿Confirmas anular esta reserva?</h3>
                    <span class="text-label-sm text-red-600 font-bold tracking-wider uppercase">Código @Model.ReferenceCode</span>
                </div>
            </div>
            <button class="p-1.5 rounded-lg text-on-surface-variant hover:bg-surface-container transition-colors cursor-pointer" onclick="closeCancelModal()" type="button">
                <span class="material-symbols-outlined">close</span>
            </button>
        </div>
        <div class="px-6 py-4 space-y-4">
            <p class="text-body-md text-on-surface leading-relaxed">
                Estás a punto de anular la reserva a nombre de <strong class="font-bold text-primary">@Model.CustomerName</strong> para el tour <strong class="font-bold" id="modalTourName">@Model.TourName</strong>.
            </p>
            <div class="p-4 rounded-xl bg-red-50 border border-red-200 text-body-sm text-red-800 space-y-1">
                <div class="flex items-center gap-1.5 font-bold">
                    <span class="material-symbols-outlined text-[18px]">info</span>
                    <span>Consecuencias operativas:</span>
                </div>
                <ul class="list-disc list-inside text-xs space-y-0.5 pl-1">
                    <li>La reserva pasará al estado <strong>Cancelado</strong>.</li>
                    <li>Los @Model.TotalPassengers cupos quedarán liberados inmediatamente del despacho.</li>
                    <li>Podrás reactivar la reserva en cualquier momento si fue un error.</li>
                </ul>
            </div>
        </div>
        <div class="p-6 pt-4 bg-surface-container-high/20 border-t border-outline-variant/40 flex flex-col-reverse sm:flex-row justify-end gap-3">
            <button class="px-5 py-2.5 rounded-lg border border-outline-variant bg-surface-container-lowest text-on-surface font-label-md font-bold hover:bg-surface-container transition-all cursor-pointer" onclick="closeCancelModal()" type="button">Volver</button>
            <form asp-action="CancelBooking" method="post" id="cancelBookingForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <button type="submit" class="flex items-center gap-2 px-5 py-2.5 rounded-lg bg-red-600 text-white font-label-md font-bold shadow-sm transition-all hover:bg-red-700 cursor-pointer">
                    <span class="material-symbols-outlined text-[18px]">cancel</span>
                    <span>Sí, Anular Reserva</span>
                </button>
            </form>
        </div>
    </div>
</div>

<!-- FORMULARIO OCULTO PARA REACTIVAR -->
<form asp-action="ReactivateBooking" method="post" id="reactivateForm" class="hidden">
    @Html.AntiForgeryToken()
    <input type="hidden" name="id" value="@Model.Id" />
</form>

<script>
    const allTours = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(toursJson));

    function onTourChanged(select) {
        const tourId = select.value;
        const selectedTour = allTours.find(t => t.id === tourId);
        if (!selectedTour) return;

        // Actualizar título del header y modal
        const headerEl = document.getElementById('headerTourTitle');
        if (headerEl) headerEl.innerText = selectedTour.title;
        const modalEl = document.getElementById('modalTourName');
        if (modalEl) modalEl.innerText = selectedTour.title;

        // Actualizar etiqueta de precio individual
        const priceBadge = document.getElementById('tourPriceBadge');
        if (priceBadge) priceBadge.innerText = `Tarifa individual base: S/ ${parseFloat(selectedTour.price).toFixed(2)}`;

        // Recalcular Total según cantidad de pasajeros
        const totalPax = parseInt(document.getElementById('TotalPassengersHidden')?.value || '1', 10);
        const newTotal = (selectedTour.price * totalPax);
        const totalInput = document.getElementById('TotalAmountHidden');
        if (totalInput) {
            totalInput.value = newTotal.toFixed(2);
            updateDisplayTotal(newTotal);
        }

        // Actualizar turnos dinámicamente
        const shiftsContainer = document.getElementById('shiftsContainer');
        if (shiftsContainer) {
            shiftsContainer.innerHTML = '';
            if (selectedTour.shifts && selectedTour.shifts.length > 0) {
                selectedTour.shifts.forEach((shift, idx) => {
                    const label = document.createElement('label');
                    label.className = `relative flex items-center justify-center p-3 border rounded-lg cursor-pointer transition-all hover:bg-surface-container-low ${idx === 0 ? 'border-primary bg-primary/5' : 'border-outline-variant'}`;
                    label.innerHTML = `
                        <input type="radio" name="ShiftName" value="${shift}" class="sr-only" ${idx === 0 ? 'checked' : ''} onchange="onShiftRadioChanged(this)" />
                        <span class="text-label-md font-label-md font-bold text-center">${shift}</span>
                    `;
                    shiftsContainer.appendChild(label);
                });
            } else {
                shiftsContainer.innerHTML = `
                    <label class="relative flex items-center justify-center p-3 border rounded-lg cursor-pointer transition-all hover:bg-surface-container-low border-primary bg-primary/5">
                        <input type="radio" name="ShiftName" value="Turno Único" class="sr-only" checked onchange="onShiftRadioChanged(this)" />
                        <span class="text-label-md font-label-md font-bold text-center">Turno Único</span>
                    </label>
                `;
            }
        }
    }

    function onShiftRadioChanged(radio) {
        document.querySelectorAll('#shiftsContainer label').forEach(lbl => {
            lbl.classList.remove('border-primary', 'bg-primary/5');
            lbl.classList.add('border-outline-variant');
        });
        radio.closest('label').classList.remove('border-outline-variant');
        radio.closest('label').classList.add('border-primary', 'bg-primary/5');
    }

    function openCancelModal() {
        document.getElementById('cancelBookingModal')?.classList.remove('hidden');
    }
    function closeCancelModal() {
        document.getElementById('cancelBookingModal')?.classList.add('hidden');
    }

    function initEditBooking() {
        loadExtraPassengers();
        recalcBalance();

        // Hook into form submit to save extra passengers
        document.getElementById('editBookingForm')?.addEventListener('submit', function() {
            saveExtraPassengersToJson();
        });
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initEditBooking);
    } else {
        initEditBooking();
    }

    function loadExtraPassengers() {
        const jsonField = document.getElementById('AdditionalPassengersJson');
        let loadedCount = 0;
        if (jsonField && jsonField.value) {
            try {
                const passengers = JSON.parse(jsonField.value);
                if (Array.isArray(passengers)) {
                    passengers.forEach(p => {
                        addPassengerRow(p.Name || '', p.Dni || '', p.Phone || '', false);
                        loadedCount++;
                    });
                }
            } catch (e) {
                console.error('Error parsing extra passengers:', e);
            }
        }

        // Auto-render companion cards if TotalPassengers > 1 (e.g. from online bookings where AdditionalPassengersJson was empty)
        const totalPaxHidden = document.getElementById('TotalPassengersHidden');
        const totalPax = parseInt(totalPaxHidden ? totalPaxHidden.value : '1', 10) || 1;
        const neededExtras = totalPax - 1;
        while (loadedCount < neededExtras) {
            addPassengerRow('', '', '', false);
            loadedCount++;
        }

        updatePassengerCount(false);
    }

    function renumberCompanions() {
        const container = document.getElementById('passengers-container');
        const rows = container.querySelectorAll('.extra-passenger-row');
        rows.forEach((row, idx) => {
            const num = idx + 2;
            const badge = row.querySelector('.companion-num');
            if (badge) badge.textContent = num;
            const title = row.querySelector('.companion-title');
            if (title) title.textContent = 'Acompañante ' + num;
        });
        updatePassengerCount(true);
    }

    function addPassengerRow(name = '', dni = '', phone = '', recalculatePrice = true) {
        const container = document.getElementById('passengers-container');
        const count = container.querySelectorAll('.extra-passenger-row').length + 2;
        
        const div = document.createElement('div');
        div.className = 'extra-passenger-row passenger-card p-4 rounded-xl border border-outline-variant bg-surface-bright relative mt-4';
        div.innerHTML = `
            <div class="flex items-center justify-between mb-3 border-b border-outline-variant/40 pb-2">
                <div class="flex items-center gap-2">
                  <span class="companion-num w-6 h-6 rounded-full bg-secondary text-on-secondary flex items-center justify-center text-label-sm font-bold">${count}</span>
                  <span class="companion-title text-title-sm font-title-sm text-on-surface font-bold">Acompañante ${count}</span>
                </div>
                <button type="button" class="btn-remove-companion p-1 text-tertiary hover:bg-error-container rounded-md transition-colors flex items-center gap-1 text-label-sm font-label-sm cursor-pointer">
                  <span class="material-symbols-outlined text-[16px]">delete</span>
                  <span>Retirar</span>
                </button>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                <div class="md:col-span-2">
                  <label class="block text-label-sm font-label-sm text-outline font-semibold mb-1">Nombre Completo</label>
                  <input type="text" class="p-name w-full py-1.5 px-3 rounded-lg border border-outline-variant bg-surface-container-lowest text-body-md font-body-md text-on-surface focus:ring-2 focus:ring-primary focus:outline-none" placeholder="Nombre y Apellidos del acompañante" />
                </div>
                <div>
                  <label class="block text-label-sm font-label-sm text-outline font-semibold mb-1">DNI / Pasaporte</label>
                  <input type="text" class="p-dni w-full py-1.5 px-3 rounded-lg border border-outline-variant bg-surface-container-lowest text-body-md font-body-md text-on-surface focus:ring-2 focus:ring-primary focus:outline-none" placeholder="N° Documento" />
                </div>
                <div class="md:col-span-1">
                  <label class="block text-label-sm font-label-sm text-outline font-semibold mb-1">Teléfono</label>
                  <input type="text" class="p-phone w-full py-1.5 px-3 rounded-lg border border-outline-variant bg-surface-container-lowest text-body-md font-body-md text-on-surface focus:ring-2 focus:ring-primary focus:outline-none" placeholder="Opcional" />
                </div>
            </div>
        `;

        div.querySelector('.p-name').value = name || '';
        div.querySelector('.p-dni').value = dni || '';
        div.querySelector('.p-phone').value = phone || '';

        div.querySelector('.btn-remove-companion').addEventListener('click', function() {
            div.remove();
            renumberCompanions();
        });

        container.appendChild(div);
        updatePassengerCount(recalculatePrice);
    }

    function escapeQuotes(str) {
        if (!str) return '';
        return str.replace(/"/g, '&quot;').replace(/'/g, '&#039;');
    }

    function updatePassengerCount(recalculatePrice = false) {
        const total = document.querySelectorAll('.extra-passenger-row').length + 1;
        const countBadge = document.getElementById('passenger-count-badge');
        if (countBadge) countBadge.innerText = total + ' Pasajeros';
        const totalHidden = document.getElementById('TotalPassengersHidden');
        if (totalHidden) totalHidden.value = total;

        if (recalculatePrice) {
            const tourSelect = document.getElementById('tourPackageSelect');
            if (tourSelect) {
                const selectedOpt = tourSelect.options[tourSelect.selectedIndex];
                const price = parseFloat(selectedOpt?.getAttribute('data-price') || '0');
                if (price > 0) {
                    const totalInput = document.getElementById('TotalAmountHidden');
                    if (totalInput) {
                        totalInput.value = (price * totalPaxCount(total)).toFixed(2);
                        updateDisplayTotal(totalInput.value);
                    }
                }
            }
        }
    }

    function totalPaxCount(num) {
        return num || 1;
    }

    function saveExtraPassengersToJson() {
        const rows = document.querySelectorAll('.extra-passenger-row');
        const passengers = [];
        rows.forEach(row => {
            const name = row.querySelector('.p-name')?.value?.trim() || '';
            const dni = row.querySelector('.p-dni')?.value?.trim() || '';
            const phone = row.querySelector('.p-phone')?.value?.trim() || '';
            passengers.push({
                Name: name,
                Dni: dni,
                Phone: phone
            });
        });
        const hiddenInput = document.getElementById('AdditionalPassengersJson');
        if (hiddenInput) {
            hiddenInput.value = JSON.stringify(passengers);
        }
    }

    function updateDisplayTotal(val) {
        document.getElementById('display-total-tariff').innerText = 'S/ ' + parseFloat(val).toFixed(2);
        recalcBalance();
    }

    function recalcBalance() {
        const total = parseFloat(document.getElementById('TotalAmountHidden').value) || 0;
        const paid = parseFloat(document.getElementById('input-paid-amount').value) || 0;
        const balance = Math.max(0, total - paid);
        
        const balanceEl = document.getElementById('display-pending-balance');
        balanceEl.innerText = 'S/ ' + balance.toFixed(2);
        
        if (balance === 0) {
            balanceEl.classList.remove('text-tertiary');
            balanceEl.classList.add('text-primary');
        } else {
            balanceEl.classList.remove('text-primary');
            balanceEl.classList.add('text-tertiary');
        }
    }
</script>
