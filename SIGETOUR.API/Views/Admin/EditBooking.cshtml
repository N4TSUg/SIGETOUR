            <!-- Actions Buttons -->
            <div class="flex flex-col gap-2 pt-1 border-t border-outline-variant/40">
                <button type="button" id="btnWaOpenDirectEdit" onclick="executeWaOpenOnlyEdit()" class="w-full py-3 px-4 bg-[#25D366] hover:bg-[#1EBE5D] text-white rounded-xl font-bold text-xs sm:text-sm flex items-center justify-center gap-2 shadow-md transition-all active:scale-98 cursor-pointer">
                    <span class="material-symbols-outlined text-[20px]">chat</span>
                    <span>Abrir WhatsApp con Enlaces Directos</span>
                </button>
                
                <div class="flex items-center gap-2">
                    <button type="button" id="btnWaDownloadAndOpenEdit" onclick="executeWaDownloadAndOpenEdit()" class="flex-1 py-2.5 px-3 bg-surface-container-high hover:bg-surface-container text-on-surface border border-outline-variant rounded-xl font-semibold text-xs flex items-center justify-center gap-1.5 transition-all cursor-pointer" title="Descargar ambos archivos PDF a la computadora y abrir WhatsApp">
                        <span class="material-symbols-outlined text-[17px] text-primary">cloud_download</span>
                        <span>Descargar PDFs y Abrir</span>
                    </button>
                    <button type="button" onclick="closeSendWhatsAppModalEdit()" class="px-4 py-2.5 rounded-xl border border-outline-variant hover:bg-surface-container text-xs font-bold text-secondary transition-all cursor-pointer">
                        Cerrar
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- MODAL DE REACTIVACIÓN Y REGULARIZACIÓN DE RESERVA (CAJA Y SUNAT) -->
@{
    var remainingToPay = Math.Max(0m, Model.TotalAmount - Model.PaidAmount);
}
<div class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-inverse-surface/70 backdrop-blur-sm transition-opacity duration-200 hidden" id="reactivateBookingModal">
    <div class="bg-surface-container-lowest rounded-2xl w-full max-w-xl border border-outline-variant shadow-2xl overflow-hidden transform transition-all duration-200 max-h-[92vh] overflow-y-auto">
        <div class="h-2 w-full bg-emerald-600"></div>
        <div class="p-6 pb-4 flex items-start justify-between gap-4 border-b border-outline-variant/50">
            <div class="flex items-center gap-3">
                <div class="w-12 h-12 rounded-xl bg-emerald-100 border border-emerald-200 flex items-center justify-center text-emerald-700 shrink-0">
                    <span class="material-symbols-outlined text-[28px]">restore</span>
                </div>
                <div>
                    <h3 class="text-title-md font-bold text-on-surface leading-snug">Reactivar Reserva y Regularizar</h3>
                    <span class="text-label-sm text-emerald-700 font-bold tracking-wider uppercase">Localizador @Model.ReferenceCode • @Model.TotalPassengers pax</span>
                </div>
            </div>
            <button class="p-1.5 rounded-lg text-on-surface-variant hover:bg-surface-container transition-colors cursor-pointer" onclick="closeReactivateModal()" type="button">
                <span class="material-symbols-outlined">close</span>
            </button>
        </div>

        <form asp-action="ReactivateBooking" method="post" id="reactivateForm">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.Id" />

            <div class="px-6 py-4 space-y-4">
                <div class="p-3.5 rounded-xl bg-surface-container-low border border-outline-variant/60 space-y-1.5 text-body-sm">
                    <div class="flex items-center justify-between">
                        <span class="text-outline">Titular / Circuito:</span>
                        <span class="font-bold text-on-surface">@Model.CustomerName • @Model.TourName</span>
                    </div>
                    <div class="flex items-center justify-between">
                        <span class="text-outline">Tarifa Total / Abonado Vigente:</span>
                        <span class="font-bold text-on-surface">S/ @Model.TotalAmount.ToString("N2") <span class="text-outline font-normal">(Abonado: S/ @Model.PaidAmount.ToString("N2"))</span></span>
                    </div>
                    <div class="flex items-center justify-between">
                        <span class="text-outline">Saldo Pendiente por Cobrar:</span>
                        <span class="font-bold @(remainingToPay > 0 ? "text-amber-700" : "text-emerald-700")">S/ @remainingToPay.ToString("N2")</span>
                    </div>
                </div>

                @if (remainingToPay > 0)
                {
                    <div class="p-4 rounded-xl bg-emerald-50/70 border border-emerald-200 space-y-3">
                        <div class="flex items-center gap-2 font-bold text-emerald-950 text-body-sm">
                            <span class="material-symbols-outlined text-[19px] text-emerald-700">point_of_sale</span>
                            <span>1. Regularización de Cobro y Caja General</span>
                        </div>
                        <div class="space-y-2 text-xs">
                            <label class="flex items-start gap-2.5 p-2.5 rounded-lg border border-emerald-300 bg-white cursor-pointer">
                                <input type="radio" name="reactivateMode" value="confirm_with_payment" checked onchange="toggleReactivateMode()" class="mt-0.5 text-primary focus:ring-primary" />
                                <span>
                                    <strong class="block font-bold text-on-surface">Reactivar como Confirmada y Registrar Nuevo Cobro en Caja (S/ @remainingToPay.ToString("N2"))</strong>
                                    <span class="text-outline">Registra automáticamente el Ingreso en el turno activo de Caja General y deja la reserva pagada al 100%.</span>
                                </span>
                            </label>
                            <label class="flex items-start gap-2.5 p-2.5 rounded-lg border border-emerald-300 bg-white cursor-pointer">
                                <input type="radio" name="reactivateMode" value="pending" onchange="toggleReactivateMode()" class="mt-0.5 text-primary focus:ring-primary" />
                                <span>
                                    <strong class="block font-bold text-on-surface">Reactivar como Pendiente de Pago (Sin movimiento en Caja todavía)</strong>
                                    <span class="text-outline">Separa los @Model.TotalPassengers cupos en la salida para que el pasajero pague posteriormente.</span>
                                </span>
                            </label>
                        </div>

                        <div id="reactivatePaymentFields" class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-1">
                            <div>
                                <label for="reactivatePaymentAmount" class="block text-[11px] font-bold text-emerald-900 mb-1">Monto a cobrar ahora (S/):</label>
                                <input type="number" step="0.50" min="0.50" max="@remainingToPay.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)" name="paymentAmount" id="reactivatePaymentAmount" value="@remainingToPay.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)" class="w-full py-1.5 px-2.5 rounded-lg border border-emerald-300 bg-white text-body-sm font-bold text-on-surface" />
                            </div>
                            <div>
                                <label for="reactivatePaymentMethod" class="block text-[11px] font-bold text-emerald-900 mb-1">Medio de pago:</label>
                                <select name="paymentMethod" id="reactivatePaymentMethod" class="w-full py-1.5 px-2.5 rounded-lg border border-emerald-300 bg-white text-xs font-semibold text-on-surface">
                                    <option value="Efectivo">Efectivo (Caja General)</option>
                                    <option value="Yape / Plin">Yape / Plin</option>
                                    <option value="Transferencia BCP / BBVA">Transferencia Bancaria</option>
                                </select>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <input type="hidden" name="reactivateMode" value="confirm" />
                    <div class="p-3.5 rounded-xl bg-emerald-50 border border-emerald-200 text-xs text-emerald-900">
                        <strong>Pago vigente al 100%:</strong> Esta reserva conserva su monto abonado completo (S/ @Model.PaidAmount.ToString("N2")), por lo que se reactivará directamente como <strong>Confirmada</strong> validando el aforo disponible.
                    </div>
                }

                <div class="p-4 rounded-xl bg-sky-50/70 border border-sky-200 space-y-2">
                    <label class="flex items-start gap-2.5 cursor-pointer">
                        <input type="checkbox" name="reissueSunatReceipt" id="chkReissueSunatReceipt" value="true" checked class="mt-0.5 rounded border-sky-400 text-primary focus:ring-primary" />
                        <span class="text-xs text-sky-950">
                            <strong class="block font-bold">2. Emitir Nueva Boleta / Factura Electrónica en SUNAT (NubeFact)</strong>
                            En SUNAT, un comprobante dado de baja o con Nota de Crédito no se puede reutilizar. Si el comprobante anterior fue anulado, el sistema emitirá automáticamente un nuevo comprobante electrónico con el siguiente correlativo oficial.
                        </span>
                    </label>
                </div>
            </div>

            <div class="p-6 pt-4 bg-surface-container-high/20 border-t border-outline-variant/40 flex flex-col-reverse sm:flex-row justify-end gap-3">
                <button class="px-5 py-2.5 rounded-lg border border-outline-variant bg-surface-container-lowest text-on-surface font-label-md font-bold hover:bg-surface-container transition-all cursor-pointer" onclick="closeReactivateModal()" type="button">Volver</button>
                <button type="submit" class="flex items-center justify-center gap-2 px-5 py-2.5 rounded-lg bg-emerald-600 text-white font-label-md font-bold shadow-sm transition-all hover:bg-emerald-700 cursor-pointer">
                    <span class="material-symbols-outlined text-[18px]">restore</span>
                    <span>Confirmar Reactivación</span>
                </button>
            </div>
        </form>
    </div>
</div>

<!-- FORMULARIO OCULTO PARA EMITIR COMPROBANTE ELECTRÓNICO SUNAT (NUBEFACT) -->
<form asp-action="EmitBookingReceipt" method="post" id="emitReceiptForm" class="hidden">
    @Html.AntiForgeryToken()
    <input type="hidden" name="id" value="@Model.Id" />
    <input type="hidden" name="invoiceType" id="emitReceiptInvoiceTypeInput" value="@Model.InvoiceType" />
</form>

<script>
    function submitEmitReceiptFromEdit() {
        const typeSelect = document.getElementById('InvoiceType');
        const hiddenType = document.getElementById('emitReceiptInvoiceTypeInput');
        if (typeSelect && hiddenType) {
            hiddenType.value = typeSelect.value;
        }
        const btn = document.getElementById('btnEmitSunatReceipt');
        if (btn) {
            btn.disabled = true;
            btn.innerHTML = '<span class="material-symbols-outlined text-[18px] animate-spin">refresh</span> <span>Emitiendo en SUNAT / NubeFact...</span>';
        }
        document.getElementById('emitReceiptForm')?.submit();
    }
    function openReactivateModal() {
        document.getElementById('reactivateBookingModal')?.classList.remove('hidden');
    }
    function closeReactivateModal() {
        document.getElementById('reactivateBookingModal')?.classList.add('hidden');
    }
    function toggleReactivateMode() {
        const mode = document.querySelector('input[name="reactivateMode"]:checked')?.value;
        const fields = document.getElementById('reactivatePaymentFields');
        const chkSunat = document.getElementById('chkReissueSunatReceipt');
        if (fields) {
            fields.classList.toggle('hidden', mode === 'pending');
        }
        if (chkSunat) {
            chkSunat.checked = mode !== 'pending';
        }
    }
    function openCancelModal() {
        document.getElementById('cancelBookingModal')?.classList.remove('hidden');
    }
    function closeCancelModal() {
        document.getElementById('cancelBookingModal')?.classList.add('hidden');
    }
    function openRefundModal() {
        document.getElementById('refundBookingModal')?.classList.remove('hidden');
    }
    function closeRefundModal() {
        document.getElementById('refundBookingModal')?.classList.add('hidden');
    }
    function toggleCancelRefundAmount() {
        const selected = document.querySelector('input[name="refundType"]:checked')?.value;
        const partialBox = document.getElementById('partialRefundInputBox');
        const methodBox = document.getElementById('refundMethodBox');
        const chkCash = document.getElementById('chkRegisterCashRefund');
        if (partialBox) {
            partialBox.classList.toggle('hidden', selected !== 'partial');
        }
        if (methodBox) {
            methodBox.classList.toggle('hidden', selected === 'none');
        }
        if (chkCash && selected === 'none') {
            chkCash.checked = false;
        } else if (chkCash && (selected === 'full' || selected === 'partial')) {
            chkCash.checked = true;
        }
    }
    function setCancelPenaltyPreset(factor) {
        const basePaid = parseFloat('@Model.PaidAmount.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)') || 0;
        const input = document.getElementById('cancelRefundAmountInput');
        if (input) {
            input.value = (Math.round(basePaid * factor * 100) / 100).toFixed(2);
        }
    }
    function openDeleteBookingModal() {
        document.getElementById('deleteBookingModal')?.classList.remove('hidden');
    }
    function closeDeleteBookingModal() {
        document.getElementById('deleteBookingModal')?.classList.add('hidden');
    }

    function sendBookingEmailFromEdit() {
        const emailInput = document.getElementById('CustomerEmail') || document.querySelector('input[name="CustomerEmail"]');
        let email = emailInput ? emailInput.value.trim() : '@Model.CustomerEmail';
        const modalInput = document.getElementById('modalBookingEmailInputEdit');
        if (modalInput) {
            modalInput.value = (email && email !== 'manual@agencia.com') ? email : '';
        }
        const statusDiv = document.getElementById('modalSendEmailStatusEdit');
        if (statusDiv) {
            statusDiv.className = 'hidden mb-4 p-3 rounded-xl text-xs font-semibold';
            statusDiv.innerHTML = '';
        }
        const btn = document.getElementById('btnConfirmSendEmailEdit');
        const btnText = document.getElementById('btnConfirmSendEmailTextEdit');
        if (btn) {
            btn.disabled = false;
            btn.classList.remove('opacity-50', 'cursor-not-allowed');
        }
        if (btnText) btnText.innerText = 'Enviar Correo con los 2 PDFs';

        document.getElementById('sendEmailModalEdit')?.classList.remove('hidden');
        if (modalInput) setTimeout(() => modalInput.focus(), 50);
    }

    function closeSendEmailModalEdit() {
        document.getElementById('sendEmailModalEdit')?.classList.add('hidden');
    }

    function executeSendEmailFromModalEdit() {
        const modalInput = document.getElementById('modalBookingEmailInputEdit');
        const email = modalInput ? modalInput.value.trim() : '';

        if (!email || !email.includes('@@')) {
            alert('Por favor ingrese un correo electrónico válido.');
            if (modalInput) modalInput.focus();
            return;
        }

        const btn = document.getElementById('btnConfirmSendEmailEdit');
        const btnText = document.getElementById('btnConfirmSendEmailTextEdit');
        const statusDiv = document.getElementById('modalSendEmailStatusEdit');

        if (btn) {
            btn.disabled = true;
            btn.classList.add('opacity-50', 'cursor-not-allowed');
        }
        if (btnText) btnText.innerText = 'Generando PDFs y enviando...';

        if (statusDiv) {
            statusDiv.className = 'mb-4 p-3 rounded-xl text-xs font-semibold bg-blue-50 text-blue-900 border border-blue-200 flex items-center gap-2';
            statusDiv.innerHTML = '<span class="material-symbols-outlined text-[18px] animate-spin">progress_activity</span> Generando Boleto de Viaje PDF y adjuntando comprobante oficial...';
        }

        const formData = new FormData();
        formData.append('id', '@Model.Id');
        formData.append('email', email);

        fetch('/Admin/ResendBookingEmail', {
            method: 'POST',
            body: formData
        })
        .then(res => res.json())
        .then(data => {
            if (data.success) {
                if (statusDiv) {
                    statusDiv.className = 'mb-4 p-3 rounded-xl text-xs font-semibold bg-emerald-50 text-emerald-900 border border-emerald-300 flex items-center gap-2';
                    statusDiv.innerHTML = `<span class="material-symbols-outlined text-[18px] text-emerald-600">check_circle</span> <span>${data.message}</span>`;
                }
                if (btnText) btnText.innerText = '✓ Enviado';
                showEditToast(data.message, 'success');
                const pageEmailInput = document.getElementById('CustomerEmail') || document.querySelector('input[name="CustomerEmail"]');
                if (pageEmailInput) pageEmailInput.value = email;
                setTimeout(() => {
                    closeSendEmailModalEdit();
                }, 1800);
            } else {
                if (statusDiv) {
                    statusDiv.className = 'mb-4 p-3 rounded-xl text-xs font-semibold bg-red-50 text-red-900 border border-red-300 flex items-center gap-2';
                    statusDiv.innerHTML = `<span class="material-symbols-outlined text-[18px] text-red-600">error</span> <span>${data.message}</span>`;
                }
                if (btn) {
                    btn.disabled = false;
                    btn.classList.remove('opacity-50', 'cursor-not-allowed');
                }
                if (btnText) btnText.innerText = 'Reintentar Envío';
                showEditToast(data.message, 'error');
            }
        })
        .catch(err => {
            if (statusDiv) {
                statusDiv.className = 'mb-4 p-3 rounded-xl text-xs font-semibold bg-red-50 text-red-900 border border-red-300 flex items-center gap-2';
                statusDiv.innerHTML = '<span class="material-symbols-outlined text-[18px] text-red-600">error</span> Error de conexión al servidor al enviar correo.';
            }
            if (btn) {
                btn.disabled = false;
                btn.classList.remove('opacity-50', 'cursor-not-allowed');
            }
            if (btnText) btnText.innerText = 'Reintentar Envío';
            showEditToast('Error de conexión al enviar correo.', 'error');
        });
    }

    let currentWaDataEdit = {
        bookingId: '@Model.Id',
        rawPhone: '@(Model.CustomerPhone ?? "")',
        customerName: '@(Model.CustomerName?.Replace("'", "\\'") ?? "Estimado(a) Cliente")',
        refCode: '@Model.ReferenceCode',
        tourTitle: '@(Model.TourName?.Replace("'", "\\'") ?? "Tour")',
        travelDate: '@Model.TravelDate.ToString("dd/MM/yyyy")',
        voucherPdfUrl: '',
        receiptPdfUrl: '',
        hasReceipt: false,
        receiptSeriesNumber: ''
    };

    function openSendWhatsAppModalEdit() {
        const phoneInputForm = document.getElementById('CustomerPhone') || document.querySelector('input[name="CustomerPhone"]');
        let currentPhone = phoneInputForm ? phoneInputForm.value.trim() : currentWaDataEdit.rawPhone;

        let digits = currentPhone.replace(/\D/g, '');
        if (digits.startsWith('51') && digits.length === 11) {
            digits = digits.substring(2);
        }
        const modalPhoneInput = document.getElementById('waModalPhoneInputEdit');
        if (modalPhoneInput) modalPhoneInput.value = digits;

        const statusDiv = document.getElementById('waModalStatusNoticeEdit');
        if (statusDiv) {
            statusDiv.className = 'hidden';
            statusDiv.innerHTML = '';
        }

        updateWaMessagePreviewEdit();
        document.getElementById('sendWhatsAppModalEdit')?.classList.remove('hidden');

        fetch('/Admin/GetBookingWhatsAppShareData/@Model.Id')
            .then(res => res.json())
            .then(data => {
                if (data && data.success) {
                    currentWaDataEdit.voucherPdfUrl = data.voucherPdfUrl;
                    currentWaDataEdit.receiptPdfUrl = data.receiptPdfUrl;
                    currentWaDataEdit.hasReceipt = data.hasReceipt;
                    currentWaDataEdit.receiptSeriesNumber = data.receiptSeriesNumber;

                    if (data.receiptSeriesNumber) {
                        const lbl = document.getElementById('waModalReceiptPdfLabelEdit');
                        if (lbl) lbl.innerText = `Boleta_${data.receiptSeriesNumber}.pdf`;
                    }
                    updateWaMessagePreviewEdit();
                }
            })
            .catch(() => {});
    }

    function updateWaMessagePreviewEdit() {
        const voucherUrl = currentWaDataEdit.voucherPdfUrl || `${window.location.origin}/b/@Model.ReferenceCode`;
        const receiptLine = currentWaDataEdit.hasReceipt && currentWaDataEdit.receiptPdfUrl
            ? `\n• *Boleta de Venta SUNAT:* ${currentWaDataEdit.receiptPdfUrl}`
            : '';

        const msg = `¡Hola *${currentWaDataEdit.customerName}*! Le saluda Turismo Chilón.\n\n` +
                    `Le confirmamos que su reserva para el tour *${currentWaDataEdit.tourTitle}* programada para el *${currentWaDataEdit.travelDate}* se encuentra CONFIRMADA.\n\n` +
                    `• *Código de Reserva:* ${currentWaDataEdit.refCode}\n\n` +
                    `*Comprobantes Oficiales en PDF:*\n` +
                    `• *Boleto Oficial de Viaje:* ${voucherUrl}` +
                    receiptLine + `\n\n` +
                    `• *Punto de salida:* Jr. 2 de Mayo 569, Cajamarca (presentarse 15 min antes con DNI físico).\n` +
                    `¡Gracias por confiar en Turismo Chilón!`;

        const previewArea = document.getElementById('waModalMessagePreviewEdit');
        if (previewArea) previewArea.value = msg;
    }

    function closeSendWhatsAppModalEdit() {
        document.getElementById('sendWhatsAppModalEdit')?.classList.add('hidden');
    }

    function executeWaDownloadAndOpenEdit() {
        const phoneInput = document.getElementById('waModalPhoneInputEdit');
        let digits = (phoneInput ? phoneInput.value.trim() : '').replace(/\D/g, '');
        if (!digits) {
            alert('Por favor ingrese el número de teléfono o WhatsApp del cliente.');
            if (phoneInput) phoneInput.focus();
            return;
        }
        if (digits.length === 9 && digits.startsWith('9')) {
            digits = '51' + digits;
        }

        const previewArea = document.getElementById('waModalMessagePreviewEdit');
        const msg = previewArea ? previewArea.value : '';

        downloadFileUrlEdit('/Admin/DownloadVoucherPdf/@Model.Id', 'Boleto_Oficial_@(Model.ReferenceCode).pdf');

        if (currentWaDataEdit.hasReceipt) {
            const receiptName = currentWaDataEdit.receiptSeriesNumber ? `Boleta_${currentWaDataEdit.receiptSeriesNumber}.pdf` : 'Boleta_Venta_SUNAT.pdf';
            setTimeout(() => {
                downloadFileUrlEdit('/Admin/DownloadReceiptPdf/@Model.Id', receiptName);
            }, 400);
        }

        const statusDiv = document.getElementById('waModalStatusNoticeEdit');
        if (statusDiv) {
            statusDiv.className = 'mb-4 p-3 rounded-xl text-xs font-semibold bg-emerald-50 text-emerald-900 border border-emerald-300 block';
            statusDiv.innerHTML = '<span class="material-symbols-outlined text-[18px] text-emerald-600 align-middle">check_circle</span> ¡2 PDFs descargados! Abriendo WhatsApp... Envíe el mensaje y adjunte (📎) los PDFs.';
        }

        setTimeout(() => {
            window.open(`https://wa.me/${digits}?text=${encodeURIComponent(msg)}`, '_blank');
        }, 700);
    }

    function downloadFileUrlEdit(url, filename) {
        const a = document.createElement('a');
        a.href = url;
        a.download = filename;
        document.body.appendChild(a);
        a.click();
        setTimeout(() => a.remove(), 300);
    }

    async function executeWaShareDirectEdit() {
        const previewArea = document.getElementById('waModalMessagePreviewEdit');
        const msg = previewArea ? previewArea.value : '';

        try {
            const filesToShare = [];
            const voucherRes = await fetch('/Admin/DownloadVoucherPdf/@Model.Id');
            const voucherBlob = await voucherRes.blob();
            filesToShare.push(new File([voucherBlob], 'Boleto_Oficial_@(Model.ReferenceCode).pdf', { type: 'application/pdf' }));

            if (currentWaDataEdit.hasReceipt) {
                try {
                    const receiptRes = await fetch('/Admin/DownloadReceiptPdf/@Model.Id');
                    const receiptBlob = await receiptRes.blob();
                    const rName = currentWaDataEdit.receiptSeriesNumber ? `Boleta_${currentWaDataEdit.receiptSeriesNumber}.pdf` : 'Boleta_Venta_SUNAT.pdf';
                    filesToShare.push(new File([receiptBlob], rName, { type: 'application/pdf' }));
                } catch {}
            }

            if (navigator.canShare && navigator.canShare({ files: filesToShare })) {
                await navigator.share({
                    title: 'Boleto y Boleta @(Model.ReferenceCode) - Turismo Chilón',
                    text: msg,
                    files: filesToShare
                });
                closeSendWhatsAppModalEdit();
                return;
            }
        } catch (e) {
            console.log('WebShare not supported or cancelled', e);
        }

        executeWaDownloadAndOpenEdit();
    }

    function executeWaOpenOnlyEdit() {
        const phoneInput = document.getElementById('waModalPhoneInputEdit');
        let digits = (phoneInput ? phoneInput.value.trim() : '').replace(/\D/g, '');
        if (!digits) {
            alert('Por favor ingrese el número de teléfono o WhatsApp del cliente.');
            if (phoneInput) phoneInput.focus();
            return;
        }
        if (digits.length === 9 && digits.startsWith('9')) {
            digits = '51' + digits;
        }

        const previewArea = document.getElementById('waModalMessagePreviewEdit');
        const msg = previewArea ? previewArea.value : '';
        window.open(`https://wa.me/${digits}?text=${encodeURIComponent(msg)}`, '_blank');
    }

    function copyWaMessageToClipboardEdit() {
        const previewArea = document.getElementById('waModalMessagePreviewEdit');
        if (!previewArea) return;
        navigator.clipboard.writeText(previewArea.value).then(() => {
            showEditToast('Mensaje copiado al portapapeles.', 'success');
        });
    }

    function showEditToast(message, type) {
        let container = document.getElementById('editToastContainer');
        if (!container) {
            container = document.createElement('div');
            container.id = 'editToastContainer';
            container.className = 'fixed bottom-5 right-5 z-[100] flex flex-col gap-2 max-w-md';
            document.body.appendChild(container);
        }
        const toast = document.createElement('div');
        const bgClass = type === 'success' ? 'bg-emerald-700 text-white' :
                        type === 'error' ? 'bg-red-700 text-white' : 'bg-secondary text-white';
        toast.className = `${bgClass} p-4 rounded-xl shadow-2xl border border-white/20 text-sm font-semibold flex items-center gap-2 transition-all duration-300 transform translate-y-2 opacity-0`;
        toast.innerHTML = `<span class="material-symbols-outlined text-[20px]">${type === 'success' ? 'check_circle' : type === 'error' ? 'error' : 'mail'}</span> <span>${message}</span>`;
        container.appendChild(toast);
        setTimeout(() => toast.classList.remove('translate-y-2', 'opacity-0'), 10);
        setTimeout(() => {
            toast.classList.add('opacity-0', 'translate-y-2');
            setTimeout(() => toast.remove(), 400);
        }, 4500);
    }
</script>
