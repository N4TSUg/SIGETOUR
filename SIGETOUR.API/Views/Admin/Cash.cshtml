                    <input type="number" step="0.01" min="0.01" name="amount" id="editTxAmount" required class="w-full py-2 px-3 bg-surface-container-low border border-outline-variant rounded-lg text-body-sm font-bold text-on-surface focus:outline-none focus:border-primary" />
