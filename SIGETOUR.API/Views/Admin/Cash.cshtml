<div id="editShiftModal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-inverse-surface/60 backdrop-blur-sm hidden">
    <div class="bg-surface-container-lowest rounded-2xl max-w-md w-full p-6 shadow-2xl border border-outline-variant">
        <div class="flex items-center justify-between border-b border-outline-variant pb-3 mb-4">
            <h3 class="text-title-md font-bold text-on-surface flex items-center gap-2">
                <span class="material-symbols-outlined text-primary">edit</span>
                Modificar Turno de Caja
            </h3>
            <button type="button" onclick="closeEditShiftModal()" class="text-outline hover:text-on-surface p-1 rounded-lg hover:bg-surface-container cursor-pointer">
                <span class="material-symbols-outlined">close</span>
            </button>
        </div>

        <form asp-action="UpdateCashShift" method="post" class="space-y-4">
            @Html.AntiForgeryToken()
            <input type="hidden" name="shiftId" id="editShiftId" />

            <div class="bg-surface-container-low p-3 rounded-xl border border-outline-variant/60 flex items-center justify-between">
                <span class="text-body-sm text-outline font-medium">Turno:</span>
                <span id="editShiftNumber" class="font-bold text-primary font-mono text-body-md"></span>
            </div>

            <div>
                <label class="block text-label-sm font-bold text-on-surface mb-1">Saldo Base Inicial en Efectivo (S/)</label>
                <input type="number" step="0.01" min="0" name="initialAmount" id="editShiftInitialAmount" required class="w-full py-2 px-3 bg-surface-container-low border border-outline-variant rounded-lg text-body-sm font-bold text-on-surface focus:outline-none focus:border-primary" />
                <p class="text-body-xs text-outline mt-1">Modifica este valor si hubo un error de tipeo al aperturar la caja.</p>
            </div>

            <div>
                <label class="block text-label-sm font-bold text-on-surface mb-1">Notas u Observaciones del Turno</label>
                <textarea name="notes" id="editShiftNotes" rows="3" class="w-full py-2 px-3 bg-surface-container-low border border-outline-variant rounded-lg text-body-sm text-on-surface focus:outline-none focus:border-primary" placeholder="Observaciones sobre la apertura o incidencias"></textarea>
            </div>

            <div class="flex items-center justify-end gap-3 pt-3 border-t border-outline-variant">
                <button type="button" onclick="closeEditShiftModal()" class="px-4 py-2 rounded-lg border border-outline text-on-surface font-semibold text-body-sm hover:bg-surface-container transition-colors cursor-pointer">
                    Cancelar
                </button>
                <button type="submit" class="px-5 py-2 rounded-lg bg-primary text-on-primary font-bold text-body-sm hover:bg-primary/90 transition-all flex items-center gap-1.5 shadow-sm cursor-pointer">
                    <span class="material-symbols-outlined text-[18px]">save</span>
                    <span>Actualizar Turno</span>
                </button>
            </div>
        </form>
    </div>
</div>

<!-- ======================================================== -->
<!-- SCRIPTS DE CONTROL DE INTERFAZ Y MODALES                 -->
<!-- ======================================================== -->
<script>
    function openCashReportsModal() {
        document.getElementById('cashReportsModal')?.classList.remove('hidden');
    }
    function closeCashReportsModal() {
        document.getElementById('cashReportsModal')?.classList.add('hidden');
    }

    function openOpenShiftModal() {
        document.getElementById('openShiftModal')?.classList.remove('hidden');
    }
    function closeOpenShiftModal() {
        document.getElementById('openShiftModal')?.classList.add('hidden');
    }

    function openCloseShiftModal() {
        document.getElementById('closeShiftModal')?.classList.remove('hidden');
        calculateDifference();
    }
    function closeCloseShiftModal() {
        document.getElementById('closeShiftModal')?.classList.add('hidden');
        closeConfirmCloseShiftModal();
    }

    function openConfirmCloseShiftModal() {
        const cashVal = document.getElementById('inputActualCash')?.value || '0.00';
        const num = parseFloat(cashVal) || 0;
        const diffText = document.getElementById('diffResultText')?.innerText || 'Caja Cuadrada (S/ 0.00)';
        
        const cashElem = document.getElementById('confirmModalActualCash');
        if (cashElem) cashElem.innerText = 'S/ ' + num.toFixed(2);

        const diffElem = document.getElementById('confirmModalDiffStatus');
        if (diffElem) {
            diffElem.innerText = diffText;
            if (diffText.toLowerCase().includes('faltante')) {
                diffElem.className = 'font-bold text-body-sm text-red-700';
            } else if (diffText.toLowerCase().includes('sobrante')) {
                diffElem.className = 'font-bold text-body-sm text-blue-700';
            } else {
                diffElem.className = 'font-bold text-body-sm text-green-700';
            }
        }

        document.getElementById('confirmCloseShiftModal')?.classList.remove('hidden');
    }

    function closeConfirmCloseShiftModal() {
        document.getElementById('confirmCloseShiftModal')?.classList.add('hidden');
    }

    function submitCloseShiftForm() {
        document.getElementById('closeShiftForm')?.submit();
    }

    function openAddTransactionModal() {
        document.getElementById('addTransactionModal')?.classList.remove('hidden');
    }
    function closeAddTransactionModal() {
        document.getElementById('addTransactionModal')?.classList.add('hidden');
    }

    function openAddPettyExpenseModal() {
        document.getElementById('addPettyExpenseModal')?.classList.remove('hidden');
    }
    function closeAddPettyExpenseModal() {
        document.getElementById('addPettyExpenseModal')?.classList.add('hidden');
    }

    function openReplenishPettyModal() {
        document.getElementById('replenishPettyModal')?.classList.remove('hidden');
    }
    function closeReplenishPettyModal() {
        document.getElementById('replenishPettyModal')?.classList.add('hidden');
    }

    function openUpdatePettyFundModal() {
        document.getElementById('updatePettyFundModal')?.classList.remove('hidden');
    }
    function closeUpdatePettyFundModal() {
        document.getElementById('updatePettyFundModal')?.classList.add('hidden');
    }

    // Funciones para Modales de Edición y Eliminación de Movimientos de Caja
    function openEditTxModal(id, type, category, amount, paymentMethod, referenceCode, description) {
        document.getElementById('editTxId').value = id;
        document.getElementById('editTxType').value = type;
        document.getElementById('editTxCategory').value = category;
        document.getElementById('editTxAmount').value = amount;
        document.getElementById('editTxPaymentMethod').value = paymentMethod;
        document.getElementById('editTxReferenceCode').value = referenceCode;
        document.getElementById('editTxDescription').value = description;
        document.getElementById('editTransactionModal')?.classList.remove('hidden');
    }
    function closeEditTxModal() {
        document.getElementById('editTransactionModal')?.classList.add('hidden');
    }

    function openDeleteTxModal(id, description, amount, type) {
        document.getElementById('deleteTxId').value = id;
        document.getElementById('deleteTxDescription').innerText = description;
        document.getElementById('deleteTxAmount').innerText = 'S/ ' + amount;
        const badge = document.getElementById('deleteTxTypeBadge');
        if (badge) {
            badge.innerText = type;
            badge.className = type === 'Ingreso' ? 'font-bold text-green-700' : 'font-bold text-red-700';
        }
        document.getElementById('deleteTransactionModal')?.classList.remove('hidden');
    }
    function closeDeleteTxModal() {
        document.getElementById('deleteTransactionModal')?.classList.add('hidden');
    }

    function openEditPettyModal(id, movementType, category, voucherType, voucherNumber, supplier, amount, responsible, concept) {
        document.getElementById('editPettyId').value = id;
        document.getElementById('editPettyMovementType').value = movementType;
        document.getElementById('editPettyCategory').value = category;
        document.getElementById('editPettyVoucherType').value = voucherType;
        document.getElementById('editPettyVoucherNumber').value = voucherNumber;
        document.getElementById('editPettySupplier').value = supplier;
        document.getElementById('editPettyAmount').value = amount;
        document.getElementById('editPettyResponsible').value = responsible;
        document.getElementById('editPettyConcept').value = concept;
        document.getElementById('editPettyExpenseModal')?.classList.remove('hidden');
    }
    function closeEditPettyModal() {
        document.getElementById('editPettyExpenseModal')?.classList.add('hidden');
    }

    function openDeletePettyModal(id, concept, amount, voucherType, voucherNumber) {
        document.getElementById('deletePettyId').value = id;
        document.getElementById('deletePettyConcept').innerText = concept;
        document.getElementById('deletePettyAmount').innerText = 'S/ ' + amount;
        document.getElementById('deletePettyVoucher').innerText = voucherType + (voucherNumber ? ' (' + voucherNumber + ')' : '');
        document.getElementById('deletePettyExpenseModal')?.classList.remove('hidden');
    }
    function closeDeletePettyModal() {
        document.getElementById('deletePettyExpenseModal')?.classList.add('hidden');
    }

    function openEditShiftModal(id, number, initialAmount, notes) {
        document.getElementById('editShiftId').value = id;
        document.getElementById('editShiftNumber').innerText = number;
        document.getElementById('editShiftInitialAmount').value = initialAmount;
        document.getElementById('editShiftNotes').value = notes;
        document.getElementById('editShiftModal')?.classList.remove('hidden');
    }
    function closeEditShiftModal() {
        document.getElementById('editShiftModal')?.classList.add('hidden');
    }

    function calculateDifference() {
        const expEl = document.getElementById('expectedCashVal');
        const inputEl = document.getElementById('inputActualCash');
        const diffCard = document.getElementById('diffCard');
        const diffText = document.getElementById('diffResultText');

        if (!expEl || !inputEl || !diffCard || !diffText) return;

        const expected = parseFloat(expEl.getAttribute('data-val') || '0');
        const actual = parseFloat(inputEl.value || '0');
        const diff = actual - expected;

        if (Math.abs(diff) < 0.01) {
            diffCard.className = 'p-3 rounded-lg border text-body-sm font-bold flex items-center justify-between bg-green-50 border-green-200 text-green-800';
            diffText.innerText = 'Caja Cuadrada Perfectamente (S/ 0.00)';
        } else if (diff > 0) {
            diffCard.className = 'p-3 rounded-lg border text-body-sm font-bold flex items-center justify-between bg-amber-50 border-amber-200 text-amber-800';
            diffText.innerText = `Sobrante en Efectivo: + S/ ${diff.toFixed(2)}`;
        } else {
            diffCard.className = 'p-3 rounded-lg border text-body-sm font-bold flex items-center justify-between bg-red-50 border-red-200 text-red-800';
            diffText.innerText = `Faltante en Efectivo: - S/ ${Math.abs(diff).toFixed(2)}`;
        }
    }

    // Cerrar con Escape
    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') {
            closeCashReportsModal();
            closeOpenShiftModal();
            closeCloseShiftModal();
            closeConfirmCloseShiftModal();
            closeAddTransactionModal();
            closeAddPettyExpenseModal();
            closeReplenishPettyModal();
            closeUpdatePettyFundModal();
            closeEditTxModal();
            closeDeleteTxModal();
            closeEditPettyModal();
            closeDeletePettyModal();
            closeEditShiftModal();
        }
    });
</script>
