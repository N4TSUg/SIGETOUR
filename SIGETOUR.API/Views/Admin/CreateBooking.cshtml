@model SIGETOUR.API.Models.EditBookingViewModel
@{
    ViewData["Title"] = "Registrar Nueva Reserva Manual";
    Layout = "_AdminLayout";
}

<div class="px-4 sm:px-6 lg:px-8 py-8 w-full max-w-9xl mx-auto">

<form asp-action="CreateBooking" method="post" id="createBookingForm">
    <!-- Page Header -->
    <div class="sm:flex sm:justify-between sm:items-center mb-8">
      <div class="mb-4 sm:mb-0 flex items-center gap-3">
        <a href="@Url.Action("Bookings", "Admin")" class="p-2 rounded-full hover:bg-surface-container-low transition-colors text-on-surface-variant cursor-pointer" title="Volver al listado de reservas">
          <span class="material-symbols-outlined text-[24px]">arrow_back</span>
        </a>
        <div>
          <h1 class="text-headline-md font-headline-md font-bold text-on-surface flex items-center gap-3">
            Registrar Nueva Reserva
          </h1>
          <p class="text-body-md text-on-surface-variant flex items-center gap-2">
            <span class="material-symbols-outlined text-[18px] text-primary">point_of_sale</span>
            Venta y registro directo de pasajeros en caja o mostrador.
          </p>
        </div>
      </div>
      <div class="flex flex-wrap gap-2 items-center">
        <a href="@Url.Action("Bookings", "Admin")" class="px-4 py-2.5 rounded-lg border border-outline text-on-surface-variant hover:bg-surface-container transition-colors font-label-md cursor-pointer">
          Cancelar
        </a>
        <button type="submit" class="bg-primary text-on-primary hover:bg-[#0e5a52] transition-colors font-label-md px-6 py-2.5 rounded-lg flex items-center gap-2 shadow-sm font-bold cursor-pointer">
          <span class="material-symbols-outlined text-[18px]">save</span>
          Registrar Reserva
        </button>
      </div>
    </div>

    <partial name="_BookingFormFields" model="Model" />

    <div asp-validation-summary="All" class="text-error text-label-sm font-bold bg-error-container/50 p-3 rounded-lg mt-6 empty:hidden"></div>
</form>
</div>
