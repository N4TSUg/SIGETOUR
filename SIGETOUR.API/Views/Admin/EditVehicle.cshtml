@model SIGETOUR.API.Models.VehicleDto
@using SIGETOUR.API.Core.Entities
@{
    bool isCreate = Model.Id == Guid.Empty;
    ViewData["Title"] = isCreate ? "Registrar Vehículo" : "Editar Vehículo " + Model.LicensePlate;
    Layout = "_AdminLayout";
}

<div class="px-4 sm:px-6 lg:px-8 py-8 w-full max-w-9xl mx-auto">
<form asp-action="EditVehicle" method="post" enctype="multipart/form-data">
    <input type="hidden" asp-for="Id" />

    <!-- Header -->
    <div class="sm:flex sm:justify-between sm:items-center mb-8">
        <div class="flex items-center gap-3">
            <a href="@Url.Action("Fleet", "Admin")" class="p-2 rounded-full hover:bg-surface-container-low transition-colors text-on-surface-variant shrink-0">
                <span class="material-symbols-outlined text-[24px]">arrow_back</span>
            </a>
            <div>
                <h1 class="text-headline-md font-headline-md font-bold text-on-surface">
                    @(isCreate ? "Registrar Nueva Unidad Vehicular" : "Editar Vehículo – " + Model.LicensePlate)
                </h1>
                <p class="text-body-md text-on-surface-variant mt-0.5">Ficha técnica oficial para operaciones y despachos.</p>
            </div>
        </div>
        <div class="flex gap-3 mt-4 sm:mt-0">
            <a href="@Url.Action("Fleet", "Admin")" class="px-4 py-2.5 rounded-lg border border-outline text-on-surface-variant hover:bg-surface-container transition-colors font-label-md">Cancelar</a>
            <button type="submit" class="px-6 py-2.5 rounded-lg bg-primary text-on-primary font-label-lg hover:bg-primary/90 transition-all flex items-center gap-2 shadow-md">
                <span class="material-symbols-outlined text-xl">save</span>
                Guardar Cambios
            </button>
        </div>
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div asp-validation-summary="All" class="text-red-700 text-label-sm font-bold bg-red-100 border border-red-200 p-3 rounded-lg mb-6"></div>
    }

    <!-- Main Grid -->
    <div class="grid grid-cols-1 xl:grid-cols-3 gap-6">

        <!-- LEFT: 2/3 width -->
        <div class="xl:col-span-2 space-y-6">

            <!-- SECCIÓN 1: Identificación -->
            <div class="bg-surface-container-lowest rounded-2xl border border-outline-variant shadow-sm overflow-hidden">
                <div class="px-6 py-4 border-b border-outline-variant bg-surface-bright">
                    <h2 class="text-title-md font-bold text-on-surface flex items-center gap-2">
                        <span class="material-symbols-outlined text-primary">directions_bus</span> Identificación del Vehículo
                    </h2>
                </div>
                <div class="p-6 grid grid-cols-1 sm:grid-cols-2 gap-5">
                    <div>
                        <label for="LicensePlate" class="block text-label-sm font-bold text-on-surface-variant mb-1">Placa de Rodaje <span class="text-tertiary">*</span></label>
                        <div class="relative">
                            <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-outline text-[20px]">pin</span>
                            <input id="LicensePlate" asp-for="LicensePlate" class="w-full bg-surface-container-low text-on-surface font-bold tracking-widest pl-10 pr-16 py-2.5 rounded-lg border border-outline-variant focus:border-primary focus:ring-2 focus:ring-primary/20 uppercase outline-none text-body-md" maxlength="8" placeholder="Ej. T7C-841" required />
                            <span class="absolute right-3 top-1/2 -translate-y-1/2 text-label-sm bg-primary-container text-on-primary-container font-bold px-1.5 py-0.5 rounded">PERÚ</span>
                        </div>
                        <span asp-validation-for="LicensePlate" class="text-error text-xs font-semibold mt-1 block"></span>
                    </div>
                    <div>
                        <label for="Model" class="block text-label-sm font-bold text-on-surface-variant mb-1">Marca y Modelo <span class="text-tertiary">*</span></label>
                        <input id="Model" asp-for="Model" class="w-full bg-surface-container-low text-on-surface py-2.5 px-3 rounded-lg border border-outline-variant focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none text-body-md" placeholder="Ej. Mercedes-Benz Sprinter 515" required />
                        <span asp-validation-for="Model" class="text-error text-xs font-semibold mt-1 block"></span>
                    </div>
                    <div>
                        <label for="Category" class="block text-label-sm font-bold text-on-surface-variant mb-1">Categoría</label>
                        <select id="Category" asp-for="Category" class="w-full bg-surface-container-low text-on-surface py-2.5 px-3 rounded-lg border border-outline-variant focus:border-primary outline-none text-body-md">
                            <option value="Van Turística VIP (14 - 19 Pas.)">Van Turística VIP (14 - 19 Pas.)</option>
                            <option value="Minibús (20 - 30 Pas.)">Minibús (20 - 30 Pas.)</option>
                            <option value="Bus Panorámico de 2 pisos">Bus Panorámico de 2 pisos</option>
                            <option value="SUV 4x4 (Servicio Privado)">SUV 4x4 (Servicio Privado)</option>
                        </select>
                        <span asp-validation-for="Category" class="text-error text-xs font-semibold mt-1 block"></span>
                    </div>
                    <div>
                        <label for="ManufactureYear" class="block text-label-sm font-bold text-on-surface-variant mb-1">Año de Fabricación</label>
                        <input id="ManufactureYear" asp-for="ManufactureYear" type="number" min="1990" max="2030" class="w-full bg-surface-container-low text-on-surface py-2.5 px-3 rounded-lg border border-outline-variant focus:border-primary outline-none text-body-md" />
                        <span asp-validation-for="ManufactureYear" class="text-error text-xs font-semibold mt-1 block"></span>
                    </div>
                </div>
            </div>

            <!-- SECCIÓN 2: Datos Técnicos -->
            <div class="bg-surface-container-lowest rounded-2xl border border-outline-variant shadow-sm overflow-hidden">
                <div class="px-6 py-4 border-b border-outline-variant bg-surface-bright">
                    <h2 class="text-title-md font-bold text-on-surface flex items-center gap-2">
                        <span class="material-symbols-outlined text-primary">engineering</span> Datos Técnicos del Motor y Chasis
                    </h2>
                </div>
                <div class="p-6 grid grid-cols-1 sm:grid-cols-2 gap-5">
                    <div>
                        <label for="ChassisNumber" class="block text-label-sm font-bold text-on-surface-variant mb-1">N° VIN / Chasis</label>
                        <input id="ChassisNumber" asp-for="ChassisNumber" class="w-full bg-surface-container-low text-on-surface font-mono py-2.5 px-3 rounded-lg border border-outline-variant focus:border-primary outline-none text-body-md uppercase" maxlength="17" placeholder="Ej. 8AC906653KE284912" />
                    </div>
                    <div>
                        <label for="EngineNumber" class="block text-label-sm font-bold text-on-surface-variant mb-1">N° de Motor</label>
                        <input id="EngineNumber" asp-for="EngineNumber" class="w-full bg-surface-container-low text-on-surface font-mono py-2.5 px-3 rounded-lg border border-outline-variant focus:border-primary outline-none text-body-md uppercase" placeholder="Ej. OM651-955-408921" />
                    </div>
                    <div>
                        <label for="SeatCapacity" class="block text-label-sm font-bold text-on-surface-variant mb-1">Capacidad de Asientos <span class="text-tertiary">*</span></label>
                        <div class="relative">
                            <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-outline text-[20px]">airline_seat_recline_normal</span>
                            <input id="SeatCapacity" asp-for="SeatCapacity" type="number" min="1" max="80" class="w-full bg-surface-container-low text-on-surface font-bold pl-10 py-2.5 px-3 rounded-lg border border-outline-variant focus:border-primary outline-none text-title-sm" required />
                        </div>
                        <span asp-validation-for="SeatCapacity" class="text-error text-xs font-semibold mt-1 block"></span>
                    </div>
                    <div>
                        <label for="Color" class="block text-label-sm font-bold text-on-surface-variant mb-1">Color</label>
                        <input id="Color" asp-for="Color" class="w-full bg-surface-container-low text-on-surface py-2.5 px-3 rounded-lg border border-outline-variant focus:border-primary outline-none text-body-md" placeholder="Ej. Blanco Glaciar" />
                    </div>
                    <div class="sm:col-span-2">
                        <label for="FuelType" class="block text-label-sm font-bold text-on-surface-variant mb-1">Combustible</label>
                        <select id="FuelType" asp-for="FuelType" class="w-full bg-surface-container-low text-on-surface py-2.5 px-3 rounded-lg border border-outline-variant focus:border-primary outline-none text-body-md">
                            <option value="Diésel B5 S-50 (Ultra Bajo Azufre)">Diésel B5 S-50 (Ultra Bajo Azufre)</option>
                            <option value="Gasolina 95/97 Octanos">Gasolina 95/97 Octanos</option>
                            <option value="GNV / GLP">GNV / GLP</option>
                        </select>
                    </div>
                </div>
            </div>

            <!-- SECCIÓN: Equipamiento y Comodidades a Bordo -->
            <div class="bg-surface-container-lowest rounded-2xl border border-outline-variant shadow-sm overflow-hidden">
                <div class="px-6 py-4 border-b border-outline-variant bg-surface-bright flex justify-between items-center">
                    <div>
                        <h2 class="text-title-md font-bold text-on-surface flex items-center gap-2">
                            <span class="material-symbols-outlined text-primary">airport_shuttle</span> Equipamiento y Comodidades a Bordo
                        </h2>
                        <p class="text-xs text-on-surface-variant mt-0.5">Selecciona los servicios y comodidades activas para esta unidad vehicular.</p>
                    </div>
                    <span class="text-label-sm bg-primary-container text-on-primary-container px-2.5 py-1 rounded-lg font-bold">Visible en Catálogo</span>
                </div>
                <div class="p-6">
                    <input type="hidden" name="SelectedEquipmentSubmitted" value="true" />
                    @{
                        var standardAmenities = new List<(string Name, string Icon, string Desc)>
                        {
                            ("Aire Acondicionado / Climatizador", "ac_unit", "Control de temperatura para rutas de altura"),
                            ("Asientos Reclinables Confort", "airline_seat_recline_extra", "Butacas reclinables ergonómicas con cabecera"),
                            ("Puertos de Carga USB", "usb", "Conectores individuales para celulares"),
                            ("Botiquín de Primeros Auxilios", "medical_services", "Botiquín normativo MTC para asistencia a bordo"),
                            ("Extintor de Incendios Reglamentario", "fire_extinguisher", "Extintor PQS certificado y vigente"),
                            ("Micrófono & Audio para Guía", "volume_up", "Sistema de audio para explicaciones turísticas"),
                            ("Maletero Amplio para Equipaje", "luggage", "Compartimiento para mochilas y maletas"),
                            ("Cinturones de Seguridad en Todas las Plazas", "health_and_safety", "Cinturones certificados de 2 y 3 puntos"),
                            ("Suspensión Reforzada para Rutas Andinas", "car_repair", "Adaptado para caminos rurales y curvas"),
                            ("Cortinas de Privacidad / Protección Solar", "curtains", "Protección UV en ventanas laterales")
                        };
                        var currentSelected = Model.SelectedEquipment ?? new List<string>();
                    }
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
                        @foreach (var amenity in standardAmenities)
                        {
                            var isChecked = currentSelected.Any(s => s.Equals(amenity.Name, StringComparison.OrdinalIgnoreCase) || s.Contains(amenity.Name.Split('/')[0].Trim(), StringComparison.OrdinalIgnoreCase));
                            <label class="flex items-start gap-3 p-3.5 rounded-xl border border-outline-variant/70 hover:border-primary/50 hover:bg-surface-container-low/40 transition-colors cursor-pointer group @(isChecked ? "bg-surface-container-low/60 border-primary/40" : "bg-surface-bright/20")">
                                <input type="checkbox" name="SelectedEquipment" value="@amenity.Name" @(isChecked ? "checked" : "") class="mt-1 rounded text-primary focus:ring-primary h-4 w-4 shrink-0" />
                                <div class="flex-1 min-w-0">
                                    <div class="flex items-center gap-1.5 font-bold text-xs text-on-surface group-hover:text-primary transition-colors">
                                        <span class="material-symbols-outlined text-[17px] text-primary shrink-0">@amenity.Icon</span>
                                        <span>@amenity.Name</span>
                                    </div>
                                    <p class="text-[11px] text-on-surface-variant mt-0.5 leading-tight">@amenity.Desc</p>
                                </div>
                            </label>
                        }
                    </div>
                </div>
            </div>

            <!-- SECCIÓN 3: Galería Fotográfica -->
            <div class="bg-surface-container-lowest rounded-2xl border border-outline-variant shadow-sm overflow-hidden">
                <div class="px-6 py-4 border-b border-outline-variant bg-surface-bright flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2">
                    <div>
                        <h2 class="text-title-md font-bold text-on-surface flex items-center gap-2">
                            <span class="material-symbols-outlined text-primary">photo_library</span> Fotografías del Vehículo
                        </h2>
                        <p class="text-xs text-on-surface-variant mt-0.5">Puedes elegir cuál será la <strong>Foto Principal de Portada</strong> con el botón de estrella.</p>
                    </div>
                    @if (Model.ExistingImages != null && Model.ExistingImages.Any()) {
                        <span class="text-label-sm bg-primary-container text-on-primary-container px-2.5 py-1 rounded-lg font-bold shrink-0 self-start sm:self-auto" id="vehicle-images-count-badge">@Model.ExistingImages.Count fotos guardadas</span>
                    }
                </div>
                <div class="p-6 space-y-5">
                    <!-- Existing images grid -->
                    <div id="vehicle-image-preview-container" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                        @if (Model.ExistingImages != null && Model.ExistingImages.Any()) {
                            @foreach (var img in Model.ExistingImages) {
                                <div class="vehicle-image-card relative rounded-xl border @(img.IsCover ? "border-primary ring-2 ring-primary/40 shadow-md" : "border-outline-variant") overflow-hidden bg-surface-container-low group shadow-sm flex flex-col transition-all duration-200" data-image-id="@img.Id">
                                    <div class="relative h-36 w-full overflow-hidden bg-surface-container">
                                        <img src="@img.ImageUrl" alt="Fotografía del vehículo @Model.Model" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-200" />
                                        
                                        <!-- Cover Badge -->
                                        <span class="cover-badge @(img.IsCover ? "" : "hidden") absolute top-2 left-2 px-2.5 py-1 rounded-full bg-primary text-white text-xs font-bold shadow-md flex items-center gap-1 z-10 backdrop-blur-sm">
                                            <span class="material-symbols-outlined text-[15px]" style="font-variation-settings: 'FILL' 1;">star</span>
                                            <span>Principal</span>
                                        </span>

                                        <!-- Hover Overlay -->
                                        <div class="absolute inset-0 bg-black/50 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center gap-2 p-2 z-10">
                                            <button type="button" onclick="setCoverVehicleImage('@Model.Id', '@img.Id', this)" 
                                                    class="set-cover-hover-btn @(img.IsCover ? "hidden" : "") px-3 py-1.5 rounded-lg bg-white text-amber-700 hover:bg-amber-50 font-bold text-xs flex items-center gap-1 shadow-md transition-all active:scale-95 cursor-pointer" 
                                                    title="Establecer como foto principal de portada">
                                                <span class="material-symbols-outlined text-base text-amber-500" style="font-variation-settings: 'FILL' 1;">star</span>
                                                <span>Hacer Principal</span>
                                            </button>
                                            <button type="button" onclick="openDeleteVehicleImageModal('@img.Id', '@Model.Id', this)" class="p-2 rounded-full bg-white text-red-600 hover:bg-red-50 shadow-md transition-all active:scale-95 cursor-pointer" title="Eliminar foto guardada">
                                                <span class="material-symbols-outlined text-base">delete</span>
                                            </button>
                                        </div>
                                    </div>
                                    <div class="p-2.5 bg-surface-container-lowest flex-1 flex flex-col justify-between gap-2">
                                        <span class="text-xs font-semibold text-on-surface truncate block" title="@System.IO.Path.GetFileName(img.ImageUrl)">@System.IO.Path.GetFileName(img.ImageUrl)</span>
                                        <div class="flex items-center justify-between gap-1 pt-1.5 border-t border-outline-variant/40">
                                            <span class="px-2 py-0.5 rounded text-[11px] bg-surface-variant text-on-surface-variant font-bold">Guardada</span>
                                            
                                            <div class="cover-action-slot">
                                                @if (img.IsCover)
                                                {
                                                    <span class="cover-footer-tag px-2.5 py-1 rounded-md text-[11px] bg-primary/10 text-primary font-bold flex items-center gap-1 border border-primary/20">
                                                        <span class="material-symbols-outlined text-[14px]" style="font-variation-settings: 'FILL' 1;">star</span>
                                                        <span>Principal</span>
                                                    </span>
                                                }
                                                else
                                                {
                                                    <button type="button" onclick="setCoverVehicleImage('@Model.Id', '@img.Id', this)" 
                                                            class="set-cover-footer-btn text-[11px] text-amber-700 hover:text-amber-900 font-bold flex items-center gap-1 cursor-pointer bg-amber-50 hover:bg-amber-100 px-2.5 py-1 rounded-md transition-all active:scale-95 border border-amber-200" 
                                                            title="Elegir como imagen principal">
                                                        <span class="material-symbols-outlined text-[14px] text-amber-500" style="font-variation-settings: 'FILL' 1;">star</span>
                                                        <span>Hacer Principal</span>
                                                    </button>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        } else {
                            <div class="col-span-full text-center py-8 text-on-surface-variant text-sm border-2 border-dashed border-outline-variant rounded-lg" id="empty-vehicle-images-msg">
                                Aún no has subido fotografías para esta unidad.
                            </div>
                        }
                    </div>

                    <!-- Upload zone -->
                    <div id="drop-zone" class="relative flex flex-col items-center justify-center w-full h-32 border-2 border-dashed border-primary/40 hover:border-primary rounded-xl cursor-pointer hover:bg-surface-container-low/40 transition-colors bg-surface group text-center p-4 select-none" onclick="document.getElementById('VehicleImages').click()">
                        <input id="VehicleImages" type="file" name="VehicleImages" multiple accept="image/jpeg,image/png,image/webp" class="hidden" onchange="previewImages(this)" />
                        <span class="material-symbols-outlined text-3xl text-primary group-hover:scale-110 transition-transform">cloud_upload</span>
                        <span class="text-body-sm text-on-surface-variant mt-1 text-center">Arrastra fotos aquí o <span class="text-primary underline font-bold">haz clic para examinar</span></span>
                        <span class="text-label-sm text-outline mt-0.5">JPG, PNG, WebP – máx. 10 MB por foto</span>
                    </div>

                    <!-- Preview container -->
                    <div id="image-preview" class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3 hidden"></div>
                </div>
            </div>

            <!-- SECCIÓN 4: Zona de Peligro -->
            @if (!isCreate) {
            <div class="bg-surface-container-lowest rounded-xl border-2 border-tertiary/30 p-6 shadow-sm">
                <div class="flex items-start justify-between flex-col md:flex-row gap-4">
                    <div class="flex items-start gap-3.5">
                        <div class="w-11 h-11 rounded-xl bg-error-container text-tertiary flex items-center justify-center shrink-0">
                            <span class="material-symbols-outlined text-2xl">warning</span>
                        </div>
                        <div>
                            <h3 class="text-title-sm font-bold text-on-surface">Zona de Peligro: Dar de Baja o Desvincular Vehículo @Model.LicensePlate</h3>
                            <p class="text-body-sm text-tertiary mt-1 flex items-center gap-1">
                                <span class="material-symbols-outlined text-base">crisis_alert</span>
                                Esta acción desvinculará la unidad del despacho activo de rutas turísticas.
                            </p>
                        </div>
                    </div>
                    <button type="button" class="shrink-0 px-4 py-2.5 rounded-lg bg-tertiary text-on-tertiary font-label-md font-bold hover:bg-tertiary/90 transition-all flex items-center gap-1.5 shadow-sm cursor-pointer" onclick="openDeleteVehicleModal()">
                        <span class="material-symbols-outlined text-base">delete_forever</span>
                        Dar de Baja Vehículo
                    </button>
                </div>
            </div>
            }
        </div>

        <!-- RIGHT: Permisos y Seguros -->
        <aside class="space-y-6">
            <div class="bg-surface-container-lowest rounded-2xl border border-outline-variant shadow-sm overflow-hidden sticky top-6">
                <div class="px-5 py-4 border-b border-outline-variant bg-surface-bright">
                    <h2 class="text-title-md font-bold text-on-surface flex items-center gap-2">
                        <span class="material-symbols-outlined text-primary">policy</span> Permisos y Seguros
                    </h2>
                </div>
                <div class="p-5 space-y-5">
                    <!-- SOAT -->
                    <div class="space-y-3">
                        <h3 class="text-label-md font-bold text-on-surface border-b border-outline-variant/60 pb-1">Seguro SOAT</h3>
                        <div>
                            <label for="SoatNumber" class="block text-label-sm text-on-surface-variant mb-1">N° Póliza</label>
                            <input id="SoatNumber" asp-for="SoatNumber" class="w-full bg-surface-container-low text-on-surface font-mono py-2 px-3 rounded-lg border border-outline-variant focus:border-primary outline-none text-body-sm" />
                        </div>
                        <div>
                            <label for="SoatProvider" class="block text-label-sm text-on-surface-variant mb-1">Aseguradora</label>
                            <input id="SoatProvider" asp-for="SoatProvider" class="w-full bg-surface-container-low text-on-surface py-2 px-3 rounded-lg border border-outline-variant outline-none text-body-sm" />
                        </div>
                        <div class="grid grid-cols-2 gap-3">
                            <div>
                                <label for="SoatIssueDate" class="block text-label-sm text-on-surface-variant mb-1">Emisión</label>
                                <input id="SoatIssueDate" asp-for="SoatIssueDate" type="date" class="w-full bg-surface-container-low text-on-surface py-2 px-2 rounded-lg border border-outline-variant focus:border-primary outline-none text-body-sm" />
                            </div>
                            <div>
                                <label for="SoatExpiryDate" class="block text-label-sm text-on-surface-variant mb-1">Vencimiento</label>
                                <input id="SoatExpiryDate" asp-for="SoatExpiryDate" type="date" class="w-full bg-surface-container-low text-primary font-bold py-2 px-2 rounded-lg border border-outline-variant focus:border-primary outline-none text-body-sm" />
                            </div>
                        </div>
                    </div>

                    <!-- CITV -->
                    <div class="space-y-3 pt-4 border-t border-outline-variant/50">
                        <h3 class="text-label-md font-bold text-on-surface border-b border-outline-variant/60 pb-1">Revisión Técnica (CITV)</h3>
                        <div>
                            <label for="CitvNumber" class="block text-label-sm text-on-surface-variant mb-1">N° Certificado</label>
                            <input id="CitvNumber" asp-for="CitvNumber" class="w-full bg-surface-container-low text-on-surface font-mono py-2 px-3 rounded-lg border border-outline-variant outline-none text-body-sm" />
                        </div>
                        <div>
                            <label for="CitvProvider" class="block text-label-sm text-on-surface-variant mb-1">Planta de Revisión</label>
                            <input id="CitvProvider" asp-for="CitvProvider" class="w-full bg-surface-container-low text-on-surface py-2 px-3 rounded-lg border border-outline-variant outline-none text-body-sm" />
                        </div>
                        <div>
                            <label for="CitvExpiryDate" class="block text-label-sm text-on-surface-variant mb-1">Fecha Vencimiento</label>
                            <input id="CitvExpiryDate" asp-for="CitvExpiryDate" type="date" class="w-full bg-surface-container-low text-on-surface py-2 px-3 rounded-lg border border-outline-variant outline-none text-body-sm" />
                        </div>
                    </div>

                    <!-- TUC -->
                    <div class="space-y-3 pt-4 border-t border-outline-variant/50">
                        <h3 class="text-label-md font-bold text-on-surface border-b border-outline-variant/60 pb-1">Permisos (DRTC / MTC)</h3>
                        <div>
                            <label for="TucNumber" class="block text-label-sm text-on-surface-variant mb-1">N° TUC</label>
                            <input id="TucNumber" asp-for="TucNumber" class="w-full bg-surface-container-low text-on-surface font-mono py-2 px-3 rounded-lg border border-outline-variant outline-none text-body-sm" />
                        </div>
                        <div>
                            <label for="ResolutionNumber" class="block text-label-sm text-on-surface-variant mb-1">Resolución Directoral</label>
                            <input id="ResolutionNumber" asp-for="ResolutionNumber" class="w-full bg-surface-container-low text-on-surface font-mono py-2 px-3 rounded-lg border border-outline-variant outline-none text-body-sm" />
                        </div>
                    </div>

                    <!-- Estado Operativo -->
                    <div class="pt-4 border-t border-outline-variant/50">
                        <label for="Status" class="block text-label-sm font-bold text-on-surface-variant mb-1">Estado Operativo</label>
                        <select id="Status" asp-for="Status" class="w-full px-3 py-2 rounded-lg border border-outline-variant focus:border-primary text-on-surface font-semibold text-body-sm bg-surface">
                            <option value="Operativo en Ruta (En Servicio)">Operativo en Ruta (En Servicio)</option>
                            <option value="En Espera / Terminal">En Espera / Terminal</option>
                            <option value="En Mantenimiento Preventivo">En Mantenimiento Preventivo</option>
                            <option value="Baja Operativa">Baja Operativa</option>
                        </select>
                    </div>

                    <!-- Save button in sidebar too -->
                    <div class="pt-4 border-t border-outline-variant/50">
                        <button type="submit" class="w-full py-2.5 px-4 rounded-lg bg-primary text-on-primary font-label-lg font-bold hover:bg-primary/90 transition-all flex items-center justify-center gap-2 shadow-sm">
                            <span class="material-symbols-outlined text-[18px]">save</span>
                            Guardar Cambios de Unidad
                        </button>
                    </div>
                </div>
            </div>
        </aside>

    </div>
</form>

<!-- MODAL ELIMINAR VEHÍCULO -->
@if (!isCreate) {
<div class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-inverse-surface/60 backdrop-blur-sm transition-all duration-200 hidden" id="delete-modal" style="display: none;">
    <div class="bg-surface-container-lowest rounded-2xl max-w-lg w-full p-6 shadow-2xl border border-outline-variant relative">
        <div class="flex items-start gap-4">
            <div class="w-12 h-12 rounded-2xl bg-error-container text-tertiary flex items-center justify-center shrink-0 shadow-sm">
                <span class="material-symbols-outlined text-2xl">warning</span>
            </div>
            <div>
                <h3 class="text-headline-sm font-bold text-on-surface leading-snug">¿Confirmas dar de baja la unidad @Model.LicensePlate?</h3>
                <p class="text-body-sm text-outline mt-1 font-mono">@Model.Model &bull; @Model.SeatCapacity pasajeros</p>
            </div>
        </div>
        <div class="mt-4 p-4 rounded-xl bg-error-container/40 border border-tertiary/30">
            <div class="flex items-center gap-2 text-tertiary font-label-md font-bold">
                <span class="material-symbols-outlined text-lg">crisis_alert</span>
                <span>Advertencia operativa crítica</span>
            </div>
            <p class="text-body-sm text-on-surface-variant mt-1 leading-relaxed">
                Dar de baja esta unidad la desvinculará del despacho activo y requerirá reasignación inmediata de flota.
            </p>
        </div>
        <div class="mt-4 space-y-2">
            <label for="confirm-plate-input" class="block text-label-sm text-on-surface-variant font-bold">Para confirmar, escribe la placa <span class="font-mono text-tertiary bg-error-container/40 px-1 rounded">@Model.LicensePlate</span> o la palabra <span class="font-mono text-tertiary bg-error-container/40 px-1 rounded">ELIMINAR</span>:</label>
            <input id="confirm-plate-input" type="text" class="w-full px-3.5 py-2.5 rounded-lg border border-outline-variant text-on-surface font-mono font-bold focus:border-tertiary focus:ring-1 focus:ring-tertiary text-body-md" placeholder="Escribe @Model.LicensePlate o ELIMINAR" />
        </div>
        <form asp-action="DeleteVehicle" method="post" class="mt-6 flex items-center justify-end gap-3 pt-3 border-t border-outline-variant">
            <input type="hidden" name="id" value="@Model.Id" />
            <button type="button" class="px-5 py-2.5 rounded-lg border border-outline-variant text-on-surface-variant font-label-md hover:bg-surface-container transition-colors cursor-pointer" onclick="closeDeleteVehicleModal()">Cancelar</button>
            <button type="submit" id="confirm-delete-btn" disabled class="px-5 py-2.5 rounded-lg bg-tertiary text-on-tertiary font-label-md font-bold hover:bg-tertiary/90 transition-all flex items-center gap-1.5 shadow-md disabled:opacity-40 disabled:cursor-not-allowed">
                <span class="material-symbols-outlined text-base">delete</span>
                Sí, Dar de Baja
            </button>
        </form>
    </div>
</div>

<script>
    function openDeleteVehicleModal() {
        const m = document.getElementById('delete-modal');
        if (m) {
            m.classList.remove('hidden');
            m.style.display = 'flex';
        }
    }

    function closeDeleteVehicleModal() {
        const m = document.getElementById('delete-modal');
        if (m) {
            m.classList.add('hidden');
            m.style.display = 'none';
        }
    }

    document.getElementById('confirm-plate-input')?.addEventListener('input', function() {
        const val = this.value.trim().toUpperCase();
        const plate = '@Model.LicensePlate'.toUpperCase();
        const btn = document.getElementById('confirm-delete-btn');
        btn.disabled = !(val === plate || val === 'ELIMINAR');
    });
</script>
}

<!-- MODAL DE CONFIRMACIÓN: ELIMINAR IMAGEN VEHÍCULO -->
<div class="fixed inset-0 z-[100] flex items-center justify-center p-4 bg-inverse-surface/70 backdrop-blur-sm transition-opacity duration-200 hidden" id="deleteVehicleImageModal" style="display: none;">
  <div class="bg-surface-container-lowest rounded-2xl w-full max-w-md border border-tertiary/30 overflow-hidden transform transition-all duration-200 shadow-xl">
    <div class="h-1.5 w-full bg-red-500"></div>
    <div class="p-5 pb-3 flex items-start justify-between gap-4">
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-red-100 border border-red-200 flex items-center justify-center text-red-600 shrink-0">
                <span class="material-symbols-outlined text-[24px]">delete</span>
            </div>
            <div>
                <h3 class="text-title-md font-title-md text-on-surface font-bold leading-snug">¿Eliminar esta fotografía?</h3>
            </div>
        </div>
        <button class="p-1.5 rounded-lg text-on-surface-variant hover:bg-surface-container transition-colors cursor-pointer" onclick="closeVehicleImageModal()" type="button">
            <span class="material-symbols-outlined">close</span>
        </button>
    </div>
    <div class="px-5 py-3">
        <p class="text-body-md font-body-md text-on-surface-variant leading-relaxed">
            Esta acción eliminará permanentemente la fotografía del vehículo del servidor y no se podrá deshacer. ¿Deseas continuar?
        </p>
    </div>
    <div class="p-5 pt-4 flex justify-end gap-3">
        <button class="px-5 py-2.5 rounded-lg border border-outline-variant bg-surface-container-lowest text-on-surface font-label-md font-bold hover:bg-surface-container transition-all cursor-pointer" onclick="closeVehicleImageModal()" type="button">Cancelar</button>
        <button type="button" class="flex items-center gap-2 px-5 py-2.5 rounded-lg bg-red-600 text-white font-label-md font-bold shadow-sm transition-all hover:bg-red-700 cursor-pointer" id="confirmVehicleImageDeleteBtn" onclick="confirmVehicleImageDelete()">
            <span class="material-symbols-outlined text-[18px]">delete_forever</span>
            <span>Sí, Eliminar</span>
        </button>
    </div>
  </div>
</div>

<script>
    let pendingDeleteImageId = null;
    let pendingDeleteVehicleId = null;
    let pendingDeleteElement = null;

    function previewImages(input) {
        const container = document.getElementById('image-preview');
        if (!container) return;
        container.innerHTML = '';
        if (input.files && input.files.length > 0) {
            container.classList.remove('hidden');
            Array.from(input.files).forEach(file => {
                const reader = new FileReader();
                reader.onload = e => {
                    const div = document.createElement('div');
                    div.className = 'relative rounded-xl border border-primary/40 overflow-hidden bg-surface-container-low shadow-sm flex flex-col';
                    div.innerHTML = `
                        <div class="relative h-32 w-full overflow-hidden bg-surface-container">
                            <img src="${e.target.result}" alt="${file.name}" class="w-full h-full object-cover">
                        </div>
                        <div class="p-2.5 bg-surface-container-lowest flex-1 flex flex-col justify-between gap-1.5">
                            <span class="text-xs font-semibold text-on-surface truncate block" title="${file.name}">${file.name}</span>
                            <div class="flex items-center justify-between gap-1 pt-1 border-t border-outline-variant/40">
                                <span class="px-2 py-0.5 rounded text-[10px] bg-primary/10 text-primary font-bold">Por Guardar</span>
                                <span class="text-[11px] text-on-surface-variant font-medium">${(file.size / 1024 / 1024).toFixed(1)} MB</span>
                            </div>
                        </div>
                    `;
                    container.appendChild(div);
                };
                reader.readAsDataURL(file);
            });
        } else {
            container.classList.add('hidden');
        }
    }

    document.addEventListener('DOMContentLoaded', function() {
        const dropZone = document.getElementById('drop-zone');
        const fileInput = document.getElementById('VehicleImages');

        if (dropZone && fileInput) {
            ['dragenter', 'dragover'].forEach(eventName => {
                dropZone.addEventListener(eventName, e => {
                    e.preventDefault();
                    e.stopPropagation();
                    dropZone.classList.add('border-primary', 'bg-surface-container-low/60');
                }, false);
            });

            ['dragleave', 'drop'].forEach(eventName => {
                dropZone.addEventListener(eventName, e => {
                    e.preventDefault();
                    e.stopPropagation();
                    dropZone.classList.remove('border-primary', 'bg-surface-container-low/60');
                }, false);
            });

            dropZone.addEventListener('drop', e => {
                const dt = e.dataTransfer;
                const files = dt ? dt.files : null;
                if (files && files.length > 0) {
                    fileInput.files = files;
                    previewImages(fileInput);
                }
            }, false);
        }
    });

    function setCoverVehicleImage(vehicleId, imageId, btnElement) {
        if (!vehicleId || vehicleId === '00000000-0000-0000-0000-000000000000') {
            return;
        }
        
        const prevHtml = btnElement.innerHTML;
        btnElement.disabled = true;
        btnElement.innerHTML = '<span class="material-symbols-outlined text-[14px] animate-spin">progress_activity</span>';

        fetch('/Admin/SetCoverVehicleImage?vehicleId=' + vehicleId + '&imageId=' + imageId, {
            method: 'POST',
            headers: {
                'X-Requested-With': 'XMLHttpRequest'
            }
        })
        .then(response => {
            if (!response.ok) throw new Error('Error al actualizar');
            return response.json();
        })
        .then(data => {
            if (data.success) {
                document.querySelectorAll('.vehicle-image-card').forEach(card => {
                    const cardImgId = card.getAttribute('data-image-id');
                    const isCurrent = (cardImgId === imageId);
                    
                    if (isCurrent) {
                        card.classList.add('border-primary', 'ring-2', 'ring-primary/40', 'shadow-md');
                        card.classList.remove('border-outline-variant');
                    } else {
                        card.classList.remove('border-primary', 'ring-2', 'ring-primary/40', 'shadow-md');
                        card.classList.add('border-outline-variant');
                    }
                    
                    const badge = card.querySelector('.cover-badge');
                    if (badge) {
                        badge.classList.toggle('hidden', !isCurrent);
                    }
                    
                    const hoverBtn = card.querySelector('.set-cover-hover-btn');
                    if (hoverBtn) {
                        hoverBtn.classList.toggle('hidden', isCurrent);
                    }
                    
                    const footerSlot = card.querySelector('.cover-action-slot');
                    if (footerSlot) {
                        if (isCurrent) {
                            footerSlot.innerHTML = `
                                <span class="cover-footer-tag px-2.5 py-1 rounded-md text-[11px] bg-primary/10 text-primary font-bold flex items-center gap-1 border border-primary/20">
                                    <span class="material-symbols-outlined text-[14px]" style="font-variation-settings: 'FILL' 1;">star</span>
                                    <span>Principal</span>
                                </span>
                            `;
                        } else {
                            footerSlot.innerHTML = `
                                <button type="button" onclick="setCoverVehicleImage('${vehicleId}', '${cardImgId}', this)" 
                                        class="set-cover-footer-btn text-[11px] text-amber-700 hover:text-amber-900 font-bold flex items-center gap-1 cursor-pointer bg-amber-50 hover:bg-amber-100 px-2.5 py-1 rounded-md transition-all active:scale-95 border border-amber-200" 
                                        title="Elegir como imagen principal">
                                    <span class="material-symbols-outlined text-[14px] text-amber-500" style="font-variation-settings: 'FILL' 1;">star</span>
                                    <span>Hacer Principal</span>
                                </button>
                            `;
                        }
                    }
                });
            }
        })
        .catch(err => {
            console.error(err);
            btnElement.innerHTML = prevHtml;
            btnElement.disabled = false;
            alert('No se pudo establecer la foto como principal.');
        });
    }

    function openDeleteVehicleImageModal(imageId, vehicleId, btnElement) {
        pendingDeleteImageId = imageId;
        pendingDeleteVehicleId = vehicleId;
        pendingDeleteElement = btnElement;
        const m = document.getElementById('deleteVehicleImageModal');
        if (m) {
            m.classList.remove('hidden');
            m.style.display = 'flex';
        }
    }

    function closeVehicleImageModal() {
        pendingDeleteImageId = null;
        pendingDeleteVehicleId = null;
        pendingDeleteElement = null;
        const m = document.getElementById('deleteVehicleImageModal');
        if (m) {
            m.classList.add('hidden');
            m.style.display = 'none';
        }
    }

    function confirmVehicleImageDelete() {
        if (!pendingDeleteImageId) return;
        
        const confirmBtn = document.getElementById('confirmVehicleImageDeleteBtn');
        const originalText = confirmBtn.innerHTML;
        confirmBtn.disabled = true;
        confirmBtn.innerHTML = '<span class="material-symbols-outlined text-[18px] animate-spin">progress_activity</span> Eliminando...';

        fetch('/Admin/DeleteVehicleImage?id=' + pendingDeleteImageId + '&vehicleId=' + pendingDeleteVehicleId, {
            method: 'POST',
            headers: {
                'X-Requested-With': 'XMLHttpRequest'
            }
        })
        .then(response => {
            if (!response.ok) throw new Error('Error al eliminar');
            return response.json();
        })
        .then(() => {
            const card = document.querySelector(`.vehicle-image-card[data-image-id="${pendingDeleteImageId}"]`);
            if (card) {
                card.remove();
            }
            closeVehicleImageModal();
            
            const remaining = document.querySelectorAll('.vehicle-image-card');
            const countBadge = document.getElementById('vehicle-images-count-badge');
            if (countBadge) {
                countBadge.innerText = `${remaining.length} fotos guardadas`;
                if (remaining.length === 0) countBadge.classList.add('hidden');
            }
            if (remaining.length === 0) {
                const container = document.getElementById('vehicle-image-preview-container');
                if (container) {
                    container.innerHTML = `
                        <div class="col-span-full text-center py-8 text-on-surface-variant text-sm border-2 border-dashed border-outline-variant rounded-lg" id="empty-vehicle-images-msg">
                            Aún no has subido fotografías para esta unidad.
                        </div>
                    `;
                }
            }
        })
        .catch(err => {
            console.error(err);
            alert('Hubo un error al eliminar la imagen.');
        })
        .finally(() => {
            confirmBtn.disabled = false;
            confirmBtn.innerHTML = originalText;
        });
    }
</script>

@if (Model.ExistingImages != null) {
    foreach(var img in Model.ExistingImages) {
        <form id="delete-img-form-@img.Id" asp-action="DeleteVehicleImage" method="post" class="hidden">
            <input type="hidden" name="id" value="@img.Id" />
            <input type="hidden" name="vehicleId" value="@Model.Id" />
        </form>
    }
}
</div>
