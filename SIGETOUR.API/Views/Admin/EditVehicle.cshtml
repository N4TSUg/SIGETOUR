@model SIGETOUR.API.Core.Entities.Vehicle
@using SIGETOUR.API.Core.Entities
@{
    bool isCreate = Model.Id == Guid.Empty;
    ViewData["Title"] = isCreate ? "Registrar Vehículo" : "Editar Vehículo " + Model.LicensePlate;
    Layout = "_AdminLayout";
}

<div class="px-4 sm:px-6 lg:px-8 py-8 w-full max-w-9xl mx-auto">
<form asp-action="EditVehicle" method="post" enctype="multipart/form-data">
    <input type="hidden" asp-for="Id" />

    <!-- Header -->
    <div class="sm:flex sm:justify-between sm:items-center mb-8">
        <div class="flex items-center gap-3">
            <a href="@Url.Action("Fleet", "Admin")" class="p-2 rounded-full hover:bg-surface-container-low transition-colors text-on-surface-variant shrink-0">
                <span class="material-symbols-outlined text-[24px]">arrow_back</span>
            </a>
            <div>
                <h1 class="text-headline-md font-headline-md font-bold text-on-surface">
                    @(isCreate ? "Registrar Nueva Unidad Vehicular" : "Editar Vehículo – " + Model.LicensePlate)
                </h1>
                <p class="text-body-md text-on-surface-variant mt-0.5">Ficha técnica oficial para operaciones y despachos.</p>
            </div>
        </div>
        <div class="flex gap-3 mt-4 sm:mt-0">
            <a href="@Url.Action("Fleet", "Admin")" class="px-4 py-2.5 rounded-lg border border-outline text-on-surface-variant hover:bg-surface-container transition-colors font-label-md">Cancelar</a>
            <button type="submit" class="px-6 py-2.5 rounded-lg bg-primary text-on-primary font-label-lg hover:bg-primary/90 transition-all flex items-center gap-2 shadow-md">
                <span class="material-symbols-outlined text-xl">save</span>
                Guardar Cambios
            </button>
        </div>
    </div>

    <!-- Main Grid -->
    <div class="grid grid-cols-1 xl:grid-cols-3 gap-6">

        <!-- LEFT: 2/3 width -->
        <div class="xl:col-span-2 space-y-6">

            <!-- SECCIÓN 1: Identificación -->
            <div class="bg-surface-container-lowest rounded-2xl border border-outline-variant shadow-sm overflow-hidden">
                <div class="px-6 py-4 border-b border-outline-variant bg-surface-bright">
                    <h2 class="text-title-md font-bold text-on-surface flex items-center gap-2">
                        <span class="material-symbols-outlined text-primary">directions_bus</span> Identificación del Vehículo
                    </h2>
                </div>
                <div class="p-6 grid grid-cols-1 sm:grid-cols-2 gap-5">
                    <div>
                        <label class="block text-label-sm font-bold text-on-surface-variant mb-1">Placa de Rodaje <span class="text-tertiary">*</span></label>
                        <div class="relative">
                            <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-outline text-[20px]">pin</span>
                            <input asp-for="LicensePlate" class="w-full bg-surface-container-low text-on-surface font-bold tracking-widest pl-10 pr-16 py-2.5 rounded-lg border border-outline-variant focus:border-primary focus:ring-2 focus:ring-primary/20 uppercase outline-none text-body-md" maxlength="8" placeholder="Ej. T7C-841" required />
                            <span class="absolute right-3 top-1/2 -translate-y-1/2 text-label-sm bg-primary-container text-on-primary-container font-bold px-1.5 py-0.5 rounded">PERÚ</span>
                        </div>
                    </div>
                    <div>
                        <label class="block text-label-sm font-bold text-on-surface-variant mb-1">Marca y Modelo <span class="text-tertiary">*</span></label>
                        <input asp-for="Model" class="w-full bg-surface-container-low text-on-surface py-2.5 px-3 rounded-lg border border-outline-variant focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none text-body-md" placeholder="Ej. Mercedes-Benz Sprinter 515" required />
                    </div>
                    <div>
                        <label class="block text-label-sm font-bold text-on-surface-variant mb-1">Categoría</label>
                        <select asp-for="Category" class="w-full bg-surface-container-low text-on-surface py-2.5 px-3 rounded-lg border border-outline-variant focus:border-primary outline-none text-body-md">
                            <option value="Van Turística VIP (14 - 19 Pas.)">Van Turística VIP (14 - 19 Pas.)</option>
                            <option value="Minibús (20 - 30 Pas.)">Minibús (20 - 30 Pas.)</option>
                            <option value="Bus Panorámico de 2 pisos">Bus Panorámico de 2 pisos</option>
                            <option value="SUV 4x4 (Servicio Privado)">SUV 4x4 (Servicio Privado)</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-label-sm font-bold text-on-surface-variant mb-1">Año de Fabricación</label>
                        <input asp-for="ManufactureYear" type="number" min="2010" max="2026" class="w-full bg-surface-container-low text-on-surface py-2.5 px-3 rounded-lg border border-outline-variant focus:border-primary outline-none text-body-md" />
                    </div>
                </div>
            </div>

            <!-- SECCIÓN 2: Datos Técnicos -->
            <div class="bg-surface-container-lowest rounded-2xl border border-outline-variant shadow-sm overflow-hidden">
                <div class="px-6 py-4 border-b border-outline-variant bg-surface-bright">
                    <h2 class="text-title-md font-bold text-on-surface flex items-center gap-2">
                        <span class="material-symbols-outlined text-primary">engineering</span> Datos Técnicos del Motor y Chasis
                    </h2>
                </div>
                <div class="p-6 grid grid-cols-1 sm:grid-cols-2 gap-5">
                    <div>
                        <label class="block text-label-sm font-bold text-on-surface-variant mb-1">N° VIN / Chasis</label>
                        <input asp-for="ChassisNumber" class="w-full bg-surface-container-low text-on-surface font-mono py-2.5 px-3 rounded-lg border border-outline-variant focus:border-primary outline-none text-body-md uppercase" maxlength="17" placeholder="Ej. 8AC906653KE284912" />
                    </div>
                    <div>
                        <label class="block text-label-sm font-bold text-on-surface-variant mb-1">N° de Motor</label>
                        <input asp-for="EngineNumber" class="w-full bg-surface-container-low text-on-surface font-mono py-2.5 px-3 rounded-lg border border-outline-variant focus:border-primary outline-none text-body-md uppercase" placeholder="Ej. OM651-955-408921" />
                    </div>
                    <div>
                        <label class="block text-label-sm font-bold text-on-surface-variant mb-1">Capacidad de Asientos <span class="text-tertiary">*</span></label>
                        <div class="relative">
                            <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-outline text-[20px]">airline_seat_recline_normal</span>
                            <input asp-for="SeatCapacity" type="number" min="1" max="80" class="w-full bg-surface-container-low text-on-surface font-bold pl-10 py-2.5 px-3 rounded-lg border border-outline-variant focus:border-primary outline-none text-title-sm" required />
                        </div>
                    </div>
                    <div>
                        <label class="block text-label-sm font-bold text-on-surface-variant mb-1">Color</label>
                        <input asp-for="Color" class="w-full bg-surface-container-low text-on-surface py-2.5 px-3 rounded-lg border border-outline-variant focus:border-primary outline-none text-body-md" placeholder="Ej. Blanco Glaciar" />
                    </div>
                    <div class="sm:col-span-2">
                        <label class="block text-label-sm font-bold text-on-surface-variant mb-1">Combustible</label>
                        <select asp-for="FuelType" class="w-full bg-surface-container-low text-on-surface py-2.5 px-3 rounded-lg border border-outline-variant focus:border-primary outline-none text-body-md">
                            <option value="Diésel B5 S-50 (Ultra Bajo Azufre)">Diésel B5 S-50 (Ultra Bajo Azufre)</option>
                            <option value="Gasolina 95/97 Octanos">Gasolina 95/97 Octanos</option>
                            <option value="GNV / GLP">GNV / GLP</option>
                        </select>
                    </div>
                </div>
            </div>

            <!-- SECCIÓN 3: Galería Fotográfica -->
            <div class="bg-surface-container-lowest rounded-2xl border border-outline-variant shadow-sm overflow-hidden">
                <div class="px-6 py-4 border-b border-outline-variant bg-surface-bright flex justify-between items-center">
                    <h2 class="text-title-md font-bold text-on-surface flex items-center gap-2">
                        <span class="material-symbols-outlined text-primary">photo_library</span> Galería Fotográfica del Vehículo
                    </h2>
                    @if (Model.Images != null) {
                        <span class="text-label-sm bg-primary-container text-on-primary-container px-2 py-1 rounded-lg font-bold">@Model.Images.Count / 6 Fotos</span>
                    }
                </div>
                <div class="p-6 space-y-4">
                    <!-- Existing images grid -->
                    @if (Model.Images != null && Model.Images.Any()) {
                        <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
                            @foreach (var img in Model.Images) {
                                <div class="relative group rounded-xl overflow-hidden border border-outline-variant aspect-video bg-surface-container-low">
                                    <img src="@img.ImageUrl" alt="Foto vehículo" class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105" />
                                    @if (img.IsCover) {
                                        <span class="absolute top-2 left-2 bg-primary text-on-primary text-label-sm font-bold px-2 py-0.5 rounded-lg">Portada</span>
                                    }
                                    <div class="absolute inset-0 bg-inverse-surface/60 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center">
                                        <button type="button" class="p-2 bg-error text-on-error rounded-full" onclick="if(confirm('¿Eliminar esta foto?')) document.getElementById('delete-img-form-@img.Id').submit();">
                                                <span class="material-symbols-outlined text-[20px]">delete</span>
                                            </button>
                                    </div>
                                </div>
                            }
                        </div>
                    }

                    <!-- Upload zone -->
                    <label class="flex flex-col items-center justify-center w-full h-36 border-2 border-dashed border-outline-variant rounded-xl cursor-pointer hover:bg-surface-container-low transition-colors bg-surface group">
                        <span class="material-symbols-outlined text-3xl text-outline group-hover:text-primary transition-colors">cloud_upload</span>
                        <span class="text-body-sm text-on-surface-variant mt-1 text-center">Arrastra fotos aquí o <span class="text-primary underline">haz clic para examinar</span></span>
                        <span class="text-label-sm text-outline mt-0.5">JPG, PNG, WebP – máx. 10 MB por foto</span>
                        <input type="file" name="VehicleImages" multiple accept="image/jpeg,image/png,image/webp" class="sr-only" onchange="previewImages(this)" />
                    </label>

                    <!-- Preview container -->
                    <div id="image-preview" class="grid grid-cols-2 sm:grid-cols-3 gap-3 hidden"></div>
                </div>
            </div>

            <!-- SECCIÓN 4: Zona de Peligro -->
            @if (!isCreate) {
            <div class="bg-surface-container-lowest rounded-xl border-2 border-tertiary/30 p-6 shadow-sm">
                <div class="flex items-start justify-between flex-col md:flex-row gap-4">
                    <div class="flex items-start gap-3.5">
                        <div class="w-11 h-11 rounded-xl bg-error-container text-tertiary flex items-center justify-center shrink-0">
                            <span class="material-symbols-outlined text-2xl">warning</span>
                        </div>
                        <div>
                            <h3 class="text-title-sm font-bold text-on-surface">Zona de Peligro: Dar de Baja o Desvincular Vehículo @Model.LicensePlate</h3>
                            <p class="text-body-sm text-tertiary mt-1 flex items-center gap-1">
                                <span class="material-symbols-outlined text-base">crisis_alert</span>
                                Esta acción desvinculará la unidad del despacho activo de rutas turísticas.
                            </p>
                        </div>
                    </div>
                    <button type="button" class="shrink-0 px-4 py-2.5 rounded-lg bg-tertiary text-on-tertiary font-label-md font-bold hover:bg-tertiary/90 transition-all flex items-center gap-1.5 shadow-sm" onclick="document.getElementById('delete-modal').classList.remove('hidden')">
                        <span class="material-symbols-outlined text-base">delete_forever</span>
                        Dar de Baja Vehículo
                    </button>
                </div>
            </div>
            }
        </div>

        <!-- RIGHT: Permisos y Seguros -->
        <aside class="space-y-6">
            <div class="bg-surface-container-lowest rounded-2xl border border-outline-variant shadow-sm overflow-hidden sticky top-6">
                <div class="px-5 py-4 border-b border-outline-variant bg-surface-bright">
                    <h2 class="text-title-md font-bold text-on-surface flex items-center gap-2">
                        <span class="material-symbols-outlined text-primary">policy</span> Permisos y Seguros
                    </h2>
                </div>
                <div class="p-5 space-y-5">
                    <!-- SOAT -->
                    <div class="space-y-3">
                        <h3 class="text-label-md font-bold text-on-surface border-b border-outline-variant/60 pb-1">Seguro SOAT</h3>
                        <div>
                            <label class="block text-label-sm text-on-surface-variant mb-1">N° Póliza</label>
                            <input asp-for="SoatNumber" class="w-full bg-surface-container-low text-on-surface font-mono py-2 px-3 rounded-lg border border-outline-variant focus:border-primary outline-none text-body-sm" />
                        </div>
                        <div>
                            <label class="block text-label-sm text-on-surface-variant mb-1">Aseguradora</label>
                            <input asp-for="SoatProvider" class="w-full bg-surface-container-low text-on-surface py-2 px-3 rounded-lg border border-outline-variant outline-none text-body-sm" />
                        </div>
                        <div class="grid grid-cols-2 gap-3">
                            <div>
                                <label class="block text-label-sm text-on-surface-variant mb-1">Emisión</label>
                                <input asp-for="SoatIssueDate" type="date" class="w-full bg-surface-container-low text-on-surface py-2 px-2 rounded-lg border border-outline-variant focus:border-primary outline-none text-body-sm" />
                            </div>
                            <div>
                                <label class="block text-label-sm text-on-surface-variant mb-1">Vencimiento</label>
                                <input asp-for="SoatExpiryDate" type="date" class="w-full bg-surface-container-low text-primary font-bold py-2 px-2 rounded-lg border border-outline-variant focus:border-primary outline-none text-body-sm" />
                            </div>
                        </div>
                    </div>

                    <!-- CITV -->
                    <div class="space-y-3 pt-4 border-t border-outline-variant/50">
                        <h3 class="text-label-md font-bold text-on-surface border-b border-outline-variant/60 pb-1">Revisión Técnica (CITV)</h3>
                        <div>
                            <label class="block text-label-sm text-on-surface-variant mb-1">N° Certificado</label>
                            <input asp-for="CitvNumber" class="w-full bg-surface-container-low text-on-surface font-mono py-2 px-3 rounded-lg border border-outline-variant outline-none text-body-sm" />
                        </div>
                        <div>
                            <label class="block text-label-sm text-on-surface-variant mb-1">Planta de Revisión</label>
                            <input asp-for="CitvProvider" class="w-full bg-surface-container-low text-on-surface py-2 px-3 rounded-lg border border-outline-variant outline-none text-body-sm" />
                        </div>
                        <div>
                            <label class="block text-label-sm text-on-surface-variant mb-1">Fecha Vencimiento</label>
                            <input asp-for="CitvExpiryDate" type="date" class="w-full bg-surface-container-low text-on-surface py-2 px-3 rounded-lg border border-outline-variant outline-none text-body-sm" />
                        </div>
                    </div>

                    <!-- TUC -->
                    <div class="space-y-3 pt-4 border-t border-outline-variant/50">
                        <h3 class="text-label-md font-bold text-on-surface border-b border-outline-variant/60 pb-1">Permisos (DRTC / MTC)</h3>
                        <div>
                            <label class="block text-label-sm text-on-surface-variant mb-1">N° TUC</label>
                            <input asp-for="TucNumber" class="w-full bg-surface-container-low text-on-surface font-mono py-2 px-3 rounded-lg border border-outline-variant outline-none text-body-sm" />
                        </div>
                        <div>
                            <label class="block text-label-sm text-on-surface-variant mb-1">Resolución Directoral</label>
                            <input asp-for="ResolutionNumber" class="w-full bg-surface-container-low text-on-surface font-mono py-2 px-3 rounded-lg border border-outline-variant outline-none text-body-sm" />
                        </div>
                    </div>

                    <!-- Estado Operativo -->
                    <div class="pt-4 border-t border-outline-variant/50">
                        <label class="block text-label-sm font-bold text-on-surface-variant mb-1">Estado Operativo</label>
                        <select asp-for="Status" class="w-full px-3 py-2 rounded-lg border border-outline-variant focus:border-primary text-on-surface font-semibold text-body-sm bg-surface">
                            <option value="Operativo en Ruta (En Servicio)">Operativo en Ruta (En Servicio)</option>
                            <option value="En Espera / Terminal">En Espera / Terminal</option>
                            <option value="En Mantenimiento Preventivo">En Mantenimiento Preventivo</option>
                            <option value="Baja Operativa">Baja Operativa</option>
                        </select>
                    </div>

                    <!-- Save button in sidebar too -->
                    <div class="pt-4 border-t border-outline-variant/50">
                        <button type="submit" class="w-full py-2.5 px-4 rounded-lg bg-primary text-on-primary font-label-lg font-bold hover:bg-primary/90 transition-all flex items-center justify-center gap-2 shadow-sm">
                            <span class="material-symbols-outlined text-[18px]">save</span>
                            Guardar Cambios de Unidad
                        </button>
                    </div>
                </div>
            </div>
        </aside>

    </div>
</form>

<!-- MODAL ELIMINAR -->
@if (!isCreate) {
<div class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-inverse-surface/60 backdrop-blur-sm transition-all duration-200 hidden" id="delete-modal">
    <div class="bg-surface-container-lowest rounded-2xl max-w-lg w-full p-6 shadow-2xl border border-outline-variant relative">
        <div class="flex items-start gap-4">
            <div class="w-12 h-12 rounded-2xl bg-error-container text-tertiary flex items-center justify-center shrink-0 shadow-sm">
                <span class="material-symbols-outlined text-2xl">warning</span>
            </div>
            <div>
                <h3 class="text-headline-sm font-bold text-on-surface leading-snug">¿Confirmas dar de baja la unidad @Model.LicensePlate?</h3>
                <p class="text-body-sm text-outline mt-1 font-mono">@Model.Model &bull; @Model.SeatCapacity pasajeros</p>
            </div>
        </div>
        <div class="mt-4 p-4 rounded-xl bg-error-container/40 border border-tertiary/30">
            <div class="flex items-center gap-2 text-tertiary font-label-md font-bold">
                <span class="material-symbols-outlined text-lg">crisis_alert</span>
                <span>Advertencia operativa crítica</span>
            </div>
            <p class="text-body-sm text-on-surface-variant mt-1 leading-relaxed">
                Dar de baja esta unidad la desvinculará del despacho activo y requerirá reasignación inmediata de flota.
            </p>
        </div>
        <div class="mt-4 space-y-2">
            <label class="block text-label-sm text-on-surface-variant font-bold">Para confirmar, escribe la placa <span class="font-mono text-tertiary bg-error-container/40 px-1 rounded">@Model.LicensePlate</span> o la palabra <span class="font-mono text-tertiary bg-error-container/40 px-1 rounded">ELIMINAR</span>:</label>
            <input id="confirm-plate-input" type="text" class="w-full px-3.5 py-2.5 rounded-lg border border-outline-variant text-on-surface font-mono font-bold focus:border-tertiary focus:ring-1 focus:ring-tertiary text-body-md" placeholder="Escribe @Model.LicensePlate o ELIMINAR" />
        </div>
        <form asp-action="DeleteVehicle" method="post" class="mt-6 flex items-center justify-end gap-3 pt-3 border-t border-outline-variant">
            <input type="hidden" name="id" value="@Model.Id" />
            <button type="button" class="px-5 py-2.5 rounded-lg border border-outline-variant text-on-surface-variant font-label-md hover:bg-surface-container transition-colors" onclick="document.getElementById('delete-modal').classList.add('hidden')">Cancelar</button>
            <button type="submit" id="confirm-delete-btn" disabled class="px-5 py-2.5 rounded-lg bg-tertiary text-on-tertiary font-label-md font-bold hover:bg-tertiary/90 transition-all flex items-center gap-1.5 shadow-md disabled:opacity-40 disabled:cursor-not-allowed">
                <span class="material-symbols-outlined text-base">delete</span>
                Sí, Dar de Baja
            </button>
        </form>
    </div>
</div>

<script>
    document.getElementById('confirm-plate-input')?.addEventListener('input', function() {
        const val = this.value.trim().toUpperCase();
        const plate = '@Model.LicensePlate'.toUpperCase();
        const btn = document.getElementById('confirm-delete-btn');
        btn.disabled = !(val === plate || val === 'ELIMINAR');
    });
</script>
}

<script>
    function previewImages(input) {
        const container = document.getElementById('image-preview');
        container.innerHTML = '';
        if (input.files && input.files.length > 0) {
            container.classList.remove('hidden');
            Array.from(input.files).forEach(file => {
                const reader = new FileReader();
                reader.onload = e => {
                    const div = document.createElement('div');
                    div.className = 'relative rounded-xl overflow-hidden border border-outline-variant aspect-video bg-surface-container-low';
                    div.innerHTML = `<img src="${e.target.result}" class="w-full h-full object-cover" /><span class="absolute bottom-1 left-1 bg-surface-container/80 text-label-sm text-on-surface px-1 rounded">${file.name}</span>`;
                    container.appendChild(div);
                };
                reader.readAsDataURL(file);
            });
        } else {
            container.classList.add('hidden');
        }
    }
</script>

@if (Model.Images != null) {
    foreach(var img in Model.Images) {
        <form id="delete-img-form-@img.Id" asp-action="DeleteVehicleImage" method="post" class="hidden">
            <input type="hidden" name="id" value="@img.Id" />
            <input type="hidden" name="vehicleId" value="@Model.Id" />
        </form>
    }
}
</div>
